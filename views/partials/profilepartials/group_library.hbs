<section class="group-profile-panel group-profile-library-section">
  <div class="group-profile-panel-header">
    <p class="group-profile-eyebrow">group contributions</p>
    <h2 class="group-profile-panel-title">group library contributions</h2>
  </div>

  {{#if groupLibraryUnits.length}}
    <div class="group-profile-library-grid">
      {{#each groupLibraryUnits}}
        <article class="group-profile-library-card group-dashboard-wave-card {{toLowerCase this.unitType}}-dashboard-card">
          <div class="group-dashboard-wave-card-inner">
            <div class="group-dashboard-wave-header">
              <img src="/icons/unitsvg.svg" alt="" aria-hidden="true" class="group-dashboard-wave-image">
            </div>

            <div class="group-dashboard-wave-content group-profile-library-wave-content">
              <div class="group-profile-library-icon">
                <img src="/icons/{{toLowerCase this.unitType}}.svg" alt="{{unitType}} icon">
              </div>

              <div class="group-profile-library-content">
                <h3 class="group-profile-library-title">{{title}}</h3>

                {{#if author}}
                  <p class="group-profile-library-author">by {{author}}</p>
                {{/if}}

                {{#if mainTopic}}
                  <p class="group-profile-library-topic">{{mainTopic}}</p>
                {{/if}}

                {{#if status}}
                  <p class="group-profile-library-status">{{status}}</p>
                {{/if}}
              </div>

              <a href="/unitviews/{{toLowerCase this.unitType}}s/view/{{this._id}}" class="group-profile-library-link">
                view unit
              </a>
            </div>
          </div>
        </article>
      {{/each}}
    </div>
  {{else}}
    <div class="group-profile-empty-state">
      <p class="group-profile-empty-kicker">No group contributions yet</p>
      <p class="group-profile-empty-text">
        Group library contributions will appear here after they are submitted.
      </p>
    </div>
  {{/if}}
</section>


