<section class="groupmember-profile-panel groupmember-profile-goals-section">
  <div class="groupmember-profile-panel-header">
    <p class="groupmember-profile-eyebrow">professional goals</p>
    <h2 class="groupmember-profile-panel-title">my goals</h2>
  </div>

  {{#if groupMember.goals}}
    <div class="groupmember-profile-goals-body">
      <p class="groupmember-profile-goals-text">
        {{groupMember.goals}}
      </p>
    </div>
  {{else}}
    <div class="groupmember-profile-empty-state">
      <p class="groupmember-profile-empty-kicker">No goals added</p>
      <p class="groupmember-profile-empty-text">
        This group member has not added goals yet.
      </p>
    </div>
  {{/if}}
</section>