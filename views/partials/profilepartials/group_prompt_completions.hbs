<section class="group-profile-panel group-profile-prompts-section">
  <div class="group-profile-panel-header">
    <p class="group-profile-eyebrow">group prompt set progress</p>
    <h2 class="group-profile-panel-title">group completed prompt sets</h2>
  </div>

  {{#if groupCompletedPromptSets.length}}
    <div class="group-profile-prompts-grid">
      {{#each groupCompletedPromptSets}}
        <article class="group-profile-prompts-card">
          <h3 class="group-profile-prompts-title">
            {{this.promptSetTitle}}
          </h3>

          <p class="group-profile-prompts-topic">
            {{#if this.mainTopic}}
              {{this.mainTopic}}
            {{else}}
              No topic recorded
            {{/if}}
          </p>

          {{#if this.badgeEarned}}
            <p class="group-profile-prompts-badge">
              {{this.badgeEarned}}
            </p>
          {{/if}}
        </article>
      {{/each}}
    </div>
  {{else}}
    <div class="group-profile-empty-state">
      <p class="group-profile-empty-kicker">No completed prompt sets yet</p>
      <p class="group-profile-empty-text">
        Completed prompt sets for this group will appear here.
      </p>
    </div>
  {{/if}}
</section>
