<section class="leader-profile-panel leader-profile-badges-section">
  <div class="leader-profile-panel-header">
    <p class="leader-profile-eyebrow">profile badges</p>
    <h2 class="leader-profile-panel-title">my earned badges</h2>
    <p class="leader-profile-panel-intro">
      Badges appear here when you complete prompt sets and earn recognition for applied learning.
    </p>
  </div>

  {{#if leaderBadges.length}}
    <div class="leader-profile-badges-grid">
      {{#each leaderBadges}}
        <article class="leader-profile-badge-card">
          <div class="leader-profile-badge-image-wrap">
            <img
              src="{{earnedBadge.image}}"
              alt="{{earnedBadge.name}} badge"
              class="leader-profile-badge-image"
            >
          </div>

          <div class="leader-profile-badge-content">
            <h3 class="leader-profile-badge-title">{{earnedBadge.name}}</h3>

            <p class="leader-profile-badge-set">
              {{#if promptSetTitle}}
                {{promptSetTitle}}
              {{else}}
                Unknown prompt set
              {{/if}}
            </p>

            <p class="leader-profile-badge-topic">
              {{#if mainTopic}}
                {{mainTopic}}
              {{else}}
                No topic recorded
              {{/if}}
            </p>
          </div>
        </article>
      {{/each}}
    </div>
  {{else}}
    <div class="leader-profile-empty-state">
      <p class="leader-profile-empty-kicker">No badges yet</p>
      <p class="leader-profile-empty-text">
        Complete a prompt set to start building your badge collection.
      </p>
    </div>
  {{/if}}
</section>
