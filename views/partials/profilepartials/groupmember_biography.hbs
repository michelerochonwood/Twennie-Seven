<section class="groupmember-profile-panel groupmember-profile-biography-section">
  <div class="groupmember-profile-panel-header">
    <p class="groupmember-profile-eyebrow">profile biography</p>
    <h2 class="groupmember-profile-panel-title">my biography</h2>
  </div>

  {{#if groupMember.biography}}
    <div class="groupmember-profile-biography-body">
      <p class="groupmember-profile-biography-text">
        {{groupMember.biography}}
      </p>
    </div>
  {{else}}
    <div class="groupmember-profile-empty-state">
      <p class="groupmember-profile-empty-kicker">No biography added</p>
      <p class="groupmember-profile-empty-text">
        This group member has not added a biography yet.
      </p>
    </div>
  {{/if}}
</section>