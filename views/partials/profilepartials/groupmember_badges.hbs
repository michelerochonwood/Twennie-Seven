<section class="groupmember-profile-panel groupmember-profile-badges-section">
  <div class="groupmember-profile-panel-header">
    <p class="groupmember-profile-eyebrow">profile badges</p>
    <h2 class="groupmember-profile-panel-title">my earned badges</h2>

    <p class="groupmember-profile-panel-intro">
      Badges appear here when prompt sets are completed and applied learning milestones are achieved.
    </p>
  </div>

  {{#if memberBadges.length}}
    <div class="groupmember-profile-badges-grid">
      {{#each memberBadges}}
        <article class="groupmember-profile-badge-card">
          <div class="groupmember-profile-badge-image-wrap">
            <img
              src="{{earnedBadge.image}}"
              alt="{{earnedBadge.name}} badge"
              class="groupmember-profile-badge-image"
            >
          </div>

          <div class="groupmember-profile-badge-content">
            <h3 class="groupmember-profile-badge-title">
              {{earnedBadge.name}}
            </h3>

            <p class="groupmember-profile-badge-set">
              {{#if promptSetTitle}}
                {{promptSetTitle}}
              {{else}}
                Unknown prompt set
              {{/if}}
            </p>

            <p class="groupmember-profile-badge-topic">
              {{#if mainTopic}}
                {{mainTopic}}
              {{else}}
                No topic recorded
              {{/if}}
            </p>
          </div>
        </article>
      {{/each}}
    </div>
  {{else}}
    <div class="groupmember-profile-empty-state">
      <p class="groupmember-profile-empty-kicker">No badges yet</p>
      <p class="groupmember-profile-empty-text">
        Complete a prompt set to begin earning badges.
      </p>
    </div>
  {{/if}}
</section>


