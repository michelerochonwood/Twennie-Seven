<script>
  document.addEventListener("DOMContentLoaded", function () {
    const realMainTopicSelect = document.querySelector('select[name="main_topic"]');
    const realSecondaryTopicSelect = document.querySelector('select[name="secondary_topics"]');

    const mainSelects = document.querySelectorAll('.main-topic-select');
    const secondarySelects = document.querySelectorAll('.secondary-topic-select');

    const existingMainTopic = "{{data.main_topic}}";
    const existingSecondaryTopic = "{{data.secondary_topics.[0]}}";

    function clearOther(selects, except) {
      selects.forEach(sel => {
        if (sel !== except) sel.value = "";
      });
    }

    // MAIN TOPIC HANDLER
    mainSelects.forEach(select => {
      select.addEventListener("change", function () {
        const chosen = this.value || "";
        clearOther(mainSelects, this);

        if (!realMainTopicSelect) return;

        // Reset options
        realMainTopicSelect.innerHTML = "";

        if (chosen) {
          const opt = document.createElement("option");
          opt.value = chosen;
          opt.textContent = chosen;
          realMainTopicSelect.appendChild(opt);
          realMainTopicSelect.value = chosen;
        } else {
          const opt = document.createElement("option");
          opt.value = "";
          opt.textContent = "Please select a main topic";
          realMainTopicSelect.appendChild(opt);
          realMainTopicSelect.value = "";
        }
      });
    });

    // SECONDARY TOPIC HANDLER
    secondarySelects.forEach(select => {
      select.addEventListener("change", function () {
        const chosen = this.value || "";
        clearOther(secondarySelects, this);

        if (!realSecondaryTopicSelect) return;

        realSecondaryTopicSelect.innerHTML = "";
        const opt = document.createElement("option");
        opt.value = chosen;
        opt.textContent = chosen || "None";
        realSecondaryTopicSelect.appendChild(opt);
        realSecondaryTopicSelect.value = chosen;
      });
    });

    // PRE-POPULATE MAIN TOPIC ON EDIT
    if (existingMainTopic && realMainTopicSelect) {
      mainSelects.forEach(select => {
        Array.from(select.options).forEach(opt => {
          if (opt.value === existingMainTopic) {
            select.value = existingMainTopic;
          }
        });
      });

      realMainTopicSelect.innerHTML = "";
      const opt = document.createElement("option");
      opt.value = existingMainTopic;
      opt.textContent = existingMainTopic;
      realMainTopicSelect.appendChild(opt);
      realMainTopicSelect.value = existingMainTopic;
    }

    // PRE-POPULATE SECONDARY TOPIC ON EDIT
    if (existingSecondaryTopic && realSecondaryTopicSelect) {
      secondarySelects.forEach(select => {
        Array.from(select.options).forEach(opt => {
          if (opt.value === existingSecondaryTopic) {
            select.value = existingSecondaryTopic;
          }
        });
      });

      realSecondaryTopicSelect.innerHTML = "";
      const opt = document.createElement("option");
      opt.value = existingSecondaryTopic;
      opt.textContent = existingSecondaryTopic;
      realSecondaryTopicSelect.appendChild(opt);
      realSecondaryTopicSelect.value = existingSecondaryTopic;
    }
  });
</script>
