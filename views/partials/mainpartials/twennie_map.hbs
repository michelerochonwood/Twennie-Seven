<section class="teach-me-map-section">

  <section class="twennie-map">
    <div class="twennie-map-grid">

      <!-- Left: Dashboard tile -->
      <div class="twennie-map-dashboard">
        <img
          src="/images/dashboardscreenshot.png"
          alt="Twennie dashboard"
          class="twennie-map-dashboard-img"
        >
        <h2 class="twennie-map-dashboard-title">Twennie Dashboard</h2>
        <p class="twennie-map-dashboard-subtitle">
          Choose a lane to the right to see what each part does.
        </p>
      </div>

      {{!-- =========================================================
          1) LEARN
      ========================================================= --}}
      {{#each mapLanes}}
        {{#if (eq this.key "learn")}}
          <details class="twennie-map-lane">
            <summary class="twennie-map-lane-summary">
              <span class="twennie-map-lane-icon" aria-hidden="true">
                <img src="/icons/topicsicon.svg" alt="" class="twennie-map-lane-icon-img">
                <span class="twennie-map-lane-icon-label">topics</span>
              </span>

              <span class="twennie-map-lane-arrow" aria-hidden="true">➜</span>
              <span class="twennie-map-lane-title">{{this.title}}</span>

              {{#if this.subtitle}}
                <span class="twennie-map-lane-subtitle">{{this.subtitle}}</span>
              {{/if}}
            </summary>

            <div class="twennie-map-lane-content">
              <div class="twennie-map-image-row">
                {{#each this.images}}
                  <button class="twennie-map-card" type="button">
                    <img src="{{this.src}}" alt="{{this.alt}}" class="twennie-map-card-img">

                    <span class="twennie-map-card-title">{{this.title}}</span>

                    <span class="twennie-map-card-overlay">
                      <strong>{{this.title}}</strong>
                      <span class="twennie-map-card-desc">{{this.desc}}</span>
                    </span>
                  </button>
                {{/each}}
              </div>
            </div>
          </details>
        {{/if}}
      {{/each}}

{{!-- =========================================================
    NEW) CREATE LEARNING
========================================================= --}}
{{#each mapLanes}}
  {{#if (eq this.key "create_learning")}}
    <details class="twennie-map-lane">
      <summary class="twennie-map-lane-summary">
        <span class="twennie-map-lane-icon" aria-hidden="true">
          <img src="/icons/customicon.svg" alt="" class="twennie-map-lane-icon-img">
          <span class="twennie-map-lane-icon-label">create learning</span>
        </span>

        <span class="twennie-map-lane-arrow" aria-hidden="true">➜</span>
        <span class="twennie-map-lane-title">{{this.title}}</span>

        {{#if this.subtitle}}
          <span class="twennie-map-lane-subtitle">{{this.subtitle}}</span>
        {{/if}}
      </summary>

      <div class="twennie-map-lane-content">
        <div class="twennie-map-image-row">
          {{#each this.images}}
            <button class="twennie-map-card" type="button">
              <img src="{{this.src}}" alt="{{this.alt}}" class="twennie-map-card-img">

              <span class="twennie-map-card-title">{{this.title}}</span>

              <span class="twennie-map-card-overlay">
                <strong>{{this.title}}</strong>
                <span class="twennie-map-card-desc">{{this.desc}}</span>
              </span>
            </button>
          {{/each}}
        </div>
      </div>
    </details>
  {{/if}}
{{/each}}



      {{!-- =========================================================
          2) MONITOR LEARNING (REPORTS)
      ========================================================= --}}
      {{#each mapLanes}}
        {{#if (eq this.key "reports")}}
          <details class="twennie-map-lane">
            <summary class="twennie-map-lane-summary">
              <span class="twennie-map-lane-icon" aria-hidden="true">
                <img src="/icons/reporticon.svg" alt="" class="twennie-map-lane-icon-img">
                <span class="twennie-map-lane-icon-label">report center</span>
              </span>

              <span class="twennie-map-lane-arrow" aria-hidden="true">➜</span>
              <span class="twennie-map-lane-title">{{this.title}}</span>

              {{#if this.subtitle}}
                <span class="twennie-map-lane-subtitle">{{this.subtitle}}</span>
              {{/if}}
            </summary>

            <div class="twennie-map-lane-content">
              <div class="twennie-map-image-row">
                {{#each this.images}}
                  <button class="twennie-map-card" type="button">
                    <img src="{{this.src}}" alt="{{this.alt}}" class="twennie-map-card-img">

                    <span class="twennie-map-card-title">{{this.title}}</span>

                    <span class="twennie-map-card-overlay">
                      <strong>{{this.title}}</strong>
                      <span class="twennie-map-card-desc">{{this.desc}}</span>
                    </span>
                  </button>
                {{/each}}
              </div>
            </div>
          </details>
        {{/if}}
      {{/each}}

      {{!-- =========================================================
          3) CREATE LEARNING AND WORK PACKAGES (MISSIONS)
      ========================================================= --}}
      {{#each mapLanes}}
        {{#if (eq this.key "missions")}}
          <details class="twennie-map-lane">
            <summary class="twennie-map-lane-summary">
              <span class="twennie-map-lane-icon" aria-hidden="true">
                <img src="/icons/missioncontrolicon.svg" alt="" class="twennie-map-lane-icon-img">
                <span class="twennie-map-lane-icon-label">mission control</span>
              </span>

              <span class="twennie-map-lane-arrow" aria-hidden="true">➜</span>
              <span class="twennie-map-lane-title">{{this.title}}</span>

              {{#if this.subtitle}}
                <span class="twennie-map-lane-subtitle">{{this.subtitle}}</span>
              {{/if}}
            </summary>

            <div class="twennie-map-lane-content">
              <div class="twennie-map-image-row">
                {{#each this.images}}
                  <button class="twennie-map-card" type="button">
                    <img src="{{this.src}}" alt="{{this.alt}}" class="twennie-map-card-img">

                    <span class="twennie-map-card-title">{{this.title}}</span>

                    <span class="twennie-map-card-overlay">
                      <strong>{{this.title}}</strong>
                      <span class="twennie-map-card-desc">{{this.desc}}</span>
                    </span>
                  </button>
                {{/each}}
              </div>
            </div>
          </details>
        {{/if}}
      {{/each}}

      {{!-- =========================================================
          4) MONITOR OPPORTUNITIES (MINE)
      ========================================================= --}}
      {{#each mapLanes}}
        {{#if (eq this.key "mine")}}
          <details class="twennie-map-lane">
            <summary class="twennie-map-lane-summary">
              <span class="twennie-map-lane-icon" aria-hidden="true">
                <img src="/icons/mineicon.svg" alt="" class="twennie-map-lane-icon-img">
                <span class="twennie-map-lane-icon-label">the mine</span>
              </span>

              <span class="twennie-map-lane-arrow" aria-hidden="true">➜</span>
              <span class="twennie-map-lane-title">{{this.title}}</span>

              {{#if this.subtitle}}
                <span class="twennie-map-lane-subtitle">{{this.subtitle}}</span>
              {{/if}}
            </summary>

            <div class="twennie-map-lane-content">
              <div class="twennie-map-image-row">
                {{#each this.images}}
                  <button class="twennie-map-card" type="button">
                    <img src="{{this.src}}" alt="{{this.alt}}" class="twennie-map-card-img">

                    <span class="twennie-map-card-title">{{this.title}}</span>

                    <span class="twennie-map-card-overlay">
                      <strong>{{this.title}}</strong>
                      <span class="twennie-map-card-desc">{{this.desc}}</span>
                    </span>
                  </button>
                {{/each}}
              </div>
            </div>
          </details>
        {{/if}}
      {{/each}}

    </div>
  </section>

</section>



