<header class="header">

  <header>
    <div id="navigation-wrapper">

      <div class="primary-logo">
        <a href="/">
          <img src="https://www.twennie.com/images/headerlogo_2.png" alt="Home">
        </a>
      </div>

      <nav id="toggle-menu">
        <ion-icon name="close-outline" id="close-menu"></ion-icon>

        <!-- Desktop Links -->
        <ul class="desktop-links">
          {{#if user}}
            <li style="display: flex; align-items: center; gap: 10px;">
              <a href="{{dashboardLink}}">Hi, {{user.username}}</a>
              <img
                src="{{userProfileImage}}"
                alt="Profile"
                style="width: 90px; height: 90px; border-radius: 50%; object-fit: cover;"
              >
            </li>
          {{/if}}
        </ul>

        <!-- MOBILE MENU (FIXED ORDER) -->
        <ul class="mobile-links">

          {{#if user}}

            <li><a href="{{dashboardLink}}">learning dashboard</a></li>
            <li><a href="/latest">latest</a></li>
            <li><a href="/topics">topics</a></li>

            <li>
              {{#if (or (eq user.membershipType "leader") (eq user.membershipType "group_member"))}}
                <a href="/missioncontrol">mission control</a>
              {{else}}
                <a href="/missioncontrol_upgrade">mission control</a>
              {{/if}}
            </li>

            <li>
              {{#if (or (eq user.membershipType "leader") (eq user.membershipType "group_member"))}}
                <a href="/unitviews/mine">the mine</a>
              {{else}}
                <a href="/themine_upgrade">the mine</a>
              {{/if}}
            </li>

            <li><a href="/create_learning">create learning</a></li>
            <li><a href="/auth/logout">logout</a></li>

          {{else}}

            <li><a href="/auth/login">login</a></li>
            <li><a href="/latest">latest</a></li>
            <li><a href="/topics">topics</a></li>
            <li><a href="/create_learning">create learning</a></li>
            <li><a href="/avail_memberships">join</a></li>

          {{/if}}

          <!-- Secondary / footer-style links -->
          <li><a href="/about_twennie">about</a></li>
          <li><a href="/about_twennie">contact</a></li>
          <li><a href="/about_twennie">tech support</a></li>
          <li><a href="/privacypolicy">privacy policy</a></li>
          <li><a href="/custom_services">services</a></li>
          <li><a href="/termsconditions">terms & conditions</a></li>

        </ul>
      </nav>

      <ion-icon name="menu-outline" id="open-menu"></ion-icon>
    </div>
  </header>

  <div class="wave-divider">
    <svg viewBox="0 0 1440 50">
      <path fill="#4e50a2" d="M0,32L80,26.7C160,21,320,11,480,11C640,11,800,21,960,24C1120,27,1280,21,1360,18.7L1440,16V0H0Z"></path>
    </svg>
  </div>

  <!-- SIDEBAR NAV (FULL SIZE HEADER SQUARES) -->

  <div class="sidebar-nav">

    {{#if user}}

      <!-- 1. DASHBOARD -->
      <a href="{{dashboardLink}}" class="nav-square" style="width: 90px; height: 90px;">
        <img src="https://www.twennie.com/icons/dashboardicon.svg" alt="Dashboard" style="width: 50px; margin-top: 15px;">
        <span class="nav-text" style="font-size: 0.8rem;">learning dashboard</span>
      </a>

      <!-- 2. LATEST -->
      <a href="/latest" class="nav-square">
        <img src="https://www.twennie.com/icons/latesticon.svg">
        <span class="nav-text">latest</span>
      </a>

      <!-- 3. TOPICS -->
      <a href="/topics" class="nav-square">
        <img src="https://www.twennie.com/icons/topicsicon.svg">
        <span class="nav-text">topics</span>
      </a>

      <!-- 4. MISSION CONTROL -->
      {{#if (or (eq user.membershipType "leader") (eq user.membershipType "group_member"))}}
        <a href="/missioncontrol" class="nav-square">
      {{else}}
        <a href="/missioncontrol_upgrade" class="nav-square">
      {{/if}}
        <img src="https://www.twennie.com/icons/missioncontrolicon.svg">
        <span class="nav-text">mission control</span>
      </a>

      <!-- 5. THE MINE -->
      {{#if (or (eq user.membershipType "leader") (eq user.membershipType "group_member"))}}
        <a href="/unitviews/mine" class="nav-square">
      {{else}}
        <a href="/themine_upgrade" class="nav-square">
      {{/if}}
        <img src="https://www.twennie.com/icons/mineicon.svg">
        <span class="nav-text">the mine</span>
      </a>

      <!-- 6. CREATE -->
      <a href="/create_learning" class="nav-square">
        <img src="/icons/customicon.svg">
        <span class="nav-text">create learning</span>
      </a>

      <!-- 7. LOGOUT -->
      <a href="/auth/logout" class="nav-square logout">
        <img src="https://www.twennie.com/icons/logouticon.svg">
        <span class="nav-text">log out</span>
      </a>

    {{else}}

      <!-- LOGIN -->
      <a href="/auth/login" class="nav-square" style="width: 90px; height: 90px;">
        <img src="https://www.twennie.com/icons/loginicon.svg" style="width: 50px; margin-top: 15px;">
        <span class="nav-text" style="font-size: 0.9rem;">login</span>
      </a>

      <!-- LATEST -->
      <a href="/latest" class="nav-square">
        <img src="https://www.twennie.com/icons/latesticon.svg">
        <span class="nav-text">latest</span>
      </a>

      <!-- TOPICS -->
      <a href="/topics" class="nav-square">
        <img src="https://www.twennie.com/icons/topicsicon.svg">
        <span class="nav-text">topics</span>
      </a>

      <!-- CREATE -->
      <a href="/create_learning" class="nav-square">
        <img src="/icons/customicon.svg">
        <span class="nav-text">create learning</span>
      </a>

    {{/if}}

  </div>

</header>

