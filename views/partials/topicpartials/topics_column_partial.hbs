<!-- Reopen pill (appears after collapsing) -->
<button class="topic-sidebar-reopen" aria-label="Show topics column" type="button">
  <ion-icon name="chevron-back-outline" aria-hidden="true"></ion-icon>
  <span class="label">topic navigation</span>
</button>

{{!-- Mobile Sidebar --}}
<aside class="mobile-sidebar" id="mobile-sidebar" role="dialog" aria-modal="true" aria-label="topic navigation">
  <ion-icon name="close-outline" id="close-sidebar-btn" aria-label="close topics"></ion-icon>
  <div class="sidebar-content">
    {{!-- existing mobile content --}}
  </div>
</aside>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const sidebar = document.querySelector('.topic-sidebar');
    const toggle = document.querySelector('.topic-sidebar-toggle');
    let reopen = document.querySelector('.topic-sidebar-reopen');

    if (!sidebar || !toggle) return;

    // If reopen button isn't in DOM (some views), create it next to the sidebar.
    if (!reopen) {
      reopen = document.createElement('button');
      reopen.className = 'topic-sidebar-reopen visible';
      reopen.setAttribute('aria-label', 'Show topics column');
      reopen.type = 'button';
      reopen.innerHTML = `
        <ion-icon name="chevron-back-outline" aria-hidden="true"></ion-icon>
        <span class="label">topic navigation</span>
      `;
      sidebar.insertAdjacentElement('afterend', reopen);
    }

    // Start hidden by default
    sidebar.classList.add('collapsed');
    reopen.classList.add('visible');

    toggle.addEventListener('click', () => {
      sidebar.classList.add('collapsed');
      reopen.classList.add('visible');
    });

    reopen.addEventListener('click', () => {
      sidebar.classList.remove('collapsed');
      reopen.classList.remove('visible');
    });
  });
</script>

