<header class="grand-poobaa-header">

  <button
    type="button"
    class="grand-poobaa-menu-button"
    aria-label="Open administrative navigation"
    aria-expanded="false"
  >
    <ion-icon name="menu-outline"></ion-icon>
  </button>

  <div class="grand-poobaa-header-title">
    <span>Twennie administration</span>
  </div>

  <div class="grand-poobaa-header-user">
    <div class="grand-poobaa-user-copy">
      <strong>{{#if user.name}}{{user.name}}{{else}}Grand Poobaa{{/if}}</strong>
      <span>platform administrator</span>
    </div>

    <div class="grand-poobaa-user-icon">
      <ion-icon name="person-outline"></ion-icon>
    </div>
  </div>

</header>