{{#*inline "title"}}Membership Form | Twennie{{/inline}}

<form id="member-form" action="/change_membership/individual" method="POST" class="membership-form">

  <input type="hidden" name="_csrf" value="{{csrfToken}}">
  <input type="hidden" name="redirectTarget" id="redirectTarget" value="form">

  <div style="text-align: center; margin-bottom: 1.5rem;">
    <img src="/images/bluey1.png" alt="Ind Membership" style="max-height: 180px; margin-top: 30px; margin-bottom: -30px">
  </div>

  <div class="individual-form-container">
    <h1 class="form-title">individual membership form</h1>

    <!-- Redirect Note for Paid Members -->
    <div id="paid-redirect-note" class="form-field hidden">
      <p>You will be redirected to Stripe to complete your membership securely.</p>
    </div>

    <!-- Fields with prefilled values -->
    <div class="form-field">
      <label for="name">Full Name</label>
      <input type="text" id="name" name="name" value="{{user.name}}" required>
    </div>

    <div class="form-field">
      <label for="professionalTitle">Professional Title</label>
      <input type="text" id="professionalTitle" name="professionalTitle" value="{{user.professionalTitle}}" required>
    </div>

    <div class="form-field">
      <label for="organization">Organization (optional)</label>
      <input type="text" id="organization" name="organization" value="{{user.organization}}">
    </div>

    <!-- Billing Address (optional) -->
<!-- Billing Address (optional) -->
<div class="form-field">
  <label for="line1">Street Address</label>
  <input
    type="text"
    id="line1"
    name="line1"
    value="{{user.billingAddress.line1}}"
    placeholder="123 Main St"
    autocomplete="address-line1"
  >
</div>

<div class="form-field">
  <label for="line2">Apartment / Suite (optional)</label>
  <input
    type="text"
    id="line2"
    name="line2"
    value="{{user.billingAddress.line2}}"
    placeholder="Unit 5B"
    autocomplete="address-line2"
  >
</div>

<div class="form-field">
  <label for="city">City</label>
  <input
    type="text"
    id="city"
    name="city"
    value="{{user.billingAddress.city}}"
    autocomplete="address-level2"
  >
</div>

<div class="form-field">
  <label for="province">Province / State</label>
  <input
    type="text"
    id="province"
    name="province"
    value="{{user.billingAddress.province}}"
    placeholder="ON"
    autocomplete="address-level1"
  >
</div>

<div class="form-field">
  <label for="postalCode">Postal Code</label>
  <input
    type="text"
    id="postalCode"
    name="postalCode"
    value="{{user.billingAddress.postalCode}}"
    placeholder="A1A 1A1"
    autocomplete="postal-code"
  >
</div>

<div class="form-field">
  <label for="country">Country</label>
  <select id="country" name="country" autocomplete="country">
    <option value="CA" {{#if (eq user.billingAddress.country "CA")}}selected{{/if}}>Canada</option>
    <option value="US" {{#if (eq user.billingAddress.country "US")}}selected{{/if}}>United States</option>
  </select>
</div>

<small class="form-instructions">
  At checkout, you'll confirm billing details. Stripe will securely save the final address to your account.
</small>



<div class="form-field-industry">
  <label for="industry">Industry</label>
  <select id="industry" name="industry" required>
    <option value="">Please select an industry</option>
    <option value="Engineering" {{#if (eq user.industry "Engineering")}}selected{{/if}}>Engineering</option>
    <option value="Architecture" {{#if (eq user.industry "Architecture")}}selected{{/if}}>Architecture</option>
    <option value="Project Management" {{#if (eq user.industry "Project Management")}}selected{{/if}}>Project Management</option>
    <option value="Information Technology(IT)" {{#if (eq user.industry "Information Technology(IT)")}}selected{{/if}}>Information Technology(IT)</option>
    <option value="Web Design" {{#if (eq user.industry "Web Design")}}selected{{/if}}>Web Design</option>
    <option value="Construction" {{#if (eq user.industry "Construction")}}selected{{/if}}>Construction</option>
    <option value="Community Planning/Landscape Architecture" {{#if (eq user.industry "Community Planning/Landscape Architecture")}}selected{{/if}}>Community Planning/Landscape Architecture</option>
    <option value="Land Development" {{#if (eq user.industry "Land Development")}}selected{{/if}}>Land Development</option>
    <option value="E-Commerce" {{#if (eq user.industry "E-Commerce")}}selected{{/if}}>E-Commerce</option>
    <option value="Edtech" {{#if (eq user.industry "Edtech")}}selected{{/if}}>Education Tech</option>
    <option value="Other" {{#if (eq user.industry "Other")}}selected{{/if}}>Other</option>
  </select>
</div>

    <div class="form-field">
      <label for="username">Username (how you prefer to be addressed on twennie.com)</label>
      <input type="text" name="username" id="username" value="{{user.username}}" required>
      <span id="username-message"></span>
    </div>

    <div class="form-field">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" value="{{user.email}}" required>
    </div>

<div class="form-field password-toggle-container">
  <label for="password">Password</label>
  <div class="password-wrapper">
    <input
      type="password"
      id="password"
      name="password"
      required
      minlength="12"
      pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z\d]).{12,}$"
    >
    <span class="toggle-password" onclick="togglePasswordVisibility()">
      <ion-icon id="toggleIcon" name="eye-outline"></ion-icon>
    </span>
  </div>

  <small class="form-instructions">
    <strong>Password requirements:</strong><br>
    • At least 12 characters<br>
    • At least one uppercase letter<br>
    • At least one lowercase letter<br>
    • At least one number<br>
    • At least one special character
  </small>
</div>

<div class="form-field">
  <label for="confirmPassword">Confirm Password</label>
  <input
    type="password"
    id="confirmPassword"
    name="confirmPassword"
    required
    minlength="12"
    pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z\d]).{12,}$"
  >
</div>

<div class="form-toggle">
  <label for="membership-terms-toggle" class="form-toggle-label">
    <input type="checkbox" id="membership-terms-toggle" onclick="toggleMembershipTerms()">
    view membership terms
  </label>
</div>

<div id="membership-terms-box" class="membership-terms-box hidden">
  <h3 class="membership-terms-title">membership terms</h3>

  <p>
    By registering as a Twennie member, you agree to use the platform for professional learning,
    collaboration, and development in a respectful and lawful manner.
  </p>

  <ul class="membership-terms-list">
    <li>You are responsible for keeping your login credentials secure.</li>
    <li>You agree not to share your account with another person.</li>
    <li>You agree to participate respectfully and professionally on the platform.</li>
    <li>You may not upload or share confidential, proprietary, or unauthorized third-party information.</li>
    <li>Your access level determines which features, reports, groups, and learning tools are available to you.</li>
    <li>Paid memberships renew and are billed according to the plan selected at checkout unless cancelled.</li>
    <li>Twennie may suspend or terminate accounts used in violation of platform rules or applicable law.</li>
    <li>Twennie may update platform features, membership benefits, and terms from time to time.</li>
  </ul>

  <p>
    By completing registration, you acknowledge that you have read and agree to these membership terms.
  </p>
</div>

<div class="checkbox-wrapper membership-checkbox">
  <input type="checkbox" id="membershipAgreement" name="membershipAgreement" value="true" required>
  <label for="membershipAgreement">I have read and agree to the membership terms.</label>
</div>



    <!-- Submit -->
    <button type="submit" id="make-member-button" class="make-member-button">
      make me a full individual member
    </button>
  </div>
</form>

<script>
  function handleAccessLevelChange(value) {
    const contributorTerms = document.getElementById('contributor-terms');
    const contributorAgreement = document.getElementById('contributorAgreement');
    const paidNote = document.getElementById('paid-redirect-note');
    const redirectTarget = document.getElementById('redirectTarget');

    contributorTerms.classList.add('hidden');
    paidNote.classList.add('hidden');
    contributorAgreement.required = false;
    redirectTarget.value = 'form';

    if (value === 'contributor_individual') {
      contributorTerms.classList.remove('hidden');
      contributorAgreement.required = true;
      redirectTarget.value = 'form';
    } else if (value === 'paid_individual') {
      paidNote.classList.remove('hidden');
      redirectTarget.value = 'payment';
    }
  }

  function togglePasswordVisibility() {
    const input = document.getElementById('password');
    const icon = document.getElementById('toggleIcon');

    if (!input || !icon) return;

    if (input.type === 'password') {
      input.type = 'text';
      icon.name = 'eye-off-outline';
    } else {
      input.type = 'password';
      icon.name = 'eye-outline';
    }
  }

  document.addEventListener('DOMContentLoaded', function () {
    const form = document.getElementById('member-form');
    const passwordInput = document.getElementById('password');
    const confirmPasswordInput = document.getElementById('confirmPassword');
    const usernameInput = document.getElementById('username');
    const msg = document.getElementById('username-message');

    function validatePasswordMatch() {
      if (!passwordInput || !confirmPasswordInput) return;

      const password = passwordInput.value;
      const confirmPassword = confirmPasswordInput.value;

      confirmPasswordInput.setCustomValidity('');

      if (confirmPassword && password !== confirmPassword) {
        confirmPasswordInput.setCustomValidity('Passwords do not match.');
      }
    }

    if (passwordInput && confirmPasswordInput) {
      passwordInput.addEventListener('input', validatePasswordMatch);
      confirmPasswordInput.addEventListener('input', validatePasswordMatch);
    }

    if (form) {
      form.addEventListener('submit', function (e) {
        validatePasswordMatch();

        if (!form.checkValidity()) {
          e.preventDefault();
          form.reportValidity();
        }
      });
    }

    if (usernameInput && msg) {
      usernameInput.addEventListener('blur', async function () {
        const username = this.value.trim();

        if (!username) {
          msg.textContent = '';
          return;
        }

        try {
          const res = await fetch(`/member/check-username?username=${encodeURIComponent(username)}`);
          const data = await res.json();

          if (!data.available) {
            msg.textContent = 'That username is already taken. Try something unique like Brian-Warrior1.';
            msg.style.color = 'red';
          } else {
            msg.textContent = 'Username is available!';
            msg.style.color = 'green';
          }
        } catch (err) {
          console.error('Username check failed:', err);
          msg.textContent = '';
        }
      });
    }
  });

  function toggleMembershipTerms() {
    const box = document.getElementById('membership-terms-box');
    if (!box) return;
    box.classList.toggle('hidden');
  }
</script>

<style>
  .membership-checkbox {
  display: flex;
  align-items: flex-start;
  gap: 0.6rem;
  margin-top: 1rem;
}

.membership-checkbox input[type="checkbox"] {
  margin-top: 0.2rem;
  flex-shrink: 0;
}

.membership-checkbox label {
  line-height: 1.4;
  cursor: pointer;
}
  .membership-terms-box.hidden {
    display: none;
  }

  .membership-terms-box {
    margin: 1rem 0 1.5rem 0;
    padding: 1rem 1.25rem;
    background: #f7f7fb;
    border: 1px solid #d8d8ea;
    border-radius: 10px;
  }

  .membership-terms-title {
    margin-top: 0;
    color: #262262;
  }

  .membership-terms-list {
    margin: 0.75rem 0 0.75rem 1.25rem;
  }
</style>

<style>
.hidden {
  display: none;
}
</style>
