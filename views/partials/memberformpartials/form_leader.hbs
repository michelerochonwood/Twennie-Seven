{{#*inline "title"}}Leader Membership Form | Twennie{{/inline}}

<form id="leader-form" action="/change_membership/leader" method="POST" class="membership-form">
  {{#if csrfToken}}
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
  {{/if}}

  <!-- Centered Image -->
  <div style="text-align: center; margin-bottom: 1.5rem;">
    <img
      src="/images/leaderbluey_2.png"
      alt="Leader Membership"
      style="max-height: 200px; margin-top: 40px; margin-bottom: -40px"
    >
  </div>

  <div class="leader-form-container">
    <h1 class="form-title">group leader membership form</h1>

    <!-- Group Information -->
    <div class="form-field">
      <label for="group-name">Group Name</label>
      <input
        type="text"
        id="group-name"
        name="groupName"
        placeholder="Hint: you'll want a fun name..."
        required
      >
    </div>

    <div class="form-field">
      <label for="group-leader-name">Group Leader Name</label>
      <input
        type="text"
        id="group-leader-name"
        name="groupLeaderName"
        value="{{user.groupLeaderName}}"
        required
      >
    </div>

    <div class="form-field">
      <label for="professionalTitle">Professional Title</label>
      <input
        type="text"
        id="professional-title"
        name="professionalTitle"
        value="{{user.professionalTitle}}"
        required
      >
    </div>

    <!-- Organization preference (new flow) -->
    <div class="checkbox-wrapper">
      <input
        type="checkbox"
        id="organizationOptOut"
        name="organizationOptOut"
        value="true"
        {{#if user.organizationOptOut}}checked{{/if}}
      >
      <label for="organizationOptOut">keep my organization anonymous</label>
    </div>

    <p class="form-instructions" style="width: 80%; margin: 0 auto;">
      You can set up your organization as a Twennie member organization after registration.
    </p>

<!-- Billing Address (optional, saved if provided) -->
<div class="form-field">
  <label for="line1">Street Address</label>
  <input
    type="text"
    id="line1"
    name="line1"
    value="{{user.billingAddress.line1}}"
    placeholder="123 Main St"
    autocomplete="address-line1"
  >
</div>

<div class="form-field">
  <label for="line2">Apartment / Suite (optional)</label>
  <input
    type="text"
    id="line2"
    name="line2"
    value="{{user.billingAddress.line2}}"
    placeholder="Unit 5B"
    autocomplete="address-line2"
  >
</div>

<div class="form-field">
  <label for="city">City</label>
  <input
    type="text"
    id="city"
    name="city"
    value="{{user.billingAddress.city}}"
    autocomplete="address-level2"
  >
</div>

<div class="form-field">
  <label for="province">Province / State</label>
  <input
    type="text"
    id="province"
    name="province"
    value="{{user.billingAddress.province}}"
    placeholder="ON"
    autocomplete="address-level1"
  >
</div>

<div class="form-field">
  <label for="postalCode">Postal Code</label>
  <input
    type="text"
    id="postalCode"
    name="postalCode"
    value="{{user.billingAddress.postalCode}}"
    placeholder="A1A 1A1"
    autocomplete="postal-code"
  >
</div>

<div class="form-field">
  <label for="country">Country</label>
  <select id="country" name="country" autocomplete="country">
    <option value="CA" {{#if user.billingAddress.country}}{{#if (eq user.billingAddress.country "CA")}}selected{{/if}}{{else}}selected{{/if}}>Canada</option>
    <option value="US" {{#if (eq user.billingAddress.country "US")}}selected{{/if}}>United States</option>
  </select>
</div>

    <small class="form-instructions">
      At checkout, you'll confirm billing details. Stripe will securely save the final address to your account.
    </small>

    <!-- Industry -->
<div class="form-field">
  <label for="industry">Industry</label>
  <select id="industry" name="industry" required>
    <option value="">Please select your industry</option>
    <option value="Engineering" {{#if (eq user.industry "Engineering")}}selected{{/if}}>Engineering</option>
    <option value="Architecture" {{#if (eq user.industry "Architecture")}}selected{{/if}}>Architecture</option>
    <option value="Project Management" {{#if (eq user.industry "Project Management")}}selected{{/if}}>Project Management</option>
    <option value="Information Technology(IT)" {{#if (eq user.industry "Information Technology(IT)")}}selected{{/if}}>Information Technology(IT)</option>
    <option value="Web Design" {{#if (eq user.industry "Web Design")}}selected{{/if}}>Web Design</option>
    <option value="Construction" {{#if (eq user.industry "Construction")}}selected{{/if}}>Construction</option>
    <option value="Community Planning/Landscape Architecture" {{#if (eq user.industry "Community Planning/Landscape Architecture")}}selected{{/if}}>Community Planning/Landscape Architecture</option>
    <option value="Land Development" {{#if (eq user.industry "Land Development")}}selected{{/if}}>Land Development</option>
    <option value="E-Commerce" {{#if (eq user.industry "E-Commerce")}}selected{{/if}}>E-Commerce</option>
    <option value="Edtech" {{#if (eq user.industry "Edtech")}}selected{{/if}}>Edtech</option>
    <option value="Other" {{#if (eq user.industry "Other")}}selected{{/if}}>Other</option>
  </select>
</div>

    <div class="form-field">
      <label for="username">Username</label>
      <input
        type="text"
        id="username"
        name="username"
        value="{{user.username}}"
        required
      >
    </div>

    <div class="form-field">
      <label for="group-leader-email">Group Leader Email Address</label>
      <input
        type="email"
        id="group-leader-email"
        name="groupLeaderEmail"
        value="{{user.groupLeaderEmail}}"
        required
      >
    </div>

<div class="form-field password-toggle-container">
  <label for="password">Password</label>
  <div class="password-wrapper">
    <input type="password" id="password" name="password" required>
    <span class="toggle-password" onclick="togglePasswordVisibility(this)">
      <ion-icon name="eye-outline"></ion-icon>
    </span>
  </div>

  <small class="form-instructions">
    Create a strong password using at least 12 characters, including an uppercase letter, a lowercase letter, a number, and a special character.
  </small>
</div>

    <p style="width: 50%; text-align: center;">
      Group leaders must start memberships for all members of their group...
    </p>

<div class="leader-form-field">
  <label for="group-size">Number of Members</label>
  <select id="group-size" name="groupSize" required>
    <option value="">Select group size</option>
    <option value="2" {{#if (eq user.groupSize 2)}}selected{{/if}}>2 members</option>
    <option value="3" {{#if (eq user.groupSize 3)}}selected{{/if}}>3 members</option>
    <option value="4" {{#if (eq user.groupSize 4)}}selected{{/if}}>4 members</option>
    <option value="5" {{#if (eq user.groupSize 5)}}selected{{/if}}>5 members</option>
    <option value="6" {{#if (eq user.groupSize 6)}}selected{{/if}}>6 members</option>
    <option value="7" {{#if (eq user.groupSize 7)}}selected{{/if}}>7 members</option>
    <option value="8" {{#if (eq user.groupSize 8)}}selected{{/if}}>8 members</option>
    <option value="9" {{#if (eq user.groupSize 9)}}selected{{/if}}>9 members</option>
    <option value="10" {{#if (eq user.groupSize 10)}}selected{{/if}}>10 members</option>
  </select>
</div>

    <!-- Member Details Placeholder -->
    <div class="individual-members-container">
      <h3>Individual Group Members</h3>
      <div id="members-grid" class="members-grid"></div>
    </div>

    <div class="form-field">
      <label for="registration-code">Create a Registration Code</label>
      <input
        type="text"
        id="registration-code"
        name="registration_code"
        placeholder="Create a unique code for your team"
        required
      >
      <small class="form-instructions">
        <strong>How to Create a Registration Code:</strong><br>
        - At least 8 characters<br>
        - Letters and numbers only<br>
        - No special characters<br>
        - Keep it secure<br>
        <strong>Examples:</strong> "TechTeam2024", "ZenGrowth45"
      </small>
    </div>

    <!-- Group Agreement -->
    <div class="form-toggle">
      <label for="group-agreement-toggle" class="form-toggle-label">
        <input type="checkbox" id="group-agreement-toggle" name="group_agreement" value="true" required>
        I agree to fulfill the responsibilities of a group leader...
      </label>
    </div>

    <!-- Payment Note -->
<div class="form-field" id="group-payment-placeholder">
  <p><strong>Payment Reminder:</strong> Once you submit this form, you’ll be redirected to Stripe to complete payment securely. Your payment will cover <strong>all registered group members</strong>.</p>
  <p>If your organization prefers to be invoiced, <a href="mailto:info@twennie.com">contact Twennie</a> before registering to arrange billing.</p>
</div>

    <!-- Hidden Submission Info -->
    <input type="hidden" name="redirectTarget" value="payment">

    <!-- Submit Button -->
    <button type="submit" class="make-member-button">
      make me a Twennie group leader
    </button>

    <script src="https://www.twennie.com/javascript/leaderform/leaderform.js"></script>
  </div>
</form>

<script>
  function togglePasswordVisibility(el) {
    const wrapper = el.closest('.password-wrapper');
    if (!wrapper) return;
    const input = wrapper.querySelector('input');
    const icon = wrapper.querySelector('ion-icon');
    if (!input || !icon) return;

    if (input.type === "password") {
      input.type = "text";
      icon.name = "eye-off-outline";
    } else {
      input.type = "password";
      icon.name = "eye-outline";
    }
  }
</script>
