

<div class="dashboard-explanation-block">
  <h3 class="dashboard-explanation-title">how this tab works</h3>
  <p class="dashboard-explanation-text">
    This tab shows the units you and your group have added to the Twennie library. If you want to edit any of your units, click the view and/or edit link in the table. Only the author of a unit can make edits. 
  </p>

</div>
<section class="old-dashboard-library-units">
  <!-- My Library Contributions -->

  {{#if hasNewLibraryItems}}
  <h2 class="old-dashboard-section-title" style="text-align: left;">new library units</h2>

  <table class="old-dashboard-library-table old-dashboard-new-table">
    <thead>
      <tr>
        <th class="old-dashboard-library-header">source</th>
        <th class="old-dashboard-library-header">unit type</th>
        <th class="old-dashboard-library-header">title</th>
        <th class="old-dashboard-library-header">main topic</th>
        <th class="old-dashboard-library-header">view unit</th>
      </tr>
    </thead>
    <tbody>

      {{!-- Leader's new units --}}
      {{#each newLeaderUnits}}
        <tr class="old-dashboard-library-row old-dashboard-new-row">
          <td class="old-dashboard-library-cell">you</td>

          <td class="old-dashboard-library-cell">
            {{#if (eq this.unitType "upcoming")}}
              upcoming ({{this.plannedType}})
            {{else}}
              {{this.unitType}}
            {{/if}}
          </td>

          <td class="old-dashboard-library-cell">{{this.title}}</td>
          <td class="old-dashboard-library-cell">{{this.mainTopic}}</td>

          <td class="old-dashboard-library-cell">
            <a href="/unitviews/{{this.unitType}}s/view/{{this._id}}" class="old-dashboard-view-link">
              view
            </a>
          </td>
        </tr>
      {{/each}}

      {{!-- Group members' new units --}}
      {{#each newGroupMemberUnits}}
        <tr class="old-dashboard-library-row old-dashboard-new-row">
          <td class="old-dashboard-library-cell">{{this.author}}</td>

          <td class="old-dashboard-library-cell">
            {{#if (eq this.unitType "upcoming")}}
              upcoming ({{this.plannedType}})
            {{else}}
              {{this.unitType}}
            {{/if}}
          </td>

          <td class="old-dashboard-library-cell">{{this.title}}</td>
          <td class="old-dashboard-library-cell">{{this.mainTopic}}</td>

          <td class="old-dashboard-library-cell">
            <a href="/unitviews/{{this.unitType}}s/view/{{this._id}}" class="old-dashboard-view-link">
              view
            </a>
          </td>
        </tr>
      {{/each}}

    </tbody>
  </table>
{{/if}}

  <h2 class="old-dashboard-section-title" style="text-align: left;">my library units</h2>
  <table class="old-dashboard-library-table">
    <thead>
      <tr>
        <th class="old-dashboard-library-header">unit type</th>
        <th class="old-dashboard-library-header">title</th>
        <th class="old-dashboard-library-header">main topic</th>
        <th class="old-dashboard-library-header">view unit</th>
      </tr>
    </thead>
    <tbody>
      {{#each leaderUnits}}
        <tr class="old-dashboard-library-row">
          <td class="old-dashboard-library-cell">
            {{#if (eq this.unitType "upcoming")}}
              upcoming ({{this.plannedType}})
            {{else}}
              {{this.unitType}}
            {{/if}}
          </td>

          <td class="old-dashboard-library-cell">{{this.title}}</td>

          <td class="old-dashboard-library-cell">{{this.mainTopic}}</td>

          <td class="old-dashboard-library-cell">
            {{#if (eq this.unitType "upcoming")}}
              <a href="/unitviews/upcoming/view/{{this._id}}" class="old-dashboard-view-link">view upcoming</a>
              {{#if this.plannedType}}
                &nbsp;|&nbsp;
                <a
                  href="/unitform/prefill_from_upcoming/{{this.plannedType}}/{{this._id}}"
                  class="old-dashboard-view-link"
                >
                  publish now
                </a>
              {{/if}}
            {{else}}
              <a
                href="/unitviews/{{this.unitType}}s/view/{{this._id}}"
                class="old-dashboard-view-link"
              >
                view and/or edit
              </a>
            {{/if}}
          </td>
        </tr>
      {{else}}
        <tr>
          <td colspan="4" class="old-dashboard-no-units">
            No contributions submitted yet.
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>

  <!-- Group Members' Library Contributions -->
  <h2 class="old-dashboard-section-title" style="text-align: left;">group members' library units</h2>
  <table class="old-dashboard-library-table">
    <thead>
      <tr>
        <th class="old-dashboard-library-header">author</th>
        <th class="old-dashboard-library-header">unit type</th>
        <th class="old-dashboard-library-header">title</th>
        <th class="old-dashboard-library-header">main topic</th>
        <th class="old-dashboard-library-header">view unit</th>
      </tr>
    </thead>
    <tbody>
      {{#each groupMemberUnits}}
        <tr class="old-dashboard-library-row">
          <td class="old-dashboard-library-cell">{{this.author}}</td>

          <td class="old-dashboard-library-cell">
            {{#if (eq this.unitType "upcoming")}}
              upcoming ({{this.plannedType}})
            {{else}}
              {{this.unitType}}
            {{/if}}
          </td>

          <td class="old-dashboard-library-cell">{{this.title}}</td>

          <td class="old-dashboard-library-cell">{{this.mainTopic}}</td>

          <td class="old-dashboard-library-cell">
            {{#if (eq this.unitType "upcoming")}}
              <a href="/unitviews/upcoming/view/{{this._id}}" class="old-dashboard-view-link">
                view upcoming
              </a>
              {{#if this.plannedType}}
                &nbsp;|&nbsp;
                <a
                  href="/unitform/prefill_from_upcoming/{{this.plannedType}}/{{this._id}}"
                  class="old-dashboard-view-link"
                >
                  publish now
                </a>
              {{/if}}
            {{else}}
              <a
                href="/unitviews/{{this.unitType}}s/view/{{this._id}}"
                class="old-dashboard-view-link"
              >
                view only
              </a>
            {{/if}}
          </td>
        </tr>
      {{else}}
        <tr>
          <td colspan="5" class="old-dashboard-no-units">
            No group contributions submitted yet.
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</section>



