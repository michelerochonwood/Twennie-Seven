{{!-- views/dashboardpartials/admin_reports.hbs --}}

<section class="leader-topics-container leader-admin-section">
  <h2 class="leader-dashboard-subtitles">team engagement</h2>

  <div class="admin-team-report-cards">

    {{#each adminTeamEngagementReports}}
      <article class="admin-team-report-card">

        {{!-- TEAM IDENTITY --}}
        <section class="admin-team-report-section admin-team-identity-section">
<div class="admin-team-identity-main">

  <div class="admin-team-image-wrap">
    <img
      src="{{this.groupImage}}"
      alt="group image"
      class="admin-team-image"
    >

    {{#if this.teamLeaderImage}}
      <img
        src="{{this.teamLeaderImage}}"
        alt="leader image"
        class="admin-team-leader-image"
      >
    {{/if}}
  </div>

  <div class="admin-team-identity-text">
    <h3 class="admin-team-name">{{this.teamName}}</h3>

    <p class="admin-team-meta">
      leader: {{#if this.teamLeaderName}}{{this.teamLeaderName}}{{else}}—{{/if}}
    </p>

    <p class="admin-team-meta">
      members: {{this.memberCount}}
    </p>
  </div>

</div>
        </section>

        {{!-- TOPICS AND UNITS --}}
        <section class="admin-team-report-section">
          <h4 class="admin-team-section-title">topics and units</h4>

          <div class="admin-team-section-grid">
            <div class="admin-team-report-block">
              <h5>topics engaged</h5>
              {{#each this.topTopics}}
                <div class="admin-report-pill">{{this}}</div>
              {{else}}
                <p class="no-data">—</p>
              {{/each}}
            </div>

            <div class="admin-team-report-block">
              <h5>units completed</h5>
              {{#each this.unitsCompleted}}
                <div class="admin-report-list-item">{{this}}</div>
              {{else}}
                <p class="no-data">—</p>
              {{/each}}
            </div>

            <div class="admin-team-report-block">
              <h5>assigned but not completed</h5>
              {{#each this.incompleteUnits}}
                <div class="admin-report-list-item">
                  <strong>{{this.title}}</strong>
                  {{#if this.assignedAtFormatted}}
                    <span>assigned: {{this.assignedAtFormatted}}</span>
                  {{/if}}
                </div>
              {{else}}
                <p class="no-data">—</p>
              {{/each}}
            </div>
          </div>
        </section>

        {{!-- PROMPT SETS --}}
        <section class="admin-team-report-section">
          <h4 class="admin-team-section-title">prompt sets</h4>

          <div class="admin-team-section-grid">
            <div class="admin-team-report-block">
              <h5>completed</h5>
              {{#each this.promptSetsCompleted}}
                <div class="admin-report-list-item">{{this}}</div>
              {{else}}
                <p class="no-data">—</p>
              {{/each}}
            </div>

            <div class="admin-team-report-block">
              <h5>badges earned</h5>
              {{#each this.promptSetBadgesEarned}}
                <div class="admin-report-badge-row">
                  {{#if this.badgeImage}}
                    <img src="{{this.badgeImage}}" alt="{{this.badgeName}}" class="admin-report-badge-img">
                  {{/if}}
                  <span>{{this.badgeName}}</span>
                </div>
              {{else}}
                <p class="no-data">—</p>
              {{/each}}
            </div>

            <div class="admin-team-report-block">
              <h5>in progress</h5>
              {{#each this.promptSetsInProgress}}
                <div class="admin-report-list-item">{{this}}</div>
              {{else}}
                <p class="no-data">—</p>
              {{/each}}
            </div>
          </div>
        </section>

        {{!-- NUGGETS --}}
        <section class="admin-team-report-section">
          <h4 class="admin-team-section-title">nuggets being monitored</h4>

          <div class="admin-nugget-grid">
            {{#each this.nuggetsMonitored}}
              <div class="admin-nugget-card">
                <strong>{{this.title}}</strong>
                {{#if this.client}}<span>client: {{this.client}}</span>{{/if}}
                {{#if this.region}}<span>region: {{this.region}}</span>{{/if}}
                {{#if this.lastMonitoredFormatted}}<span>last monitored: {{this.lastMonitoredFormatted}}</span>{{/if}}
              </div>
            {{else}}
              <p class="no-data">—</p>
            {{/each}}
          </div>
        </section>

        {{!-- MISSIONS --}}
        <section class="admin-team-report-section">
          <h4 class="admin-team-section-title">missions</h4>

          <div class="admin-team-section-grid">
            <div class="admin-team-report-block">
              <h5>in progress</h5>
              {{#each this.missionsInProgress}}
                <div class="admin-report-list-item">{{this}}</div>
              {{else}}
                <p class="no-data">—</p>
              {{/each}}
            </div>

            <div class="admin-team-report-block">
              <h5>completed</h5>
              {{#each this.missionsCompleted}}
                <div class="admin-report-list-item">{{this}}</div>
              {{else}}
                <p class="no-data">—</p>
              {{/each}}
            </div>

            <div class="admin-team-report-block">
              <h5>badges earned</h5>
              {{#each this.missionBadgesEarned}}
                <div class="admin-report-badge-row">
                  {{#if this.badgeImage}}
                    <img src="{{this.badgeImage}}" alt="{{this.badgeName}}" class="admin-report-badge-img">
                  {{/if}}
                  <span>{{this.badgeName}}</span>
                </div>
              {{else}}
                <p class="no-data">—</p>
              {{/each}}
            </div>
          </div>
        </section>

      </article>
    {{else}}
      <p class="no-data">No team engagement data available.</p>
    {{/each}}

  </div>
</section>