{{!-- views/dashboardpartials/admin_reports.hbs --}}

<section class="leader-topics-container leader-admin-section">
  <h2 class="leader-dashboard-subtitles">team engagement</h2>

  <div class="table-container">
    <table class="dashboard-library-table">
      <thead>
        <tr>
          <th class="dashboard-library-header">team</th>
          <th class="dashboard-library-header">prompt sets completed</th>
          <th class="dashboard-library-header">units completed</th>
          <th class="dashboard-library-header">top topics</th>
        </tr>
      </thead>

      <tbody>
        {{#each adminTeamEngagementReports}}
          <tr class="dashboard-library-row">

            <!-- Team -->
            <td class="dashboard-library-cell">
              <div style="display:flex; gap:0.75rem; align-items:flex-start;">
                
                <!-- Group Image -->
                <img
                  src="{{this.groupImage}}"
                  alt="group image"
                  style="width:44px; height:44px; border-radius:8px; object-fit:cover;"
                >

                <!-- Team Info -->
                <div>
                  <div class="multi-record-item">
                    <strong>{{this.teamName}}</strong>
                  </div>

                  {{#if this.teamLeaderName}}
                    <div class="multi-record-item" style="opacity:0.8;">
                      leader: {{this.teamLeaderName}}
                    </div>
                  {{/if}}

                  <div class="multi-record-item" style="opacity:0.8;">
                    members: {{this.memberCount}}
                  </div>
                </div>
              </div>
            </td>

            <!-- Prompt Sets Completed (titles only) -->
            <td class="dashboard-library-cell">
              {{#each this.recentPromptSets}}
                <div class="multi-record-item">{{this}}</div>
              {{else}}
                <span class="no-data">—</span>
              {{/each}}
            </td>

            <!-- Units Completed (titles only) -->
            <td class="dashboard-library-cell">
              {{#each this.recentUnitsCompleted}}
                <div class="multi-record-item">{{this}}</div>
              {{else}}
                <span class="no-data">—</span>
              {{/each}}
            </td>

            <!-- Top Topics -->
            <td class="dashboard-library-cell">
              {{#each this.topTopics}}
                <div class="multi-record-item">{{this}}</div>
              {{else}}
                <span class="no-data">—</span>
              {{/each}}
            </td>

          </tr>
        {{else}}
          <tr>
            <td colspan="4" class="no-data">No team engagement data available.</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>


