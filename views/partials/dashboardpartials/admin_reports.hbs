{{!-- views/dashboardpartials/admin_reports.hbs --}}

<section class="leader-topics-container leader-admin-section">
  <h2 class="leader-dashboard-subtitles">team engagement</h2>

  <div class="table-container admin-wide-table-container">
    <table class="dashboard-library-table admin-wide-table">
      <thead>
        <tr>
          <th class="dashboard-library-header" style="min-width: 260px;">team</th>
          <th class="dashboard-library-header" style="min-width: 260px;">top topics</th>
          <th class="dashboard-library-header" style="min-width: 420px;">units completed</th>
          <th class="dashboard-library-header" style="min-width: 340px;">prompt sets completed</th>
        </tr>
      </thead>

      <tbody>
        {{#each adminTeamEngagementReports}}
          <tr class="dashboard-library-row">

            {{!-- TEAM --}}
            <td class="dashboard-library-cell">
              <div style="display:flex; gap:0.75rem; align-items:flex-start;">
                <img
                  src="{{this.groupImage}}"
                  alt="group image"
                  style="width:44px; height:44px; border-radius:8px; object-fit:cover;"
                >

                <div>
                  <div class="multi-record-item">
                    <strong>{{this.teamName}}</strong>
                  </div>

                  {{#if this.teamLeaderName}}
                    <div class="multi-record-item" style="opacity:0.8;">
                      leader: {{this.teamLeaderName}}
                    </div>
                  {{/if}}

                  <div class="multi-record-item" style="opacity:0.8;">
                    members: {{this.memberCount}}
                  </div>
                </div>
              </div>
            </td>

            {{!-- TOP TOPICS --}}
            <td class="dashboard-library-cell">
              {{#each this.topTopics}}
                <div class="multi-record-item">{{this}}</div>
              {{else}}
                <span class="no-data">—</span>
              {{/each}}
            </td>

            {{!-- UNITS COMPLETED --}}
            <td class="dashboard-library-cell">
              {{#each this.unitsCompleted}}
                <div class="multi-record-item">{{this}}</div>
              {{else}}
                <span class="no-data">—</span>
              {{/each}}
            </td>

            {{!-- PROMPT SETS COMPLETED --}}
            <td class="dashboard-library-cell">
              {{#each this.promptSetsCompleted}}
                <div class="multi-record-item">{{this}}</div>
              {{else}}
                <span class="no-data">—</span>
              {{/each}}
            </td>

          </tr>
        {{else}}
          <tr>
            <td colspan="4" class="no-data">
              No team engagement data available.
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>








