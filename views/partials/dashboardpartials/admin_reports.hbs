{{!-- views/dashboardpartials/admin_reports.hbs --}}

<section class="leader-topics-container leader-admin-section">
  <h2 class="leader-dashboard-subtitles">team engagement</h2>

  <div class="table-container">
    <table class="dashboard-library-table">
      <thead>
        <tr>
          <th class="dashboard-library-header">team</th>
          <th class="dashboard-library-header">prompt sets completed</th>
          <th class="dashboard-library-header">badges earned</th>
          <th class="dashboard-library-header">units completed</th>
          <th class="dashboard-library-header">units contributed</th>
          <th class="dashboard-library-header">topics engaged</th>
          <th class="dashboard-library-header">top topics</th>
        </tr>
      </thead>

      <tbody>
        {{#each adminTeamEngagementReports}}
          <tr class="dashboard-library-row">

            <!-- Team -->
            <td class="dashboard-library-cell">
              <div class="multi-record-item"><strong>{{this.teamName}}</strong></div>
              {{#if this.teamLeaderName}}
                <div class="multi-record-item" style="opacity:0.8;">leader: {{this.teamLeaderName}}</div>
              {{/if}}
              <div class="multi-record-item" style="opacity:0.8;">
                members: {{this.memberCount}}
              </div>
            </td>

            <!-- Prompt Sets Completed -->
            <td class="dashboard-library-cell">
              <div class="multi-record-item">{{this.promptSetsCompletedCount}}</div>
{{#each this.recentPromptSets}}
  <div class="multi-record-item" style="opacity:0.9;">{{this}}</div>
{{else}}
  <span class="no-data">—</span>
{{/each}}
            </td>

            <!-- Badges Earned -->
            <td class="dashboard-library-cell">
              <div class="multi-record-item">{{this.badgesEarnedCount}}</div>
            </td>

            <!-- Units Completed -->
            <td class="dashboard-library-cell">
              <div class="multi-record-item">{{this.unitsCompletedCount}}</div>
            </td>

            <!-- Units Contributed -->
            <td class="dashboard-library-cell">
              <div class="multi-record-item">{{this.unitsContributedCount}}</div>
            </td>

            <!-- Topics Engaged -->
            <td class="dashboard-library-cell">
              <div class="multi-record-item">{{this.topicsEngagedCount}}</div>
            </td>

            <!-- Top Topics -->
            <td class="dashboard-library-cell">
              {{#each this.topTopics}}
                <div class="multi-record-item">{{this}}</div>
              {{else}}
                <span class="no-data">No topics</span>
              {{/each}}
            </td>

          </tr>
        {{else}}
          <tr>
            <td colspan="7" class="no-data">No team engagement data available.</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>
