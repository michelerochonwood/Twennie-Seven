
{{/each}}<meta name="csrf-token" content="{{csrfToken}}">

<section class="group-member-tagged-units-section">
  <h2 class="tagged-units-title">my nuggets and missions</h2>

  {{!-- 1) MY SELF-ASSIGNED NUGGETS --}}
  <div class="group-member-tagged-subsection">
    <h3 class="group-member-tagged-subtitle">my self-assigned nuggets</h3>

    <div class="tagged-units-grid">
      {{#if groupMemberTaggedNuggets.length}}
        {{#each groupMemberTaggedNuggets}}
          <div class="leader-assigned-unit-card leader-nugget-card">
            <div class="leader-nugget-card-inner">
              <div class="leader-nugget-card-svg-header">
                <img src="/icons/goldsvg.svg" alt="" aria-hidden="true" class="leader-nugget-card-svg-image">
              </div>

              <div class="leader-nugget-card-content">
                <div class="tagged-unit-icon">
                  <img src="/icons/nuggeticon.svg" alt="nugget icon" style="width: 70px; height: auto;">
                </div>

                <div class="tagged-unit-info">
                  <h3 class="tagged-unit-title">{{title}}</h3>
                  {{#if client}}<p class="tagged-unit-topic">client: {{client}}</p>{{/if}}
                  {{#if region}}<p class="tagged-unit-topic">region: {{region}}</p>{{/if}}
                  {{#if discipline}}<p class="tagged-unit-topic">discipline: {{discipline}}</p>{{/if}}

                  {{#if completedAtFormatted}}
                    <p class="leader-assigned-status">✅ closed <span class="muted">({{completedAtFormatted}})</span></p>
                  {{else}}
                    <p class="leader-assigned-status">⏳ monitoring</p>
                  {{/if}}
                </div>

                <div class="tagged-unit-actions">
                  <a href="{{viewPath}}" class="tagged-unit-link">view nugget</a>

                  {{#if tagId}}
                    <button
                      type="button"
                      class="tagged-unit-link"
                      onclick="archiveUnit('{{tagId}}','{{_id}}','nugget')"
                    >
                      move to archive
                    </button>
                  {{/if}}
                </div>
              </div>
            </div>
          </div>
        {{/each}}
      {{else}}
        <p class="tagged-no-units">You have not self-assigned any nuggets.</p>
      {{/if}}
    </div>
  </div>

  <div class="tagged-section-divider" aria-hidden="true"></div>

  {{!-- 2) MY LEADER-ASSIGNED NUGGETS --}}
  <div class="group-member-tagged-subsection">
    <h3 class="group-member-tagged-subtitle">my leader-assigned nuggets</h3>

    <div class="tagged-units-grid">
      {{#if groupMemberAssignedNuggets.length}}
        {{#each groupMemberAssignedNuggets}}
          <div class="leader-assigned-unit-card leader-nugget-card">
            <div class="leader-nugget-card-inner">
              <div class="leader-nugget-card-svg-header">
                <img src="/icons/goldsvg.svg" alt="" aria-hidden="true" class="leader-nugget-card-svg-image">
              </div>

              <div class="leader-nugget-card-content">
                <div class="tagged-unit-icon">
                  <img src="/icons/nuggeticon.svg" alt="nugget icon" style="width: 70px; height: auto;">
                </div>

                <div class="tagged-unit-info">
                  <h3 class="tagged-unit-title">{{title}}</h3>
                  {{#if client}}<p class="tagged-unit-topic">client: {{client}}</p>{{/if}}
                  {{#if region}}<p class="tagged-unit-topic">region: {{region}}</p>{{/if}}
                  {{#if discipline}}<p class="tagged-unit-topic">discipline: {{discipline}}</p>{{/if}}
                  {{#if leaderName}}<p class="tagged-unit-meta">assigned by: {{leaderName}}</p>{{/if}}

                  {{#if assignedInstructions}}
                    <p class="tagged-unit-instructions"><em>instructions:</em> {{assignedInstructions}}</p>
                  {{/if}}

                  {{#if assignedCompletedAtFormatted}}
                    <p class="leader-assigned-status">✅ closed <span class="muted">({{assignedCompletedAtFormatted}})</span></p>
                  {{else}}
                    <p class="leader-assigned-status">⏳ monitoring</p>
                  {{/if}}
                </div>

                <div class="tagged-unit-actions">
                  <a href="{{viewPath}}" class="tagged-unit-link">view nugget</a>

                  {{#if tagId}}
                    <button
                      type="button"
                      class="tagged-unit-link"
                      onclick="archiveUnit('{{tagId}}','{{_id}}','nugget','{{assignedToId}}')"
                    >
                      move to archive
                    </button>
                  {{/if}}
                </div>
              </div>
            </div>
          </div>
        {{/each}}
      {{else}}
        <p class="tagged-no-units">You have no nuggets assigned by your leader.</p>
      {{/if}}
    </div>
  </div>

  <div class="tagged-section-divider" aria-hidden="true"></div>

  {{!-- 3) MY SELF-ASSIGNED MISSIONS --}}
  <div class="group-member-tagged-subsection">
    <h3 class="group-member-tagged-subtitle">my self-assigned missions</h3>

    <div class="tagged-units-grid">
      {{#if groupMemberTaggedMissions.length}}
        {{#each groupMemberTaggedMissions}}
          <div class="tagged-unit-card leader-dashboard-wave-card">
            <div class="leader-dashboard-wave-card-inner">
              <div class="leader-dashboard-wave-header">
                <img
                  src="/images/onyxsvg.svg"
                  alt=""
                  class="leader-dashboard-wave-image"
                  aria-hidden="true"
                >
              </div>

              <div class="leader-dashboard-wave-content">
                <div class="tagged-unit-icon">
                  <img src="/icons/mission.svg" alt="mission icon">
                </div>

                <div class="tagged-unit-info">
                  <h3 class="tagged-unit-title">{{title}}</h3>
                  {{#if mainTopic}}<p class="tagged-unit-topic">{{mainTopic}}</p>{{/if}}

                  {{#if completedAtFormatted}}
                    <p class="leader-assigned-status">✅ completed <span class="muted">({{completedAtFormatted}})</span></p>
                  {{else}}
                    <p class="leader-assigned-status">⏳ pending</p>
                  {{/if}}

                  {{#if badgeImagePath}}
                    <div class="mission-badge-row">
                      <img src="{{badgeImagePath}}" alt="{{badge_name}}" class="mission-badge-icon">
                      {{#if badge_name}}<p class="mission-badge-name">{{badge_name}}</p>{{/if}}
                    </div>
                  {{/if}}
                </div>

                <div class="tagged-unit-actions">
                  <a href="{{viewPath}}" class="tagged-unit-link">view mission</a>

                  {{#if tagId}}
                    <button
                      type="button"
                      class="tagged-unit-link"
                      onclick="archiveUnit('{{tagId}}','{{_id}}','mission')"
                    >
                      move to archive
                    </button>
                  {{/if}}
                </div>
              </div>
            </div>
          </div>
        {{/each}}
      {{else}}
        <p class="tagged-no-units">You have not self-assigned any missions.</p>
      {{/if}}
    </div>
  </div>

  <div class="tagged-section-divider" aria-hidden="true"></div>

  {{!-- 4) MY LEADER-ASSIGNED MISSIONS --}}
  <div class="group-member-tagged-subsection" style="margin-top:20px;">
    <h3 class="group-member-tagged-subtitle">my leader-assigned missions</h3>

    <div class="tagged-units-grid">
      {{#if groupMemberAssignedMissions.length}}
        {{#each groupMemberAssignedMissions}}
          <div class="leader-assigned-unit-card leader-dashboard-wave-card">
            <div class="leader-dashboard-wave-card-inner">
              <div class="leader-dashboard-wave-header">
                <img
                  src="/images/onyxsvg.svg"
                  alt=""
                  class="leader-dashboard-wave-image"
                  aria-hidden="true"
                >
              </div>

              <div class="leader-dashboard-wave-content">
                <div class="tagged-unit-icon">
                  <img src="/icons/mission.svg" alt="mission icon">
                </div>

                <div class="tagged-unit-info">
                  <h3 class="tagged-unit-title">{{title}}</h3>
                  {{#if mainTopic}}<p class="tagged-unit-topic">{{mainTopic}}</p>{{/if}}
                  {{#if leaderName}}<p class="tagged-unit-meta">assigned by: {{leaderName}}</p>{{/if}}

                  {{#if assignedInstructions}}
                    <p class="tagged-unit-instructions"><em>instructions:</em> {{assignedInstructions}}</p>
                  {{/if}}

                  {{#if assignedCompletedAtFormatted}}
                    <p class="leader-assigned-status">✅ completed <span class="muted">({{assignedCompletedAtFormatted}})</span></p>
                  {{else}}
                    <p class="leader-assigned-status">⏳ pending</p>
                  {{/if}}

                  {{#if badgeImagePath}}
                    <div class="mission-badge-row">
                      <img src="{{badgeImagePath}}" alt="{{badge_name}}" class="mission-badge-icon">
                      {{#if badge_name}}<p class="mission-badge-name">{{badge_name}}</p>{{/if}}
                    </div>
                  {{/if}}
                </div>

                <div class="tagged-unit-actions">
                  <a href="{{viewPath}}" class="tagged-unit-link">view mission</a>

                  {{#if tagId}}
                    <button
                      type="button"
                      class="tagged-unit-link"
                      onclick="archiveUnit('{{tagId}}','{{_id}}','mission','{{assignedToId}}')"
                    >
                      move to archive
                    </button>
                  {{/if}}
                </div>
              </div>
            </div>
          </div>
        {{/each}}
      {{else}}
        <p class="tagged-no-units">You have no missions assigned by your leader.</p>
      {{/if}}
    </div>
  </div>

  <div class="tagged-section-divider" aria-hidden="true"></div>

  {{!-- 5) MISSION BADGES --}}
  <div class="group-member-tagged-subsection" style="margin-top:20px;">
    <h3 class="group-member-tagged-subtitle">mission badges</h3>

    {{#if @root.missionBadges.length}}
      <div class="gm-mission-badges-grid">
        {{#each @root.missionBadges}}
          <article class="gm-mission-badge-card">
            <div class="gm-mission-badge-inner">
              <div class="gm-mission-badge-top">
                <img src="{{badgePath}}" alt="{{badgeName}} badge" class="gm-mission-badge-img">
              </div>

              <div class="gm-mission-badge-body">
                <p class="gm-mission-badge-congrats">
                  🎉 <strong>Congratulations!</strong><br>
                  You earned the <strong>{{badgeName}}</strong> badge!
                </p>

                {{#if completed_at}}
                  <p class="gm-mission-badge-date">
                    completed {{formatDate completed_at "MMM D, YYYY"}}
                  </p>
                {{/if}}

                <a href="/unitviews/missions/view/{{missionId}}" class="gm-mission-badge-link">
                  view mission
                </a>
              </div>
            </div>
          </article>
        {{/each}}
      </div>
    {{else}}
      <p class="tagged-no-units" style="text-align:center;">
        You haven’t completed any missions yet. Once you finish a mission and submit notes, your badge will appear here.
      </p>
    {{/if}}
  </div>

  <div class="leader-archive-button-wrap">
    <a href="/archive/groupmember" class="leader-archive-button">
      learning archive
    </a>
  </div>
</section>

<script>
  function getCsrfGM() {
    return document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
  }

  async function archiveUnit(tagId, unitId, unitType, assignedToMemberId = null) {
    if (!tagId || !unitId || !unitType) return;
    if (!confirm('Move this item to archive?')) return;

    try {
      const res = await fetch('/archive', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': getCsrfGM()
        },
        body: JSON.stringify({
          tagId,
          unitId,
          unitType,
          assignedToMemberId
        })
      });

      const data = await res.json().catch(() => ({}));

      if (res.ok && data.ok) {
        location.reload();
      } else {
        alert(data.message || 'Could not archive this item.');
      }
    } catch (e) {
      console.error('archiveUnit error', e);
      alert('An error occurred while archiving this item.');
    }
  }

  (async function markMissionsSeenOnce() {
    try {
      const count = Number('{{@root.gmCounts.missions}}') || 0;

      await fetch('/dashboard/groupmember/mark-seen', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': getCsrfGM()
        },
        body: JSON.stringify({
          tabKey: 'missions',
          currentCount: count
        })
      });

      const dot = document.querySelector('.dashboard-tab[data-tab="missions"] .tab-dot');
      if (dot) dot.remove();
    } catch (e) {
      /* no-op */
    }
  })();
</script>