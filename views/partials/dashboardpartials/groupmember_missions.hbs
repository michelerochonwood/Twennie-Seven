<meta name="csrf-token" content="{{csrfToken}}">

<section class="group-member-tagged-units-section">
  <h2 class="tagged-units-title">missions</h2>

  {{!-- =========================
       1) MY TAGGED MISSIONS
       expects: groupMemberTaggedMissions = [{
         _id, title, mainTopic, tagId, viewPath,
         badge_name, badgeImagePath
       }]
       ========================= --}}
  <div class="group-member-tagged-subsection">
    <h3 class="group-member-tagged-subtitle">my tagged missions</h3>

    <div class="tagged-units-grid">
      {{#if groupMemberTaggedMissions.length}}
        {{#each groupMemberTaggedMissions}}
          <div class="tagged-unit-card">
            <div class="tagged-unit-icon">
              <img src="/icons/mission.svg" alt="mission icon">
            </div>

            <div class="tagged-unit-info">
              <h3 class="tagged-unit-title">{{title}}</h3>
              {{#if mainTopic}}<p class="tagged-unit-topic">{{mainTopic}}</p>{{/if}}

              {{!-- Mission badge (optional) --}}
              {{#if badgeImagePath}}
                <div class="mission-badge-row">
                  <img src="{{badgeImagePath}}" alt="{{badge_name}}" class="mission-badge-icon">
                  {{#if badge_name}}
                    <p class="mission-badge-name">{{badge_name}}</p>
                  {{/if}}
                </div>
              {{/if}}
            </div>

            <div class="tagged-unit-actions" style="display:flex; flex-direction:column; align-items:center; gap:6px; margin-top:6px;">
              <a href="{{viewPath}}" class="tagged-unit-link">view mission</a>

              <button
                class="tagged-unit-link"
                onclick="removeSelfTag('{{tagId}}','{{_id}}','mission')">
                remove tag
              </button>
            </div>
          </div>
        {{/each}}
      {{else}}
        <p class="tagged-no-units">You have not tagged any missions.</p>
      {{/if}}
    </div>
  </div>

  <div class="tagged-section-divider" aria-hidden="true"></div>

  {{!-- =========================
       2) MY ASSIGNED MISSIONS
       expects: groupMemberAssignedMissions = [{
         _id, title, mainTopic, tagId, leaderName,
         assignedInstructions, assignedCompletedAtFormatted,
         viewPath,
         badge_name, badgeImagePath
       }]
       ========================= --}}
  <div class="group-member-tagged-subsection" style="margin-top:20px;">
    <h3 class="group-member-tagged-subtitle">my assigned missions</h3>

    <div class="tagged-units-grid">
      {{#if groupMemberAssignedMissions.length}}
        {{#each groupMemberAssignedMissions}}
          <div class="leader-assigned-unit-card">
            <div class="tagged-unit-icon">
              <img src="/icons/mission.svg" alt="mission icon">
            </div>

            <div class="tagged-unit-info">
              <h3 class="tagged-unit-title">{{title}}</h3>
              {{#if mainTopic}}<p class="tagged-unit-topic">{{mainTopic}}</p>{{/if}}
              {{#if leaderName}}<p class="tagged-unit-meta">assigned by: {{leaderName}}</p>{{/if}}

              {{#if assignedInstructions}}
                <p class="tagged-unit-instructions"><em>instructions:</em> {{assignedInstructions}}</p>
              {{/if}}

              {{#if assignedCompletedAtFormatted}}
                <p class="leader-assigned-status">✅ completed <span class="muted">({{assignedCompletedAtFormatted}})</span></p>
              {{else}}
                <p class="leader-assigned-status">⏳ pending</p>
              {{/if}}

              {{!-- Mission badge (optional) --}}
              {{#if badgeImagePath}}
                <div class="mission-badge-row">
                  <img src="{{badgeImagePath}}" alt="{{badge_name}}" class="mission-badge-icon">
                  {{#if badge_name}}
                    <p class="mission-badge-name">{{badge_name}}</p>
                  {{/if}}
                </div>
              {{/if}}
            </div>

            <div class="tagged-unit-actions" style="display:flex; flex-direction:column; align-items:center; gap:6px; margin-top:6px;">
              <a href="{{viewPath}}" class="tagged-unit-link">view mission</a>
            </div>
          </div>
        {{/each}}
      {{else}}
        <p class="tagged-no-units">You have no missions assigned by your leader.</p>
      {{/if}}
    </div>
  </div>

  <div class="tagged-section-divider" aria-hidden="true"></div>

{{!-- =========================
     3) MISSION BADGES (COMPLETED MISSIONS)
     expects: @root.missionBadges = [{ missionId, title, completed_at, badgePath, badgeName }]
     ========================= --}}
<div class="group-member-tagged-subsection" style="margin-top:20px;">
  <h3 class="group-member-tagged-subtitle">mission badges</h3>

  {{#if @root.missionBadges.length}}
    <div class="gm-mission-badges-grid">
      {{#each @root.missionBadges}}
        <article class="gm-mission-badge-card">
          <div class="gm-mission-badge-inner">

            <div class="gm-mission-badge-top">
              <img
                src="{{badgePath}}"
                alt="{{badgeName}} badge"
                class="gm-mission-badge-img"
              >
            </div>

            <div class="gm-mission-badge-body">
              <p class="gm-mission-badge-congrats">
                🎉 <strong>Congratulations!</strong><br>
                You earned the <strong>{{badgeName}}</strong> badge!
              </p>

              {{#if completed_at}}
                <p class="gm-mission-badge-date">
                  completed {{formatDate completed_at "MMM D, YYYY"}}
                </p>
              {{/if}}

              <a href="/unitviews/missions/view/{{missionId}}" class="gm-mission-badge-link">
                view mission
              </a>
            </div>

          </div>
        </article>
      {{/each}}
    </div>
  {{else}}
    <p class="tagged-no-units" style="text-align:center;">
      You haven’t completed any missions yet. Once you finish a mission and submit notes, your badge will appear here.
    </p>
  {{/if}}
</div>



</section>

<script>
  function getCsrfGM() {
    return document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
  }

  async function removeSelfTag(tagId, unitId, unitType) {
    if (!confirm('Remove this tag from the unit?')) return;
    try {
      const res = await fetch(`/tags/remove/${tagId}/${unitId}/${unitType}`, {
        method: 'DELETE',
        headers: { 'X-CSRF-Token': getCsrfGM() }
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok) location.reload();
      else alert(data.message || 'Failed to remove tag.');
    } catch (e) {
      console.error('removeSelfTag error', e);
      alert('An error occurred while removing the tag.');
    }
  }

  // 🔵 Auto-mark the "missions" tab as seen when this partial loads
  (async function markMissionsSeenOnce() {
    try {
      const count = Number('{{@root.gmCounts.missions}}') || 0;
      await fetch('/dashboard/groupmember/mark-seen', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': getCsrfGM()
        },
        body: JSON.stringify({ tabKey: 'missions', currentCount: count })
      });
      const dot = document.querySelector('.dashboard-tab[data-tab="missions"] .tab-dot');
      if (dot) dot.remove();
    } catch (e) {
      /* no-op */
    }
  })();
</script>
