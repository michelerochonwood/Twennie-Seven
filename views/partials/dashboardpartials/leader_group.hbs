<section class="groupsection">
  <h2 class="groupsection-title">group overview</h2>
  <p class="groupsection-title2">{{leader.groupName}}</p>

  {{!-- Group image under the name --}}
  <div class="groupsection-groupimage-wrapper" style="display:flex; justify-content:center; margin: 10px 0 20px;">
    <div class="groupsection-groupimage" style="width:140px; height:140px; border-radius:999px; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,.08);">
      <img
        src="{{#if leader.groupImage}}{{leader.groupImage}}{{else}}/images/default-avatar.png{{/if}}"
        alt="{{leader.groupName}} group image"
        style="width:100%; height:100%; object-fit:cover; display:block;"
      >
    </div>
  </div>

  <div class="groupsection-stats">
    <p>Total Members: {{leader.members.length}} of possible {{leader.maxGroupSize}}</p>
  </div>

  <div class="groupsection-grid">
    {{#each leader.members}}
      <div class="groupsection-card">
        <div class="groupsection-card-image">
          <img
            src="{{#if profileImage}}{{profileImage}}{{else}}/images/default-avatar.png{{/if}}"
            alt="{{#if name}}{{name}}{{else}}Group member{{/if}}'s profile"
          >
        </div>

        <div class="groupsection-card-info">
          <h3 class="groupsection-card-name">{{name}}</h3>
          <p class="groupsection-card-title">{{professionalTitle}}</p>
          <span class="groupsection-card-status {{#if isVerified}}groupsection-registered{{else}}groupsection-pending{{/if}}">
            {{#if isVerified}}registered{{else}}registration pending{{/if}}
          </span>
        </div>

        <button
          type="button"
          class="groupsection-card-button"
          onclick="window.location.href='/profile/groupmember/{{_id}}'"
        >
          view profile
        </button>
      </div>
    {{/each}}

    {{!-- Empty slots to visualize remaining capacity --}}
    {{#if (lt leader.members.length leader.maxGroupSize)}}
      {{#each (range leader.members.length leader.maxGroupSize)}}
        <div class="groupsection-card groupsection-empty">
          <div class="groupsection-card-image">
            <img src="/images/default-avatar.png" alt="Empty slot">
          </div>
          <div class="groupsection-card-info">
            <h3 class="groupsection-card-name">Available Slot</h3>
            <p class="groupsection-card-title">Available</p>
          </div>
        </div>
      {{/each}}
    {{/if}}
  </div>

  <div class="groupsection-button-container" style="margin-bottom: 100px">
    <button
      type="button"
      class="groupsection-addmember-button"
      onclick="window.location.href='/leader/{{leader._id}}/add_group_member'"
    >
      add a member
    </button>
  </div>

  <div class="groupsection-button-container" style="margin-bottom: 60px">
    <button
      type="button"
      class="groupsection-deletemember-button"
      onclick="window.location.href='/leader/{{leader._id}}/delete_group_member'"
    >
      delete a member
    </button>
  </div>

  {{!-- ============================================================
       ORGANIZATION BLOCK (3 states)
       Expects:
         leader.hasOrg (boolean)
         leader.organizationName (string optional)
         suggestedOrg (object optional): _id, name
         orgGroups (array) with: _id, groupName, groupLeaderName, groupImage, memberCount (or members.length fallback)
       ============================================================ --}}

  {{#if leader.hasOrg}}
    <div class="group-member-instructions groupsection-org">
      <h3 class="groupsection-org-title">groups in my organization</h3>

      {{#if leader.organizationName}}
        <p class="groupsection-org-text">
          Organization: <strong>{{leader.organizationName}}</strong>
        </p>
      {{/if}}

      {{#if orgGroups.length}}
        <p class="groupsection-org-text">
          Here are other Twennie groups connected to your organization.
        </p>

        <div class="groupsection-org-grid">
          {{#each orgGroups}}
            <div class="groupsection-org-card">
              <div class="groupsection-org-card-image">
                <img
                  src="{{#if groupImage}}{{groupImage}}{{else}}/images/default-group.png{{/if}}"
                  alt="{{groupName}} group image"
                >
              </div>

              <div class="groupsection-org-card-info">
                <h3 class="groupsection-org-card-name">{{groupName}}</h3>
                <p class="groupsection-org-card-meta">Leader: {{groupLeaderName}}</p>

                <p class="groupsection-org-card-meta">
                  Members:
                  {{#if memberCount}}{{memberCount}}{{else}}{{#if members.length}}{{members.length}}{{else}}—{{/if}}{{/if}}
                </p>
              </div>
            </div>
          {{/each}}
        </div>

      {{else}}
        <p class="groupsection-org-empty" style="text-align: center;">
          No other groups in your organization have been added to Twennie yet.
        </p>
      {{/if}}
    </div>

  {{else if suggestedOrg}}
    <div class="group-member-instructions groupsection-org">
      <h3 class="groupsection-org-title">we found your organization</h3>

      <p class="groupsection-org-text">
        Based on your email address, it looks like you belong to <strong>{{suggestedOrg.name}}</strong>.
      </p>

      <form method="POST" action="/dashboard/leader/organization/join" class="groupsection-org-actions">
        {{#if csrfToken}}<input type="hidden" name="_csrf" value="{{csrfToken}}">{{/if}}
        <input type="hidden" name="orgId" value="{{suggestedOrg._id}}">
        <button type="submit" class="groupsection-org-addbtn">
          join this organization
        </button>
      </form>

      <p class="groupsection-org-text" style="text-align:center; margin-top: 1rem;">
        Not correct? You can create a new organization instead.
      </p>

<div class="groupsection-org-formwrap" id="org-formwrap-dashboard" hidden>
  {{> memberformpartials/organization_form}}
</div>
    </div>

  {{else}}
    <div class="group-member-instructions groupsection-org">
      <h3 class="groupsection-org-title">groups in my organization</h3>

      <p class="groupsection-org-text">
        Add your organization to unlock organization features — including the ability to see the group profiles
        of other Twennie groups inside your organization.
      </p>

      <div class="groupsection-org-actions">
        <button
          type="button"
          class="groupsection-org-addbtn"
          id="show-org-form-dashboard"
        >
          add my organization
        </button>
      </div>

<div class="groupsection-org-formwrap" id="org-formwrap-dashboard" hidden>
  {{> memberformpartials/organization_form}}
</div>


      {{!-- Optional: request to join an existing org (approval flow) --}}
      <form method="POST" action="/dashboard/leader/organization/request-join" class="groupsection-org-request" style="margin-top: 1.5rem;">
        {{#if csrfToken}}<input type="hidden" name="_csrf" value="{{csrfToken}}">{{/if}}

        <p class="groupsection-org-text" style="text-align:center;">
          Looking for an organization that already exists on Twennie?
        </p>

        <div style="display:flex; gap: 0.75rem; justify-content:center; flex-wrap: wrap;">
          <input
            type="text"
            name="orgSlugOrName"
            placeholder="organization name"
            class="groupsection-org-request-input"
            style="max-width: 360px; width: 100%;"
          >
          <button type="submit" class="groupsection-org-request-btn">
            request to join
          </button>
        </div>
      </form>
    </div>
  {{/if}}
</section>

<script>
  (function () {
    const btn = document.getElementById('show-org-form-dashboard');
    const wrap = document.getElementById('org-formwrap-dashboard');
    if (!btn || !wrap) return;

    btn.addEventListener('click', function () {
      const isHidden = wrap.hasAttribute('hidden');
      if (isHidden) wrap.removeAttribute('hidden');
      else wrap.setAttribute('hidden', '');

      if (isHidden) wrap.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  })();
</script>











