<section class="groupsection">
  <h2 class="groupsection-title">group overview</h2>
  <p class="groupsection-title2">{{leader.groupName}}</p>

  {{!-- Group image under the name --}}
  <div class="groupsection-groupimage-wrapper" style="display:flex; justify-content:center; margin: 10px 0 20px;">
    <div class="groupsection-groupimage" style="width:140px; height:140px; border-radius:999px; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,.08);">
      <img
        src="{{#if leader.groupImage}}{{leader.groupImage}}{{else}}/images/default-avatar.png{{/if}}"
        alt="{{leader.groupName}} group image"
        style="width:100%; height:100%; object-fit:cover; display:block;"
      >
    </div>
  </div>

  <div class="groupsection-stats">
    <p>Total Members: {{leader.members.length}} of possible {{leader.maxGroupSize}}</p>
  </div>

  <div class="groupsection-grid">
    {{#each leader.members}}
      <div class="groupsection-card">
        <div class="groupsection-card-image">
          <img
            src="{{#if profileImage}}{{profileImage}}{{else}}/images/default-avatar.png{{/if}}"
            alt="{{#if name}}{{name}}{{else}}Group member{{/if}}'s profile"
          >
        </div>

        <div class="groupsection-card-info">
          <h3 class="groupsection-card-name">{{name}}</h3>
          <p class="groupsection-card-title">{{professionalTitle}}</p>
          <span class="groupsection-card-status {{#if isVerified}}groupsection-registered{{else}}groupsection-pending{{/if}}">
            {{#if isVerified}}registered{{else}}registration pending{{/if}}
          </span>
        </div>

        <button
          type="button"
          class="groupsection-card-button"
          onclick="window.location.href='/profile/groupmember/{{_id}}'"
        >
          view profile
        </button>
      </div>
    {{/each}}

    {{!-- Empty slots to visualize remaining capacity --}}
    {{#if (lt leader.members.length leader.maxGroupSize)}}
      {{#each (range leader.members.length leader.maxGroupSize)}}
        <div class="groupsection-card groupsection-empty">
          <div class="groupsection-card-image">
            <img src="/images/default-avatar.png" alt="Empty slot">
          </div>
          <div class="groupsection-card-info">
            <h3 class="groupsection-card-name">Available Slot</h3>
            <p class="groupsection-card-title">Available</p>
          </div>
        </div>
      {{/each}}
    {{/if}}
  </div>

  <div class="groupsection-button-container" style="margin-bottom: 100px">
    <button
      type="button"
      class="groupsection-addmember-button"
      onclick="window.location.href='/leader/{{leader._id}}/add_group_member'"
    >
      add a member
    </button>
  </div>

  <div class="groupsection-button-container" style="margin-bottom: 100px">
    <button
      type="button"
      class="groupsection-deletemember-button"
      onclick="window.location.href='/leader/{{leader._id}}/delete_group_member'"
    >
      delete a member
    </button>
  </div>
</section>









