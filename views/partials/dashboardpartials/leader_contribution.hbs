<section class="contribution-section">
  <div class="contribution-container">
    <!-- Centered Image -->
    <div style="text-align: center; margin-bottom: -20px; margin-top: -40px;">
      <img src="/images/blueyteacher.png" alt="Bluey Teacher" style="max-width: 200px;">
    </div>

    <!-- Main Title -->
    <h2 class="dashboard-titles" style="text-align: center;">
      add a unit to the library
    </h2>

    <!-- Subtitle -->
    <p class="contribution-subtitle" style="text-align: center; font-weight: 500; margin-top: -10px;">
      learn by unleashing your inner teacher
    </p>

    <p class="contributor-benefits">
      Are you a writer? A coach? A videographer? A trainer? Twennie enables you to develop these skills,
      practice, and share learning with other professionals.
    </p>

    <button id="toggleContribute" class="contribute-btn">
      I want to contribute to the library
    </button>

    <!-- All unit cards live inside this grid and are hidden/shown by the toggle -->
    <div id="contributionGrid" class="contribution-grid" style="display: none;">

      <!-- Article -->
      <a href="/unitform/form_article" class="unit-card">
        <div class="svg-container" style="padding-top: 8px;">
          <img
            src="/icons/article.svg"
            alt="Article icon"
            style="display:block; width:40px; height:auto; margin:0 auto;"
          >
        </div>
      </a>

      <!-- Video -->
      <a href="/unitform/form_video" class="unit-card">
        <div class="svg-container" style="padding-top: 8px; width: 40px">
          <img
            src="/icons/video.svg"
            alt="Video icon"
            style="display:block; height:auto; margin:0 auto;"
          >
        </div>
      </a>

      <!-- Interview -->
      <a href="/unitform/form_interview" class="unit-card" >
        <div class="svg-container" style="padding-top: 8px;">
          <img
            src="/icons/interview.svg"
            alt="Interview icon"
            style="display:block; width:90px; height:auto; margin:0 auto;"
          >
        </div>
      </a>

      <!-- Prompt Set -->
      <a href="/unitform/form_promptset" class="unit-card">
        <div class="svg-container" style="padding-top: 8px;">
          <img
            src="/icons/promptset.svg"
            alt="Prompt set icon"
            style="display:block; width:100px; height:auto; margin:0 auto;"
          >
        </div>
      </a>

      <!-- Template -->
      <a href="/unitform/form_template" class="unit-card">
        <div class="svg-container" style="padding-top: 8px;">
          <img
            src="/icons/template.svg"
            alt="Template icon"
            style="display:block; width:100px; height:auto; margin:0 auto;"
          >
        </div>
      </a>

      <!-- Exercise -->
      <a href="/unitform/form_exercise" class="unit-card">
        <div class="svg-container" style="padding-top: 8px;">
          <img
            src="/icons/exercise.svg"
            alt="Exercise icon"
            style="display:block; width:65px; height:auto; margin:0 auto;"
          >
        </div>
      </a>

      <!-- Mission -->
      <a href="/unitform/form_mission" class="unit-card">
        <div class="svg-container" style="padding-top: 8px;">
          <img
            src="/icons/mission.svg"
            alt="Mission icon"
            style="display:block; width:65px; height:auto; margin:0 auto;"
          >
        </div>
      </a>

      <!-- Upcoming Unit -->
      <a href="/unitform/form_upcoming" class="unit-card">
        <div class="svg-container" style="padding-top: 8px;">
          <img
            src="/icons/upcoming.svg"
            alt="Upcoming unit icon"
            style="display:block; width:70px; height:auto; margin:0 auto;"
          >
        </div>
      </a>

      <!-- Nugget -->
      <a href="/unitform/form_nugget" class="unit-card">
        <div class="svg-container" style="padding-top: 8px;">
          <img
            src="/icons/nuggeticon.svg"
            alt="Nugget icon"
            style="display:block; width:90px; height:auto; margin:0 auto;"
          >
        </div>
      </a>

    </div>
  </div>
</section>
