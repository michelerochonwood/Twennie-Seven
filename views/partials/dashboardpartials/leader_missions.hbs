{{!-- views/dashboardpartials/leader_missions.hbs --}}

<!-- CSRF token for AJAX actions (remove/unassign) -->
<meta name="csrf-token" content="{{csrfToken}}">

{{!-- =========================
     3) ASSIGNED NUGGETS (GROUPED BY NUGGET)
     expects: leaderAssignedNuggetsGrouped = [
       {
         _id, title, client, region, discipline,
         assignments: [
           { tagId, assignedToId, assignedToName, assignedCompletedAtFormatted, assignedInstructions }
         ]
       }
     ]
     ========================= --}}

<section class="leader-assigned-nuggets-section" style="margin-top:20px">
  <h2 class="tagged-units-title">nuggets I've assigned to myself and my group</h2>

  <div class="tagged-units-grid">
    {{#if leaderAssignedNuggetsGrouped.length}}

      {{#each leaderAssignedNuggetsGrouped}}
        <div class="leader-assigned-unit-card leader-nugget-card">
          <div class="leader-nugget-card-inner">

            <!-- Header wave -->
            <div class="leader-nugget-card-svg-header">
              <img
                src="/icons/goldsvg.svg"
                alt=""
                aria-hidden="true"
                class="leader-nugget-card-svg-image"
              >
            </div>

            <!-- Card content -->
            <div class="leader-nugget-card-content">

              <div class="tagged-unit-icon">
                <img src="/icons/nuggeticon.svg" alt="nugget icon" style="width: 80px; height: auto">
              </div>

              <div class="tagged-unit-info">
                <h3 class="tagged-unit-title">{{this.title}}</h3>
                {{#if this.client}}<p class="tagged-unit-topic">client: {{this.client}}</p>{{/if}}
                {{#if this.region}}<p class="tagged-unit-topic">region: {{this.region}}</p>{{/if}}
                {{#if this.discipline}}<p class="tagged-unit-topic">discipline: {{this.discipline}}</p>{{/if}}

                {{!-- Assignments list --}}
                <div class="leader-assigned-list leader-nugget-assigned-list">
                  {{#if this.assignments.length}}

{{#each this.assignments}}
  <div class="leader-assigned-row leader-nugget-assigned-row">

    <div class="leader-nugget-divider"></div>

    <div class="leader-assigned-row-left">
      <p class="leader-assigned-to">assigned to: {{this.assignedToName}}</p>

      {{#if this.assignedCompletedAtFormatted}}
        <p class="leader-assigned-status">
          ✅ closed <span class="muted">({{this.assignedCompletedAtFormatted}})</span>
        </p>
      {{else}}
        <p class="leader-assigned-status">⏳ monitoring</p>
      {{/if}}

      {{#if this.assignedInstructions}}
        <p class="leader-assigned-instructions">
          <em>{{this.assignedInstructions}}</em>
        </p>
      {{/if}}
    </div>

    <div class="tagged-unit-actions leader-nugget-actions">
      <a href="/unitviews/nuggets/view/{{../_id}}" class="tagged-unit-link">
        view nugget
      </a>

      <button
        type="button"
        class="tagged-unit-link"
        onclick="archiveUnit('{{this.tagId}}','{{../_id}}','nugget','{{this.assignedToId}}')"
      >
        move to archive
      </button>
    </div>

    <div class="leader-nugget-divider"></div>

  </div>
{{/each}}


                  {{else}}
                    <p class="tagged-no-units">No members are currently assigned this nugget.</p>
                  {{/if}}
                </div>
              </div>



            </div>
          </div>
        </div>
      {{/each}}

    {{else}}
      <p class="tagged-no-units">You have no assigned nuggets.</p>
    {{/if}}
  </div>
</section>


<div class="tagged-section-divider" aria-hidden="true"></div>
{{!-- =========================
     1) SELF-ASSIGNED MISSIONS
     expects: leaderSelfTaggedMissions = [{
       _id, title, mainTopic, unitType="mission", tagId, viewPath,
       badge_name, badgeImagePath, category, completedAtFormatted
     }]
     ========================= --}}
<section class="tagged-units-section">
  <h2 class="tagged-units-title">self-assigned missions</h2>

  <div class="tagged-units-grid">
    {{#if leaderSelfTaggedMissions.length}}
      {{#each leaderSelfTaggedMissions}}
        <div class="tagged-unit-card leader-dashboard-wave-card mission-dashboard-card">
          <div class="leader-dashboard-wave-card-inner">

            <div class="leader-dashboard-wave-header">
              <img
                src="/icons/onyxsvg.svg"
                alt=""
                aria-hidden="true"
                class="leader-dashboard-wave-image"
              >
            </div>

            <div class="leader-dashboard-wave-content">
              <div class="tagged-unit-icon">
                {{#if badgeImagePath}}
                  <img src="{{badgeImagePath}}" alt="{{#if badge_name}}{{badge_name}}{{else}}mission badge{{/if}}" class="mission-badge-icon">
                {{else}}
                  <img src="/icons/mission.svg" alt="mission icon">
                {{/if}}
              </div>

              <div class="tagged-unit-info">
                <h3 class="tagged-unit-title">{{title}}</h3>

                {{#if mainTopic}}
                  <p class="tagged-unit-topic">{{mainTopic}}</p>
                {{/if}}

                {{#if completedAtFormatted}}
                  <p class="leader-assigned-status">
                    ✅ completed <span class="muted">({{completedAtFormatted}})</span>
                  </p>
                {{else}}
                  <p class="leader-assigned-status">⏳ pending</p>
                {{/if}}

                <div class="mission-badge-row">
                  {{#if badge_name}}
                    <p class="mission-badge-name">{{badge_name}}</p>
                  {{else}}
                    <p class="mission-badge-name mission-badge-name--muted">badge pending</p>
                  {{/if}}
                </div>
              </div>

              <div class="tagged-unit-actions" style="display:flex; flex-direction:column; align-items:center; gap:6px; margin-top:6px;">
                <a href="{{viewPath}}" class="tagged-unit-link">view mission</a>

<button
  type="button"
  class="tagged-unit-link"
  onclick="archiveUnit('{{tagId}}','{{_id}}','mission')"
>
  move to archive
</button>
              </div>
            </div>

          </div>
        </div>
      {{/each}}
    {{else}}
      <p class="tagged-no-units">You have no self-assigned missions.</p>
    {{/if}}
  </div>
</section>

<div class="tagged-section-divider" aria-hidden="true"></div>

{{!-- =========================
     2) ASSIGNED MISSIONS
     expects: leaderAssignedMissions = [{
       _id, title, mainTopic, unitType="mission", tagId,
       assignedToName, assignedCompletedAtFormatted, assignedInstructions,
       viewPath, assignedToId,
       badge_name, badgeImagePath, category
     }]
     ========================= --}}
<section class="leader-assigned-units-section" style="margin-top:20px">
  <h2 class="tagged-units-title">missions I have assigned to my group</h2>

  <div class="tagged-units-grid">
    {{#if leaderAssignedMissions.length}}
      {{#each leaderAssignedMissions}}
        <div class="leader-assigned-unit-card leader-dashboard-wave-card mission-dashboard-card">
          <div class="leader-dashboard-wave-card-inner">

            <div class="leader-dashboard-wave-header">
              <img
                src="/icons/onyxsvg.svg"
                alt=""
                aria-hidden="true"
                class="leader-dashboard-wave-image"
              >
            </div>

            <div class="leader-dashboard-wave-content">
              <div class="tagged-unit-icon">
                {{#if badgeImagePath}}
                  <img src="{{badgeImagePath}}" alt="{{#if badge_name}}{{badge_name}}{{else}}mission badge{{/if}}" class="mission-badge-icon">
                {{else}}
                  <img src="/icons/mission.svg" alt="mission icon">
                {{/if}}
              </div>

              <div class="tagged-unit-info">
                <h3 class="tagged-unit-title">{{title}}</h3>

                {{#if mainTopic}}
                  <p class="tagged-unit-topic">{{mainTopic}}</p>
                {{/if}}

                <p class="leader-assigned-to">assigned to: {{assignedToName}}</p>

                {{#if assignedCompletedAtFormatted}}
                  <p class="leader-assigned-status">
                    ✅ completed <span class="muted">({{assignedCompletedAtFormatted}})</span>
                  </p>
                {{else}}
                  <p class="leader-assigned-status">⏳ in progress</p>
                {{/if}}

                {{#if assignedInstructions}}
                  <p class="leader-assigned-instructions"><em>{{assignedInstructions}}</em></p>
                {{/if}}

                <div class="mission-badge-row">
                  {{#if badge_name}}
                    <p class="mission-badge-name">{{badge_name}}</p>
                  {{else}}
                    <p class="mission-badge-name mission-badge-name--muted">badge pending</p>
                  {{/if}}
                </div>
              </div>

              <div class="tagged-unit-actions" style="display:flex; flex-direction:column; align-items:center; gap:6px; margin-top:6px;">
                <a href="{{viewPath}}" class="tagged-unit-link">view mission</a>

<button
  type="button"
  class="tagged-unit-link"
  onclick="archiveUnit('{{tagId}}','{{_id}}','mission','{{assignedToId}}')"
>
  move to archive
</button>
              </div>
            </div>

          </div>
        </div>
      {{/each}}
    {{else}}
      <p class="tagged-no-units">You have no assigned missions.</p>
    {{/if}}
  </div>

  
</section>

<div class="leader-archive-button-wrap">
  <a href="/archive/leader" class="leader-archive-button">
    view learning archive
  </a>
</div>