<div class="leader-topics-container">
  <h3 class="leader-dashboard-subtitles">topics</h3>
  <p>
    For all users: These are your three chosen topics. The links help you access relevant content quickly and determine which email alerts you receive. To change them or opt out of emails, go to your membership overview tab and choose from three different levels of email preferences. 
  </p>
  <p>
    For group leaders: These are your personal topics. Each team member can select their own, and your group has a separate set visible in the group profile. To update group topics, click your group profile on the left sidebar.
  </p>

  {{!-- If ANY topic exists, show the cards; otherwise show CTA to profile --}}
  {{#if (or selectedTopics.topic1.title (or selectedTopics.topic2.title selectedTopics.topic3.title))}}
    <div class="leader-topics-grid">
      {{#if selectedTopics.topic1.title}}
        <div class="leader-topic-card" data-topic-id="{{selectedTopics.topic1.slug}}">
          <div class="leader-topic-title">{{selectedTopics.topic1.title}}</div>
          <ul class="leader-topic-subtopics">
            {{#each selectedTopics.topic1.subtopics}}
              <li>{{this}}</li>
            {{else}}
              <li>No subtopics available</li>
            {{/each}}
          </ul>
          <a href="/membertopics/{{selectedTopics.topic1.viewName}}" class="leader-topic-review">review this topic</a>
        </div>
      {{/if}}

      {{#if selectedTopics.topic2.title}}
        <div class="leader-topic-card" data-topic-id="{{selectedTopics.topic2.slug}}">
          <div class="leader-topic-title">{{selectedTopics.topic2.title}}</div>
          <ul class="leader-topic-subtopics">
            {{#each selectedTopics.topic2.subtopics}}
              <li>{{this}}</li>
            {{else}}
              <li>No subtopics available</li>
            {{/each}}
          </ul>
          <a href="/membertopics/{{selectedTopics.topic2.viewName}}" class="leader-topic-review">review this topic</a>
        </div>
      {{/if}}

      {{#if selectedTopics.topic3.title}}
        <div class="leader-topic-card" data-topic-id="{{selectedTopics.topic3.slug}}">
          <div class="leader-topic-title">{{selectedTopics.topic3.title}}</div>
          <ul class="leader-topic-subtopics">
            {{#each selectedTopics.topic3.subtopics}}
              <li>{{this}}</li>
            {{else}}
              <li>No subtopics available</li>
            {{/each}}
          </ul>
          <a href="/membertopics/{{selectedTopics.topic3.viewName}}" class="leader-topic-review">review this topic</a>
        </div>
      {{/if}}
    </div>
  {{else}}
    <div class="no-topics-cta" style="text-align:center; padding:1rem; background:#f8f8ff; border:1px solid #e6e6f5; border-radius:12px; margin-top:.75rem;">
      <p><strong>No topics yet</strong></p>
      <p>You haven’t chosen your personal topics. Select up to three in your profile to personalize your dashboard and email alerts.</p>
      <a
        href="/profile/leader/{{leader._id}}"
        class="leader-profile-btn"
        style="display:inline-block; margin-top:.5rem;"
      >
        my profile
      </a>
    </div>
  {{/if}}
</div>

<!-- ✅ Topic Suggestion Section with Headings -->
<div class="leader-topic-suggestion-card">
  {{#if topicSuggestions.length}}
    {{#each topicSuggestions}}
      <h4 class="leader-topic-suggestion-title">suggested new topic: {{this.topicTitle}}</h4>
      <p class="leader-topic-suggestion-meta">
        Submitted on {{formatDate this.submittedAt}} |
        {{#if this.approved}}
          <span class="approved">✅ Approved</span><br>
          Estimated library release: {{formatDate this.expectedLibraryDate}}
        {{else}}
          <span class="pending">🕓 Approval pending</span>
        {{/if}}
      </p>
      <div class="leader-topic-suggestion-grid">
        <div class="leader-topic-suggestion-col">
          <h5>1. How has this topic evolved? Why is it especially important now?</h5>
          <p>{{this.paragraph1}}</p>
        </div>
        <div class="leader-topic-suggestion-col">
          <h5>2. How does this topic fit in the world of technical services?</h5>
          <p>{{this.paragraph2}}</p>
        </div>
        <div class="leader-topic-suggestion-col">
          <h5>3. What is the future of this topic?</h5>
          <p>{{this.paragraph3}}</p>
        </div>
      </div>
    {{/each}}
  {{else}}
    <h4 class="leader-topic-suggestion-title">No Suggestions Yet</h4>
    <p class="leader-topic-suggestion-meta">You have not suggested any new topics for Twennie’s library.</p>
  {{/if}}

  <!-- Always show suggest-a-topic call-to-action -->
  <div class="topic-grid-center" style="margin-top: 30px;">
    <div class="topic-item">
      <h3>suggest a new topic</h3>
      <p>Have an idea that would benefit Twennie members? We’d love to hear it. Use the form to propose a new topic for future learning content. (Your topic will not be connected to your username or profile. It will become part of all Twennie topics.)</p>
      <a href="/topics/suggest" class="suggest-topic-button">submit a topic</a>
    </div>
  </div>
</div>





