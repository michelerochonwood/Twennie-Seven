

<div class="dashboard-explanation-block">
  <h3 class="dashboard-explanation-title">how this tab works</h3>
  <p class="dashboard-explanation-text">
    This tab shows your three chosen topics. The links help you access relevant content quickly and determine which email alerts you receive. To change them or opt out of emails, go to your membership overview tab and choose from three different levels of email preferences. To change your three topics, go to your leader profile. 
  </p>

</div>


<div class="member-topics-container">
  <h3 class="member-dashboard-subtitles">my topics</h3>
  <p>
    These are your three topics of interest. They give you quick access to content that matters to you and help determine email alerts. To change them or opt out of emails, visit your membership overview and choose your preferred email level.
  </p>

  {{!-- If ANY topic exists, render cards; else show profile CTA --}}
  {{#if (or selectedTopics.topic1.title (or selectedTopics.topic2.title selectedTopics.topic3.title))}}
    <div class="member-topics-grid">
      {{#if selectedTopics.topic1.title}}
        <div class="member-topic-card">
          <div class="member-topic-inner">
            <div class="member-topic-title-area">
              <div class="member-topic-title">{{selectedTopics.topic1.title}}</div>
            </div>
            <div class="member-topic-subtopics-area">
              <ul class="member-topic-subtopics">
                {{#each selectedTopics.topic1.subtopics}}
                  <li>{{this}}</li>
                {{else}}
                  <li>No subtopics available</li>
                {{/each}}
              </ul>
            </div>
            <div class="member-topic-button-area">
              <a href="/topics/{{selectedTopics.topic1.viewName}}" class="member-topic-review">review this topic</a>
            </div>
          </div>
        </div>
      {{/if}}

      {{#if selectedTopics.topic2.title}}
        <div class="member-topic-card">
          <div class="member-topic-inner">
            <div class="member-topic-title-area">
              <div class="member-topic-title">{{selectedTopics.topic2.title}}</div>
            </div>
            <div class="member-topic-subtopics-area">
              <ul class="member-topic-subtopics">
                {{#each selectedTopics.topic2.subtopics}}
                  <li>{{this}}</li>
                {{else}}
                  <li>No subtopics available</li>
                {{/each}}
              </ul>
            </div>
            <div class="member-topic-button-area">
              <a href="/topics/{{selectedTopics.topic2.viewName}}" class="member-topic-review">review this topic</a>
            </div>
          </div>
        </div>
      {{/if}}

      {{#if selectedTopics.topic3.title}}
        <div class="member-topic-card">
          <div class="member-topic-inner">
            <div class="member-topic-title-area">
              <div class="member-topic-title">{{selectedTopics.topic3.title}}</div>
            </div>
            <div class="member-topic-subtopics-area">
              <ul class="member-topic-subtopics">
                {{#each selectedTopics.topic3.subtopics}}
                  <li>{{this}}</li>
                {{else}}
                  <li>No subtopics available</li>
                {{/each}}
              </ul>
            </div>
            <div class="member-topic-button-area">
              <a href="/topics/{{selectedTopics.topic3.viewName}}" class="member-topic-review">review this topic</a>
            </div>
          </div>
        </div>
      {{/if}}
    </div>
  {{else}}
    <div class="no-topics-cta" style="text-align:center; padding:1rem; background:#f8f8ff; border:1px solid #e6e6f5; border-radius:12px; margin-top:.75rem;">
      <p><strong>No topics yet</strong></p>
      <p>You haven’t chosen your personal topics. Select up to three in your profile to personalize your dashboard and email alerts.</p>
      <a
        href="/profile/groupmember/{{groupMember._id}}"
        class="groupmember-profile-btn"
        style="display:inline-block; margin-top:.5rem;"
      >
        my profile
      </a>
    </div>
  {{/if}}
</div>

<!-- ✅ Topic Suggestion Section -->
<div class="leader-topic-suggestion-card">
  {{#if topicSuggestions.length}}
    {{#each topicSuggestions}}
      <h4 class="leader-topic-suggestion-title">suggested new topic: {{this.topicTitle}}</h4>
      <p class="leader-topic-suggestion-meta">
        Submitted on {{formatDate this.submittedAt}} |
        {{#if this.approved}}
          <span class="approved">✅ Approved</span><br>
          Estimated library release: {{formatDate this.expectedLibraryDate}}
        {{else}}
          <span class="pending">🕓 Approval pending</span>
        {{/if}}
      </p>

      <div class="leader-topic-suggestion-single">
        <h5>Why should this topic be added to Twennie’s library?</h5>
        <p>{{this.description}}</p>
      </div>
    {{/each}}
  {{else}}
    <h4 class="leader-topic-suggestion-title">No Suggestions Yet</h4>
    <p class="leader-topic-suggestion-meta">You have not suggested any new topics for Twennie’s library.</p>
  {{/if}}

  <!-- ✅ Always show suggest-a-topic call-to-action -->
  <div class="topic-grid-center" style="margin-top: 30px;">
    <div class="topic-item">
      <h3>suggest a new topic</h3>
      <p>Have an idea that would benefit Twennie members? We’d love to hear it. Use the form to propose a new topic for future learning content. Your topic will not be connected to your username or profile. It will become part of Twennie’s shared topic library.</p>
      <a href="/topics/suggest" class="suggest-topic-button">submit a topic</a>
    </div>
  </div>
</div>







