<meta name="csrf-token" content="{{csrfToken}}">

<section class="group-member-tagged-units-section">
  <h2 class="tagged-units-title">tagged library units</h2>

  <!-- 🔖 Section 1: Units I Tagged Myself -->
  <div class="group-member-tagged-subsection">
    <h3 class="group-member-tagged-subtitle">my tagged units</h3>
    <div class="tagged-units-grid">
      {{#each groupMemberTaggedUnits}}
        <div class="tagged-unit-card">
          <div class="tagged-unit-icon">
            <img src="/icons/{{unitType}}.svg" alt="{{unitType}} icon">
          </div>

          <div class="tagged-unit-info">
            <h3 class="tagged-unit-title">{{title}}</h3>
            <p class="tagged-unit-topic">{{mainTopic}}</p>
            {{#if (eq unitType "upcoming")}}
              <p class="tagged-unit-status">🚧 coming soon</p>
            {{/if}}
          </div>

          <!-- Actions stacked vertically -->
          <div class="tagged-unit-actions" style="display:flex; flex-direction:column; align-items:center; gap:6px; margin-top:6px;">
            <a href="/unitviews/{{capitalize unitType}}s/view/{{_id}}" class="tagged-unit-link">view unit</a>
            <button
              class="tagged-unit-link"
              onclick="removeSelfTag('{{tagId}}','{{_id}}','{{unitType}}')">
              remove tag
            </button>
          </div>
        </div>
      {{else}}
        <p class="tagged-no-units">You have not tagged any units.</p>
      {{/each}}
    </div>
  </div>

  <!-- 👥 Section 2: Units Tagged by My Leader (pending; completion tracked by notes, not a button) -->
  <div class="group-member-tagged-subsection">
    <h3 class="group-member-tagged-subtitle">units tagged by my leader</h3>
    <div class="tagged-units-grid">
      {{#each leaderAssignedTags}}
        <div class="tagged-unit-card">
          <div class="tagged-unit-icon">
            <img src="/icons/{{unitType}}.svg" alt="{{unitType}} icon">
          </div>

          <div class="tagged-unit-info">
            <h3 class="tagged-unit-title">{{title}}</h3>
            <p class="tagged-unit-topic">{{mainTopic}}</p>
            {{#if instructions}}
              <p class="tagged-unit-instructions"><em>Instructions:</em> {{instructions}}</p>
            {{/if}}
            <p class="tagged-unit-status">
              {{#if (eq unitType "upcoming")}}🚧 coming soon{{else}}⏳ pending{{/if}}
            </p>
          </div>

          <!-- Only "view unit" (no mark-complete button) -->
          <div class="tagged-unit-actions" style="display:flex; flex-direction:column; align-items:center; gap:6px; margin-top:6px;">
            <a href="/unitviews/{{capitalize unitType}}s/view/{{_id}}" class="tagged-unit-link">view unit</a>
          </div>
        </div>
      {{else}}
        <p class="tagged-no-units">You have no units assigned by your leader.</p>
      {{/each}}
    </div>
  </div>

  <!-- ✅ Completed Units Section -->
  <div class="group-member-tagged-subsection">
    <h3 class="group-member-tagged-subtitle">completed leader-assigned units</h3>
    <div class="tagged-units-grid">
      {{#each completedLeaderAssignedTags}}
        <div class="tagged-unit-card">
          <div class="tagged-unit-icon">
            <img src="/icons/{{unitType}}.svg" alt="{{unitType}} icon">
          </div>

          <div class="tagged-unit-info">
            <h3 class="tagged-unit-title">{{title}}</h3>
            <p class="tagged-unit-topic">{{mainTopic}}</p>
            <p class="tagged-unit-completed"><strong>Completed:</strong> {{formatDate completedAt}}</p>
          </div>

          <!-- Only "review unit" -->
          <div class="tagged-unit-actions" style="display:flex; flex-direction:column; align-items:center; gap:6px; margin-top:6px;">
            <a href="/unitviews/{{capitalize unitType}}s/view/{{_id}}" class="tagged-unit-link">review unit</a>
          </div>
        </div>
      {{else}}
        <p class="tagged-no-units">No completed units yet.</p>
      {{/each}}
    </div>
  </div>
</section>

<script>
  function getCsrf() {
    return document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
  }

  // Group member removing their own tag from a unit (allowed by controller)
  async function removeSelfTag(tagId, unitId, unitType) {
    if (!confirm('Remove this tag from the unit?')) return;
    try {
      const res = await fetch(`/tags/remove/${tagId}/${unitId}/${unitType}`, {
        method: 'DELETE',
        headers: { 'X-CSRF-Token': getCsrf() }
      });
      if (res.ok) location.reload();
      else {
        const data = await res.json().catch(() => ({}));
        alert(data.message || 'Failed to remove tag.');
      }
    } catch (e) {
      console.error('removeSelfTag error', e);
      alert('An error occurred while removing the tag.');
    }
  }
</script>







