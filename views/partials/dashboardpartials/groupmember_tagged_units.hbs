<meta name="csrf-token" content="{{csrfToken}}">

<section class="group-member-tagged-units-section">
  <h2 class="tagged-units-title">tagged library units</h2>

  {{!-- =========================
       1) MY TAGGED UNITS (SELF)
       expects: groupMemberSelfTaggedUnits = [{ _id, title, mainTopic, unitType, tagId, viewPath }]
       ========================= --}}
  <div class="group-member-tagged-subsection">
    <h3 class="group-member-tagged-subtitle">my tagged units</h3>

    <div class="tagged-units-grid">
      {{#if groupMemberSelfTaggedUnits.length}}
        {{#each groupMemberSelfTaggedUnits}}
          <div class="tagged-unit-card">
            <div class="tagged-unit-icon">
              <img src="/icons/{{unitType}}.svg" alt="{{unitType}} icon">
            </div>

            <div class="tagged-unit-info">
              <h3 class="tagged-unit-title">{{title}}</h3>
              {{#if mainTopic}}<p class="tagged-unit-topic">{{mainTopic}}</p>{{/if}}
            </div>

            <div class="tagged-unit-actions" style="display:flex; flex-direction:column; align-items:center; gap:6px; margin-top:6px;">
              <a href="{{viewPath}}" class="tagged-unit-link">view unit</a>

              <button
                class="tagged-unit-link"
                onclick="removeSelfTag('{{tagId}}','{{_id}}','{{unitType}}')">
                remove tag
              </button>
            </div>
          </div>
        {{/each}}
      {{else}}
        <p class="tagged-no-units">You have not tagged any units.</p>
      {{/if}}
    </div>
  </div>

  <div class="tagged-section-divider" aria-hidden="true"></div>

  {{!-- =========================
       2) MY ASSIGNED UNITS (ALL NON-NUGGET, NON-MISSION)
       expects: groupMemberAssignedUnits = [{ _id, title, mainTopic, unitType, tagId, viewPath, assignedInstructions, assignedCompletedAtFormatted, leaderName }]
       We will later have dedicated sections for nuggets & missions.
       ========================= --}}
  <div class="group-member-tagged-subsection" style="margin-top:20px;">
    <h3 class="group-member-tagged-subtitle">my assigned units</h3>

    <div class="tagged-units-grid">
      {{#if groupMemberAssignedUnits.length}}
        {{#each groupMemberAssignedUnits}}
          {{!-- Show only non-nugget, non-mission here --}}
          {{#unless (eq unitType "nugget")}}
            {{#unless (eq unitType "mission")}}
              <div class="tagged-unit-card">
                <div class="tagged-unit-icon">
                  <img src="/icons/{{unitType}}.svg" alt="{{unitType}} icon">
                </div>

                <div class="tagged-unit-info">
                  <h3 class="tagged-unit-title">{{title}}</h3>
                  {{#if mainTopic}}<p class="tagged-unit-topic">{{mainTopic}}</p>{{/if}}
                  {{#if leaderName}}<p class="tagged-unit-meta">assigned by: {{leaderName}}</p>{{/if}}
                  {{#if assignedInstructions}}
                    <p class="tagged-unit-instructions"><em>instructions:</em> {{assignedInstructions}}</p>
                  {{/if}}

                  {{#if assignedCompletedAtFormatted}}
                    <p class="leader-assigned-status">✅ completed <span class="muted">({{assignedCompletedAtFormatted}})</span></p>
                  {{else}}
                    <p class="leader-assigned-status">⏳ pending</p>
                  {{/if}}
                </div>

                <div class="tagged-unit-actions" style="display:flex; flex-direction:column; align-items:center; gap:6px; margin-top:6px;">
                  <a href="{{viewPath}}" class="tagged-unit-link">view unit</a>
                  {{!-- completion can be handled from unit view / notes --}}
                </div>
              </div>
            {{/unless}}
          {{/unless}}
        {{/each}}
      {{else}}
        <p class="tagged-no-units">You have no units assigned by your leader.</p>
      {{/if}}
    </div>
  </div>

  <div class="tagged-section-divider" aria-hidden="true"></div>

  {{!-- =========================
       3) MY TAGGED NUGGETS
       expects: groupMemberTaggedNuggets = [{ _id, title, mainTopic, tagId, viewPath }]
       ========================= --}}
  <div class="group-member-tagged-subsection" style="margin-top:20px;">
    <h3 class="group-member-tagged-subtitle">my tagged nuggets</h3>

    <div class="tagged-units-grid">
      {{#if groupMemberTaggedNuggets.length}}
        {{#each groupMemberTaggedNuggets}}
          <div class="tagged-unit-card">
            <div class="tagged-unit-icon">
              <img src="/icons/nuggeticon.svg" alt="nugget icon">
            </div>

            <div class="tagged-unit-info">
              <h3 class="tagged-unit-title">{{title}}</h3>
              {{#if mainTopic}}<p class="tagged-unit-topic">{{mainTopic}}</p>{{/if}}
            </div>

            <div class="tagged-unit-actions" style="display:flex; flex-direction:column; align-items:center; gap:6px; margin-top:6px;">
              <a href="{{viewPath}}" class="tagged-unit-link">view nugget</a>

              <button
                class="tagged-unit-link"
                onclick="removeSelfTag('{{tagId}}','{{_id}}','nugget')">
                remove tag
              </button>
            </div>
          </div>
        {{/each}}
      {{else}}
        <p class="tagged-no-units">You have not tagged any nuggets.</p>
      {{/if}}
    </div>
  </div>

  <div class="tagged-section-divider" aria-hidden="true"></div>

  {{!-- =========================
       4) MY ASSIGNED NUGGETS
       expects: groupMemberAssignedNuggets = [{ _id, title, client, region, discipline, tagId, leaderName, assignedInstructions, assignedCompletedAtFormatted, viewPath }]
       ========================= --}}
  <div class="group-member-tagged-subsection" style="margin-top:20px;">
