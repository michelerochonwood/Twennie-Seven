<meta name="csrf-token" content="{{csrfToken}}">

<section class="group-member-tagged-units-section">
  <h2 class="tagged-units-title">assigned library units</h2>

  {{!-- =====================================================
       1) MY TAGGED UNITS (NON-NUGGET, NON-MISSION)
       ===================================================== --}}
  <div class="group-member-tagged-subsection">
    <h3 class="group-member-tagged-subtitle">my self-assigned units</h3>

    <div class="tagged-units-grid">
      {{#if groupMemberSelfTaggedUnits.length}}
        {{#each groupMemberSelfTaggedUnits}}
          {{#unless (eq unitType "nugget")}}
            {{#unless (eq unitType "mission")}}
              <div class="tagged-unit-card">
                <div class="tagged-unit-icon">
                  <img src="/icons/{{unitType}}.svg" alt="{{unitType}} icon">
                </div>

                <div class="tagged-unit-info">
                  <h3 class="tagged-unit-title">{{title}}</h3>
                  {{#if mainTopic}}<p class="tagged-unit-topic">{{mainTopic}}</p>{{/if}}

                  {{#if completedAtFormatted}}
                    <p class="leader-assigned-status">✅ completed <span class="muted">({{completedAtFormatted}})</span></p>
                  {{else}}
                    <p class="leader-assigned-status">⏳ pending</p>
                  {{/if}}
                </div>

                <div class="tagged-unit-actions">
                  <a href="{{viewPath}}" class="tagged-unit-link">view unit</a>
                  <button
                    class="tagged-unit-link"
                    onclick="removeSelfTag('{{tagId}}','{{_id}}','{{unitType}}')"
                  >
                    move to archive
                  </button>
                </div>
              </div>
            {{/unless}}
          {{/unless}}
        {{/each}}
      {{else}}
        <p class="tagged-no-units">You have not self-assigned any units.</p>
      {{/if}}
    </div>
  </div>

  <div class="tagged-section-divider" aria-hidden="true"></div>

  {{!-- =====================================================
       2) MY ASSIGNED UNITS (NON-NUGGET, NON-MISSION)
       ===================================================== --}}
  <div class="group-member-tagged-subsection">
    <h3 class="group-member-tagged-subtitle">my leader-assigned units</h3>

    <div class="tagged-units-grid">
      {{#if groupMemberAssignedUnits.length}}
        {{#each groupMemberAssignedUnits}}
          {{#unless (eq unitType "nugget")}}
            {{#unless (eq unitType "mission")}}
              <div class="tagged-unit-card">
                <div class="tagged-unit-icon">
                  <img src="/icons/{{unitType}}.svg" alt="{{unitType}} icon">
                </div>

                <div class="tagged-unit-info">
                  <h3 class="tagged-unit-title">{{title}}</h3>
                  {{#if mainTopic}}<p class="tagged-unit-topic">{{mainTopic}}</p>{{/if}}
                  {{#if leaderName}}<p class="tagged-unit-meta">assigned by: {{leaderName}}</p>{{/if}}

                  {{#if assignedInstructions}}
                    <p class="tagged-unit-instructions"><em>instructions:</em> {{assignedInstructions}}</p>
                  {{/if}}

                  {{#if assignedCompletedAtFormatted}}
                    <p class="leader-assigned-status">✅ completed <span class="muted">({{assignedCompletedAtFormatted}})</span></p>
                  {{else}}
                    <p class="leader-assigned-status">⏳ pending</p>
                  {{/if}}
                </div>

                <div class="tagged-unit-actions">
                  <a href="{{viewPath}}" class="tagged-unit-link">view unit</a>
                </div>
              </div>
            {{/unless}}
          {{/unless}}
        {{/each}}
      {{else}}
        <p class="tagged-no-units">You have no leader-assigned units.</p>
      {{/if}}
    </div>
  </div>

  <div class="tagged-section-divider" aria-hidden="true"></div>

  {{!-- =====================================================
       3) MY LEARNING NOTES REPORT
       ===================================================== --}}
  <div class="group-member-tagged-subsection">
    <h3 class="group-member-tagged-subtitle">my learning notes</h3>

    <div class="member-progress-report-button-container" style="margin-bottom: 1.5rem; text-align:center;">
      <a href="/reports/mylearningnotes" class="member-progress-report-image-link">
        <img
          src="/images/libraryunitsreport.png"
          alt="View my learning notes"
          class="member-progress-report-image"
          style="max-width: 150px; width: 100%; height: auto;"
        >
      </a>
    </div>
  </div>

</section>