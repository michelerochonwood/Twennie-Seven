<!-- CSRF token for secure AJAX -->
<meta name="csrf-token" content="{{csrfToken}}">

<section class="tagged-units-section">
  <h2 class="tagged-units-title">tagged library units</h2>

  <div class="group-member-tagged-subsection">
    <h3 class="group-member-tagged-subtitle">my tagged units</h3>

    <div class="tagged-units-grid">
      {{#if recentTaggedUnits.length}}
        {{#each recentTaggedUnits}}
          <div class="tagged-unit-card">
            <div class="tagged-unit-icon">
              <img src="/icons/{{unitType}}.svg" alt="{{unitType}} icon">
            </div>

            <div class="tagged-unit-info">
              <h3 class="tagged-unit-title">{{title}}</h3>

              {{#if mainTopic}}
                <p class="tagged-unit-topic">{{mainTopic}}</p>
              {{/if}}

              {{#if (eq unitType "upcoming")}}
                <p class="tagged-unit-status">🚧 coming soon</p>
              {{/if}}
            </div>

            <div class="tagged-unit-actions">
              <a href="{{viewPath}}" class="tagged-unit-link">view unit</a>

              {{#if tagId}}
                <button
                  type="button"
                  class="tagged-unit-link"
                  onclick="archiveUnit('{{tagId}}','{{_id}}','{{unitType}}')">
                  move to archive
                </button>
              {{/if}}
            </div>
          </div>
        {{/each}}
      {{else}}
        <p class="tagged-no-units">You have no tagged units.</p>
      {{/if}}
    </div>
  </div>

  <div class="member-progress-report-button-container" style="margin-top: 1.5rem;">
    <a href="/reports/mylearningnotes-individual" class="member-progress-report-button">
      view my learning notes
    </a>
  </div>
</section>

<script>
  function getCsrfToken() {
    return document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
  }

  async function archiveUnit(tagId, unitId, unitType, assignedToMemberId = null) {
    if (!tagId) return;
    if (!confirm("Move this item to archive?")) return;

    try {
      const response = await fetch('/archive', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': getCsrfToken()
        },
        body: JSON.stringify({
          tagId,
          unitId,
          unitType,
          assignedToMemberId
        })
      });

      const result = await response.json().catch(() => ({}));

      if (response.ok && result.ok) {
        location.reload();
      } else {
        alert(result.message || 'Failed to archive item.');
      }
    } catch (err) {
      console.error('❌ Archive failed:', err);
      alert('An error occurred while archiving this item.');
    }
  }
</script>