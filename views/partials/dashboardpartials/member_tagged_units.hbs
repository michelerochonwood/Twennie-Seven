<div class="dashboard-explanation-block">
  <h3 class="dashboard-explanation-title">how this tab works</h3>
  <p class="dashboard-explanation-text">
    In this tab you will complete learning units. These could include articles, videos, interviews, exercises, or templates. View the unit and record notes to complete it. Once completed, you can move it to the archive by clicking <strong>move to archive</strong>. View your notes in the completed library units report link below.
  </p>
</div>

<meta name="csrf-token" content="{{csrfToken}}">

<section class="tagged-units-section">
  <h2 class="tagged-units-title">self-assigned library units</h2>

  <div class="group-member-tagged-subsection">
    <h3 class="group-member-tagged-subtitle">my self-assigned units</h3>

    <div class="tagged-units-grid">
      {{#if recentTaggedUnits.length}}
        {{#each recentTaggedUnits}}
          <div class="tagged-unit-card leader-dashboard-wave-card">
            <div class="leader-dashboard-wave-card-inner">

              <div class="leader-dashboard-wave-header">
                <img
                  src="/icons/unitsvg.svg"
                  alt=""
                  class="leader-dashboard-wave-image"
                  aria-hidden="true"
                >
              </div>

              <div class="leader-dashboard-wave-content">
                <div class="tagged-unit-icon">
                  <img src="/icons/{{unitType}}.svg" alt="{{unitType}} icon">
                </div>

                <div class="tagged-unit-info">
                  <h3 class="tagged-unit-title">{{title}}</h3>

                  {{#if mainTopic}}
                    <p class="tagged-unit-topic">{{mainTopic}}</p>
                  {{/if}}

                  {{#if (eq unitType "upcoming")}}
                    <p class="tagged-unit-status">🚧 coming soon</p>
                  {{/if}}
                </div>

                <div class="tagged-unit-actions">
                  <a href="{{viewPath}}" class="tagged-unit-link">view unit</a>

                  {{#if tagId}}
                    <button
                      type="button"
                      class="tagged-unit-link"
                      onclick="archiveUnit('{{tagId}}','{{_id}}','{{unitType}}')"
                    >
                      move to archive
                    </button>
                  {{/if}}
                </div>
              </div>

            </div>
          </div>
        {{/each}}
      {{else}}
        <p class="tagged-no-units">You have no tagged units.</p>
      {{/if}}
    </div>
  </div>

  <div class="tagged-section-divider" aria-hidden="true"></div>

  {{!-- NEW: MY LEARNING NOTES LINK --}}
  <div class="group-member-tagged-subsection">
    <h3 class="group-member-tagged-subtitle">my learning notes</h3>

<div class="member-report-actions">

  <!-- Learning Notes -->
  <div class="member-report-card">
    <a href="/reports/mylearningnotes-individual" class="member-report-link">
      <img
        src="/images/libraryunitsreport.png"
        alt="View my learning notes"
        class="member-report-image"
      >
    </a>
    <p class="member-report-description">
      This library unit report shows you all the notes you've kept on your completed library units.
    </p>
  </div>

  <!-- Learning Archive -->
  <div class="member-report-card">
    <a href="/archive/member" class="member-report-link">
      <img
        src="/images/learningarchivebutton.png"
        alt="View learning archive"
        class="member-report-image"
      >
    </a>
    <p class="member-report-description">
      The learning archive contains units you've archived. These may or may not have been completed.
    </p>
  </div>

</div>

</section>

<script>
  function getCsrfToken() {
    return document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
  }

  async function archiveUnit(tagId, unitId, unitType, assignedToMemberId = null) {
    if (!tagId) return;
    if (!confirm("Move this item to archive?")) return;

    try {
      const response = await fetch('/archive', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': getCsrfToken()
        },
        body: JSON.stringify({
          tagId,
          unitId,
          unitType,
          assignedToMemberId
        })
      });

      const result = await response.json().catch(() => ({}));

      if (response.ok && result.ok) {
        location.reload();
      } else {
        alert(result.message || 'Failed to archive item.');
      }
    } catch (err) {
      console.error('❌ Archive failed:', err);
      alert('An error occurred while archiving this item.');
    }
  }
</script>