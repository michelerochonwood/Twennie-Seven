<section class="leader-topics-container leader-admin-section">

  <h2 class="leader-dashboard-subtitles">my organization</h2>

  {{!-- Org Identity --}}
  <div class="groupsection-org-card" style="margin: 0.75rem auto; max-width: 800px;">
    <p class="groupsection-org-card-name" style="margin: 0;">
      {{#if organization.name}}{{organization.name}}{{else}}(organization){{/if}}
    </p>

    <p class="groupsection-org-card-meta">
      {{#if organization.industry}}
        industry: {{organization.industry}}
      {{else}}
        industry: —
      {{/if}}
    </p>

    {{!-- Optional: show when org was created / joined --}}
    {{#if organization.createdAt}}
      <p class="groupsection-org-card-meta">on twennie since {{formatDate organization.createdAt}}</p>
    {{/if}}

    <p class="groupsection-org-card-info" style="margin-top: 0.5rem;">
      you are viewing this organization as an administrator.
    </p>
  </div>

  {{!-- Snapshot Counts --}}
  <div class="groupsection-org-grid" style="max-width: 800px; margin: 0.5rem auto 1.25rem auto;">
    <div class="groupsection-org-card">
      <p class="groupsection-org-card-name">{{counts.leaders}}</p>
      <p class="groupsection-org-card-meta">leaders</p>
    </div>
    <div class="groupsection-org-card">
      <p class="groupsection-org-card-name">{{counts.members}}</p>
      <p class="groupsection-org-card-meta">members</p>
    </div>
    <div class="groupsection-org-card">
      <p class="groupsection-org-card-name">{{counts.pendingJoinRequests}}</p>
      <p class="groupsection-org-card-meta">join requests</p>
    </div>    
    <div class="groupsection-org-card">
      <p class="groupsection-org-card-name">{{counts.suggestionsSent}}</p>
      <p class="groupsection-org-card-meta">suggestions sent</p>
    </div>
    <div class="groupsection-org-card">
      <p class="groupsection-org-card-name">{{counts.pendingLibrarySubmissions}}</p>
      <p class="groupsection-org-card-meta">library submissions</p>
    </div>
  </div>



{{!-- Learning footprint (light) --}}
<div class="groupsection-org-card" style="margin: 0 auto 1.25rem auto; max-width: 800px;">
  <p class="leader-membership-access-title" style="margin: 0 0 0.5rem 0;">learning footprint (last 30 days)</p>

  <div class="groupsection-org-grid" style="margin-top: 0.5rem;">
    <div class="groupsection-org-card">
      <p class="groupsection-org-card-name">{{learningFootprint.activeLearners}}</p>
      <p class="groupsection-org-card-meta">active learners</p>
    </div>

    <div class="groupsection-org-card">
      <p class="groupsection-org-card-name">{{learningFootprint.unitsCompleted}}</p>
      <p class="groupsection-org-card-meta">units completed</p>
    </div>

    <div class="groupsection-org-card">
      <p class="groupsection-org-card-name">{{learningFootprint.promptSetsCompleted}}</p>
      <p class="groupsection-org-card-meta">prompt sets completed</p>
    </div>

    <div class="groupsection-org-card">
      <p class="groupsection-org-card-name">{{learningFootprint.avgCompletionsPerLearner}}</p>
      <p class="groupsection-org-card-meta">avg / learner</p>
    </div>

    <div class="groupsection-org-card">
      <p class="groupsection-org-card-name">
        {{#if learningFootprint.mostPopularTopic}}
          {{learningFootprint.mostPopularTopic}}
        {{else}}
          —
        {{/if}}
      </p>
      <p class="groupsection-org-card-meta">most popular topic</p>
    </div>
  </div>

  <p class="groupsection-org-card-info" style="margin-top: 0.75rem;">
    this is a light snapshot. the full comparison report lives in “organization reports.”
  </p>
</div>


</section>
