<div class="group-member-tagged-units-section">

  {{#if currentPromptSets.length}}
    <div class="group-member-tagged-subsection">
      <h2 class="group-member-tagged-subtitle">prompt sets in progress</h2>

      <div class="tagged-units-grid">
        {{#each currentPromptSets}}
          <div class="tagged-unit-card">
            <div class="tagged-unit-icon">
              <img
                src="/promptprogress/promptprogress{{increment @index}}-{{this.promptIndex}}.svg"
                alt="Progress Pie Chart"
                class="groupmember-progress-svg"
                data-progress="{{this.promptIndex}}"
              >
            </div>

            <div class="tagged-unit-info">
              <h3 class="tagged-unit-title">{{this.promptSetTitle}}</h3>

              <p class="leader-assigned-status">
                ⏳ in progress
              </p>

              <p class="tagged-unit-topic">
                you have completed {{this.promptIndex}} prompts in this set
              </p>
            </div>

            <div class="tagged-unit-actions">
              <a href="/reports/mycompletedpromptsets" class="tagged-unit-link">view my prompt report</a>
            </div>
          </div>
        {{/each}}
      </div>
    </div>
  {{/if}}

  <div class="tagged-section-divider" aria-hidden="true"></div>

  <div class="group-member-tagged-subsection">
    <h2 class="group-member-tagged-subtitle">completed prompt sets</h2>

    <div class="tagged-units-grid">
      {{#if completedPromptSets.length}}
        {{#each completedPromptSets}}
          <a
            href="/reports/mycompletedpromptsets#promptset-{{@index}}"
            class="tagged-unit-card"
            style="text-decoration: none; color: inherit;"
          >
            <div class="tagged-unit-icon">
              {{#if this.badge.image}}
                <img
                  src="{{this.badge.image}}"
                  alt="{{this.badge.name}} badge"
                  class="tagged-unit-badge-image"
                >
              {{else}}
                <img src="/icons/promptset.svg" alt="promptset icon">
              {{/if}}
            </div>

            <div class="tagged-unit-info">
              <h3 class="tagged-unit-title">{{this.promptSetTitle}}</h3>

              <p class="leader-assigned-status">
                ✅ completed
                {{#if this.completedAt}}
                  <span class="muted">({{this.completedAt}})</span>
                {{/if}}
              </p>

              <p class="tagged-unit-topic">
                you completed all prompts in this set
              </p>

              {{#if this.badge.name}}
                <p class="tagged-unit-meta">
                  badge earned: {{this.badge.name}}
                </p>
              {{/if}}
            </div>

            <div class="tagged-unit-actions">
              <span class="tagged-unit-link">view completed prompts</span>
            </div>
          </a>
        {{/each}}
      {{else}}
        <p class="tagged-no-units">You haven’t completed any prompt sets yet.</p>
      {{/if}}
    </div>

    <div class="member-progress-report-button-container" style="margin-top: 1.5rem; text-align:center;">
      <a href="/reports/mycompletedpromptsets" class="member-progress-report-button">
        view my completed prompts
      </a>
    </div>
  </div>

</div>


    