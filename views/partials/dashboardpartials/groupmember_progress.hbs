<div class="dashboard-explanation-block">
  <h3 class="dashboard-explanation-title">how this tab works</h3>
  <p class="dashboard-explanation-text">
    In this tab you will monitor your prompt completions. Your (up to) three prompt sets in progress will show as a pie chart. Completed sets and badges will show in the next section. If you don't see a completed prompt set here, check the archive. Click <strong>view learning archive</strong> in the sidebar.
  </p>
</div>

<meta name="csrf-token" content="{{csrfToken}}">

<div class="group-member-tagged-units-section">

  {{#if currentPromptSets.length}}
    <h2 class="groupmember-progress-current-title">prompt sets in progress</h2>

    <div class="groupmember-progress-current">
      {{#each currentPromptSets}}
        <div class="groupmember-progress-grid">
          <h2 class="groupmember-progress-title">{{this.promptSetTitle}}</h2>

          <img
            src="/promptprogress/promptprogress{{increment @index}}-{{this.promptIndex}}.svg"
            alt="Progress Pie Chart"
            class="groupmember-progress-svg"
            data-progress="{{this.promptIndex}}"
          >

          <p class="groupmember-progress-target">
            you have completed {{this.promptIndex}} prompts in this set
          </p>
        </div>
      {{/each}}
    </div>
  {{/if}}

  <div class="tagged-section-divider" aria-hidden="true"></div>

  <div class="group-member-tagged-subsection">
    <h2 class="group-member-tagged-subtitle">completed prompt sets</h2>

    <div class="tagged-units-grid">
      {{#if completedPromptSets.length}}
        {{#each completedPromptSets}}
          <div class="tagged-unit-card leader-dashboard-wave-card">
            <div class="leader-dashboard-wave-card-inner">

              <div class="leader-dashboard-wave-header">
                <img
                  src="/images/unitsvg.svg"
                  alt=""
                  class="leader-dashboard-wave-image"
                  aria-hidden="true"
                >
              </div>

              <div class="leader-dashboard-wave-content">
                <a
                  href="/reports/mycompletedpromptsets#promptset-{{@index}}"
                  style="text-decoration: none; color: inherit;"
                >
                  <div class="tagged-unit-icon">
                    {{#if this.badge.image}}
                      <img
                        src="{{this.badge.image}}"
                        alt="{{this.badge.name}} badge"
                        class="tagged-unit-badge-image"
                        style="height: auto;"
                      >
                    {{else}}
                      <img src="/icons/promptset.svg" alt="promptset icon">
                    {{/if}}
                  </div>

                  <div class="tagged-unit-info">
                    <h3 class="tagged-unit-title">{{this.promptSetTitle}}</h3>

                    <p class="leader-assigned-status">
                      ✅ completed
                      {{#if this.completedAt}}
                        <span class="muted">({{this.completedAt}})</span>
                      {{/if}}
                    </p>

                    <p class="tagged-unit-topic">
                      you completed all prompts in this set
                    </p>

                    {{#if this.badge.name}}
                      <p class="tagged-unit-meta">
                        badge earned: {{this.badge.name}}
                      </p>
                    {{/if}}
                  </div>
                </a>

                <div class="tagged-unit-actions">
                  <button
                    type="button"
                    class="tagged-unit-link"
                    onclick="archiveCompletedPromptSet('{{this.promptSetId}}','{{this.assignedToId}}')"
                  >
                    move to archive
                  </button>
                </div>
              </div>

            </div>
          </div>
        {{/each}}
      {{else}}
        <p class="tagged-no-units">
          You haven’t completed any prompt sets recently, but check the archive for any you might have moved.
        </p>
      {{/if}}
    </div>
  </div>

  <div class="tagged-section-divider" aria-hidden="true"></div>

  <div class="member-report-actions">

    <div class="member-report-card">
      <a href="/reports/mylearningnotes" class="member-report-link">
        <img
          src="/images/libraryunitsreport.png"
          alt="View my learning notes"
          class="member-report-image"
        >
      </a>

      <p class="member-report-description">
        This library unit report shows you all the notes you've kept on your completed library units.
      </p>
    </div>

    <div class="member-report-card">
      <a href="/archive/groupmember" class="member-report-link">
        <img
          src="/images/learningarchivebutton.png"
          alt="View learning archive"
          class="member-report-image"
        >
      </a>

      <p class="member-report-description">
        The learning archive contains units you've archived. These may or may not have been completed.
      </p>
    </div>

  </div>

</div>

<script>
  async function archiveCompletedPromptSet(promptSetId, assignedToMemberId = null) {
    if (!confirm('Move this prompt set to archive?')) return;

    try {
      const res = await fetch('/archive/completed-promptset', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content')
        },
        body: JSON.stringify({
          promptSetId,
          assignedToMemberId
        })
      });

      const data = await res.json().catch(() => ({}));

      if (res.ok && data.ok) {
        location.reload();
      } else {
        alert(data.message || 'Could not archive this prompt set.');
      }
    } catch (e) {
      console.error('archiveCompletedPromptSet error', e);
      alert('An error occurred while archiving this prompt set.');
    }
  }
</script>