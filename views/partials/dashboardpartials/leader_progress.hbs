<meta name="csrf-token" content="{{csrfToken}}">

<div class="leader-progress-container" style="overflow: hidden; padding-bottom: 2rem;">

  {{#if currentPromptSets.length}}
    <h2 class="leader-progress-current-title">my prompt sets in progress</h2>

    <div class="leader-progress-current">
      {{#each currentPromptSets}}
        <div class="leader-progress-grid">
          <h2 class="leader-progress-title">{{this.promptSetTitle}}</h2>

          <img
            src="/promptprogress/promptprogress{{increment @index}}-{{this.promptIndex}}.svg"
            alt="Progress Pie Chart"
            class="leader-progress-svg"
            data-progress="{{this.promptIndex}}"
          >

          <p class="leader-progress-target">
            you have completed {{this.promptIndex}} prompts in this set
          </p>
        </div>
      {{/each}}
    </div>
  {{/if}}

  <div class="leader-progress-completed">
    <h2 class="leader-progress-completed-title">my completed prompt sets and badges</h2>

    {{#if completedPromptSets.length}}
      <div class="leader-progress-completed-grid" style="overflow: hidden;">
        {{#each completedPromptSets}}
          <div class="leader-progress-completed-card">
            <h3 class="leader-progress-completed-title">{{this.promptSetTitle}}</h3>
            <p class="leader-progress-completed-main-topic">{{this.mainTopic}}</p>
            <p class="leader-progress-completed-date">completed: {{this.completedAt}}</p>

            <div class="leader-progress-badge">
              {{#if this.badge}}
                <img src="{{this.badge.image}}" alt="{{this.badge.name}}" class="leader-progress-badge-img" style="height: auto;">
                <p class="leader-progress-badge-name">{{this.badge.name}}</p>
              {{else}}
                <p class="leader-progress-badge-name">No badge earned</p>
              {{/if}}
            </div>

            <div class="leader-archive-button-wrap">
              <button
                type="button"
                class="leader-archive-button"
                onclick="archiveCompletedPromptSet('{{this.promptSetId}}','{{this.assignedToId}}','{{this.completionId}}')"
              >
                move to archive
              </button>
            </div>
          </div>
        {{/each}}
      </div>
    {{else}}
      <p class="no-data" style="text-align: center; margin-top: 1rem; font-size: 1rem">
        You haven’t completed any prompt sets yet.
      </p>
    {{/if}}

    <div class="leader-progress-report-access" style="text-align: center; margin-top: 2rem;">
      <p style="margin-bottom: 0.75rem;">
        All prompt sets you and the members of your group have completed can be reviewed in the report center.
      </p>

      <a href="/reports/promptsetscompleted" class="report-link" style="display: inline-block;">
        <img src="https://www.twennie.com/images/promptsetsreport.png" alt="Prompt Sets Report" style="width: 100px; height: auto;">
      </a>
    </div>
  </div>

  <hr class="leader-prompts-divider">

  <section class="leader-prompt-section">
    <h2 class="leader-assigned-title">prompt sets I have assigned to my group</h2>
    <p class="leader-assigned-subtitle">Each card is one prompt set.</p>

    <div class="leader-assigned-grid">
      {{#if assignedPromptSets.length}}
        {{#each assignedPromptSets}}
          <div class="leader-assigned-card">
            <h3 class="leader-assigned-ps-title">{{promptSetTitle}}</h3>

            <p class="leader-assigned-meta">
              <span class="leader-assigned-pill">{{frequency}} prompt</span>
              <span class="leader-assigned-sep">•</span>
              <span class="leader-assigned-topic">{{mainTopic}}</span>
            </p>

            <div class="leader-assigned-members">
              {{#each members}}
                <div class="leader-assigned-member">
                  <div class="leader-assigned-card-top">
                    <span class="leader-assigned-status leader-assigned-status--{{status}}">{{statusLabel}}</span>
                    <span class="leader-assigned-due">due {{targetCompletionDate}}</span>
                  </div>

                  <img
                    src="{{#if memberImage}}{{memberImage}}{{else}}/images/default-avatar.png{{/if}}"
                    alt="{{memberName}}"
                    class="leader-assigned-avatar"
                  >

                  <div class="leader-assigned-member-info">
                    <p class="leader-assigned-member-name">{{memberName}}</p>

                    <div class="leader-assigned-progress-wrap">
                      <div class="leader-progress-bar">
                        <div class="leader-progress-bar-fill" style="width: {{progressPercent}}%;"></div>
                      </div>

                      <p class="leader-assigned-progress-text">
                        prompt {{currentPromptIndex}}/20
                      </p>
                    </div>
                  </div>

                  <div class="leader-assigned-actions">
                    <form
                      method="POST"
                      action="/promptsetassign/unassign/{{assignmentId}}/{{memberId}}"
                      class="leader-unassign-form"
                      onsubmit="return confirm('Unassign this prompt set from {{memberName}}?');"
                    >
                      {{#if ../../csrfToken}}
                        <input type="hidden" name="_csrf" value="{{../../csrfToken}}">
                      {{/if}}

                      <input type="hidden" name="_method" value="DELETE">

                      <button type="submit" class="leader-assigned-unassign">
                        unassign
                      </button>
                    </form>
                  </div>
                </div>
              {{/each}}
            </div>
          </div>
        {{/each}}
      {{else}}
        <p class="leader-assigned-empty">No assigned prompt sets yet.</p>
      {{/if}}
    </div>

    <hr class="leader-prompts-divider">

    <div class="leader-group-badges">
      <h2 class="leader-progress-completed-title">group badges</h2>

      <p class="leader-group-badges-subtitle">
        Badges earned by members of your group for completing prompt sets.
      </p>

      {{#if groupCompletedPromptSets.length}}
        <div class="leader-progress-completed-grid" style="overflow: hidden;">
          {{#each groupCompletedPromptSets}}
            <div class="leader-progress-completed-card leader-group-badge-card">
              <h3 class="leader-progress-completed-title">{{this.promptSetTitle}}</h3>
              <p class="leader-progress-completed-main-topic">{{this.mainTopic}}</p>

              {{#if this.memberName}}
                <p class="leader-group-badge-member">
                  earned by <strong>{{this.memberName}}</strong>
                </p>
              {{/if}}

              <p class="leader-progress-completed-date">
                completed: {{this.completedAt}}
              </p>

              <div class="leader-progress-badge">
                {{#if this.badge}}
                  <img src="{{this.badge.image}}" alt="{{this.badge.name}}" class="leader-progress-badge-img" style="height: auto;">
                  <p class="leader-progress-badge-name">{{this.badge.name}}</p>
                {{else}}
                  <p class="leader-progress-badge-name">No badge data for this completion</p>
                {{/if}}
              </div>

              <div class="leader-archive-button-wrap">
                <button
                  type="button"
                  class="leader-archive-button"
                  onclick="archiveCompletedPromptSet('{{this.promptSetId}}','{{this.assignedToId}}','{{this.completionId}}')"
                >
                  move to archive
                </button>
              </div>
            </div>
          {{/each}}
        </div>
      {{else}}
        <p class="no-data" style="text-align: center; margin-top: 1rem; font-size: 1rem">
          No badges have been earned by your group recently, but check the archive for any you may have moved.
        </p>
      {{/if}}
    </div>
</section>



<div style="height: 1px; clear: both;"></div>
</div>

<script>
  function getCsrfLeader() {
    return document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
  }

  async function archiveCompletedPromptSet(promptSetId, assignedToMemberId = null, completionId = null) {
    if (!promptSetId) return;
    if (!confirm('Move this completed prompt set to archive?')) return;

    try {
      const res = await fetch('/archive/completed-promptset', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': getCsrfLeader()
        },
        body: JSON.stringify({
          promptSetId,
          assignedToMemberId,
          completionId
        })
      });

      const data = await res.json().catch(() => ({}));

      if (res.ok && data.ok) {
        location.reload();
      } else {
        alert(data.message || 'Could not archive this prompt set.');
      }
    } catch (e) {
      console.error('archiveCompletedPromptSet error', e);
      alert('An error occurred while archiving this prompt set.');
    }
  }
</script>