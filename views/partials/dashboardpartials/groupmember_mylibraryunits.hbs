<div class="dashboard-explanation-block">
  <h3 class="dashboard-explanation-title">how this tab works</h3>
  <p class="dashboard-explanation-text">
    This tab shows units you and your group have added to the Twennie library. Only the author can edit a unit.
  </p>
</div>

<section class="dashboard-library-units-card-section">

  <h2 class="dashboard-section-title dashboard-library-card-title">
    my library units
  </h2>

  <div class="dashboard-library-card-grid">
    {{#each groupMemberUnits}}

      <article class="dashboard-library-card leader-dashboard-wave-card">
        <div class="leader-dashboard-wave-card-inner">

<div class="leader-dashboard-wave-header">
  {{#if (eq unitType "nugget")}}
    <img
      src="/icons/goldsvg.svg"
      alt=""
      class="leader-dashboard-wave-image"
      aria-hidden="true"
    >

  {{else if (eq unitType "mission")}}
    <img
      src="/icons/onyxsvg.svg"
      alt=""
      class="leader-dashboard-wave-image"
      aria-hidden="true"
    >

  {{else}}
    <img
      src="/icons/unitsvg.svg"
      alt=""
      class="leader-dashboard-wave-image"
      aria-hidden="true"
    >
  {{/if}}
</div>

          <div class="leader-dashboard-wave-content dashboard-library-wave-content">
            <img src="{{authorImage}}" alt="{{author}}" class="dashboard-library-author-image">

            <div class="dashboard-library-card-body">
              <p class="dashboard-library-card-type">{{displayType}}</p>

              <h3 class="dashboard-library-card-heading">{{title}}</h3>

              <p class="dashboard-library-card-meta">
                <strong>status:</strong> {{status}}
              </p>

              <p class="dashboard-library-card-meta">
                <strong>topic:</strong> {{mainTopic}}
              </p>

              {{#if projectedRelease}}
                <p class="dashboard-library-card-meta">
                  <strong>projected release:</strong> {{formatDate projectedRelease}}
                </p>
              {{/if}}

              <a href="{{viewPath}}" class="dashboard-library-card-link">
                view and/or edit
              </a>
            </div>
          </div>

        </div>
      </article>

    {{else}}
      <p class="dashboard-library-empty">
        no contributions submitted yet.
      </p>
    {{/each}}
  </div>

  <h2 class="dashboard-section-title dashboard-library-card-title">
    my group's library units
  </h2>

  <div class="dashboard-library-card-grid">
    {{#each groupLibraryUnits}}

      <article class="dashboard-library-card leader-dashboard-wave-card">
        <div class="leader-dashboard-wave-card-inner">

<div class="leader-dashboard-wave-header">
  {{#if (eq unitType "nugget")}}
    <img
      src="/icons/goldsvg.svg"
      alt=""
      class="leader-dashboard-wave-image"
      aria-hidden="true"
    >

  {{else if (eq unitType "mission")}}
    <img
      src="/icons/onyxsvg.svg"
      alt=""
      class="leader-dashboard-wave-image"
      aria-hidden="true"
    >

  {{else}}
    <img
      src="/icons/unitsvg.svg"
      alt=""
      class="leader-dashboard-wave-image"
      aria-hidden="true"
    >
  {{/if}}
</div>

          <div class="leader-dashboard-wave-content dashboard-library-wave-content">
            <img src="{{authorImage}}" alt="{{author}}" class="dashboard-library-author-image">

            <div class="dashboard-library-card-body">
              <p class="dashboard-library-card-author">{{author}}</p>

              <p class="dashboard-library-card-type">{{displayType}}</p>

              <h3 class="dashboard-library-card-heading">{{title}}</h3>

              <p class="dashboard-library-card-meta">
                <strong>status:</strong> {{status}}
              </p>

              <p class="dashboard-library-card-meta">
                <strong>topic:</strong> {{mainTopic}}
              </p>

              {{#if projectedRelease}}
                <p class="dashboard-library-card-meta">
                  <strong>projected release:</strong> {{formatDate projectedRelease}}
                </p>
              {{/if}}

              <a href="{{viewPath}}" class="dashboard-library-card-link">
                view only
              </a>
            </div>
          </div>

        </div>
      </article>

    {{else}}
      <p class="dashboard-library-empty">
        no group contributions submitted yet.
      </p>
    {{/each}}
  </div>

</section>