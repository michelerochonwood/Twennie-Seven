<div class="dashboard-explanation-block">
  <h3 class="dashboard-explanation-title">how this tab works</h3>
  <p class="dashboard-explanation-text">
    In this tab you will monitor yours and your group's learning unit completions. These units could include articles, videos, interviews, exercises, or templates. If a unit is showing as completed, you can click <strong>move to archive</strong>. This will make room for more assignments in this tab for you and members of your group. 
  </p>
</div>
<!-- CSRF token for AJAX deletes -->
<meta name="csrf-token" content="{{csrfToken}}">

{{!-- allowed in this tab only:
     article, video, interview, exercise, template
--}}

<section class="tagged-units-section">
  <h2 class="tagged-units-title">my self-assigned library units</h2>

  <div class="tagged-units-grid">
    {{#if leaderSelfAssignedNonMissionUnits.length}}
      {{#each leaderSelfAssignedNonMissionUnits}}
        {{#if (or (eq unitType "article") (eq unitType "video") (eq unitType "interview") (eq unitType "exercise") (eq unitType "template"))}}

          <div class="tagged-unit-card leader-dashboard-wave-card {{unitType}}-dashboard-card">
            <div class="leader-dashboard-wave-card-inner">

              <div class="leader-dashboard-wave-header">
                <img src="/icons/unitsvg.svg" alt="" aria-hidden="true" class="leader-dashboard-wave-image">
              </div>

              <div class="leader-dashboard-wave-content">
                <div class="tagged-unit-icon">
                  <img src="/icons/{{unitType}}.svg" alt="{{unitType}} icon">
                </div>

                <div class="tagged-unit-info">
                  <h3 class="tagged-unit-title">{{title}}</h3>

                  {{#if mainTopic}}
                    <p class="tagged-unit-topic">{{mainTopic}}</p>
                  {{/if}}

                  {{#if assignedCompletedAtFormatted}}
                    <p class="leader-assigned-status">
                      ✅ completed <span class="muted">({{assignedCompletedAtFormatted}})</span>
                    </p>
                  {{else}}
                    <p class="leader-assigned-status">⏳ pending</p>
                  {{/if}}

                  {{#if assignedInstructions}}
                    <p class="leader-assigned-instructions"><em>{{assignedInstructions}}</em></p>
                  {{/if}}
                </div>

                <div class="tagged-unit-actions" style="display:flex; flex-direction:column; align-items:center; gap:6px; margin-top:6px;">
                  <a href="{{viewPath}}" class="tagged-unit-link">view unit</a>

                  <button
                    class="tagged-unit-link"
                    type="button"
                    onclick="archiveUnit('{{tagId}}','{{_id}}','{{unitType}}')">
                    move to archive
                  </button>
                </div>
              </div>

            </div>
          </div>

        {{/if}}
      {{/each}}
    {{else}}
      <p class="tagged-no-units">You have no self-assigned library units.</p>
    {{/if}}
  </div>
</section>

<div class="tagged-section-divider" aria-hidden="true"></div>

<section class="leader-assigned-units-section" style="margin-top:20px">
  <h2 class="tagged-units-title">units I have assigned to my group</h2>

  <div class="tagged-units-grid">
    {{#if leaderAssignedNonMissionUnits.length}}
      {{#each leaderAssignedNonMissionUnits}}
        {{#if (or (eq unitType "article") (eq unitType "video") (eq unitType "interview") (eq unitType "exercise") (eq unitType "template"))}}

          <div class="leader-assigned-unit-card leader-dashboard-wave-card {{unitType}}-dashboard-card">
            <div class="leader-dashboard-wave-card-inner">

              <div class="leader-dashboard-wave-header">
                <img src="/icons/unitsvg.svg" alt="" aria-hidden="true" class="leader-dashboard-wave-image">
              </div>

              <div class="leader-dashboard-wave-content">
                <div class="tagged-unit-icon">
                  <img src="/icons/{{unitType}}.svg" alt="{{unitType}} icon">
                </div>

                <div class="tagged-unit-info">
                  <h3 class="tagged-unit-title">{{title}}</h3>

                  {{#if mainTopic}}
                    <p class="tagged-unit-topic">{{mainTopic}}</p>
                  {{/if}}

                  <p class="leader-assigned-to">
                    assigned to: {{assignedToName}}
                  </p>

                  {{#if assignedCompletedAtFormatted}}
                    <p class="leader-assigned-status">
                      ✅ completed <span class="muted">({{assignedCompletedAtFormatted}})</span>
                    </p>
                  {{else}}
                    <p class="leader-assigned-status">⏳ pending</p>
                  {{/if}}

                  {{#if assignedInstructions}}
                    <p class="leader-assigned-instructions"><em>{{assignedInstructions}}</em></p>
                  {{/if}}
                </div>

                <div class="tagged-unit-actions" style="display:flex; flex-direction:column; align-items:center; gap:6px; margin-top:6px;">
                  <a href="{{viewPath}}" class="tagged-unit-link">view unit</a>

                  <button
                    class="tagged-unit-link"
                    type="button"
                    onclick="archiveUnit('{{tagId}}','{{_id}}','{{unitType}}','{{assignedToId}}')">
                    move to archive
                  </button>
                </div>
              </div>

            </div>
          </div>

        {{/if}}
      {{/each}}
    {{else}}
      <p class="tagged-no-units">You have no assigned units.</p>
    {{/if}}
  </div>
</section>

<div class="tagged-section-divider" aria-hidden="true"></div>

<section class="leader-suggested-units-section" style="margin-top:20px">
  <h2 class="tagged-units-title">suggested to me by my organization</h2>

  <div class="tagged-units-grid">
    {{#if leaderSuggestedUnits.length}}
      {{#each leaderSuggestedUnits}}
        {{#if (or (eq unitType "article") (eq unitType "video") (eq unitType "interview") (eq unitType "exercise") (eq unitType "template"))}}

          <div class="leader-assigned-unit-card leader-suggested-unit-card leader-dashboard-wave-card {{unitType}}-dashboard-card">
            <div class="leader-dashboard-wave-card-inner">

              <div class="leader-dashboard-wave-header">
                <img src="/icons/unitsvg.svg" alt="" aria-hidden="true" class="leader-dashboard-wave-image">
              </div>

              <div class="leader-dashboard-wave-content">
                <div class="tagged-unit-icon">
                  <img src="/icons/{{unitType}}.svg" alt="{{unitType}} icon">
                </div>

                <div class="tagged-unit-info">
                  <h3 class="tagged-unit-title">{{unitTitle}}</h3>

                  {{#if main_topic}}
                    <p class="tagged-unit-topic">{{main_topic}}</p>
                  {{/if}}

                  <p class="leader-assigned-to">
                    suggested by: {{suggestedByName}}
                    {{#if suggestedAtFormatted}}
                      <span class="muted">({{suggestedAtFormatted}})</span>
                    {{/if}}
                  </p>

                  {{#if note}}
                    <p class="leader-assigned-instructions">
                      <em>{{note}}</em>
                    </p>
                  {{/if}}
                </div>

                <div class="tagged-unit-actions" style="display:flex; flex-direction:column; align-items:center; gap:6px; margin-top:6px;">
                  {{#if viewPath}}
                    <a href="{{viewPath}}" class="tagged-unit-link">view unit</a>
                  {{else}}
                    <span class="tagged-unit-link muted">view unavailable</span>
                  {{/if}}

                  {{#if isAcknowledged}}
                    <span class="tagged-unit-link muted" aria-disabled="true">
                      seen{{#if acknowledgedAtFormatted}} <span class="muted">({{acknowledgedAtFormatted}})</span>{{/if}}
                    </span>
                  {{else}}
                    <button
                      class="tagged-unit-link js-thanks-btn"
                      type="button"
                      data-suggestion-id="{{_id}}">
                      thanks!
                    </button>

                    <div class="multi-record-item muted js-thanks-msg" style="display:none; text-align:center;">
                      your thanks have been sent to the admin!
                    </div>
                  {{/if}}

                  <button class="tagged-unit-link muted" type="button" disabled>
                    dismiss
                  </button>
                </div>
              </div>

            </div>
          </div>

        {{/if}}
      {{/each}}
    {{else}}
      <p class="tagged-no-units">
        Your organization hasn’t suggested any units yet.
      </p>
    {{/if}}
  </div>
</section>



<script>
  function getCsrfToken() {
    return document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
  }

  async function archiveUnit(tagId, unitId, unitType, assignedToMemberId = null) {
    if (!confirm("Move this item to archive?")) return;

    try {
      const res = await fetch('/archive', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': getCsrfToken()
        },
        body: JSON.stringify({
          tagId,
          unitId,
          unitType,
          assignedToMemberId
        })
      });

      const data = await res.json().catch(() => ({}));

      if (res.ok && data.ok) {
        location.reload();
      } else {
        alert(data.message || 'Could not archive this item.');
      }
    } catch (err) {
      console.error('archiveUnit error:', err);
      alert('An error occurred while archiving this item.');
    }
  }

  async function sendThanksForSuggestion(buttonEl) {
    const id = buttonEl?.dataset?.suggestionId;
    if (!id) return;

    const card =
      buttonEl.closest('.leader-suggested-unit-card') ||
      buttonEl.closest('.leader-assigned-unit-card');

    const msg = card ? card.querySelector('.js-thanks-msg') : null;

    const originalText = buttonEl.textContent;
    buttonEl.disabled = true;
    buttonEl.textContent = 'sending...';

    try {
      const csrf = getCsrfToken();

      if (!csrf) {
        buttonEl.disabled = false;
        buttonEl.textContent = originalText;
        alert('Missing CSRF token. Please refresh and try again.');
        return;
      }

      const res = await fetch(`/dashboard/leader/suggestions/${id}/thanks`, {
        method: 'POST',
        headers: { 'X-CSRF-Token': csrf }
      });

      const data = await res.json().catch(() => ({}));

      if (!res.ok || !data.ok) {
        buttonEl.disabled = false;
        buttonEl.textContent = originalText;
        alert(data.message || `Could not send thanks (HTTP ${res.status}).`);
        return;
      }

      const seenLabel = document.createElement('span');
      seenLabel.className = 'tagged-unit-link muted';
      seenLabel.setAttribute('aria-disabled', 'true');

      const dt = data.acknowledgedAtFormatted ? ` (${data.acknowledgedAtFormatted})` : '';
      seenLabel.textContent = `seen${dt}`;

      buttonEl.replaceWith(seenLabel);

      if (msg) {
        msg.style.display = 'block';
      }
    } catch (err) {
      console.error('sendThanksForSuggestion error:', err);
      buttonEl.disabled = false;
      buttonEl.textContent = originalText;
      alert('Could not send thanks. Please try again.');
    }
  }

  document.addEventListener('click', (e) => {
    const btn = e.target.closest('.js-thanks-btn');
    if (!btn) return;
    sendThanksForSuggestion(btn);
  });
</script>







