<!-- CSRF token for AJAX deletes -->
<meta name="csrf-token" content="{{csrfToken}}">

<section class="tagged-units-section">
  <h2 class="tagged-units-title">tagged library units</h2>
  <div class="tagged-units-grid">
    {{#each leaderSelfTaggedUnits}}
      <div class="tagged-unit-card">
        <div class="tagged-unit-icon">
          <img src="/icons/{{unitType}}.svg" alt="{{unitType}} icon">
        </div>

        <div class="tagged-unit-info">
          <h3 class="tagged-unit-title">{{title}}</h3>
          <p class="tagged-unit-topic">{{mainTopic}}</p>
          {{#if (eq unitType "upcoming")}}
            <p class="tagged-unit-status">🚧 coming soon</p>
          {{/if}}
        </div>

        <!-- Actions stacked vertically, reusing the "view" button style -->
        <div class="tagged-unit-actions" style="display:flex; flex-direction:column; align-items:center; gap:6px; margin-top:6px;">
          <a href="/unitviews/{{capitalize unitType}}s/view/{{_id}}" class="tagged-unit-link">view unit</a>

          <button
            class="tagged-unit-link"
            onclick="removeTagFromUnit('{{tagId}}','{{_id}}','{{unitType}}')">
            remove from this unit
          </button>

          <button
            class="tagged-unit-link"
            onclick="deleteTag('{{tagId}}')">
            delete tag
          </button>
        </div>
      </div>
    {{else}}
      <p class="tagged-no-units">You have no self-tagged units.</p>
    {{/each}}
  </div>
</section>

<section class="leader-assigned-units-section" style="margin-top:20px">
  <h2 class="tagged-units-title">assigned units</h2>
  <div class="tagged-units-grid">
    {{#each leaderAssignedUnits}}
      <div class="leader-assigned-unit-card">
        <div class="tagged-unit-icon">
          <img src="/icons/{{unitType}}.svg" alt="{{unitType}} icon">
        </div>

        <div class="tagged-unit-info">
          <h3 class="tagged-unit-title">{{title}}</h3>
          <p class="tagged-unit-topic">{{mainTopic}}</p>

          <p class="leader-assigned-to">assigned to: {{assignedTo.name}}</p>

          {{!-- 3-state status --}}
          {{#if (eq unitType "upcoming")}}
            <p class="leader-assigned-status">🚧 coming soon</p>
          {{else if assignedTo.completedAt}}
            <p class="leader-assigned-status">✅ completed <span class="muted">({{formatDate assignedTo.completedAt}})</span></p>
          {{else}}
            <p class="leader-assigned-status">⏳ pending</p>
          {{/if}}

          {{#if assignedTo.instructions}}
            <p class="leader-assigned-instructions"><em>{{assignedTo.instructions}}</em></p>
          {{/if}}
        </div>

        <!-- Actions stacked vertically, reusing the "view" button style -->
        <div class="tagged-unit-actions" style="display:flex; flex-direction:column; align-items:center; gap:6px; margin-top:6px;">
          <a href="/unitviews/{{capitalize unitType}}s/view/{{_id}}" class="tagged-unit-link">view unit</a>

          <!-- Unassign only this member (keep the tag) -->
          <button
            class="tagged-unit-link"
            onclick="unassignMember('{{tagId}}','{{assignedTo._id}}')">
            unassign
          </button>

          <!-- Delete entire tag (removes for all assignees + units) -->
          <button
            class="tagged-unit-link"
            onclick="deleteTag('{{tagId}}')">
            delete tag
          </button>
        </div>
      </div>
    {{else}}
      <p class="tagged-no-units">You have no assigned units.</p>
    {{/each}}
  </div>
</section>

<script>
  function getCsrfToken() {
    return document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
  }

  // Remove this tag from ONE unit (keeps the tag if it has other associations)
  async function removeTagFromUnit(tagId, unitId, unitType) {
    if (!confirm("Remove this tag from the unit?")) return;
    try {
      const res = await fetch(`/tags/remove/${tagId}/${unitId}/${unitType}`, {
        method: 'DELETE',
        headers: { 'X-CSRF-Token': getCsrfToken() }
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok) location.reload(); else alert(data.message || 'Failed to remove tag.');
    } catch (err) {
      console.error('removeTagFromUnit error:', err);
      alert('An error occurred while removing the tag.');
    }
  }

  // Unassign a single member from a tag (keeps the tag and other assignees)
  async function unassignMember(tagId, memberId) {
    if (!confirm("Unassign this member from the tag?")) return;
    try {
      const res = await fetch(`/tags/${tagId}/assigned/${memberId}`, {
        method: 'DELETE',
        headers: { 'X-CSRF-Token': getCsrfToken() }
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok) location.reload(); else alert(data.message || 'Could not unassign.');
    } catch (err) {
      console.error('unassignMember error:', err);
      alert('An error occurred while unassigning.');
    }
  }

  // Delete the entire tag (creator-only, enforced by controller)
  async function deleteTag(tagId) {
    if (!confirm("Delete this tag entirely? This removes it from all units and all assignees.")) return;
    try {
      const res = await fetch(`/tags/${tagId}`, {
        method: 'DELETE',
        headers: { 'X-CSRF-Token': getCsrfToken() }
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok) location.reload(); else alert(data.message || 'Failed to delete tag.');
    } catch (err) {
      console.error('deleteTag error:', err);
      alert('An error occurred while deleting the tag.');
    }
  }
</script>








