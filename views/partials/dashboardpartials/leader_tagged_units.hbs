{{!-- =========================
     3) ASSIGNED NUGGETS (GROUPED BY NUGGET)
     expects: leaderAssignedNuggetsGrouped = [
       {
         _id, title, client, region, discipline,
         assignments: [
           { tagId, assignedToId, assignedToName, assignedCompletedAtFormatted, assignedInstructions }
         ]
       }
     ]
     ========================= --}}

<section class="leader-assigned-nuggets-section" style="margin-top:20px">
  <h2 class="tagged-units-title">nuggets I've assigned to my group</h2>

  <div class="tagged-units-grid">
    {{#if leaderAssignedNuggetsGrouped.length}}

      {{#each leaderAssignedNuggetsGrouped}}
        <div class="leader-assigned-unit-card leader-nugget-card">
          <div class="leader-nugget-card-inner">

            <!-- Header wave -->
            <div class="leader-nugget-card-svg-header">
              <img
                src="/icons/goldsvg.svg"
                alt=""
                aria-hidden="true"
                class="leader-nugget-card-svg-image"
              >
            </div>

            <!-- Card content -->
            <div class="leader-nugget-card-content">

              <div class="tagged-unit-icon">
                <img src="/icons/nuggeticon.svg" alt="nugget icon" style="width: 80px; height: auto">
              </div>

              <div class="tagged-unit-info">
                <h3 class="tagged-unit-title">{{this.title}}</h3>
                {{#if this.client}}<p class="tagged-unit-topic">client: {{this.client}}</p>{{/if}}
                {{#if this.region}}<p class="tagged-unit-topic">region: {{this.region}}</p>{{/if}}
                {{#if this.discipline}}<p class="tagged-unit-topic">discipline: {{this.discipline}}</p>{{/if}}

                {{!-- Assignments list --}}
                <div class="leader-assigned-list leader-nugget-assigned-list">
                  {{#if this.assignments.length}}

{{#each this.assignments}}
  <div class="leader-assigned-row leader-nugget-assigned-row">

    <!-- TOP DIVIDER -->
    <div class="leader-nugget-divider"></div>

    <div class="leader-assigned-row-left">
      <p class="leader-assigned-to">assigned to: {{this.assignedToName}}</p>

      {{#if this.assignedCompletedAtFormatted}}
        <p class="leader-assigned-status">✅ closed <span class="muted">({{this.assignedCompletedAtFormatted}})</span></p>
      {{else}}
        <p class="leader-assigned-status">⏳ monitoring</p>
      {{/if}}

      {{#if this.assignedInstructions}}
        <p class="leader-assigned-instructions"><em>{{this.assignedInstructions}}</em></p>
      {{/if}}
    </div>

    <div class="leader-assigned-row-actions leader-nugget-row-actions">
      <button
        type="button"
        class="tagged-unit-link"
        onclick="unassignAssignedNugget('{{this.tagId}}','{{this.assignedToId}}')"
      >
        move to archive
      </button>
    </div>

    <!-- BOTTOM DIVIDER -->
    <div class="leader-nugget-divider"></div>

  </div>
{{/each}}

                  {{else}}
                    <p class="tagged-no-units">No members are currently assigned this nugget.</p>
                  {{/if}}
                </div>
              </div>

              <div class="tagged-unit-actions leader-nugget-actions">
                <a href="/unitviews/nuggets/view/{{this._id}}" class="tagged-unit-link">view nugget</a>
              </div>

            </div>
          </div>
        </div>
      {{/each}}

    {{else}}
      <p class="tagged-no-units">You have no assigned nuggets.</p>
    {{/if}}
  </div>
</section>





<div class="tagged-section-divider" aria-hidden="true"></div>

{{!-- =========================
     4) ORG-SUGGESTED UNITS (ADMIN → LEADER)
     expects: leaderSuggestedUnits = [{
       _id,
       unitType,
       unitTitle,
       main_topic,
       note,
       suggestedByName,
       suggestedAtFormatted,
       viewPath,
       isAcknowledged,
       acknowledgedAtFormatted
     }]
     ========================= --}}
<section class="leader-suggested-units-section" style="margin-top:20px">
  <h2 class="tagged-units-title">suggested to me by my organization</h2>

  <div class="tagged-units-grid">
    {{#if leaderSuggestedUnits.length}}
      {{#each leaderSuggestedUnits}}

        {{!-- Skip missions (handled in mission tab) --}}
        {{#unless (eq unitType "mission")}}

        <div class="leader-assigned-unit-card leader-suggested-unit-card leader-dashboard-wave-card {{unitType}}-dashboard-card">
          <div class="leader-dashboard-wave-card-inner">

            <!-- Dynamic wave -->
            <div class="leader-dashboard-wave-header">
              <img
                src="
                  {{#if (eq unitType 'nugget')}}
                    /icons/goldsvg.svg
                  {{else}}
                    /icons/unitsvg.svg
                  {{/if}}
                "
                alt=""
                aria-hidden="true"
                class="leader-dashboard-wave-image"
              >
            </div>

            <div class="leader-dashboard-wave-content">

              <div class="tagged-unit-icon">
                <img src="/icons/{{unitType}}.svg" alt="{{unitType}} icon">
              </div>

              <div class="tagged-unit-info">
                <h3 class="tagged-unit-title">{{unitTitle}}</h3>

                {{#if main_topic}}
                  <p class="tagged-unit-topic">{{main_topic}}</p>
                {{/if}}

                <p class="leader-assigned-to">
                  suggested by: {{suggestedByName}}
                  {{#if suggestedAtFormatted}}
                    <span class="muted">({{suggestedAtFormatted}})</span>
                  {{/if}}
                </p>

                {{#if note}}
                  <p class="leader-assigned-instructions">
                    <em>{{note}}</em>
                  </p>
                {{/if}}
              </div>

              <div class="tagged-unit-actions" style="display:flex; flex-direction:column; align-items:center; gap:6px; margin-top:6px;">

                {{#if viewPath}}
                  <a href="{{viewPath}}" class="tagged-unit-link">view unit</a>
                {{else}}
                  <span class="tagged-unit-link muted">view unavailable</span>
                {{/if}}

                {{#if isAcknowledged}}
                  <span class="tagged-unit-link muted" aria-disabled="true">
                    seen{{#if acknowledgedAtFormatted}} <span class="muted">({{acknowledgedAtFormatted}})</span>{{/if}}
                  </span>
                {{else}}
                  <button
                    class="tagged-unit-link js-thanks-btn"
                    type="button"
                    data-suggestion-id="{{_id}}">
                    thanks!
                  </button>

                  <div class="multi-record-item muted js-thanks-msg" style="display:none; text-align:center;">
                    your thanks have been sent to the admin!
                  </div>
                {{/if}}

                <button class="tagged-unit-link muted" type="button" disabled>
                  dismiss
                </button>

              </div>
            </div>

          </div>
        </div>

        {{/unless}}

      {{/each}}
    {{else}}
      <p class="tagged-no-units">
        Your organization hasn’t suggested any units yet.
      </p>
    {{/if}}
  </div>
</section>



<script>
  function getCsrfToken() {
    return document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
  }

  async function removeTagFromUnit(tagId, unitId, unitType) {
    if (!confirm("Remove this tag from the unit?")) return;
    try {
      const res = await fetch(`/tags/remove/${tagId}/${unitId}/${unitType}`, {
        method: 'DELETE',
        headers: { 'X-CSRF-Token': getCsrfToken() }
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok) location.reload(); else alert(data.message || 'Failed to remove tag.');
    } catch (err) {
      console.error('removeTagFromUnit error:', err);
      alert('An error occurred while removing the tag.');
    }
  }

  async function unassignMember(tagId, memberId) {
    if (!confirm("Unassign this member from the tag?")) return;
    try {
      const res = await fetch(`/tags/${tagId}/assigned/${memberId}`, {
        method: 'DELETE',
        headers: { 'X-CSRF-Token': getCsrfToken() }
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok) location.reload(); else alert(data.message || 'Could not unassign.');
    } catch (err) {
      console.error('unassignMember error:', err);
      alert('An error occurred while unassigning.');
    }
  }

  async function deleteTag(tagId) {
    if (!confirm("Delete this tag entirely? This removes it from all units and all assignees.")) return;
    try {
      const res = await fetch(`/tags/${tagId}`, {
        method: 'DELETE',
        headers: { 'X-CSRF-Token': getCsrfToken() }
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok) location.reload(); else alert(data.message || 'Failed to delete tag.');
    } catch (err) {
      console.error('deleteTag error:', err);
      alert('An error occurred while deleting the tag.');
    }
  }

async function sendThanksForSuggestion(buttonEl) {
  const id = buttonEl?.dataset?.suggestionId;
  if (!id) return;

  // Find the card + success message early (before DOM changes)
  const card =
    buttonEl.closest('.leader-suggested-unit-card') ||
    buttonEl.closest('.leader-assigned-unit-card');

  const msg = card ? card.querySelector('.js-thanks-msg') : null;

  // UI: disable + show sending state
  const originalText = buttonEl.textContent;
  buttonEl.disabled = true;
  buttonEl.textContent = 'sending...';

  try {
    const csrf = getCsrfToken();
    if (!csrf) {
      buttonEl.disabled = false;
      buttonEl.textContent = originalText;
      alert('Missing CSRF token. Please refresh and try again.');
      return;
    }

    const res = await fetch(`/dashboard/leader/suggestions/${id}/thanks`, {
      method: 'POST',
      headers: { 'X-CSRF-Token': csrf }
    });

    const data = await res.json().catch(() => ({}));

    if (!res.ok || !data.ok) {
      buttonEl.disabled = false;
      buttonEl.textContent = originalText;
      alert(data.message || `Could not send thanks (HTTP ${res.status}).`);
      return;
    }

    // Build the "seen" label to replace the button
    const seenLabel = document.createElement('span');
    seenLabel.className = 'tagged-unit-link muted';
    seenLabel.setAttribute('aria-disabled', 'true');

    const dt = data.acknowledgedAtFormatted ? ` (${data.acknowledgedAtFormatted})` : '';
    seenLabel.textContent = `seen${dt}`;

    // Replace button with the label
    buttonEl.replaceWith(seenLabel);

    // Show the success message on the card (if present)
    if (msg) {
      msg.style.display = 'block';
    }
  } catch (err) {
    console.error('sendThanksForSuggestion error:', err);
    buttonEl.disabled = false;
    buttonEl.textContent = originalText;
    alert('Could not send thanks. Please try again.');
  }
}


// event delegation: works even if cards render dynamically
document.addEventListener('click', (e) => {
  const btn = e.target.closest('.js-thanks-btn');
  if (!btn) return;
  sendThanksForSuggestion(btn);
});

</script>









