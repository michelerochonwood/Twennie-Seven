<h2>organization join requests ({{orgSnapshot.counts.pendingJoinRequests}})</h2>

{{#if orgSnapshot.pendingJoinRequestsList.length}}
  {{#each orgSnapshot.pendingJoinRequestsList}}
    <div class="admin-request-card">
      <div>
        <strong>{{this.leader.groupLeaderName}}</strong>
        <div class="muted">{{this.leader.groupLeaderEmail}}</div>
      </div>

      <div class="admin-request-actions" style="display:flex; gap:0.75rem; flex-wrap:wrap; align-items:center; margin-top:0.75rem;">
        {{!-- APPROVE --}}
        <form method="POST" action="/dashboard/leader/org-admin/join-requests/{{this._id}}/approve" style="display:flex; gap:0.5rem; align-items:center;">
          {{#if ../csrfToken}}<input type="hidden" name="_csrf" value="{{../csrfToken}}">{{/if}}
          <input
            type="text"
            name="note"
            placeholder="note (optional)"
            style="min-width:220px;"
          >
          <button type="submit">approve</button>
        </form>

        {{!-- REJECT --}}
        <form method="POST" action="/dashboard/leader/org-admin/join-requests/{{this._id}}/reject" style="display:flex; gap:0.5rem; align-items:center;">
          {{#if ../csrfToken}}<input type="hidden" name="_csrf" value="{{../csrfToken}}">{{/if}}
          <input
            type="text"
            name="note"
            placeholder="note (optional)"
            style="min-width:220px;"
          >
          <button type="submit" class="danger">reject</button>
        </form>
      </div>
    </div>
  {{/each}}
{{else}}
  <p class="muted">no pending requests</p>
{{/if}}
