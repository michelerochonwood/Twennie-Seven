<h2 class="orgadmin-title">
  organization join requests ({{orgSnapshot.counts.pendingJoinRequests}})
</h2>

{{#if orgSnapshot.pendingJoinRequestsList.length}}
  <div class="orgadmin-gl-grid">
    {{#each orgSnapshot.pendingJoinRequestsList}}
      <div class="orgadmin-gl-card admin-request-card">

        {{!-- Leader identity --}}
        <div class="orgadmin-gl-info">
          <h3 class="orgadmin-gl-groupname">
            {{this.leader.groupLeaderName}}
          </h3>
          <p class="orgadmin-gl-meta muted">
            {{this.leader.groupLeaderEmail}}
          </p>
        </div>

        {{!-- Actions --}}
        <div class="orgadmin-gl-actions admin-request-actions">

          {{!-- APPROVE --}}
          <form
            method="POST"
            action="/dashboard/leader/org-admin/join-requests/{{this._id}}/approve"
            class="admin-request-form"
          >
            {{#if ../csrfToken}}
              <input type="hidden" name="_csrf" value="{{../csrfToken}}">
            {{/if}}

            <input
              type="text"
              name="note"
              placeholder="approval note (optional)"
              class="admin-request-note"
            >

            <button
              type="submit"
              class="orgadmin-gl-btn orgadmin-gl-btn--primary"
            >
              approve
            </button>
          </form>

          {{!-- REJECT --}}
          <form
            method="POST"
            action="/dashboard/leader/org-admin/join-requests/{{this._id}}/reject"
            class="admin-request-form"
          >
            {{#if ../csrfToken}}
              <input type="hidden" name="_csrf" value="{{../csrfToken}}">
            {{/if}}

            <input
              type="text"
              name="note"
              placeholder="rejection note (optional)"
              class="admin-request-note"
            >

            <button
              type="submit"
              class="orgadmin-gl-btn orgadmin-gl-btn--danger"
            >
              reject
            </button>
          </form>

        </div>
      </div>
    {{/each}}
  </div>
{{else}}
  <p class="muted" style="text-align:center;">
    no pending requests
  </p>
{{/if}}

