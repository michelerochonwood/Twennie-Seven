{{!-- groupmember_prompt_tab.hbs --}}

<div class="dashboard-explanation-block">
  <h3 class="dashboard-explanation-title">how this tab works</h3>
  <p class="dashboard-explanation-text">
    In this tab you will complete prompts. You can have up to three prompt sets in progress. Each prompt set contains 20 prompts. 
    Read the prompt, record your notes, and click <strong>submit this prompt</strong>.
    When you return to the dashboard, the next prompt in the set will show in this tab. When you've completed all 20 prompts in the set, you earn the prompt set's badge. 
  </p>
</div>

<div class="groupmember-prompt-tab" id="groupmemberPromptTab" data-member-id="{{@root.user.id}}">
  {{#if promptSets}}
    {{#each promptSets}}
      {{> _gm_prompt_card promptSet=this csrfToken=@root.csrfToken}}
    {{/each}}
  {{else if promptSet}}
    {{> _gm_prompt_card promptSet=promptSet csrfToken=@root.csrfToken}}
  {{else}}
    <h2 class="leader-assigned-title">
      You have no prompt sets in progress at the moment.
    </h2>

    <div class="leader-prompt-container leader-prompt-empty-state">
      <img
        src="/images/blueyplaying.png"
        alt="Bluey encouraging prompt set progress"
        class="leader-prompt-empty-image"
      >

      <p class="leader-prompt-empty-message">
        <b>We have some fun prompt sets you might enjoy for stress relief and better mental health.</b>
      </p>

      <p class="leader-prompt-empty-message">
        Go to the
        <a href="/bytopic/thepowerofplayintheworkplace" class="leader-prompt-empty-link">
          The Power of Play in the Workplace
        </a>
        topic!
      </p>
    </div>
  {{/if}}
</div>

{{#*inline "_gm_prompt_card"}}
  {{#with promptSet as |ps|}}
  <div class="leader-prompt-container" data-psid="{{ps.promptSetId}}" data-regid="{{ps.registrationId}}">
    <h2 class="leader-prompt-title">{{ps.frequency}} prompt</h2>

    <p class="leader-prompt-set-title">
      <strong>{{ps.promptSetTitle}}</strong> - {{ps.mainTopic}}
    </p>

    <p class="leader-prompt-purpose">
      <strong>Purpose of this prompt set:</strong> {{ps.purpose}}
    </p>

    {{#if (or ../promptSchedule ps.promptSchedule)}}
      <p class="leader-prompt-schedule">
        To stay on schedule, Twennie recommends completing this prompt by:
      </p>
      <p class="leader-prompt-schedule-date">
        {{#if ../promptSchedule}}{{../promptSchedule.recommendedCompletionDate}}{{else}}{{ps.promptSchedule.recommendedCompletionDate}}{{/if}}
      </p>
    {{/if}}

    {{#if ps.leaderNotes}}
      <div class="leader-leader-notes">
        <h4 class="leader-leader-notes-title">instructions from {{ps.leaderName}}:</h4>
        <p class="leader-leader-notes-text">{{ps.leaderNotes}}</p>
      </div>
    {{/if}}

    <div class="leader-prompt-card">
      <div class="leader-prompt-border">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1224.99 153.32">
          <defs><style>.cls-777 {fill: #4e50a2;}</style></defs>
          <g>
            <path class="cls-777" d="M149.91,136.71c-.06,0-.11,0-.17,0,.06,0,.11,0,.17,0Z"/>
            <path class="cls-777" d="M109.06,90.03h-49.65c28.73-7.2,48.89-24.04,48.89-43.65C108.29,20.2,72.54.92,28.27.92,21,.92,14.68.28,7.69.28L.3,0h-.3l.64,149.68c31-6.8,68.57-11.39,108.41-14.03v-45.62Z"/>
            <path class="cls-777" d="M1224.99,0L215,4.7c-68.86-.52-105.94,30.88-105.94,62.55,0,28.27,50.59,67.87,183.53,72.77h0c83.12,1.86,260.56-21.97,326.9-30.26,300.52-37.57,604.74,43.55,604.74,43.55l.76-153.32Z"/>
          </g>
        </svg>
      </div>

      <p class="leader-prompt-headline">{{ps.promptHeadline}}</p>
      <p class="leader-prompt-text">{{ps.promptText}}</p>
    </div>

    {{#if ps.promptIndex}}
      <form action="/promptsetnotes/submit-prompt-notes" method="POST">
        <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
        <input type="hidden" name="promptSetId" value="{{ps.promptSetId}}">

        <label for="notes-{{ps.promptSetId}}" class="leader-prompt-notes-label">Record your notes here:</label>
        <textarea
          name="notes"
          id="notes-{{ps.promptSetId}}"
          class="leader-prompt-notes"
          placeholder="Write your notes here..."
          required></textarea>

        {{#if (eq ps.promptIndex 20)}}
          <p class="final-prompt-message">
            <strong>Final Prompt!</strong> This is the last prompt in the set. Add your final thoughts about what you learned.
          </p>
        {{/if}}

        <button type="submit" class="leader-prompt-submit">submit this prompt</button>
      </form>
    {{else}}
      <form action="/promptsetstart/start" method="POST">
        <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
        <input type="hidden" name="promptSetId" value="{{ps.promptSetId}}">
        <button type="submit" class="leader-prompt-submit">get started completing prompts</button>
      </form>
    {{/if}}

    <button type="button" class="leader-unregister-btn" data-id="{{ps.registrationId}}">
      unregister for this prompt set
    </button>
  </div>
  {{/with}}
{{/inline}}

<script>
(function () {
  var root = document.getElementById('groupmemberPromptTab');
  if (!root) return;

  var seen = Object.create(null);
  var cards = root.querySelectorAll('.leader-prompt-container[data-psid]');

  for (var i = 0; i < cards.length; i++) {
    var card = cards[i];
    var key = card.getAttribute('data-psid') || '';
    if (!key) continue;

    if (seen[key]) {
      card.parentNode && card.parentNode.removeChild(card);
    } else {
      seen[key] = true;
    }
  }
})();
</script>