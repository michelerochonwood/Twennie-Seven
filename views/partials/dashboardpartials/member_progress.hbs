<meta name="csrf-token" content="{{csrfToken}}">

<div class="member-progress-container" style="overflow: hidden; padding-bottom: 2rem;">

  <style>
    .member-progress-completed-card-link {
      display: block;
      text-decoration: none;
      color: inherit;
    }

    .member-progress-completed-card-link:hover,
    .member-progress-completed-card-link:focus,
    .member-progress-completed-card-link:active,
    .member-progress-completed-card-link:visited {
      text-decoration: none;
      color: inherit;
    }
  </style>

  {{#if (eq @root.member.accessLevel "free_individual")}}
    <p style="text-align: center; margin: 2rem 0; font-style: italic; color: #4e50a2;">
      To register for prompts, you must upgrade your membership.
    </p>
  {{else}}

    {{#if currentPromptSets.length}}
      <h2 class="member-progress-current-title">current prompt sets</h2>

      <div class="member-progress-current">
        {{#each currentPromptSets}}
          <div class="member-progress-grid">
            <h2 class="member-progress-title">{{this.promptSetTitle}}</h2>

            <img
              src="/promptprogress/promptprogress{{increment @index}}-{{this.promptIndex}}.svg"
              alt="Progress Pie Chart"
              class="member-progress-svg"
              data-progress="{{this.promptIndex}}"
            >

            <p class="member-progress-target">
              you have completed {{this.promptIndex}} prompts in this set
            </p>
          </div>
        {{/each}}
      </div>
    {{/if}}

    <div class="tagged-section-divider" aria-hidden="true"></div>

    <div class="member-progress-completed">
      <h2 class="member-progress-completed-title">completed prompt sets</h2>

      {{#if completedPromptSets.length}}
        <div class="member-progress-completed-grid" style="overflow: hidden;">
          {{#each completedPromptSets}}
            <div class="member-progress-completed-card" style="padding: 1rem; min-height: auto;">
              <a
                href="/reports/mycompletedpromptsets-individual#promptset-{{this.promptSetId}}"
                class="member-progress-completed-card-link"
              >
                <h3 class="member-progress-completed-title">{{this.promptSetTitle}}</h3>

                {{#if this.mainTopic}}
                  <p class="member-progress-completed-main-topic">{{this.mainTopic}}</p>
                {{/if}}

                {{#if this.completedAt}}
                  <p class="member-progress-completed-date">
                    completed: {{this.completedAt}}
                  </p>
                {{/if}}

                <div class="member-progress-badge" style="text-align: center; margin-top: 1rem;">
                  {{#if this.badge}}
                    <img
                      src="{{this.badge.image}}"
                      alt="{{this.badge.name}}"
                      class="member-progress-badge-img"
                      style="max-width: 80px; height: auto;"
                    >
                    <p class="member-progress-badge-name">{{this.badge.name}}</p>
                  {{else}}
                    <p class="member-progress-badge-name">No badge earned</p>
                  {{/if}}
                </div>
              </a>

              {{#if this.promptSetId}}
                <div class="leader-archive-button-wrap">
                  <button
                    type="button"
                    class="leader-archive-button"
                    onclick="archiveCompletedPromptSet('{{this.promptSetId}}','{{this.completionId}}')"
                  >
                    move to archive
                  </button>
                </div>
              {{/if}}
            </div>
          {{/each}}
        </div>
      {{else}}
        <p class="no-data" style="text-align: center; margin-top: 1rem;">
          You haven’t completed any prompt sets yet.
        </p>
      {{/if}}
    </div>

    <div class="tagged-section-divider" aria-hidden="true"></div>

    <div class="member-report-actions">

      <div class="member-report-card">
        <a href="/reports/mylearningnotes-individual" class="member-report-link">
          <img
            src="/images/libraryunitsreport.png"
            alt="View my learning notes"
            class="member-report-image"
          >
        </a>

        <p class="member-report-description">
          This library unit report shows you all the notes you've kept on your completed library units.
        </p>
      </div>

      <div class="member-report-card">
        <a href="/archive/member" class="member-report-link">
          <img
            src="/images/learningarchivebutton.png"
            alt="View learning archive"
            class="member-report-image"
          >
        </a>

        <p class="member-report-description">
          The learning archive contains units you've archived. These may or may not have been completed.
        </p>
      </div>

    </div>

  {{/if}}

  <div style="height: 1px; clear: both;"></div>
</div>

<script>
  function getCsrfMember() {
    return document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
  }

  async function archiveCompletedPromptSet(promptSetId, completionId = null) {
    if (!promptSetId) return;
    if (!confirm('Move this completed prompt set to archive?')) return;

    try {
      const res = await fetch('/archive/completed-promptset', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': getCsrfMember()
        },
        body: JSON.stringify({
          promptSetId,
          completionId
        })
      });

      const data = await res.json().catch(() => ({}));

      if (res.ok && data.ok) {
        location.reload();
      } else {
        alert(data.message || 'Could not archive this prompt set.');
      }
    } catch (e) {
      console.error('archiveCompletedPromptSet error', e);
      alert('An error occurred while archiving this prompt set.');
    }
  }
</script>