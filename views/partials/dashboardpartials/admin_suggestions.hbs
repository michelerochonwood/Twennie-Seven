<section class="leader-admin-section" style="margin-top:20px">
  <h2 class="tagged-units-title">my suggestions</h2>

  <div class="tagged-units-grid">
    {{#if mySuggestions.length}}
      {{#each mySuggestions}}
        <div class="leader-assigned-unit-card leader-suggested-unit-card">
          <div class="tagged-unit-icon">
            <img src="/icons/{{unitType}}.svg" alt="{{unitType}} icon">
          </div>

          <div class="tagged-unit-info">
            <h3 class="tagged-unit-title">{{unitTitle}}</h3>

            {{#if main_topic}}
              <p class="tagged-unit-topic">{{main_topic}}</p>
            {{/if}}

            <p class="leader-assigned-to">
              status: {{status}}
              {{#if suggestedAtFormatted}}
                <span class="muted">({{suggestedAtFormatted}})</span>
              {{/if}}
            </p>

            {{#if note}}
              <p class="leader-assigned-instructions">
                <em>{{note}}</em>
              </p>
            {{/if}}
          </div>

          <div class="tagged-unit-actions" style="display:flex; flex-direction:column; align-items:center; gap:6px; margin-top:6px;">
            <a href="{{viewPath}}" class="tagged-unit-link">view unit</a>

            {{!-- Later: add "withdraw suggestion" etc --}}
            <button class="tagged-unit-link muted" disabled>
              withdraw
            </button>
          </div>
        </div>
      {{/each}}
    {{else}}
      <p class="tagged-no-units">You haven’t suggested any units yet.</p>
    {{/if}}
  </div>
</section>
