{{!--
  Expects (passed by the dashboard view):
    registeredPromptSets : Array  (leader’s own)
    assignedPromptCards  : Array  (one-per-assignment-per-member)
    csrfToken            : String
--}}

{{!-- ========== Registered prompt sets (unchanged UI) ========== --}}
{{#if registeredPromptSets.length}}
  {{#each registeredPromptSets}}
    <section class="leader-prompt-section">
      {{!-- Reuse the original registered partial exactly as before --}}
      {{> dashboardpartials/leader_prompt promptSet=this csrfToken=../csrfToken }}
    </section>
  {{/each}}
{{else}}
  <p class="leader-assigned-empty" style="text-align:center;margin:6px 0 14px;">
    You haven’t registered for any prompt sets yet.
  </p>
{{/if}}

{{!-- Divider only if there are assigned items --}}
{{#if assignedPromptCards.length}}
  <hr class="leader-prompts-divider">
{{/if}}

{{!-- ========== Assigned prompt sets (one card per assignment) ========== --}}
{{#if assignedPromptCards.length}}
  <section class="leader-prompt-section">
    <h2 class="leader-assigned-title">assigned prompt sets</h2>
    <p class="leader-assigned-subtitle">Each card is one member’s assignment.</p>

    <div class="leader-assigned-grid">
      {{#each assignedPromptCards}}
        <div class="leader-assigned-card">
          <div class="leader-assigned-card-top">
            <span class="leader-assigned-status leader-assigned-status--{{status}}">{{statusLabel}}</span>
            <span class="leader-assigned-due">due {{targetCompletionDate}}</span>
          </div>

          <h3 class="leader-assigned-ps-title">{{promptSetTitle}}</h3>
          <p class="leader-assigned-meta">
            <span class="leader-assigned-pill">{{frequency}} prompt</span>
            <span class="leader-assigned-sep">•</span>
            <span class="leader-assigned-topic">{{mainTopic}}</span>
          </p>

          <div class="leader-assigned-member">
            <img src="{{#if memberImage}}{{memberImage}}{{else}}/images/default-avatar.png{{/if}}"
                 alt="{{memberName}}" class="leader-assigned-avatar">
            <div class="leader-assigned-member-info">
              <p class="leader-assigned-member-name">{{memberName}}</p>
              <div class="leader-assigned-progress-wrap">
                <div class="leader-progress-bar">
                  <div class="leader-progress-bar-fill" style="width: {{progressPercent}}%;"></div>
                </div>
                <p class="leader-assigned-progress-text">
                  {{progressPercent}}% • prompt {{currentPromptIndex}}/20
                </p>
              </div>
            </div>
          </div>

          {{#if leaderNotes}}
            <p class="leader-assigned-notes"><span>notes:</span> {{leaderNotes}}</p>
          {{/if}}

          <div class="leader-assigned-actions">
            <form action="/promptsetassign/unassign/{{assignmentId}}" method="POST" class="leader-unassign-form" onsubmit="return confirm('Unassign this prompt set from {{memberName}}?');">
              <input type="hidden" name="_csrf" value="{{../csrfToken}}">
              <input type="hidden" name="_method" value="DELETE">
              <button type="submit" class="leader-assigned-unassign">unassign</button>
            </form>

            <a href="/members/{{memberId}}/prompts/{{promptSetId}}" class="leader-assigned-view">open progress</a>
          </div>
        </div>
      {{/each}}
    </div>
  </section>
{{/if}}





