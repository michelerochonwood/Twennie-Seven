<div class="grand-poobaa-page">

  {{!-- =====================================================
       PAGE HEADING
  ====================================================== --}}
  <section class="grand-poobaa-page-heading">

    <div class="grand-poobaa-page-heading-copy">
      <p class="grand-poobaa-eyebrow">
        Twennie administration
      </p>

      <h1>grand poobaa dashboard</h1>

      <p class="grand-poobaa-page-intro">
        Review items requiring attention and manage activity across Twennie.
      </p>
    </div>

    <div class="grand-poobaa-heading-date">
      <span>today</span>

      <strong>
        {{#if currentDate}}
          {{currentDate}}
        {{else}}
          —
        {{/if}}
      </strong>
    </div>

  </section>


  {{!-- =====================================================
       SUMMARY METRICS
  ====================================================== --}}
  <section
    class="grand-poobaa-summary-grid"
    aria-label="Platform summary"
  >

    <article class="grand-poobaa-summary-card">
      <span class="grand-poobaa-summary-label">
        requires attention
      </span>

      <strong class="grand-poobaa-summary-number">
        {{#if totalActionItems}}
          {{totalActionItems}}
        {{else}}
          0
        {{/if}}
      </strong>
    </article>


    <article class="grand-poobaa-summary-card">
      <span class="grand-poobaa-summary-label">
        new today
      </span>

      <strong class="grand-poobaa-summary-number">
        {{#if newToday}}
          {{newToday}}
        {{else}}
          0
        {{/if}}
      </strong>
    </article>


    <article class="grand-poobaa-summary-card">
      <span class="grand-poobaa-summary-label">
        members
      </span>

      <strong class="grand-poobaa-summary-number">
        {{#if totalMembers}}
          {{totalMembers}}
        {{else}}
          0
        {{/if}}
      </strong>
    </article>


    <article class="grand-poobaa-summary-card">
      <span class="grand-poobaa-summary-label">
        organizations
      </span>

      <strong class="grand-poobaa-summary-number">
        {{#if totalOrganizations}}
          {{totalOrganizations}}
        {{else}}
          0
        {{/if}}
      </strong>
    </article>

  </section>


  {{!-- =====================================================
       ACTION CENTRE
  ====================================================== --}}
  <section class="grand-poobaa-section grand-poobaa-action-section">

    <div class="grand-poobaa-section-heading">

      <div>
        <p class="grand-poobaa-section-kicker">
          action centre
        </p>

        <h2>items requiring attention</h2>
      </div>

      <p>
        Open an action card to review the related requests, submissions,
        or administrative tasks directly beneath it.
      </p>

    </div>


    <div class="grand-poobaa-action-grid">


      {{!-- =================================================
           TOPIC SUGGESTIONS MODULE
           This is the first fully developed action module.
      ================================================== --}}
      <div
        class="grand-poobaa-action-module"
        data-grand-poobaa-module
      >

        <button
          type="button"
          class="grand-poobaa-action-card grand-poobaa-dropdown-trigger"
          id="topic-suggestions-trigger"
          data-dropdown-trigger="topic-suggestions-panel"
          aria-expanded="false"
          aria-controls="topic-suggestions-panel"
        >

          <div class="grand-poobaa-action-card-top">

            <div class="grand-poobaa-action-icon">
              <ion-icon name="bulb-outline"></ion-icon>
            </div>

            <span class="grand-poobaa-action-count">
              {{#if topicSuggestionCount}}
                {{topicSuggestionCount}}
              {{else}}
                0
              {{/if}}
            </span>

          </div>


          <div class="grand-poobaa-action-card-copy">

            <h3>new topic suggestions</h3>

            <p>
              Review learning topics suggested by Twennie members.
            </p>

          </div>


          <span class="grand-poobaa-action-link">

            <span>review suggestions</span>

            <ion-icon
              class="grand-poobaa-dropdown-arrow"
              name="chevron-down-outline"
            ></ion-icon>

          </span>

        </button>


        <div
          class="grand-poobaa-dropdown-panel"
          id="topic-suggestions-panel"
          data-dropdown-panel
          aria-labelledby="topic-suggestions-trigger"
          hidden
        >

          <div class="grand-poobaa-dropdown-heading">

            <div class="grand-poobaa-dropdown-heading-copy">

              <p class="grand-poobaa-dropdown-kicker">
                content requests
              </p>

              <h3>new topic suggestions</h3>

              <p>
                Review suggestions submitted by members and approve topics
                for future development.
              </p>

            </div>


            <button
              type="button"
              class="grand-poobaa-dropdown-close"
              data-close-dropdown="topic-suggestions-panel"
              aria-label="Close topic suggestions"
            >
              <ion-icon name="close-outline"></ion-icon>
            </button>

          </div>


          {{#if topicSuggestions}}

            <div class="grand-poobaa-table-scroll">

              <table class="grand-poobaa-table">

                <thead>
                  <tr>
                    <th scope="col">suggested topic</th>
                    <th scope="col">description</th>
                    <th scope="col">submitted by</th>
                    <th scope="col">member details</th>
                    <th scope="col">submitted</th>
                    <th scope="col">approval</th>
                  </tr>
                </thead>


                <tbody>

                  {{#each topicSuggestions}}

                    <tr>

                      <td class="grand-poobaa-table-topic">
                        <strong>
                          {{this.topicTitle}}
                        </strong>
                      </td>


                      <td class="grand-poobaa-table-description">
                        <p>
                          {{this.description}}
                        </p>
                      </td>


                      <td>

                        <div class="grand-poobaa-table-person">

                          <strong>
                            {{this.name}}
                          </strong>

                          {{#if this.email}}
                            <a href="mailto:{{this.email}}">
                              {{this.email}}
                            </a>
                          {{else}}
                            <span class="grand-poobaa-table-missing">
                              no email provided
                            </span>
                          {{/if}}

                        </div>

                      </td>


                      <td>

                        <div class="grand-poobaa-table-meta">

                          <span>
                            {{#if this.memberType}}
                              {{this.memberType}}
                            {{else}}
                              member
                            {{/if}}
                          </span>

                          {{#if this.groupName}}
                            <small>
                              {{this.groupName}}
                            </small>
                          {{else}}
                            <small>
                              no group
                            </small>
                          {{/if}}

                        </div>

                      </td>


                      <td>

                        {{#if this.submittedAt}}
                          <time datetime="{{this.submittedAt}}">
                            {{this.submittedAt}}
                          </time>
                        {{else}}
                          <span class="grand-poobaa-table-missing">
                            not available
                          </span>
                        {{/if}}

                      </td>


                      <td class="grand-poobaa-table-action">

                        <form
                          action="/grand-poobaa/topic-suggestions/{{this._id}}/approve"
                          method="POST"
                          class="grand-poobaa-approval-form"
                        >

                          {{#if ../csrfToken}}
                            <input
                              type="hidden"
                              name="_csrf"
                              value="{{../csrfToken}}"
                            >
                          {{/if}}


                          <div class="grand-poobaa-date-field">

                            <label for="expectedLibraryDate-{{this._id}}">
                              expected library date
                            </label>

                            <input
                              type="date"
                              id="expectedLibraryDate-{{this._id}}"
                              name="expectedLibraryDate"
                              required
                            >

                          </div>


                          <button
                            type="submit"
                            class="grand-poobaa-approve-button"
                          >

                            <ion-icon name="checkmark-outline"></ion-icon>

                            <span>approve topic</span>

                          </button>

                        </form>

                      </td>

                    </tr>

                  {{/each}}

                </tbody>

              </table>

            </div>

          {{else}}

            <div class="grand-poobaa-empty-state">

              <div class="grand-poobaa-empty-icon">
                <ion-icon name="checkmark-circle-outline"></ion-icon>
              </div>

              <div>
                <h4>nothing waiting for review</h4>

                <p>
                  There are no new topic suggestions at the moment.
                </p>
              </div>

            </div>

          {{/if}}

        </div>

      </div>


{{!-- =================================================
     MEMBER CANCELLATIONS MODULE
================================================== --}}
