<div class="grand-poobaa-page">

  {{!-- =====================================================
       PAGE HEADING
  ====================================================== --}}
  <section class="grand-poobaa-page-heading">

    <div class="grand-poobaa-page-heading-copy">
      <p class="grand-poobaa-eyebrow">
        Twennie administration
      </p>

      <h1>grand poobaa dashboard</h1>

      <p class="grand-poobaa-page-intro">
        Review items requiring attention and manage activity across Twennie.
      </p>
    </div>

    <div class="grand-poobaa-heading-date">
      <span>today</span>

      <strong>
        {{#if currentDate}}
          {{currentDate}}
        {{else}}
          —
        {{/if}}
      </strong>
    </div>

  </section>


  {{!-- =====================================================
       SUMMARY METRICS
  ====================================================== --}}
  <section
    class="grand-poobaa-summary-grid"
    aria-label="Platform summary"
  >

    <article class="grand-poobaa-summary-card">
      <span class="grand-poobaa-summary-label">
        requires attention
      </span>

      <strong class="grand-poobaa-summary-number">
        {{#if totalActionItems}}
          {{totalActionItems}}
        {{else}}
          0
        {{/if}}
      </strong>
    </article>


    <article class="grand-poobaa-summary-card">
      <span class="grand-poobaa-summary-label">
        new today
      </span>

      <strong class="grand-poobaa-summary-number">
        {{#if newToday}}
          {{newToday}}
        {{else}}
          0
        {{/if}}
      </strong>
    </article>


    <article class="grand-poobaa-summary-card">
      <span class="grand-poobaa-summary-label">
        members
      </span>

      <strong class="grand-poobaa-summary-number">
        {{#if totalMembers}}
          {{totalMembers}}
        {{else}}
          0
        {{/if}}
      </strong>
    </article>


    <article class="grand-poobaa-summary-card">
      <span class="grand-poobaa-summary-label">
        organizations
      </span>

      <strong class="grand-poobaa-summary-number">
        {{#if totalOrganizations}}
          {{totalOrganizations}}
        {{else}}
          0
        {{/if}}
      </strong>
    </article>

  </section>


  {{!-- =====================================================
       ACTION CENTRE
  ====================================================== --}}
  <section class="grand-poobaa-section grand-poobaa-action-section">

    <div class="grand-poobaa-section-heading">

      <div>
        <p class="grand-poobaa-section-kicker">
          action centre
        </p>

        <h2>items requiring attention</h2>
      </div>

      <p>
        Open an action card to review the related requests, submissions,
        or administrative tasks directly beneath it.
      </p>

    </div>


    <div class="grand-poobaa-action-grid">


      {{!-- =================================================
           TOPIC SUGGESTIONS MODULE
           This is the first fully developed action module.
      ================================================== --}}
      <div
        class="grand-poobaa-action-module"
        data-grand-poobaa-module
      >

        <button
          type="button"
          class="grand-poobaa-action-card grand-poobaa-dropdown-trigger"
          id="topic-suggestions-trigger"
          data-dropdown-trigger="topic-suggestions-panel"
          aria-expanded="false"
          aria-controls="topic-suggestions-panel"
        >

          <div class="grand-poobaa-action-card-top">

            <div class="grand-poobaa-action-icon">
              <ion-icon name="bulb-outline"></ion-icon>
            </div>

            <span class="grand-poobaa-action-count">
              {{#if topicSuggestionCount}}
                {{topicSuggestionCount}}
              {{else}}
                0
              {{/if}}
            </span>

          </div>


          <div class="grand-poobaa-action-card-copy">

            <h3>new topic suggestions</h3>

            <p>
              Review learning topics suggested by Twennie members.
            </p>

          </div>


          <span class="grand-poobaa-action-link">

            <span>review suggestions</span>

            <ion-icon
              class="grand-poobaa-dropdown-arrow"
              name="chevron-down-outline"
            ></ion-icon>

          </span>

        </button>


        <div
          class="grand-poobaa-dropdown-panel"
          id="topic-suggestions-panel"
          data-dropdown-panel
          aria-labelledby="topic-suggestions-trigger"
          hidden
        >

          <div class="grand-poobaa-dropdown-heading">

            <div class="grand-poobaa-dropdown-heading-copy">

              <p class="grand-poobaa-dropdown-kicker">
                content requests
              </p>

              <h3>new topic suggestions</h3>

              <p>
                Review suggestions submitted by members and approve topics
                for future development.
              </p>

            </div>


            <button
              type="button"
              class="grand-poobaa-dropdown-close"
              data-close-dropdown="topic-suggestions-panel"
              aria-label="Close topic suggestions"
            >
              <ion-icon name="close-outline"></ion-icon>
            </button>

          </div>


          {{#if topicSuggestions}}

            <div class="grand-poobaa-table-scroll">

              <table class="grand-poobaa-table">

                <thead>
                  <tr>
                    <th scope="col">suggested topic</th>
                    <th scope="col">description</th>
                    <th scope="col">submitted by</th>
                    <th scope="col">member details</th>
                    <th scope="col">submitted</th>
                    <th scope="col">approval</th>
                  </tr>
                </thead>


                <tbody>

                  {{#each topicSuggestions}}

                    <tr>

                      <td class="grand-poobaa-table-topic">
                        <strong>
                          {{this.topicTitle}}
                        </strong>
                      </td>


                      <td class="grand-poobaa-table-description">
                        <p>
                          {{this.description}}
                        </p>
                      </td>


                      <td>

                        <div class="grand-poobaa-table-person">

                          <strong>
                            {{this.name}}
                          </strong>

                          {{#if this.email}}
                            <a href="mailto:{{this.email}}">
                              {{this.email}}
                            </a>
                          {{else}}
                            <span class="grand-poobaa-table-missing">
                              no email provided
                            </span>
                          {{/if}}

                        </div>

                      </td>


                      <td>

                        <div class="grand-poobaa-table-meta">

                          <span>
                            {{#if this.memberType}}
                              {{this.memberType}}
                            {{else}}
                              member
                            {{/if}}
                          </span>

                          {{#if this.groupName}}
                            <small>
                              {{this.groupName}}
                            </small>
                          {{else}}
                            <small>
                              no group
                            </small>
                          {{/if}}

                        </div>

                      </td>


                      <td>

                        {{#if this.submittedAt}}
                          <time datetime="{{this.submittedAt}}">
                            {{this.submittedAt}}
                          </time>
                        {{else}}
                          <span class="grand-poobaa-table-missing">
                            not available
                          </span>
                        {{/if}}

                      </td>


                      <td class="grand-poobaa-table-action">

                        <form
                          action="/grand-poobaa/topic-suggestions/{{this._id}}/approve"
                          method="POST"
                          class="grand-poobaa-approval-form"
                        >

                          {{#if ../csrfToken}}
                            <input
                              type="hidden"
                              name="_csrf"
                              value="{{../csrfToken}}"
                            >
                          {{/if}}


                          <div class="grand-poobaa-date-field">

                            <label for="expectedLibraryDate-{{this._id}}">
                              expected library date
                            </label>

                            <input
                              type="date"
                              id="expectedLibraryDate-{{this._id}}"
                              name="expectedLibraryDate"
                              required
                            >

                          </div>


                          <button
                            type="submit"
                            class="grand-poobaa-approve-button"
                          >

                            <ion-icon name="checkmark-outline"></ion-icon>

                            <span>approve topic</span>

                          </button>

                        </form>

                      </td>

                    </tr>

                  {{/each}}

                </tbody>

              </table>

            </div>

          {{else}}

            <div class="grand-poobaa-empty-state">

              <div class="grand-poobaa-empty-icon">
                <ion-icon name="checkmark-circle-outline"></ion-icon>
              </div>

              <div>
                <h4>nothing waiting for review</h4>

                <p>
                  There are no new topic suggestions at the moment.
                </p>
              </div>

            </div>

          {{/if}}

        </div>

      </div>


{{!-- =================================================
     MEMBER CANCELLATIONS MODULE
================================================== --}}
<div
  class="grand-poobaa-action-module"
  data-grand-poobaa-module
>

  <button
    type="button"
    class="grand-poobaa-action-card grand-poobaa-dropdown-trigger"
    id="member-cancellations-trigger"
    data-dropdown-trigger="member-cancellations-panel"
    aria-expanded="false"
    aria-controls="member-cancellations-panel"
  >

    <div class="grand-poobaa-action-card-top">

      <div class="grand-poobaa-action-icon">
        <ion-icon name="person-remove-outline"></ion-icon>
      </div>

      <span class="grand-poobaa-action-count">
        {{#if cancellationCount}}
          {{cancellationCount}}
        {{else}}
          0
        {{/if}}
      </span>

    </div>


    <div class="grand-poobaa-action-card-copy">

      <h3>member cancellations</h3>

      <p>
        Review members whose Twennie accounts have been cancelled.
      </p>

    </div>


    <span class="grand-poobaa-action-link">

      <span>review cancellations</span>

      <ion-icon
        class="grand-poobaa-dropdown-arrow"
        name="chevron-down-outline"
      ></ion-icon>

    </span>

  </button>


  <div
    class="grand-poobaa-dropdown-panel"
    id="member-cancellations-panel"
    data-dropdown-panel
    aria-labelledby="member-cancellations-trigger"
    hidden
  >

    <div class="grand-poobaa-dropdown-heading">

      <div class="grand-poobaa-dropdown-heading-copy">

        <p class="grand-poobaa-dropdown-kicker">
          membership administration
        </p>

        <h3>member cancellations</h3>

        <p>
          Review former member details, membership status, cancellation
          dates, and any reasons recorded when the account was cancelled.
        </p>

      </div>


      <button
        type="button"
        class="grand-poobaa-dropdown-close"
        data-close-dropdown="member-cancellations-panel"
        aria-label="Close member cancellations"
      >
        <ion-icon name="close-outline"></ion-icon>
      </button>

    </div>


    {{#if cancelledMembers.length}}

      <div class="grand-poobaa-table-scroll">

        <table class="grand-poobaa-table grand-poobaa-cancellations-table">

          <thead>
            <tr>
              <th scope="col">former member</th>
              <th scope="col">contact</th>
              <th scope="col">membership</th>
              <th scope="col">account role</th>
              <th scope="col">reason</th>
              <th scope="col">cancelled</th>
            </tr>
          </thead>


          <tbody>

            {{#each cancelledMembers}}

              <tr>

                {{!-- FORMER MEMBER --}}
                <td>

                  <div class="grand-poobaa-table-person">

                    <strong>
                      {{#if this.name}}
                        {{this.name}}
                      {{else}}
                        unnamed member
                      {{/if}}
                    </strong>

                    {{#if this.username}}
                      <span class="grand-poobaa-table-secondary">
                        @{{this.username}}
                      </span>
                    {{else}}
                      <span class="grand-poobaa-table-missing">
                        no username recorded
                      </span>
                    {{/if}}

                  </div>

                </td>


                {{!-- CONTACT --}}
                <td>

                  {{#if this.email}}

                    <a
                      href="mailto:{{this.email}}"
                      class="grand-poobaa-table-email"
                    >
                      {{this.email}}
                    </a>

                  {{else}}

                    <span class="grand-poobaa-table-missing">
                      no email recorded
                    </span>

                  {{/if}}

                </td>


                {{!-- MEMBERSHIP --}}
                <td>

                  <div class="grand-poobaa-table-meta">

                    <span>
                      {{#if this.membershipType}}
                        {{this.membershipType}}
                      {{else}}
                        unknown membership
                      {{/if}}
                    </span>

                    {{#if this.accessLevel}}
                      <small>
                        access: {{this.accessLevel}}
                      </small>
                    {{else}}
                      <small>
                        no access level recorded
                      </small>
                    {{/if}}

                  </div>

                </td>


                {{!-- ACCOUNT ROLE --}}
                <td>

                  {{#if this.wasLeader}}

                    <span class="grand-poobaa-status-badge grand-poobaa-status-badge-leader">
                      <ion-icon name="people-outline"></ion-icon>
                      former leader
                    </span>

                  {{else}}

                    <span class="grand-poobaa-status-badge grand-poobaa-status-badge-member">
                      <ion-icon name="person-outline"></ion-icon>
                      member
                    </span>

                  {{/if}}

                </td>


                {{!-- REASON --}}
                <td class="grand-poobaa-cancellation-reason">

                  {{#if this.reason}}

                    <p>
                      {{this.reason}}
                    </p>

                  {{else}}

                    <span class="grand-poobaa-table-missing">
                      no reason provided
                    </span>

                  {{/if}}

                </td>


                {{!-- CANCELLATION DATE --}}
                <td>
{{#if this.cancelledAtDisplay}}

  <time datetime="{{this.cancelledAtISO}}">
    {{this.cancelledAtDisplay}}
  </time>

{{else}}

                    <span class="grand-poobaa-table-missing">
                      date unavailable
                    </span>

                  {{/if}}

                </td>

              </tr>

            {{/each}}

          </tbody>

        </table>

      </div>

    {{else}}

      <div class="grand-poobaa-empty-state">

        <div class="grand-poobaa-empty-icon">
          <ion-icon name="checkmark-circle-outline"></ion-icon>
        </div>

        <div>

          <h4>no cancelled memberships</h4>

          <p>
            There are no cancelled member accounts to review.
          </p>

        </div>

      </div>

    {{/if}}

  </div>

</div>


{{!-- =================================================
     DEMO REQUESTS MODULE
================================================== --}}
<div
  class="grand-poobaa-action-module"
  data-grand-poobaa-module
>

  <button
    type="button"
    class="grand-poobaa-action-card grand-poobaa-dropdown-trigger"
    id="demo-requests-trigger"
    data-dropdown-trigger="demo-requests-panel"
    aria-expanded="false"
    aria-controls="demo-requests-panel"
  >

    <div class="grand-poobaa-action-card-top">

      <div class="grand-poobaa-action-icon">
        <ion-icon name="desktop-outline"></ion-icon>
      </div>

      <span class="grand-poobaa-action-count">
        {{#if demoRequestCount}}
          {{demoRequestCount}}
        {{else}}
          0
        {{/if}}
      </span>

    </div>


    <div class="grand-poobaa-action-card-copy">

      <h3>demo requests</h3>

      <p>
        Review organizations and professionals interested in learning more
        about Twennie.
      </p>

    </div>


    <span class="grand-poobaa-action-link">

      <span>review requests</span>

      <ion-icon
        class="grand-poobaa-dropdown-arrow"
        name="chevron-down-outline"
      ></ion-icon>

    </span>

  </button>


  <div
    class="grand-poobaa-dropdown-panel"
    id="demo-requests-panel"
    data-dropdown-panel
    aria-labelledby="demo-requests-trigger"
    hidden
  >

    <div class="grand-poobaa-dropdown-heading">

      <div class="grand-poobaa-dropdown-heading-copy">

        <p class="grand-poobaa-dropdown-kicker">
          sales opportunities
        </p>

        <h3>demo requests</h3>

        <p>
          Review prospective clients, contact them, record when a demonstration
          has been scheduled, and close completed requests.
        </p>

      </div>


      <button
        type="button"
        class="grand-poobaa-dropdown-close"
        data-close-dropdown="demo-requests-panel"
        aria-label="Close demo requests"
      >
        <ion-icon name="close-outline"></ion-icon>
      </button>

    </div>


    {{#if demoRequests.length}}

      <div class="grand-poobaa-demo-grid">

        {{#each demoRequests}}

          <article class="grand-poobaa-demo-card">

            <div class="grand-poobaa-demo-header">

              <div>

                <h4>
                  {{#if this.name}}
                    {{this.name}}
                  {{else}}
                    unnamed prospect
                  {{/if}}
                </h4>

                {{#if this.organization}}
                  <p class="grand-poobaa-demo-organization">
                    {{this.organization}}
                  </p>
                {{/if}}

              </div>


              <div class="grand-poobaa-demo-header-meta">

                {{#if this.isScheduled}}

                  <span
                    class="
                      grand-poobaa-demo-status
                      grand-poobaa-demo-status-scheduled
                    "
                  >
                    <ion-icon name="calendar-outline"></ion-icon>
                    scheduled
                  </span>

                {{else}}

                  <span
                    class="
                      grand-poobaa-demo-status
                      grand-poobaa-demo-status-new
                    "
                  >
                    <ion-icon name="sparkles-outline"></ion-icon>
                    new
                  </span>

                {{/if}}


                {{#if this.createdAtDisplay}}

                  <time
                    class="grand-poobaa-demo-date"
                    datetime="{{this.createdAtISO}}"
                  >
                    received {{this.createdAtDisplay}}
                  </time>

                {{else}}

                  <span class="grand-poobaa-demo-date">
                    date unavailable
                  </span>

                {{/if}}

              </div>

            </div>


            <div class="grand-poobaa-demo-details">

              <div>

                <span class="grand-poobaa-demo-field-label">
                  email
                </span>

                {{#if this.email}}

                  <a href="mailto:{{this.email}}">
                    {{this.email}}
                  </a>

                {{else}}

                  <span class="grand-poobaa-table-missing">
                    no email provided
                  </span>

                {{/if}}

              </div>


              <div>

                <span class="grand-poobaa-demo-field-label">
                  job title
                </span>

                <span>

                  {{#if this.jobTitle}}
                    {{this.jobTitle}}
                  {{else}}
                    not provided
                  {{/if}}

                </span>

              </div>


              <div>

                <span class="grand-poobaa-demo-field-label">
                  organization
                </span>

                <span>

                  {{#if this.organization}}
                    {{this.organization}}
                  {{else}}
                    not provided
                  {{/if}}

                </span>

              </div>


              <div>

                <span class="grand-poobaa-demo-field-label">
                  team size
                </span>

                <span>

                  {{#if this.teamSize}}
                    {{this.teamSize}}
                  {{else}}
                    not provided
                  {{/if}}

                </span>

              </div>

            </div>


            {{#if this.isScheduled}}

              <div class="grand-poobaa-demo-scheduled-note">

                <ion-icon name="calendar-outline"></ion-icon>

                <div>

                  <strong>marked as scheduled</strong>

                  {{#if this.scheduledAtDisplay}}

                    <time datetime="{{this.scheduledAtISO}}">
                      {{this.scheduledAtDisplay}}
                    </time>

                  {{else}}

                    <span>
                      Scheduling date unavailable
                    </span>

                  {{/if}}

                </div>

              </div>

            {{/if}}


            <div class="grand-poobaa-demo-message">

              <span class="grand-poobaa-demo-field-label">
                message
              </span>

              {{#if this.message}}

                <p>
                  {{this.message}}
                </p>

              {{else}}

                <p class="grand-poobaa-demo-message-empty">
                  No additional message was submitted.
                </p>

              {{/if}}

            </div>


            <div class="grand-poobaa-demo-actions">

              {{#if this.email}}

                <a
                  href="mailto:{{this.email}}?subject=Your%20Twennie%20demonstration%20request"
                  class="
                    grand-poobaa-demo-action-button
                    grand-poobaa-demo-action-button-email
                  "
                >
                  <ion-icon name="mail-outline"></ion-icon>
                  email prospect
                </a>

              {{/if}}


              {{#unless this.isScheduled}}

                <form
                  action="/grand-poobaa/demo-requests/{{this._id}}/schedule"
                  method="POST"
                  class="grand-poobaa-demo-action-form"
                >

                  {{#if ../csrfToken}}
                    <input
                      type="hidden"
                      name="_csrf"
                      value="{{../csrfToken}}"
                    >
                  {{/if}}

                  <button
                    type="submit"
                    class="
                      grand-poobaa-demo-action-button
                      grand-poobaa-demo-action-button-schedule
                    "
                  >
                    <ion-icon name="calendar-outline"></ion-icon>
                    mark scheduled
                  </button>

                </form>

              {{/unless}}


              <form
                action="/grand-poobaa/demo-requests/{{this._id}}/complete"
                method="POST"
                class="grand-poobaa-demo-action-form"
                onsubmit="return confirm('Mark this demo request as complete?');"
              >

                {{#if ../csrfToken}}
                  <input
                    type="hidden"
                    name="_csrf"
                    value="{{../csrfToken}}"
                  >
                {{/if}}

                <button
                  type="submit"
                  class="
                    grand-poobaa-demo-action-button
                    grand-poobaa-demo-action-button-complete
                  "
                >
                  <ion-icon name="checkmark-outline"></ion-icon>
                  mark complete
                </button>

              </form>

            </div>

          </article>

        {{/each}}

      </div>

    {{else}}

      <div class="grand-poobaa-empty-state">

        <div class="grand-poobaa-empty-icon">
          <ion-icon name="checkmark-circle-outline"></ion-icon>
        </div>

        <div>

          <h4>no active demo requests</h4>

          <p>
            There are currently no demo requests waiting for attention.
          </p>

        </div>

      </div>

    {{/if}}

  </div>

</div>

{{!-- =================================================
     TECH SUPPORT MODULE
================================================== --}}
<div
  class="grand-poobaa-action-module"
  data-grand-poobaa-module
>

  <button
    type="button"
    class="grand-poobaa-action-card grand-poobaa-dropdown-trigger"
    id="tech-support-trigger"
    data-dropdown-trigger="tech-support-panel"
    aria-expanded="false"
    aria-controls="tech-support-panel"
  >

    <div class="grand-poobaa-action-card-top">

      <div class="grand-poobaa-action-icon">
        <ion-icon name="construct-outline"></ion-icon>
      </div>

      <span class="grand-poobaa-action-count">
        {{#if techSupportCount}}
          {{techSupportCount}}
        {{else}}
          0
        {{/if}}
      </span>

    </div>


    <div class="grand-poobaa-action-card-copy">

      <h3>tech support</h3>

      <p>
        Review support activity and manage requests received through
        info@twennie.com.
      </p>

    </div>


    <span class="grand-poobaa-action-link">

      <span>review support</span>

      <ion-icon
        class="grand-poobaa-dropdown-arrow"
        name="chevron-down-outline"
      ></ion-icon>

    </span>

  </button>


  <div
    class="grand-poobaa-dropdown-panel"
    id="tech-support-panel"
    data-dropdown-panel
    aria-labelledby="tech-support-trigger"
    hidden
  >

    <div class="grand-poobaa-dropdown-heading">

      <div class="grand-poobaa-dropdown-heading-copy">

        <p class="grand-poobaa-dropdown-kicker">
          user support
        </p>

        <h3>tech support</h3>

        <p>
          Support requests are currently received and answered through
          info@twennie.com. This panel can also retain a record of support
          issues as the administrative system develops.
        </p>

      </div>


      <button
        type="button"
        class="grand-poobaa-dropdown-close"
        data-close-dropdown="tech-support-panel"
        aria-label="Close tech support"
      >
        <ion-icon name="close-outline"></ion-icon>
      </button>

    </div>


    {{!-- CURRENT SUPPORT WORKFLOW --}}
    <div class="grand-poobaa-support-workflow">

      <div class="grand-poobaa-support-workflow-icon">
        <ion-icon name="mail-outline"></ion-icon>
      </div>


      <div class="grand-poobaa-support-workflow-copy">

        <p class="grand-poobaa-support-label">
          current support inbox
        </p>

        <h4>info@twennie.com</h4>

        <p>
          Members send technical questions and problem reports to this
          address. Replies and follow-up communication continue through email.
        </p>

      </div>


      <a
        href="mailto:info@twennie.com"
        class="grand-poobaa-support-email-button"
      >
        <ion-icon name="mail-open-outline"></ion-icon>
        email support inbox
      </a>

    </div>


    {{!-- SAVED SUPPORT RECORDS --}}
    {{#if techSupportRequests.length}}

      <div class="grand-poobaa-support-records-heading">

        <div>
          <p class="grand-poobaa-support-label">
            saved records
          </p>

          <h4>recent support activity</h4>
        </div>

        <span class="grand-poobaa-support-record-count">
          {{techSupportCount}}
          {{#if techSupportCount}}
            records
          {{else}}
            record
          {{/if}}
        </span>

      </div>


      <div class="grand-poobaa-support-grid">

        {{#each techSupportRequests}}

          <article class="grand-poobaa-support-card">

            <div class="grand-poobaa-support-card-header">

              <div>

                <h5>
                  {{#if this.subject}}
                    {{this.subject}}
                  {{else}}
                    support request
                  {{/if}}
                </h5>

                <p>
                  {{#if this.name}}
                    {{this.name}}
                  {{else}}
                    Twennie member
                  {{/if}}
                </p>

              </div>


              {{#if this.isResolved}}

                <span
                  class="
                    grand-poobaa-support-status
                    grand-poobaa-support-status-resolved
                  "
                >
                  <ion-icon name="checkmark-circle-outline"></ion-icon>
                  resolved
                </span>

              {{else}}

                <span
                  class="
                    grand-poobaa-support-status
                    grand-poobaa-support-status-open
                  "
                >
                  <ion-icon name="alert-circle-outline"></ion-icon>
                  open
                </span>

              {{/if}}

            </div>


            <div class="grand-poobaa-support-meta">

              <div>

                <span class="grand-poobaa-support-label">
                  email
                </span>

                {{#if this.email}}

                  <a href="mailto:{{this.email}}">
                    {{this.email}}
                  </a>

                {{else}}

                  <span class="grand-poobaa-table-missing">
                    no email recorded
                  </span>

                {{/if}}

              </div>


              <div>

                <span class="grand-poobaa-support-label">
                  received
                </span>

                {{#if this.createdAtDisplay}}

                  <time datetime="{{this.createdAtISO}}">
                    {{this.createdAtDisplay}}
                  </time>

                {{else}}

                  <span class="grand-poobaa-table-missing">
                    date unavailable
                  </span>

                {{/if}}

              </div>

            </div>


            <div class="grand-poobaa-support-description">

              <span class="grand-poobaa-support-label">
                issue
              </span>

              {{#if this.description}}

                <p>
                  {{this.description}}
                </p>

              {{else}}

                <p class="grand-poobaa-support-description-empty">
                  No issue summary was recorded.
                </p>

              {{/if}}

            </div>


            <div class="grand-poobaa-support-actions">

              {{#if this.email}}

                <a
                  href="mailto:{{this.email}}?subject=Twennie%20technical%20support"
                  class="
                    grand-poobaa-support-action-button
                    grand-poobaa-support-action-button-email
                  "
                >
                  <ion-icon name="mail-outline"></ion-icon>
                  reply by email
                </a>

              {{/if}}

            </div>

          </article>

        {{/each}}

      </div>

    {{else}}

      <div class="grand-poobaa-support-empty">

        <div class="grand-poobaa-support-empty-icon">
          <ion-icon name="file-tray-outline"></ion-icon>
        </div>

        <div>

          <h4>no saved support records</h4>

          <p>
            Technical support is currently handled through
            info@twennie.com. A support-record model can be added later if
            you decide that selected issues should also be retained here.
          </p>

        </div>

      </div>

    {{/if}}

  </div>

</div>


{{!-- =================================================
     NEW LIBRARY UNITS MODULE
================================================== --}}
<div
  class="grand-poobaa-action-module"
  data-grand-poobaa-module
>

  <button
    type="button"
    class="grand-poobaa-action-card grand-poobaa-dropdown-trigger"
    id="new-library-units-trigger"
    data-dropdown-trigger="new-library-units-panel"
    aria-expanded="false"
    aria-controls="new-library-units-panel"
  >

    <div class="grand-poobaa-action-card-top">

      <div class="grand-poobaa-action-icon">
        <ion-icon name="library-outline"></ion-icon>
      </div>

      <span class="grand-poobaa-action-count">
        {{#if newLibraryUnitCount}}
          {{newLibraryUnitCount}}
        {{else}}
          0
        {{/if}}
      </span>

    </div>


    <div class="grand-poobaa-action-card-copy">

      <h3>new library units</h3>

      <p>
        Review and approve recently added units from leaders, group members,
        and individual contributors.
      </p>

    </div>


    <span class="grand-poobaa-action-link">

      <span>review new units</span>

      <ion-icon
        class="grand-poobaa-dropdown-arrow"
        name="chevron-down-outline"
      ></ion-icon>

    </span>

  </button>


  <div
    class="grand-poobaa-dropdown-panel"
    id="new-library-units-panel"
    data-dropdown-panel
    aria-labelledby="new-library-units-trigger"
    hidden
  >

    <div class="grand-poobaa-dropdown-heading">

      <div class="grand-poobaa-dropdown-heading-copy">

        <p class="grand-poobaa-dropdown-kicker">
          content approval
        </p>

        <h3>new library units</h3>

        <p>
          Open each contribution to review its content, author, unit type,
          topic, and publication details before approving it for the Twennie
          library.
        </p>

      </div>


      <button
        type="button"
        class="grand-poobaa-dropdown-close"
        data-close-dropdown="new-library-units-panel"
        aria-label="Close new library units"
      >
        <ion-icon name="close-outline"></ion-icon>
      </button>

    </div>


    {{#if newLibraryUnits.length}}

      <div class="grand-poobaa-library-summary">

        <div>

          <p class="grand-poobaa-library-summary-label">
            awaiting review
          </p>

          <strong>
            {{newLibraryUnitCount}}
          </strong>

        </div>

        <p>
          Review each new contribution before approving it. Approved units
          will be removed from this list.
        </p>

      </div>


      <div class="grand-poobaa-table-scroll">

        <table
          class="
            grand-poobaa-table
            grand-poobaa-library-table
          "
        >

          <thead>
            <tr>
              <th scope="col">author</th>
              <th scope="col">member type</th>
              <th scope="col">unit type</th>
              <th scope="col">title</th>
              <th scope="col">main topic</th>
              <th scope="col">status</th>
              <th scope="col">added</th>
              <th scope="col">view</th>
              <th scope="col">approve</th>
            </tr>
          </thead>


          <tbody>

            {{#each newLibraryUnits}}

              <tr>

                {{!-- AUTHOR --}}
                <td>

                  <div class="grand-poobaa-table-person">

                    <strong>
                      {{#if this.author}}
                        {{this.author}}
                      {{else}}
                        unknown author
                      {{/if}}
                    </strong>

                    {{#if this.email}}

                      <a href="mailto:{{this.email}}">
                        {{this.email}}
                      </a>

                    {{/if}}

                  </div>

                </td>


                {{!-- MEMBER TYPE --}}
                <td>

                  <div class="grand-poobaa-table-meta">

                    <span>
                      {{#if this.memberType}}
                        {{this.memberType}}
                      {{else}}
                        contributor
                      {{/if}}
                    </span>

                    {{#if this.groupName}}

                      <small>
                        {{this.groupName}}
                      </small>

                    {{else if this.organizationName}}

                      <small>
                        {{this.organizationName}}
                      </small>

                    {{else}}

                      <small>
                        independent
                      </small>

                    {{/if}}

                  </div>

                </td>


                {{!-- UNIT TYPE --}}
                <td>

                  <span class="grand-poobaa-library-unit-type">

                    {{#if (eq this.unitType "upcoming")}}

                      upcoming

                      {{#if this.plannedType}}

                        <small>
                          planned: {{this.plannedType}}
                        </small>

                      {{/if}}

                    {{else}}

                      {{this.unitType}}

                    {{/if}}

                  </span>

                </td>


                {{!-- TITLE --}}
                <td class="grand-poobaa-library-title">

                  <strong>
                    {{#if this.title}}
                      {{this.title}}
                    {{else}}
                      untitled unit
                    {{/if}}
                  </strong>

                </td>


                {{!-- MAIN TOPIC --}}
                <td>

                  {{#if this.mainTopic}}

                    <span class="grand-poobaa-library-topic">
                      {{this.mainTopic}}
                    </span>

                  {{else}}

                    <span class="grand-poobaa-table-missing">
                      no topic assigned
                    </span>

                  {{/if}}

                </td>


                {{!-- STATUS --}}
                <td>

                  {{#if this.isApproved}}

                    <span
                      class="
                        grand-poobaa-library-status
                        grand-poobaa-library-status-approved
                      "
                    >
                      <ion-icon name="shield-checkmark-outline"></ion-icon>
                      approved
                    </span>

                  {{else if (eq this.unitType "upcoming")}}

                    <span
                      class="
                        grand-poobaa-library-status
                        grand-poobaa-library-status-upcoming
                      "
                    >
                      <ion-icon name="time-outline"></ion-icon>

                      {{#if this.status}}
                        {{this.status}}
                      {{else}}
                        in production
                      {{/if}}
                    </span>

                  {{else}}

                    <span
                      class="
                        grand-poobaa-library-status
                        grand-poobaa-library-status-pending
                      "
                    >
                      <ion-icon name="hourglass-outline"></ion-icon>
                      awaiting approval
                    </span>

                  {{/if}}

                </td>


                {{!-- DATE ADDED --}}
                <td>

                  {{#if this.createdAtDisplay}}

                    <time datetime="{{this.createdAtISO}}">
                      {{this.createdAtDisplay}}
                    </time>

                  {{else}}

                    <span class="grand-poobaa-table-missing">
                      date unavailable
                    </span>

                  {{/if}}

                </td>


                {{!-- VIEW UNIT --}}
                <td class="grand-poobaa-library-action">

                  {{#if (eq this.unitType "upcoming")}}

                    <a
                      href="/unitviews/upcoming/view/{{this._id}}"
                      class="
                        grand-poobaa-library-button
                        grand-poobaa-library-view-button
                      "
                      aria-label="View {{this.title}}"
                    >
                      <ion-icon name="eye-outline"></ion-icon>
                      <span>view</span>
                    </a>

                  {{else}}

                    <a
                      href="/unitviews/{{this.unitType}}s/view/{{this._id}}"
                      class="
                        grand-poobaa-library-button
                        grand-poobaa-library-view-button
                      "
                      aria-label="View {{this.title}}"
                    >
                      <ion-icon name="eye-outline"></ion-icon>
                      <span>view</span>
                    </a>

                  {{/if}}

                </td>


                {{!-- APPROVE UNIT --}}
                <td class="grand-poobaa-library-action">

                  {{#if this.isApproved}}

                    <span
                      class="
                        grand-poobaa-library-button
                        grand-poobaa-library-approved-button
                      "
                    >
                      <ion-icon name="checkmark-circle-outline"></ion-icon>
                      <span>approved</span>
                    </span>

                  {{else}}

                    <form
                      action="/grand-poobaa/library-units/{{this._id}}/approve"
                      method="POST"
                      class="grand-poobaa-library-approve-form"
                    >

                      {{#if ../csrfToken}}

                        <input
                          type="hidden"
                          name="_csrf"
                          value="{{../csrfToken}}"
                        >

                      {{/if}}

                      <input
                        type="hidden"
                        name="unitType"
                        value="{{this.unitType}}"
                      >

                      <button
                        type="submit"
                        class="
                          grand-poobaa-library-button
                          grand-poobaa-library-approve-button
                        "
                        aria-label="Approve {{this.title}}"
                      >
                        <ion-icon name="checkmark-outline"></ion-icon>
                        <span>approve</span>
                      </button>

                    </form>

                  {{/if}}

                </td>

              </tr>

            {{/each}}

          </tbody>

        </table>

      </div>

    {{else}}

      <div class="grand-poobaa-empty-state">

        <div class="grand-poobaa-empty-icon">
          <ion-icon name="checkmark-circle-outline"></ion-icon>
        </div>

        <div>

          <h4>no units awaiting approval</h4>

          <p>
            There are currently no new library contributions waiting for
            review.
          </p>

        </div>

      </div>

    {{/if}}

  </div>

</div>
</section>

  {{!-- =====================================================
       FUTURE REPORTING AREA

       This remains structural only. It gives us a location
       for the reporting modules without filling the page
       with unfinished report cards.
  ====================================================== --}}
  <section class="grand-poobaa-section grand-poobaa-reporting-section">

    <div class="grand-poobaa-section-heading">

      <div>
        <p class="grand-poobaa-section-kicker">
          platform intelligence
        </p>

        <h2>reporting and administration</h2>
      </div>

      <p>
        Platform reporting and system-management tools will be developed here
        after the action-centre modules are complete.
      </p>

    </div>


    <div class="grand-poobaa-reporting-placeholder">

      <div class="grand-poobaa-reporting-placeholder-icon">
        <ion-icon name="analytics-outline"></ion-icon>
      </div>

      <div>

        <h3>reporting framework ready</h3>

        <p>
          Growth, engagement, learning, content, organization, revenue, and
          system reporting will be added as individual dashboard sections.
        </p>

      </div>

    </div>

  </section>

</div>


<script>
  document.addEventListener('DOMContentLoaded', function () {
    const modules = Array.from(
      document.querySelectorAll('[data-grand-poobaa-module]')
    );

    const closeModule = function (module, returnFocus) {
      if (!module) return;

      const trigger = module.querySelector('[data-dropdown-trigger]');
      const panel = module.querySelector('[data-dropdown-panel]');

      if (!trigger || !panel) return;

      trigger.setAttribute('aria-expanded', 'false');
      trigger.classList.remove('is-open');
      panel.classList.remove('is-open');
      module.classList.remove('is-open');
      panel.hidden = true;

      if (returnFocus) {
        trigger.focus();
      }
    };


    const closeAllModules = function (exceptModule) {
      modules.forEach(function (module) {
        if (module !== exceptModule) {
          closeModule(module, false);
        }
      });
    };


    const openModule = function (module) {
      if (!module) return;

      const trigger = module.querySelector('[data-dropdown-trigger]');
      const panel = module.querySelector('[data-dropdown-panel]');

      if (!trigger || !panel) return;

      closeAllModules(module);

      trigger.setAttribute('aria-expanded', 'true');
      trigger.classList.add('is-open');
      panel.hidden = false;
      panel.classList.add('is-open');
      module.classList.add('is-open');

      window.requestAnimationFrame(function () {
        panel.scrollIntoView({
          behavior: 'smooth',
          block: 'nearest'
        });
      });
    };


    modules.forEach(function (module) {
      const trigger = module.querySelector('[data-dropdown-trigger]');
      const panel = module.querySelector('[data-dropdown-panel]');
      const closeButtons = module.querySelectorAll(
        '[data-close-dropdown]'
      );

      if (!trigger || !panel) return;


      trigger.addEventListener('click', function () {
        const isOpen =
          trigger.getAttribute('aria-expanded') === 'true';

        if (isOpen) {
          closeModule(module, false);
        } else {
          openModule(module);
        }
      });


      closeButtons.forEach(function (button) {
        button.addEventListener('click', function () {
          closeModule(module, true);
        });
      });
    });


    document.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape') return;

      const openModuleElement = document.querySelector(
        '[data-grand-poobaa-module].is-open'
      );

      if (openModuleElement) {
        closeModule(openModuleElement, true);
      }
    });
  });
</script>