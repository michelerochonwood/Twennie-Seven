        </p>

      </div>


      <button
        type="button"
        class="grand-poobaa-dropdown-close"
        data-close-dropdown="member-cancellations-panel"
        aria-label="Close member cancellations"
      >
        <ion-icon name="close-outline"></ion-icon>
      </button>

    </div>


    {{#if cancelledMembers.length}}

      <div class="grand-poobaa-table-scroll">

        <table class="grand-poobaa-table grand-poobaa-cancellations-table">

          <thead>
            <tr>
              <th scope="col">former member</th>
              <th scope="col">contact</th>
              <th scope="col">membership</th>
              <th scope="col">account role</th>
              <th scope="col">reason</th>
              <th scope="col">cancelled</th>
            </tr>
          </thead>


          <tbody>

            {{#each cancelledMembers}}

              <tr>

                {{!-- FORMER MEMBER --}}
                <td>

                  <div class="grand-poobaa-table-person">

                    <strong>
                      {{#if this.name}}
                        {{this.name}}
                      {{else}}
                        unnamed member
                      {{/if}}
                    </strong>

                    {{#if this.username}}
                      <span class="grand-poobaa-table-secondary">
                        @{{this.username}}
                      </span>
                    {{else}}
                      <span class="grand-poobaa-table-missing">
                        no username recorded
                      </span>
                    {{/if}}

                  </div>

                </td>


                {{!-- CONTACT --}}
                <td>

                  {{#if this.email}}

                    <a
                      href="mailto:{{this.email}}"
                      class="grand-poobaa-table-email"
                    >
                      {{this.email}}
                    </a>

                  {{else}}

                    <span class="grand-poobaa-table-missing">
                      no email recorded
                    </span>

                  {{/if}}

                </td>


                {{!-- MEMBERSHIP --}}
                <td>

                  <div class="grand-poobaa-table-meta">

                    <span>
                      {{#if this.membershipType}}
                        {{this.membershipType}}
                      {{else}}
                        unknown membership
                      {{/if}}
                    </span>

                    {{#if this.accessLevel}}
                      <small>
                        access: {{this.accessLevel}}
                      </small>
                    {{else}}
                      <small>
                        no access level recorded
                      </small>
                    {{/if}}

                  </div>

                </td>


                {{!-- ACCOUNT ROLE --}}
                <td>

                  {{#if this.wasLeader}}

                    <span class="grand-poobaa-status-badge grand-poobaa-status-badge-leader">
                      <ion-icon name="people-outline"></ion-icon>
                      former leader
                    </span>

                  {{else}}

                    <span class="grand-poobaa-status-badge grand-poobaa-status-badge-member">
                      <ion-icon name="person-outline"></ion-icon>
                      member
                    </span>

                  {{/if}}

                </td>


                {{!-- REASON --}}
                <td class="grand-poobaa-cancellation-reason">

                  {{#if this.reason}}

                    <p>
                      {{this.reason}}
                    </p>

                  {{else}}

                    <span class="grand-poobaa-table-missing">
                      no reason provided
                    </span>

                  {{/if}}

                </td>


                {{!-- CANCELLATION DATE --}}
                <td>
{{#if this.cancelledAtDisplay}}

  <time datetime="{{this.cancelledAtISO}}">
    {{this.cancelledAtDisplay}}
  </time>

{{else}}

                    <span class="grand-poobaa-table-missing">
                      date unavailable
                    </span>

                  {{/if}}

                </td>

              </tr>

            {{/each}}

          </tbody>

        </table>

      </div>

    {{else}}

      <div class="grand-poobaa-empty-state">

        <div class="grand-poobaa-empty-icon">
          <ion-icon name="checkmark-circle-outline"></ion-icon>
        </div>

        <div>

          <h4>no cancelled memberships</h4>

          <p>
            There are no cancelled member accounts to review.
          </p>

        </div>

      </div>

    {{/if}}

  </div>

</div>


