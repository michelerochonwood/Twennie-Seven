<script>
  document.addEventListener('DOMContentLoaded', function () {
    const modules = Array.from(
      document.querySelectorAll('[data-grand-poobaa-module]')
    );

    const closeModule = function (module, returnFocus) {
      if (!module) return;

      const trigger = module.querySelector('[data-dropdown-trigger]');
      const panel = module.querySelector('[data-dropdown-panel]');

      if (!trigger || !panel) return;

      trigger.setAttribute('aria-expanded', 'false');
      trigger.classList.remove('is-open');
      panel.classList.remove('is-open');
      module.classList.remove('is-open');
      panel.hidden = true;

      if (returnFocus) {
        trigger.focus();
      }
    };


    const closeAllModules = function (exceptModule) {
      modules.forEach(function (module) {
        if (module !== exceptModule) {
          closeModule(module, false);
        }
      });
    };


    const openModule = function (module) {
      if (!module) return;

      const trigger = module.querySelector('[data-dropdown-trigger]');
      const panel = module.querySelector('[data-dropdown-panel]');

      if (!trigger || !panel) return;

      closeAllModules(module);

      trigger.setAttribute('aria-expanded', 'true');
      trigger.classList.add('is-open');
      panel.hidden = false;
      panel.classList.add('is-open');
      module.classList.add('is-open');

      window.requestAnimationFrame(function () {
        panel.scrollIntoView({
          behavior: 'smooth',
          block: 'nearest'
        });
      });
    };


    modules.forEach(function (module) {
      const trigger = module.querySelector('[data-dropdown-trigger]');
      const panel = module.querySelector('[data-dropdown-panel]');
      const closeButtons = module.querySelectorAll(
        '[data-close-dropdown]'
      );

      if (!trigger || !panel) return;


      trigger.addEventListener('click', function () {
        const isOpen =
          trigger.getAttribute('aria-expanded') === 'true';

        if (isOpen) {
          closeModule(module, false);
        } else {
          openModule(module);
        }
      });


      closeButtons.forEach(function (button) {
        button.addEventListener('click', function () {
          closeModule(module, true);
        });
      });
    });


    document.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape') return;

      const openModuleElement = document.querySelector(
        '[data-grand-poobaa-module].is-open'
      );

      if (openModuleElement) {
        closeModule(openModuleElement, true);
      }
    });
  });
</script>