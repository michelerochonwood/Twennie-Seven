{{#*inline "title"}}Free Contributor Membership Form | Twennie{{/inline}}

<form id="member-form" action="/member/form" method="POST" class="membership-form">
  <input type="hidden" name="_csrf" value="{{csrfToken}}">
  <input type="hidden" name="accessLevel" value="free_individual">
  <input type="hidden" name="redirectTarget" value="form">

  <div class="individual-form-container">

    <div class="membership-hero-image-wrap">
      <img src="/images/freebluey.png" alt="Free Membership" class="membership-hero-image">
    </div>

    <h1 class="form-title">free contributor membership form</h1>

    <div class="membership-info-block">
  <p>
    <strong>Twennie’s free contributor membership</strong> gives you access to <strong> articles, videos, interviews, prompt sets, exercises, and templates in all topics</strong>. 
    Free contributor members can <strong>self-assign these units</strong>, complete them, and <strong>track progress through reports</strong>. To maintain a free contributor membership, you must submit at least one learning unit per month. Learning units are subject to Twennie's approval.
  </p>

  <p>
    Free contributor members <strong>do not have access</strong> to nuggets in the Twennie Mine, or missions in Mission Control.
  </p>

  <p>
    When you’re ready to upgrade, visit your <strong>dashboard membership tab</strong> to move to a 
    <strong>full individual membership</strong>, or <strong>join as a leader of a group</strong>. 
    Leaders must have <strong>at least two members</strong>.
  </p>

  <p>
    As a <strong>leader or group member</strong>, you gain access to <strong>everything Twennie offers</strong>.
  </p>
</div>

<div class="form-field-access-level">
  <label>Membership type</label>
  <div class="form-static-value">Contributor Member</div>

  <input type="hidden" name="accessLevel" value="contributor_individual">
</div>

    <div id="contributor-terms" class="form-field hidden">
      <p><strong>Contributor Agreement</strong></p>
      <ul class="membership-terms-list">
        <li>To maintain a contributor membership, members must submit one library unit per month. All submitted units are subject to the approval of Twennie administrators.</li>
        <li>Instructions for submitting units are available in each submission form.</li>
        <li>If you need further information about submitting library units or the contributor membership option, contact Twennie at <a href="mailto:info@twennie.com">info@twennie.com</a>.</li>
      </ul>

      <div class="checkbox-wrapper">
        <input type="checkbox" id="contributorAgreement" name="contributorAgreement">
        <label for="contributorAgreement">I have read and understand these conditions.</label>
      </div>
    </div>

    <div class="form-field">
      <label for="name">Full Name</label>
      <input type="text" id="name" name="name" required>
    </div>

    <div class="form-field">
      <label for="professionalTitle">Professional Title</label>
      <input type="text" id="professionalTitle" name="professionalTitle" required>
    </div>

    <div class="form-field">
      <label for="organization">Organization (optional)</label>
      <input type="text" id="organization" name="organization">
    </div>

    <div class="form-field-industry">
      <label for="industry">Industry</label>
      <select id="industry" name="industry" required>
        <option value="">Please select an industry</option>
        <option value="Engineering">Engineering</option>
        <option value="Architecture">Architecture</option>
        <option value="Project Management">Project Management</option>
        <option value="Information Technology(IT)">Information Technology(IT)</option>
        <option value="Web Design">Web Design</option>
        <option value="Construction">Construction</option>
        <option value="Community Planning/Landscape Architecture">Community Planning/Landscape Architecture</option>
        <option value="Land Development">Land Development</option>
        <option value="E-Commerce">E-Commerce</option>
        <option value="Edtech">Education Tech</option>
        <option value="Other">Other</option>
      </select>
    </div>

    <div class="form-field">
      <label for="username">Username (your first name, how you prefer to be addressed on twennie.com)</label>
      <input type="text" name="username" id="username" required>
      <span id="username-message" class="form-help-inline"></span>
    </div>

    <div class="form-field">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required>
    </div>

    <div class="form-field password-toggle-container">
      <label for="password">Password</label>
      <div class="password-wrapper">
        <input
          type="password"
          id="password"
          name="password"
          required
          minlength="12"
          pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z\d]).{12,}$"
        >
        <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility()" aria-label="Show or hide password">
          <ion-icon id="toggleIcon" name="eye-outline"></ion-icon>
        </button>
      </div>

      <small class="form-instructions">
        <strong>Password requirements:</strong><br>
        • At least 12 characters<br>
        • At least one uppercase letter<br>
        • At least one lowercase letter<br>
        • At least one number<br>
        • At least one special character
      </small>
    </div>

    <div class="form-field">
      <label for="confirmPassword">Confirm Password</label>
      <input
        type="password"
        id="confirmPassword"
        name="confirmPassword"
        required
        minlength="12"
        pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z\d]).{12,}$"
      >
    </div>

    <div class="checkbox-wrapper membership-terms-toggle-row">
      <input type="checkbox" id="membership-terms-toggle" onclick="toggleMembershipTerms()">
      <label for="membership-terms-toggle">view membership terms</label>
    </div>

    <div id="membership-terms-box" class="membership-terms-box hidden">
      <h3 class="membership-terms-title">membership terms</h3>

      <p>
        By registering as a Twennie member, you agree to use the platform for professional learning,
        collaboration, and development in a respectful and lawful manner.
      </p>

      <ul class="membership-terms-list">
        <li>You are responsible for keeping your login credentials secure.</li>
        <li>You agree not to share your account with another person.</li>
        <li>You agree to participate respectfully and professionally on the platform.</li>
        <li>You may not upload or share confidential, proprietary, or unauthorized third-party information.</li>
        <li>Your access level determines which features, reports, groups, and learning tools are available to you.</li>
        <li>Paid memberships renew and are billed according to the plan selected at checkout unless cancelled.</li>
        <li>Twennie may suspend or terminate accounts used in violation of platform rules or applicable law.</li>
        <li>Twennie may update platform features, membership benefits, and terms from time to time.</li>
      </ul>

      <p>
        By completing registration, you acknowledge that you have read and agree to these membership terms.
      </p>
    </div>

    <div class="checkbox-wrapper membership-agreement-row">
      <input type="checkbox" id="membershipAgreement" name="membershipAgreement" value="true" required>
      <label for="membershipAgreement">I have read and agree to the membership terms.</label>
    </div>

    <button type="submit" id="make-member-button" class="make-member-button">
      make me a free member
    </button>
  </div>
</form>

<script>
  function handleAccessLevelChange(value) {
    const contributorTerms = document.getElementById('contributor-terms');
    const contributorAgreement = document.getElementById('contributorAgreement');
    const redirectTarget = document.getElementById('redirectTarget');

    contributorTerms.classList.add('hidden');
    if (contributorAgreement) contributorAgreement.required = false;
    redirectTarget.value = 'form';

    if (value === 'contributor_individual') {
      contributorTerms.classList.remove('hidden');
      if (contributorAgreement) contributorAgreement.required = true;
      redirectTarget.value = 'form';
    }
  }

  function togglePasswordVisibility() {
    const input = document.getElementById('password');
    const icon = document.getElementById('toggleIcon');

    if (!input || !icon) return;

    if (input.type === 'password') {
      input.type = 'text';
      icon.name = 'eye-off-outline';
    } else {
      input.type = 'password';
      icon.name = 'eye-outline';
    }
  }

  function toggleMembershipTerms() {
    const box = document.getElementById('membership-terms-box');
    if (!box) return;
    box.classList.toggle('hidden');
  }

  document.addEventListener('DOMContentLoaded', function () {
    const form = document.getElementById('member-form');
    const passwordInput = document.getElementById('password');
    const confirmPasswordInput = document.getElementById('confirmPassword');
    const usernameInput = document.getElementById('username');
    const msg = document.getElementById('username-message');

    function validatePasswordMatch() {
      if (!passwordInput || !confirmPasswordInput) return;
      confirmPasswordInput.setCustomValidity('');

      if (confirmPasswordInput.value && passwordInput.value !== confirmPasswordInput.value) {
        confirmPasswordInput.setCustomValidity('Passwords do not match.');
      }
    }

    if (passwordInput && confirmPasswordInput) {
      passwordInput.addEventListener('input', validatePasswordMatch);
      confirmPasswordInput.addEventListener('input', validatePasswordMatch);
    }

    if (form) {
      form.addEventListener('submit', function (e) {
        validatePasswordMatch();
        if (!form.checkValidity()) {
          e.preventDefault();
          form.reportValidity();
        }
      });
    }

    if (usernameInput && msg) {
      usernameInput.addEventListener('blur', async function () {
        const username = this.value.trim();

        if (!username) {
          msg.textContent = '';
          return;
        }

        try {
          const res = await fetch(`/member/check-username?username=${encodeURIComponent(username)}`);
          const data = await res.json();

          if (!data.available) {
            msg.textContent = 'That username is already taken. Try something unique like Brian-Warrior1.';
            msg.className = 'form-help-inline form-help-error';
          } else {
            msg.textContent = 'Username is available!';
            msg.className = 'form-help-inline form-help-success';
          }
        } catch (err) {
          console.error('Username check failed:', err);
          msg.textContent = '';
          msg.className = 'form-help-inline';
        }
      });
    }
  });
</script>

