  <h1 class="registration-complete">registration complete!</h1>
  <p>Welcome to Twennie{{#if username}}, {{username}}{{/if}}!</p>

  <div class="button-row" style="display:flex; gap:10px; flex-wrap:wrap; margin-top:12px;">
