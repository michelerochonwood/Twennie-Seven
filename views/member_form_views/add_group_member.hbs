{{#*inline "title"}}Add Group Member | Twennie{{/inline}}

<div class="add-group-member-container">
  <form id="add-group-member-form" action="/leader/{{leader._id}}/add_group_member" method="POST" class="addgroupmember-form" novalidate>
    {{#if csrfToken}}
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
    {{/if}}

    <div class="addgroupmember-container">
      <h1 class="addgroupmember-title">Add Group Member</h1>
      <p class="addgroupmember-description">
        Add an unregistered group member by entering their name and email below. We’ll send a verification prompt so they can complete registration.
      </p>

      <div class="addgroupmember-leader-info">
        <p><strong>Group Name:</strong> {{leader.groupName}}</p>
        <p><strong>Leader:</strong> {{leader.groupLeaderName}}</p>
        <p><strong>Professional Title:</strong> {{leader.professionalTitle}}</p>
      </div>

      {{#if errorMessage}}
        <div class="form-error-banner">
          <p>{{errorMessage}}</p>
        </div>
      {{/if}}

      <div class="addgroupmember-fields">
        <div class="addgroupmember-field">
          <label for="member-name">Group Member Name</label>
          <input
            type="text"
            id="member-name"
            name="name"
            placeholder="Enter the member’s full name"
            required
            autocomplete="name"
          >
        </div>

        <div class="addgroupmember-field">
          <label for="member-email">Group Member Email</label>
          <input
            type="email"
            id="member-email"
            name="email"
            placeholder="Enter the member’s email address"
            required
            autocomplete="email"
            inputmode="email"
          >
        </div>
      </div>

      <div class="addgroupmember-note">
        <p>
          The member will receive an email to verify and set their password. Until they complete verification, their account will remain pending.
        </p>
      </div>

      <div class="addgroupmember-actions">
        <a href="/dashboard/leader" class="button button-secondary" style="margin-right: 8px;">back to dashboard</a>
        <button type="submit" class="addgroupmember-button">add member</button>
      </div>
    </div>
  </form>
</div>

