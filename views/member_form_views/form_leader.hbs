{{#*inline "title"}}Leader Membership Form | Twennie{{/inline}}

<form id="lf-leader-form" action="/leader/form" method="POST" class="lf-form" novalidate>
  {{#if csrfToken}}<input type="hidden" name="_csrf" value="{{csrfToken}}">{{/if}}

  <div class="lf-wrapper">
    <!-- Hero -->
    <div class="lf-hero">
      <img src="/images/leaderbluey_2.png" alt="Leader Membership" class="lf-hero-img">
    </div>

    <h1 class="lf-title">group leader membership form</h1>

    {{#if errorMessage}}
      <div class="lf-banner lf-banner--error">{{errorMessage}}</div>
    {{/if}}

    <!-- Group Information -->
    <section class="lf-section">
      <h2 class="lf-section-title">Group Information</h2>

      <div class="lf-field">
        <label for="lf-group-name" class="lf-label">Group Name</label>
        <input id="lf-group-name" name="groupName" class="lf-input" type="text" required
               placeholder="Hint: you'll want a fun name, like the Marshmallow Spartans or the Zen Mechanics."
               autocomplete="organization">
      </div>

      <div class="lf-field">
        <label for="lf-leader-name" class="lf-label">Group Leader Name</label>
        <input id="lf-leader-name" name="groupLeaderName" class="lf-input" type="text" required
               placeholder="Your full name, or the name your team knows you by."
               autocomplete="name">
      </div>

      <div class="lf-field">
        <label for="lf-title" class="lf-label">Professional Title</label>
        <input id="lf-title" name="professionalTitle" class="lf-input" type="text" required
               placeholder="The title your organization knows you by."
               autocomplete="organization-title">
      </div>

      <div class="lf-field">
        <label for="lf-org" class="lf-label">Organization</label>
        <input id="lf-org" name="organization" class="lf-input" type="text"
               placeholder="If you prefer not to name your organization, write 'anonymous'."
               autocomplete="organization">
      </div>

      <div class="lf-field">
        <label for="lf-industry" class="lf-label">Industry</label>
        <select id="lf-industry" name="industry" class="lf-select" required>
          <option value="">Please select your industry</option>
          <option>Engineering</option>
          <option>Architecture</option>
          <option>Project Management</option>
          <option>Information Technology(IT)</option>
          <option>Web Design</option>
          <option>Construction</option>
          <option>Technology</option>
          <option>AI and Robotics</option>
          <option>Social Media/Digital Advertising</option>
          <option>Community Planning/Landscape Architecture</option>
          <option>Land Development</option>
          <option>Telecommunications</option>
          <option>E-Commerce</option>
          <option>Cybersecurity</option>
          <option>Edtech</option>
          <option>Energy and Utilities</option>
          <option>Manufacturing</option>
          <option>Other</option>
        </select>
      </div>
    </section>

    <!-- Account -->
    <section class="lf-section">
      <h2 class="lf-section-title">Leader Account</h2>

      <div class="lf-field">
        <label for="lf-username" class="lf-label">Username</label>
        <input id="lf-username" name="username" class="lf-input" type="text" required
               placeholder="Choose a username for login" autocomplete="username">
      </div>

      <div class="lf-field">
        <label for="lf-email" class="lf-label">Group Leader Email Address</label>
        <input id="lf-email" name="groupLeaderEmail" class="lf-input" type="email" required
               autocomplete="email">
      </div>

      <div class="lf-field">
        <label for="lf-password" class="lf-label">Password</label>
        <div class="lf-password">
          <input id="lf-password" name="password" class="lf-input" type="password" required minlength="6" autocomplete="new-password">
          <button type="button" class="lf-eye" aria-label="Toggle password visibility" onclick="(function(){
            const i=document.getElementById('lf-password'); const b=document.getElementById('lf-eye-icon');
            if(i.type==='password'){ i.type='text'; b.textContent='🙈'; } else { i.type='password'; b.textContent='👁️'; }
          })()"><span id="lf-eye-icon">👁️</span></button>
        </div>
        <div class="lf-hint">Minimum 6 characters.</div>
      </div>
    </section>

    <!-- Billing Address -->
    <section class="lf-section">
      <h2 class="lf-section-title">Billing Address <span class="lf-muted">(optional)</span></h2>

      <div class="lf-field">
        <label for="lf-line1" class="lf-label">Street Address</label>
        <input id="lf-line1" name="line1" class="lf-input" type="text" placeholder="123 Main St" autocomplete="address-line1">
      </div>

      <div class="lf-field">
        <label for="lf-line2" class="lf-label">Apartment / Suite</label>
        <input id="lf-line2" name="line2" class="lf-input" type="text" placeholder="Unit 5B" autocomplete="address-line2">
      </div>

      <div class="lf-grid lf-grid--3">
        <div class="lf-field">
          <label for="lf-city" class="lf-label">City</label>
          <input id="lf-city" name="city" class="lf-input" type="text" autocomplete="address-level2">
        </div>
        <div class="lf-field">
          <label for="lf-province" class="lf-label">Province / State</label>
          <input id="lf-province" name="province" class="lf-input" type="text" placeholder="ON" autocomplete="address-level1">
        </div>
        <div class="lf-field">
          <label for="lf-postal" class="lf-label">Postal Code</label>
          <input id="lf-postal" name="postalCode" class="lf-input" type="text" placeholder="A1A 1A1" autocomplete="postal-code">
        </div>
      </div>

      <div class="lf-field">
        <label for="lf-country" class="lf-label">Country</label>
        <select id="lf-country" name="country" class="lf-select" autocomplete="country">
          <option value="CA" selected>Canada</option>
          <option value="US">United States</option>
        </select>
      </div>

      <div class="lf-hint">At checkout, you’ll confirm billing details. Stripe will securely save the final address to your account.</div>
    </section>

    <!-- Group Size & Members -->
    <section class="lf-section">
      <h2 class="lf-section-title">Group Members</h2>

      <p class="lf-note">Group leaders must start memberships for all members of their group.</p>

      <div class="lf-field">
        <label for="lf-group-size" class="lf-label">Number of Members (excluding you)</label>
        <select id="lf-group-size" name="groupSize" class="lf-select" required>
          <option value="">Select group size</option>
          {{#each [2,3,4,5,6,7,8,9,10]}}
            <option value="{{this}}">{{this}} members</option>
          {{/each}}
        </select>
      </div>

      <div class="lf-members">
        <h3 class="lf-subtitle">Individual Group Members</h3>
        <div id="lf-members-grid" class="lf-members-grid"><!-- your JS can insert rows here --></div>
        <!-- Hidden field your JS can populate with JSON: -->
        <!-- <input type="hidden" id="lf-members-json" name="members"> -->
      </div>
    </section>

    <!-- Billing Seats Summary -->
    <section class="lf-section">
      <h2 class="lf-section-title">Billing seats</h2>
      <div class="lf-billing" aria-live="polite">
        <div class="lf-row"><span>Leader seat</span><strong id="lf-seat-leader">1</strong></div>
        <div class="lf-row"><span>Member seats</span><strong id="lf-seat-members">0</strong></div>
        <hr class="lf-divider">
        <div class="lf-row lf-row--total"><span>Total seats billed</span><strong id="lf-seat-total">1</strong></div>
        <div class="lf-row"><span>Price per seat</span><strong>$17.00 / month</strong></div>
        <div class="lf-row"><span>Subtotal (before tax)</span><strong id="lf-subtotal">$17.00 CAD / month</strong></div>
      </div>
      <input type="hidden" name="computedSeats" id="lf-computed-seats" value="1">
      <input type="hidden" name="computedSubtotalCents" id="lf-computed-subtotal" value="1700">
    </section>

    <!-- Registration Code -->
    <section class="lf-section">
      <h2 class="lf-section-title">Team Registration Code</h2>
      <div class="lf-field">
        <label for="lf-regcode" class="lf-label">Create a Registration Code</label>
        <input id="lf-regcode" name="registration_code" class="lf-input" type="text" required
               placeholder="Create a unique code for your team"
               pattern="[A-Za-z0-9]{8,}" title="At least 8 characters, letters and numbers only"
               autocomplete="off">
        <div class="lf-hint">
          <strong>Rules:</strong> At least 8 characters, letters and numbers only. No special characters. Keep it secure.
        </div>
      </div>
    </section>

    <!-- Agreement -->
    <section class="lf-section">
      <h2 class="lf-section-title">Agreement</h2>
      <label class="lf-check">
        <input type="checkbox" name="group_agreement" value="true" required>
        <span>I agree to fulfill the responsibilities of a group leader according to the Twennie guidelines and our group agreement.</span>
      </label>
    </section>

    <!-- Payment -->
    <section class="lf-section">
      <h2 class="lf-section-title">Payment</h2>
      <div class="lf-info">
        <p><strong>Payment Reminder:</strong> After submit, you’ll be redirected to a secure checkout page to start your group subscription. Taxes are calculated automatically.</p>
        <p>If your organization prefers to be invoiced, please <a href="mailto:info@twennie.com">contact Twennie</a> first to arrange billing.</p>
      </div>
      <input type="hidden" name="redirectTarget" value="payment">
    </section>

    <div class="lf-actions">
      <button type="submit" class="lf-btn lf-btn--primary">make me a Twennie group leader</button>
    </div>
  </div>
</form>

<script>
  (function(){
    const PRICE = 1700; // cents
    const fmt = c => '$' + (c/100).toFixed(2);
    const size = document.getElementById('lf-group-size');
    const seatLeader = document.getElementById('lf-seat-leader');
    const seatMembers = document.getElementById('lf-seat-members');
    const seatTotal = document.getElementById('lf-seat-total');
    const subtotal = document.getElementById('lf-subtotal');
    const hiddenSeats = document.getElementById('lf-computed-seats');
    const hiddenSubtotal = document.getElementById('lf-computed-subtotal');

    function update() {
      const members = parseInt(size && size.value ? size.value : '0', 10) || 0;
      const seats = 1 + members;
      const cents = seats * PRICE;
      seatLeader.textContent = '1';
      seatMembers.textContent = String(members);
      seatTotal.textContent = String(seats);
      subtotal.textContent = fmt(cents) + ' CAD / month';
      hiddenSeats.value = String(seats);
      hiddenSubtotal.value = String(cents);
    }
    if (size) size.addEventListener('change', update);
    document.addEventListener('DOMContentLoaded', update);
  })();
</script>



