<h1 class="form-title">find your group</h1>

<div class="group-membership-info-wrap">
  <div class="membership-info-block">
    <p>
      As a <strong>Twennie group member</strong>, you are part of a <strong>team of up to 10 learners</strong> led by a group leader.
    </p>

    <p>
      Group membership is <strong>initiated by your leader</strong>. You will receive access through a secure list
      and complete your registration using your email. You can find your group below - look for your team name, which will be given to you by your leader. 
    </p>

    <p>
      Your leader can <strong>assign learning units</strong> to you and <strong>monitor your progress</strong>.
    </p>

    <p>
      You can also <strong>self-assign units</strong>, complete them at any time, and track your
      <strong>badges and completions</strong> in your group member dashboard.
    </p>
  </div>
</div>

<div class="verify-form-container">
  <div class="groups-list">
    {{#each groups}}
      <div class="group-card">

        <div class="group-image-wrapper">
          <img
            src="{{#if this.groupImage}}{{this.groupImage}}{{else}}/images/default-group.png{{/if}}"
            alt="{{this.groupName}} group image"
            class="group-avatar"
          >
        </div>

        <div class="group-header">
          <h3>{{this.groupName}}</h3>
          <button type="button" class="dropdown-btn" data-group="{{this._id}}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 331.65 100.99" class="dropdown-arrow">
              <defs>
                <style>.cls-1 { fill: #4e50a2; }</style>
              </defs>
              <g>
                <polygon class="cls-1" points="0 0 161.57 100.99 331.65 0 0 0"/>
              </g>
            </svg>
          </button>
        </div>

        <form action="/member/group/verify-registration-code" method="POST" class="registration-form" data-group="{{this._id}}">
          <input type="hidden" name="groupId" value="{{this._id}}">

          <label for="registration-code-{{this._id}}">enter your group's registration code</label>
          <input type="text" id="registration-code-{{this._id}}" name="registration_code" required>
          <button type="submit" class="submit-registration">verify</button>
        </form>

        {{#if this.verified}}
          <p class="success-message" style="color: green; font-weight: bold;">Registration Code Verified!</p>

          <button type="button" class="expand-members-btn" data-group="{{this._id}}">
            <span>find my name</span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 331.65 100.99" class="dropdown-arrow">
              <defs>
                <style>.cls-1 { fill: #4e50a2; }</style>
              </defs>
              <g>
                <polygon class="cls-1" points="0 0 161.57 100.99 331.65 0 0 0"/>
              </g>
            </svg>
          </button>
        {{else if this.error}}
          <p class="error-message" style="color: red;">Invalid registration code. Try again.</p>
        {{/if}}

        {{#if this.verified}}
          <div class="group-details" id="group-details-{{this._id}}">
            <p>Members:</p>

            <ul class="members-list">
              {{#if this.members.length}}
                {{#each this.members}}
                  <li>
                    {{this.name}}
                    <a
                      href="/member/group/complete-registration?memberName={{this.name}}&memberEmail={{this.email}}&groupId={{../_id}}&groupName={{../groupName}}"
                      class="select-member-btn"
                    >
                      this is me
                    </a>
                  </li>
                {{/each}}
              {{else}}
                <li>No members found for this group.</li>
              {{/if}}
            </ul>
          </div>
        {{/if}}

      </div>
    {{/each}}
  </div>
</div>


