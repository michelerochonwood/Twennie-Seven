{{#*inline "title"}}Upgrade Membership Form | Twennie{{/inline}}

<form id="convert-leader-form" action="/member/convert-to-leader" method="POST" class="membership-form" novalidate>
  {{#if csrfToken}}<input type="hidden" name="_csrf" value="{{csrfToken}}">{{/if}}

  <div class="convert-leader-form-container">
    <h1 class="form-title">convert to group leader</h1>
    <p class="form-instructions">
      You’re already a Twennie member. Provide the details below to convert your account to a group leader and set up billing for your team.
    </p>

    {{#if errorMessage}}
      <div class="form-error-banner">
        <p>{{errorMessage}}</p>
      </div>
    {{/if}}

    <!-- Group Information -->
    <fieldset class="form-section">
      <legend>Group Information</legend>

      <div class="form-field">
        <label for="group-name">Group Name</label>
        <input type="text" id="group-name" name="groupName"
               placeholder="Your team name — fun and memorable!"
               required autocomplete="organization">
      </div>

      <div class="form-field">
        <label for="group-leader-name">Group Leader Name</label>
        <input type="text" id="group-leader-name" name="groupLeaderName"
               placeholder="The name your team knows you by."
               required autocomplete="name">
      </div>

      <div class="form-field">
        <label for="organization">Organization</label>
        <input type="text" id="organization" name="organization"
               placeholder="Your company or organization name" required autocomplete="organization">
      </div>

      <div class="form-field">
        <label for="industry">Industry</label>
        <select id="industry" name="industry" required>
          <option value="">Select your industry</option>
          <option value="Engineering">Engineering</option>
          <option value="Architecture">Architecture</option>
          <option value="Project Management">Project Management</option>
          <option value="Information Technology(IT)">Information Technology (IT)</option>
          <option value="Web Design">Web Design</option>
          <option value="Construction">Construction</option>
          <option value="Technology">Technology</option>
          <option value="AI and Robotics">AI and Robotics</option>
          <option value="Social Media/Digital Advertising">Social Media / Digital Advertising</option>
          <option value="Community Planning/Landscape Architecture">Community Planning / Landscape Architecture</option>
          <option value="Land Development">Land Development</option>
          <option value="Telecommunications">Telecommunications</option>
          <option value="E-Commerce">E-Commerce</option>
          <option value="Cybersecurity">Cybersecurity</option>
          <option value="Fintech">Fintech</option>
          <option value="Edtech">Edtech</option>
          <option value="Energy and Utilities">Energy and Utilities</option>
          <option value="Manufacturing">Manufacturing</option>
          <option value="Other">Other</option>
        </select>
      </div>
    </fieldset>

    <!-- Billing Address (optional, stored if provided) -->
    <fieldset class="form-section">
      <legend>Billing Address</legend>

      <div class="form-field">
        <label for="line1">Street Address</label>
        <input type="text" id="line1" name="line1" autocomplete="address-line1" placeholder="123 Main St">
      </div>

      <div class="form-field">
        <label for="line2">Apartment / Suite (optional)</label>
        <input type="text" id="line2" name="line2" autocomplete="address-line2" placeholder="Unit 5B">
      </div>

      <div class="form-field">
        <label for="city">City</label>
        <input type="text" id="city" name="city" autocomplete="address-level2">
      </div>

      <div class="form-field">
        <label for="province">Province / State</label>
        <input type="text" id="province" name="province" autocomplete="address-level1" placeholder="ON">
      </div>

      <div class="form-field">
        <label for="postalCode">Postal Code</label>
        <input type="text" id="postalCode" name="postalCode" autocomplete="postal-code" placeholder="A1A 1A1">
      </div>

      <div class="form-field">
        <label for="country">Country</label>
        <select id="country" name="country" autocomplete="country">
          <option value="CA" selected>Canada</option>
          <option value="US">United States</option>
        </select>
      </div>

      <small class="form-instructions">
        At checkout, you’ll confirm billing details. Stripe will securely save the final address to your account.
      </small>
    </fieldset>

    <!-- Group Size & Members -->
    <fieldset class="form-section">
      <legend>Group Members</legend>

      <div class="form-field">
        <label for="group-size">Number of Members (excluding you)</label>
        <select id="group-size" name="groupSize" required>
          <option value="">Select group size</option>
          {{#each [2,3,4,5,6,7,8,9,10]}}
            <option value="{{this}}">{{this}} members</option>
          {{/each}}
        </select>
        <small class="form-instructions">You’ll be billed for your seat + your members.</small>
      </div>

      <div class="individual-members-container">
        <h3>Individual Group Members</h3>
        <div id="members-grid" class="members-grid"></div>
        <!-- Your JS should serialize entries into a hidden input named "members" -->
      </div>
    </fieldset>

    <!-- Billing Seats Summary -->
    <fieldset class="form-section" id="billing-summary-section" aria-live="polite">
      <legend>Billing seats</legend>

      <div class="billing-summary">
        <div class="billing-row">
          <span>Leader seat</span>
          <strong><span id="billing-leader-seats">1</span></strong>
        </div>

        <div class="billing-row">
          <span>Member seats</span>
          <strong><span id="billing-member-seats">0</span></strong>
        </div>

        <hr class="billing-divider">

        <div class="billing-row billing-total">
          <span>Total seats billed</span>
          <strong><span id="billing-total-seats">1</span></strong>
        </div>

        <div class="billing-row">
          <span>Price per seat</span>
          <strong>$<span id="billing-price-per-seat">17.00</span>/month</strong>
        </div>

        <div class="billing-row">
          <span>Subtotal (before tax)</span>
          <strong>$<span id="billing-subtotal">17.00</span> CAD / month</strong>
        </div>

        <small class="form-instructions">
          Taxes are calculated at checkout.
        </small>
      </div>

      <!-- Optional: expose computed values to the server -->
      <input type="hidden" name="computedSeats" id="computedSeats" value="1">
      <input type="hidden" name="computedSubtotalCents" id="computedSubtotalCents" value="1700">
    </fieldset>

    <!-- Registration Code -->
    <fieldset class="form-section">
      <legend>Team Registration Code</legend>
      <div class="form-field">
        <label for="registration-code">Create a Registration Code</label>
        <input type="text" id="registration-code" name="registration_code"
               placeholder="e.g. BuildTeam2025"
               required pattern="[A-Za-z0-9]{8,}"
               title="At least 8 characters, letters and numbers only"
               autocomplete="off">
        <small class="form-instructions">
          Your members will use this code to join your group.
        </small>
      </div>
    </fieldset>

    <!-- Agreement -->
    <fieldset class="form-section">
      <legend>Agreement</legend>
      <div class="form-toggle">
        <label for="group-agreement-toggle" class="form-toggle-label">
          <input type="checkbox" id="group-agreement-toggle" name="group_agreement" value="true" required>
          I agree to the Twennie group leadership responsibilities.
        </label>
      </div>
    </fieldset>

    <!-- Payment -->
    <fieldset class="form-section">
      <legend>Payment</legend>
      <div class="form-field" id="group-payment-placeholder">
        <p><strong>Payment Reminder:</strong> After submit, you’ll be redirected to a secure checkout page to start your group subscription. Taxes are calculated automatically.</p>
        <p>If your organization needs alternate billing, contact <a href="mailto:info@twennie.com">info@twennie.com</a> before submitting.</p>
      </div>

      <!-- Hidden Submission Info -->
      <input type="hidden" name="redirectTarget" value="payment">
    </fieldset>

    <!-- Submit -->
    <div class="form-actions">
      <button type="submit" class="make-member-button">upgrade to group leader</button>
    </div>
  </div>
</form>

<script>
  (function () {
    const PRICE_PER_SEAT_CENTS = 1700; // $17 CAD
    const select = document.getElementById('group-size');

    const leaderSeatsEl = document.getElementById('billing-leader-seats');
    const memberSeatsEl = document.getElementById('billing-member-seats');
    const totalSeatsEl  = document.getElementById('billing-total-seats');
    const priceSeatEl   = document.getElementById('billing-price-per-seat');
    const subtotalEl    = document.getElementById('billing-subtotal');

    const seatsInput    = document.getElementById('computedSeats');
    const subtotalInput = document.getElementById('computedSubtotalCents');

    function dollars(cents){ return (cents/100).toFixed(2); }

    function updateSummary() {
      const memberCount = parseInt(select && select.value ? select.value : '0', 10) || 0;
      const seats = 1 + memberCount;
      const subtotalCents = seats * PRICE_PER_SEAT_CENTS;

      leaderSeatsEl.textContent = '1';
      memberSeatsEl.textContent = String(memberCount);
      totalSeatsEl.textContent  = String(seats);
      priceSeatEl.textContent   = dollars(PRICE_PER_SEAT_CENTS);
      subtotalEl.textContent    = dollars(subtotalCents);

      seatsInput.value = String(seats);
      subtotalInput.value = String(subtotalCents);
    }

    if (select) select.addEventListener('change', updateSummary);
    document.addEventListener('DOMContentLoaded', updateSummary);
  })();

  // If you also use leaderform.js to add dynamic member rows, include it as well:
  // <script src="https://www.twennie.com/javascript/leaderform/leaderform.js" defer></script>
</script>

