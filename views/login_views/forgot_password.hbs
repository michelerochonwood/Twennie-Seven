{{#*inline "title"}}Forgot Password | Twennie{{/inline}}

<div class="login-container">
  <h1 class="login-title">forgot password</h1>

  {{#if error}}
    <div class="login-alert login-alert-error">{{error}}</div>
  {{/if}}

  {{#if message}}
    <div class="login-alert login-alert-success">{{message}}</div>
  {{/if}}

  <form class="login-form" action="/auth/forgot-password" method="POST">
    {{#if csrfToken}}<input type="hidden" name="_csrf" value="{{csrfToken}}">{{/if}}

    <div class="login-field">
      <label for="email" class="login-label">Email</label>
      <input type="email" id="email" name="email" class="login-input" required autocomplete="email">
      <small style="display:block; margin-top:0.5rem; opacity:0.8;">
        We’ll email you a link to reset your password.
      </small>
    </div>

    <button type="submit" class="login-button">send reset link</button>

    <div class="login-links">
      <a href="/auth/login" class="login-link">back to login</a>
    </div>
  </form>
</div>
