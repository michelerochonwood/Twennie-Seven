{{#*inline "title"}}Reset Password | Twennie{{/inline}}

<div class="login-container">
  <h1 class="login-title">reset password</h1>

  {{#if error}}
    <div class="login-alert login-alert-error">{{error}}</div>
  {{/if}}

  <form class="login-form" action="/auth/reset-password" method="POST">
    {{#if csrfToken}}<input type="hidden" name="_csrf" value="{{csrfToken}}">{{/if}}
    <input type="hidden" name="token" value="{{token}}">

    <div class="login-field">
      <label for="password" class="login-label">New password</label>
      <input type="password" id="password" name="password" class="login-input" required minlength="8">
    </div>

    <div class="login-field">
      <label for="confirmPassword" class="login-label">Confirm new password</label>
      <input type="password" id="confirmPassword" name="confirmPassword" class="login-input" required minlength="8">
    </div>

    <button type="submit" class="login-button">update password</button>

    <div class="login-links">
      <a href="/auth/login" class="login-link">back to login</a>
    </div>
  </form>
</div>
