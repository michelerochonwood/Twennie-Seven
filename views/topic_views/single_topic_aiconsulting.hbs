<div class="topic-resource-cta-wrapper">
<video
  id="bluey-cta-video"
  class="bluey-cta-img"
  style="margin-bottom: 5px; max-width: 180px; width: 100%; height: auto; border-radius: 12px;"
  src="/videos/blueydown.mp4"
  poster="/images/blueydown.png"
  controls
  playsinline
  webkit-playsinline
  muted
  preload="metadata"
></video>

  <a href="/bytopic/AI in Consulting" class="single-topic-resource-btn">
    <button class="topic-resource-btn" style="margin-bottom: 200px">
      let me show you Twennie's units on this topic
    </button>
  </a>


  </div>

  {{> topicpartials/topics_column_partial}}
</div>

<script>
  function toggleCard(element) {
    let card = element.closest('.bytopic-library-unit-card');
    card.classList.toggle('active');
    let arrow = element.querySelector('.bytopic-arrow-icon');
    arrow.classList.toggle('open');
  }

  (function() {
  const v = document.getElementById('bluey-cta-video');
  if (!v) return;

  // Force muted + inline (some browsers ignore attribute order)
  v.muted = true;

  // Play once only
  v.addEventListener('ended', () => v.pause(), { once: true });

  // Try to play as soon as it can
  const tryPlay = () => v.play().catch(err => {
    // If autoplay is blocked, we’ll start on the first user gesture instead
    // console.warn('Autoplay blocked:', err);
  });

  v.addEventListener('canplay', tryPlay, { once: true });

  // Start when visible (helps some mobile browsers)
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { tryPlay(); io.disconnect(); }
    }, { threshold: 0.2 });
    io.observe(v);
  }

  // Fallback: first user interaction
  const kick = () => { tryPlay(); window.removeEventListener('pointerdown', kick); };
  window.addEventListener('pointerdown', kick, { once: true });

  // Safety net: attempt again shortly after load
  setTimeout(tryPlay, 400);
})();

(() => {
  const v = document.getElementById('bluey-cta-video');
  if (!v) return;

  const log = (...a) => console.log('[bluey video]', ...a);

  ['loadedmetadata','canplay','playing','pause','ended','error','stalled','suspend'].forEach(ev =>
    v.addEventListener(ev, () => log(ev, { readyState: v.readyState, networkState: v.networkState }))
  );

  v.addEventListener('error', () => {
    const e = v.error;
    log('error detail', e && { code: e.code, message: e.message });
  });
})();

</script>
