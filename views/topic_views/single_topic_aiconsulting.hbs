<script>
  function toggleCard(element) {
    let card = element.closest('.bytopic-library-unit-card');
    card.classList.toggle('active');
    let arrow = element.querySelector('.bytopic-arrow-icon');
    arrow.classList.toggle('open');
  }

(function() {
  const v = document.getElementById('bluey-cta-video');
  if (!v) return;

  // Ensure muted for autoplay policies
  v.muted = true;

  // Try to play once we can
  function tryPlay() { v.play().catch(()=>{}); }
  v.addEventListener('canplay', tryPlay, { once: true });

  // Stop after one loop
  v.addEventListener('ended', () => v.pause(), { once: true });

  // Visibility nudge for mobile
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { tryPlay(); io.disconnect(); }
    }, { threshold: 0.2 });
    io.observe(v);
  }

  // User gesture fallback if autoplay is blocked
  const kick = () => { tryPlay(); window.removeEventListener('pointerdown', kick); };
  window.addEventListener('pointerdown', kick, { once: true });
})();



</script>
