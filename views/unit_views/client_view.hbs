{{!-- File: views/unit_views/client_view.hbs --}}
{{#*inline "title"}}Nuggets by Client | Twennie{{/inline}}

<div class="mineclients-container bytopic-container">
  <!-- Hero -->
  <div class="mineclients-hero">
    <h1 class="mineclients-title bytopic-title">{{#if pageTitle}}{{pageTitle}}{{else}}Nuggets by Client{{/if}}</h1>
    <img src="/images/clientbluey.png" alt="Client Bluey" class="mineclients-hero-img" />
    {{#if pageIntro}}<p class="mineclients-intro bytopic-short-summary">{{pageIntro}}</p>{{/if}}
    {{#if shortSummary}}<p class="mineclients-short-summary bytopic-short-summary">{{shortSummary}}</p>{{/if}}
    {{#if longSummary}}<p class="mineclients-long-summary bytopic-long-summary">{{longSummary}}</p>{{/if}}
  </div>

  <!-- Main content + right rail (mirrors bytopic layout) -->
  <div class="mineclients-content has-right-rail bytopic-content">
    {{!-- Sectioned nuggets --}}
    {{#each sectionedNuggets}}
      <h2 class="mineclients-section-title bytopic-section-title">{{this.sectionTitle}}</h2>
      <hr class="mineclients-section-divider bytopic-section-divider">

      {{#if this.nuggets.length}}
        <div class="mineclients-nuggets-grid bytopic-library-units-grid">
          {{#each this.nuggets}}
            <article class="mineclients-nugget-card bytopic-library-unit-card" data-nugget-id="{{_id}}">
              <!-- Header wave -->
              <div class="mineclients-card-svg-header bytopic-card-svg-header">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 198.89 17.83" aria-hidden="true" focusable="false">
                  <defs><style>.cls-1 { fill: #4e50a2; }</style></defs>
                  <path class="cls-1" d="M0,9.74s30.57,13.88,92.83,1.88c0,0,68.2-13.17,106.06,6.21V0H0v9.74Z"/>
                </svg>
              </div>

              <!-- Card content -->
              <div class="mineclients-card-content bytopic-card-content">
                <div class="mineclients-visible-content bytopic-visible-content">
                  <div class="mineclients-nugget-icon-container bytopic-unit-type-icon-container">
                    <img src="/images/icons/nuggeticon.svg" alt="Nugget icon" class="mineclients-nugget-icon bytopic-unit-type-icon">
                  </div>

                  {{!-- Per spec: the title on CLIENT view is the client name --}}
                  <div class="mineclients-nugget-title-container bytopic-unit-title-container">
                    <h2 class="mineclients-nugget-title bytopic-unit-title">{{client}}</h2>
                  </div>
                </div>

                <!-- Expand Toggle -->
                <button class="mineclients-expand-toggle bytopic-expand-toggle" type="button"
                        onclick="toggleMineClientCard(this)" aria-expanded="false" aria-label="Toggle details">
                  <svg class="expand-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 331.65 100.99" aria-hidden="true" focusable="false">
                    <defs><style>.cls-1 { fill: #4e50a2; }</style></defs>
                    <polygon class="cls-1" points="0 0 161.57 100.99 331.65 0 0 0"/>
                  </svg>
                </button>

                <!-- Hidden (expanded) content -->
                <div class="mineclients-hidden-content bytopic-hidden-content" style="display:none;">
                  <div class="mineclients-meta-badges">
                    {{#if horizon}}<span class="mineclients-badge">horizon: {{horizon}}</span>{{/if}}
                    {{#if discipline}}<span class="mineclients-badge">discipline: {{discipline}}</span>{{/if}}
                    {{#if region}}<span class="mineclients-badge">region: {{region}}</span>{{/if}}
                    {{#if projectDeliveryType}}<span class="mineclients-badge">delivery: {{projectDeliveryType}}</span>{{/if}}
                    {{#if likelihood}}<span class="mineclients-badge">likelihood: {{likelihood}}%</span>{{/if}}
                    {{#if estimatedValue.amount}}
                      <span class="mineclients-badge">est. value: {{estimatedValue.currency}} {{estimatedValue.amount}}</span>
                    {{/if}}
                  </div>

                  {{#if title}}
                    <div class="mineclients-detail-row">
                      <strong>working title:</strong>&nbsp;<span>{{title}}</span>
                    </div>
                  {{/if}}

                  {{#if originalSource}}
                    <div class="mineclients-detail-row">
                      <strong>source:</strong>&nbsp;
                      {{#if originalSource.url}}
                        <a href="{{originalSource.url}}" target="_blank" rel="noopener">{{originalSource.label}}</a>
                      {{else}}
                        <span>{{originalSource.label}}</span>
                      {{/if}}
                    </div>
                  {{/if}}

                  {{#if notes}}
                    <div class="mineclients-notes">
                      <p>{{notes}}</p>
                    </div>
                  {{/if}}

                  <div class="mineclients-actions bytopic-unit-review-container">
                    <a href="/unitviews/nuggets/view/{{_id}}" class="mineclients-view-btn bytopic-unit-review-btn">
                      view nugget
                    </a>
                  </div>
                </div>
              </div>
            </article>
          {{/each}}
        </div>
      {{else}}
        <div class="mineclients-empty-section-message bytopic-empty-section-message">
          {{#if this.emptyMessage}}<p>{{this.emptyMessage}}</p>{{/if}}
        </div>
      {{/if}}
    {{/each}}
  </div>

  <!-- Right Topics Column (reused partial) -->
  <div class="mineclients-right-rail bytopic-page">
    {{> topicpartials/topics_column_partial}}
  </div>
</div>

<script>
  function toggleMineClientCard(el) {
    const card = el.closest('.mineclients-nugget-card');
    const content = card.querySelector('.mineclients-hidden-content');
    const isOpen = card.classList.contains('active');
    card.classList.toggle('active', !isOpen);
    el.setAttribute('aria-expanded', String(!isOpen));
    if (content) content.style.display = isOpen ? 'none' : 'flex';
  }
</script>

