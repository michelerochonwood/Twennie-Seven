{{!-- views/unit_views/missions_rogue.hbs --}}
{{#*inline "title"}}{{title}} | Twennie{{/inline}}

<div class="mission-category-container">
  <!-- Main content column -->
  <div class="mission-category-content mission-has-right-rail">
    <h1 class="mission-category-title">{{title}}</h1>

    {{#if shortSummary}}
      <p class="mission-category-short-summary">{{shortSummary}}</p>
    {{/if}}

    {{#if longSummary}}
      <p class="mission-category-long-summary">{{longSummary}}</p>
    {{/if}}

    <hr class="mission-category-key-divider">

    <!-- Mission Card SVG Key -->
    <div class="mission-category-unit-key" aria-label="Mission card key">
      <div class="mission-category-unit-key-item">
        <span class="mission-category-unit-key-label">mission</span>
        <img
          src="/icons/onyxsvg.svg"
          alt=""
          aria-hidden="true"
          class="mission-category-unit-key-svg"
        >
      </div>
    </div>

    <hr class="mission-category-key-divider">

    <!-- Mission Type Key -->
    <div class="mission-category-unit-type-key" aria-label="Mission type key">
      <div class="mission-category-unit-type-key-item">
        <img
          src="/images/missionicon.png"
          alt=""
          aria-hidden="true"
          class="mission-category-unit-type-key-icon"
        >
        <div class="mission-category-unit-type-desc">
          A structured assignment designed to turn light workload periods into purposeful learning, research, business development, or improvement work.
        </div>
      </div>
    </div>

    <hr class="mission-category-key-divider">

    {{#each sectionedMissions}}
      <h2 class="mission-category-section-title">{{this.sectionTitle}}</h2>
      <hr class="mission-category-section-divider">

      {{#if this.missions.length}}
        <div class="mission-category-grid">

          {{#each this.missions}}
            <article class="mission-category-card" data-mission-id="{{_id}}">

              <div class="mission-category-card-top-badges">
                <div class="mission-category-card-top-badge mission-category-card-author-badge">
                  <img
                    src="{{#if creatorImage}}{{creatorImage}}{{else}}/images/default-avatar.png{{/if}}"
                    alt="{{creatorName}}"
                    class="mission-category-card-author-mini"
                  >
                </div>

                {{#if organizationId}}
                  <div class="mission-category-card-top-badge mission-category-card-org-badge">
                    <a href="/profile/organization/{{organizationId}}" class="mission-category-card-org-link">
                      <img
                        src="{{#if organizationLogo}}{{organizationLogo}}{{else}}/images/default-organization-logo.png{{/if}}"
                        alt="{{#if organizationName}}{{organizationName}}{{else}}Organization{{/if}} logo"
                        class="mission-category-card-org-logo"
                      >
                    </a>
                  </div>
                {{/if}}
              </div>

              <div class="mission-category-card-inner">

                <!-- Mission SVG Header -->
                <div class="mission-category-card-svg-header">
                  <img
                    src="/icons/onyxsvg.svg"
                    alt=""
                    aria-hidden="true"
                    class="mission-category-card-svg-image"
                  >
                </div>

                <!-- Card Content -->
                <div class="mission-category-card-content">
                  <!-- Always-visible content -->
                  <div class="mission-category-visible-content">
                    <div class="mission-category-unit-type-icon-container">
                      <img
                        src="/images/missionicon.png"
                        alt="Rogue mission icon"
                        class="mission-category-unit-type-icon"
                      >
                    </div>

                    <div class="mission-category-unit-title-container">
                      <h2 class="mission-category-unit-title">
                        {{mission_title}}
                      </h2>
                    </div>

                    <p class="mission-category-label">
                      Your mission, should you choose to accept it, is to…
                    </p>
                  </div>

                  <!-- Expand Toggle -->
                  <button
                    class="mission-category-expand-toggle"
                    type="button"
                    onclick="toggleMissionCard(this)"
                    aria-expanded="false"
                    aria-label="Toggle mission details"
                  >
                    <svg
                      class="mission-category-expand-arrow"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 331.65 100.99"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <defs><style>.cls-1 { fill: #4e50a2; }</style></defs>
                      <polygon
                        class="cls-1"
                        points="0 0 161.57 100.99 331.65 0 0 0"
                      />
                    </svg>
                  </button>

                  <!-- Expandable content -->
                  <div class="mission-category-hidden-content" style="display:none;">
                    <div class="mission-category-author-label">
                      CREATOR
                    </div>

                    <div class="mission-category-author-image-container">
                      <img
                        src="{{#if creatorImage}}{{creatorImage}}{{else}}/images/default-avatar.png{{/if}}"
                        alt="{{creatorName}}"
                        class="mission-category-author-image"
                      >
                    </div>

                    <div class="mission-category-author-name-container">
                      <span class="mission-category-author-name">
                        {{creatorName}}
                      </span>
                    </div>

                    <div class="mission-category-summary-container">
                      <p class="mission-category-long-text">
                        {{#if summary}}
                          {{summary}}
                        {{else}}
                          {{purpose}}
                        {{/if}}
                      </p>
                    </div>

                    <div class="mission-category-review-container mission-category-cta-container">
                      {{#if loggedIn}}
                        {{#if isLeaderOrGroupMember}}
                          <a
                            href="/unitviews/missions/view/{{_id}}"
                            class="mission-category-review-btn"
                          >
                            review this unit
                          </a>
                        {{else if isPaid}}
                          <a
                            href="/unitviews/missions/view/{{_id}}"
                            class="mission-category-review-btn"
                          >
                            review this unit
                          </a>
                        {{else}}
                          <div class="mission-category-review-btn mission-category-cta-disabled">
                            membership upgrade required
                          </div>
                        {{/if}}
                      {{else}}
                        <div class="mission-category-review-btn mission-category-cta-disabled">
                          login required
                        </div>
                      {{/if}}
                    </div>

                  </div>
                </div>

              </div>
            </article>
          {{/each}}

        </div>
      {{else}}
        <div class="mission-category-empty-section-message">
          {{#if this.emptyMessage}}<p>{{this.emptyMessage}}</p>{{/if}}
        </div>
      {{/if}}
    {{/each}}
  </div>

  <!-- Right Topics Column -->
  <div class="mission-category-page">
    {{> topicpartials/topics_column_partial}}
  </div>
</div>

<script>
  function toggleMissionCard(el) {
    var card = el.closest('.mission-category-card');
    if (!card) return;

    var content = card.querySelector('.mission-category-hidden-content');
    if (!content) return;

    var isOpen = card.classList.contains('active');
    card.classList.toggle('active', !isOpen);
    el.setAttribute('aria-expanded', String(!isOpen));
    content.style.display = isOpen ? 'none' : 'flex';
  }
</script>

