{{#*inline "title"}}Mission Control | Twennie{{/inline}}

<div class="mine-wrapper">  {{!-- reuse same outer wrapper styling as the Mine --}}
  <h1 class="mine-title">Welcome to Mission Control</h1>

  <div class="mine-hero">
    <img src="/images/spybluey.png"
         alt="Bluey Ethan Hunt, Twennie mission mascot"
         class="mine-hero-img"
         style="width: 250px" />
  </div>

  <p class="mine-subtitle">
    When the workload is light, your missions keep you sharp. Choose a mission type to explore
    structured, time-bound assignments that make downtime feel like progress.
  </p>

  <div class="mine-grid">

    <!-- LEARNING -->
    <a href="/unitviews/missioncontrol/learning"
       class="mine-card"
       aria-label="Browse learning missions"
       title="Browse learning missions">
      <div class="mine-card-inner">
        <div class="mine-card-icon">
          <img src="/images/mission_learning.png" alt="learning missions icon" style="width: 110px;">
        </div>
        <p class="mine-card-label">learning missions</p>
      </div>
    </a>

