{{#*inline "title"}}View Nugget | Twennie{{/inline}}

<div class="single_nugget-container">
  <!-- Main Section -->
  <div class="single_nugget-main">
    <h1 class="single_nugget-title">{{title}}</h1>

    <!-- Summary -->
    <div class="single_nugget-summary white-container">
      <p><strong>Client:</strong> {{client}}</p>
      <p><strong>Horizon:</strong>
        {{#ifEquals horizon "1y"}}1 Year{{/ifEquals}}
        {{#ifEquals horizon "3y"}}3 Years{{/ifEquals}}
        {{#ifEquals horizon "5y"}}5 Years{{/ifEquals}}
      </p>
      <p><strong>Discipline:</strong> {{discipline}}</p>
      <p><strong>Region:</strong> {{region}}</p>
    </div>

    <!-- Core Details -->
    <div class="single_nugget-details white-container">
      <h3>Project Details</h3>
      <p><strong>Estimated Value:</strong>
        {{#if estimatedValue.amount}}
          ${{estimatedValue.amount}} {{estimatedValue.currency}}
        {{else}}Not available{{/if}}
      </p>
      <p><strong>Project Delivery Type:</strong> {{projectDeliveryType}}</p>
      <p><strong>Win Probability:</strong> {{likelihood}}%</p>
      <p><strong>Original Source:</strong>
        <a href="{{originalSource.url}}" target="_blank" rel="noopener">
          {{#if originalSource.label}}{{originalSource.label}}{{else}}{{originalSource.url}}{{/if}}
        </a>
      </p>
      {{#if notes}}
        <div class="single_nugget-notes">
          <h4>Notes</h4>
          <p>{{notes}}</p>
        </div>
      {{/if}}
    </div>

    <!-- Connected Units -->
    <div class="single_nugget-connected-units white-container">
      <h3>Connected Twennie Units</h3>
      {{#if connectedTwennieUnits.length}}
        <ul class="connected-unit-list">
          {{#each connectedTwennieUnits}}
            <li>
              <a
                href="/unitviews/{{this.kind}}s/view/{{this.unitId}}"
                class="connected-unit-link"
                rel="noopener"
              >
                {{capitalize this.kind}}: {{this.unitId}}
              </a>
              {{#if this.note}}<p class="connected-unit-note">{{this.note}}</p>{{/if}}
            </li>
          {{/each}}
        </ul>
      {{else}}
        <p>No connected units yet. Leaders can link this nugget to articles, videos, or prompt sets.</p>
      {{/if}}
    </div>

    <!-- Tagging / Assignments (Leader) -->
   {{#if isLeader}}
  {{#unless isAssignedToCurrentUser}}
    <div class="assign-tag-form white-container">
      <h4>Assign this nugget</h4>

      <form id="assignNuggetForm" action="/tags/create" method="POST">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <input type="hidden" name="itemId" value="{{_id}}">
        <input type="hidden" name="itemType" value="nugget">

        <div class="form-field">
          <label for="tagName">Give the assignment a name</label>
          <input type="text" id="tagName" name="tagName" required>
        </div>

        <fieldset class="assign-tag-members">
          <legend>Select recipients and enter instructions:</legend>

          <div class="assign-tag-member-block">
            <label>
              <input
                type="checkbox"
                name="assignedTo[{{leaderId}}][member]"
                value="{{leaderId}}"
                onchange="toggleInstructionField(this)"
              >
              {{leaderName}} (you)
            </label>
            <textarea
              class="assign-tag-instructions"
              name="assignedTo[{{leaderId}}][instructions]"
              placeholder="Instructions for yourself"
              style="display:none;"
            ></textarea>
          </div>

          <hr>

          {{#each groupMembers}}
            <div class="assign-tag-member-block">
              <label>
                <input
                  type="checkbox"
                  name="assignedTo[{{_id}}][member]"
                  value="{{_id}}"
                  onchange="toggleInstructionField(this)"
                >
                {{name}}
              </label>
              <textarea
                class="assign-tag-instructions"
                name="assignedTo[{{_id}}][instructions]"
                placeholder="Instructions for {{name}}"
                style="display:none;"
              ></textarea>
            </div>
          {{/each}}
        </fieldset>

        <button type="submit" class="form-button submit-button">assign nugget</button>
      </form>
    </div>
  {{/unless}}
{{/if}}

    {{!-- Admin: suggest this unit to org leaders --}}
{{#if isOrgAdmin}}
  <div class="assign-tag-form white-container" style="margin-top:1.25rem;">
        {{!-- ✅ SUCCESS MESSAGE --}}
    {{#if (and suggestionSuccess (eq suggestedUnitId _id))}}
      <div class="success-message" style="
        margin-bottom:0.75rem;
        padding:0.6rem 0.75rem;
        background:#e9f7ef;
        color:#0f5132;
        border-radius:6px;
        font-weight:600;
      ">
        ✅ Suggestions sent successfully.
      </div>
    {{/if}}
    <h4 class="assign-tag-title">Suggest this nugget to your organization's leaders</h4>
    <p class="groupsection-org-card-info" style="margin-top:0.25rem;">
      Send a suggestion to one or more leaders in your organization.
    </p>

    <form id="suggestNuggetForm-{{_id}}" action="/unitsuggestions/org-suggestions/create" method="POST">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <input type="hidden" name="unitId" value="{{_id}}">
      <input type="hidden" name="unitType" value="nugget">

      <fieldset class="assign-tag-members">
        <legend class="assign-tag-legend">Select leaders and add a note, if needed:</legend>

        {{#each orgLeaders}}
          <div class="assign-tag-member-block">
            <label class="assign-tag-member-label">
              <input
                type="checkbox"
                name="suggestTo[{{_id}}][leader]"
                value="{{_id}}"
                onchange="toggleSuggestNoteField(this)">
              {{groupLeaderName}}{{#if groupName}} — {{groupName}}{{/if}}
            </label>

            <textarea
              class="assign-tag-instructions"
              name="suggestTo[{{_id}}][note]"
              placeholder="Optional note for {{groupLeaderName}}"
              style="display:none;"></textarea>
          </div>
        {{/each}} 
      </fieldset>

      <button type="submit" class="form-button submit-button">send suggestions</button>
    </form>
  </div>
{{/if}}


    <!-- Member/Group Member Quick Tag -->
{{#if isGroupMemberOrMember}}
  {{#unless isAssignedToCurrentUser}}
    <div class="single_unit-tag-container">
      <form action="/tags/create" method="POST" class="inline" id="nuggetTagForm">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <input type="hidden" name="itemId" value="{{_id}}">
        <input type="hidden" name="itemType" value="nugget">
        <input type="hidden" name="tagName" value="Watch Later">
        <input type="hidden" name="assignedTo[{{currentUserId}}][member]" value="{{currentUserId}}">

        <button
          type="button"
          class="tag-this-unit-link"
          onclick="promptAndSubmitTag('nuggetTagForm')"
        >
          assign this nugget to myself
        </button>
      </form>
    </div>
  {{/unless}}
{{/if}}

  </div> <!-- /.single_nugget-main -->
{{#if canAddNuggetMonitoringNotes}}
  <div class="single_nugget-notes-container">
    <h3 class="single_nugget-notes-title">record monitoring notes for this nugget</h3>
    <p class="single_nugget-notes-instructions">
      Use this space to record what you are learning as you monitor this opportunity. Add updates, new signals, changes in timing, client movement, risk, or anything your team should know. These notes help maintain continuity as monitoring changes hands.
    </p>

    <form action="/notes/submit-nugget-monitoring" method="POST" class="single_nugget-notes-form">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <input type="hidden" name="unitId" value="{{_id}}">
      <input type="hidden" name="unitType" value="nugget">
      <input type="hidden" name="main_topic" value="{{discipline}}">
      <input type="hidden" name="secondary_topic" value="{{region}}">

      <textarea
        name="note_content"
        class="single_nugget-notes-textarea"
        rows="5"
        maxlength="2000"
        placeholder="Record what you are noticing about this nugget..."
      ></textarea>

      <button type="submit" class="single_nugget-notes-submit">save monitoring notes</button>
    </form>
  </div>
{{else}}
  <div class="single_nugget-notes-container">
    <h3 class="single_nugget-notes-title">record monitoring notes for this nugget</h3>
    <p class="single_nugget-notes-instructions">
      If you will be monitoring itAssign this nugget to yourself first , so your updates stay connected to the dashboard and reporting properly.
    </p>
  </div>
{{/if}}

  <!-- Sidebar -->
  <aside class="single_nugget-sidebar">
    <!-- Top: centered nugget icon + title -->
    <div class="single_nugget-sideheader">
      <div class="single_nugget-icon-wrap" aria-hidden="true">
        <img src="/images/nuggeticon.png" alt="" class="single_nugget-icon">
      </div>
      <h2 class="single_nugget-side-title" title="{{title}}">{{title}}</h2>
    </div>

    <!-- Creator -->
    <div class="single_nugget-author">
      <img src="{{creator.image}}" alt="Creator Image" class="single_nugget-author-image">
      <p class="single_nugget-author-name">Created by: {{creator.name}}</p>
    </div>

    <!-- Meta / actions -->
    <div class="single_nugget-details-meta">
      {{#if isOwner}}
        <a href="/unitform/edit_nugget/{{_id}}" class="single_nugget-edit-btn">edit this nugget</a>
      {{/if}}
    </div>
  </aside>
</div>

<script>
  function toggleInstructionField(checkbox) {
    const memberId = checkbox.value;
    const selector = `textarea[name="assignedTo[${memberId}][instructions]"]`;
    const textarea = document.querySelector(selector);
    if (textarea) textarea.style.display = checkbox.checked ? 'block' : 'none';
  }

  function toggleSuggestNoteField(checkbox) {
  const leaderId = checkbox.value;
  const selector = `textarea[name="suggestTo[${leaderId}][note]"]`;
  const textarea = document.querySelector(selector);
  if (textarea) textarea.style.display = checkbox.checked ? 'block' : 'none';
}


  function promptAndSubmitTag(formId) {
    const form = document.getElementById(formId);
    const btn  = form.querySelector('.tag-this-unit-link');
    const input = form.querySelector('input[name="tagName"]');
    const suggested = (input.value || 'Watch Later').trim();
    const entered = window.prompt('Name this tag', suggested);
    if (!entered) return;
    input.value = entered.trim();
    if (!input.value) return;
    if (btn) btn.disabled = true;
    form.submit();
  }
</script>

