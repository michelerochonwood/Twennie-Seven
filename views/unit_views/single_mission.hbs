{{#*inline "title"}}View Mission | Twennie{{/inline}}

<div class="single_mission-container">
  <!-- Main Column -->
  <div class="single_mission-main">
    <!-- Title -->
    <h1 class="single_mission-main-title">{{mission_title}}</h1>

    {{#if short_purpose}}
      <p class="single_mission-short-summary">{{short_purpose}}</p>
    {{/if}}

    <!-- Intro: tagline + full summary + main toggle -->
    <section class="white-container single_mission-intro">
      <p class="single_mission-tagline">
        Your mission, should you choose to accept it, is to…
      </p>

      {{#if full_summary}}
        <p class="single_mission-long-summary">
          {{nl2br full_summary}}
        </p>
      {{/if}}

      <button
        type="button"
        class="single_mission-toggle-btn"
        onclick="toggleMissionDetails(this)"
        aria-expanded="false"
        aria-label="Toggle mission details"
      >
        <svg class="single_mission-main-arrow-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 331.65 100.99">
          <defs><style>.cls-1 { fill: #4e50a2; }</style></defs>
          <g><polygon class="cls-1" points="0 0 161.57 100.99 331.65 0 0 0"/></g>
        </svg>
      </button>
    </section>




    <!-- MAIN BODY: hidden until user opens it -->
    <div class="single_mission-main-body hidden" id="singleMissionBody">
      {{!-- MISSION BADGE (image + name) --}}
{{#if badgeImagePath}}
  <section class="white-container single_mission-badge">
    <div class="single_mission-badge-inner">
      <img
        src="{{badgeImagePath}}"
        alt="{{badge_name}}"
        class="single_mission-badge-image"
      />
      {{#if badge_name}}
        <p class="single_mission-badge-name">{{badge_name}}</p>
      {{/if}}
    </div>
  </section>
{{/if}}


    <!-- LEARNING UNITS -->
<section class="white-container single_mission-section">
  <h2 class="single_mission-section-title">learning units</h2>

  <p class="form-hint">
    These are the Twennie units and assignments that make up this mission.
  </p>

  {{#if learningUnits.length}}
    <ul class="single_mission-learning-units" style="margin:0; padding-left:18px;">
      {{#each learningUnits}}
        <li style="margin:6px 0;">
          <a href="{{url}}" style="color:#4e50a2; font-weight:600; text-decoration:none;">
            {{displayType}}: {{title}}
          </a>
        </li>
      {{/each}}
    </ul>
  {{else}}
    <p class="single_mission-text" style="margin:0; color:#6b7280;">
      No learning units have been added to this mission yet.
    </p>
  {{/if}}
</section>



      <!-- PURPOSE / WHY / BACKGROUND -->
      <section class="white-container single_mission-section">
        <h2 class="single_mission-section-title">mission purpose</h2>
        <p class="single_mission-text">{{nl2br purpose}}</p>
      </section>

      <section class="white-container single_mission-section">
        <h2 class="single_mission-section-title">why this mission matters</h2>
        <p class="single_mission-text">{{nl2br why_it_matters}}</p>
      </section>

      {{#if background}}
        <section class="white-container single_mission-section">
          <h2 class="single_mission-section-title">background</h2>
          <p class="single_mission-text">{{nl2br background}}</p>
        </section>
      {{/if}}

      <!-- DETAILS -->
      <section class="white-container single_mission-section">
        <h2 class="single_mission-section-title">mission details</h2>
        <dl class="single_mission-details-list">
          {{#if department_requesting}}
            <div class="details-row">
              <dt>Requesting department</dt>
              <dd>{{department_requesting}}</dd>
            </div>
          {{/if}}

          {{#if job_number}}
            <div class="details-row">
              <dt>Job number</dt>
              <dd>{{job_number}}</dd>
            </div>
          {{/if}}

          {{#if budget_amount}}
            <div class="details-row">
              <dt>Budget amount</dt>
              <dd>{{budget_amount}}</dd>
            </div>
          {{/if}}

          {{#if due_date}}
            <div class="details-row">
              <dt>Due date</dt>
              <dd>{{due_date}}</dd>
            </div>
          {{/if}}

          {{#if visibility}}
            <div class="details-row">
              <dt>Visibility</dt>
              <dd>
                {{#ifEquals visibility "team_only"}}team only{{/ifEquals}}
                {{#ifEquals visibility "organization_only"}}organization only{{/ifEquals}}
                {{#ifEquals visibility "all_members"}}all Twennie members{{/ifEquals}}
              </dd>
            </div>
          {{/if}}

          {{#if main_topic}}
            <div class="details-row">
              <dt>Main topic</dt>
              <dd>{{main_topic}}</dd>
            </div>
          {{/if}}
        </dl>
      </section>

      <!-- APPROVALS REQUIRED -->
      {{#if approvals_required.length}}
        <section class="white-container single_mission-section">
          <h2 class="single_mission-section-title">approvals required</h2>
          <p class="form-hint">
            These people / roles need to review or approve this mission or its outputs.
          </p>
          <ul class="single_mission-approvals-list">
            {{#each approvals_required}}
              <li class="approval-row">
                <strong>{{role}}</strong>
                {{#if name}} – {{name}}{{/if}}
                {{#if email}}
                  <span class="approval-email">&lt;{{email}}&gt;</span>
                {{/if}}
              </li>
            {{/each}}
          </ul>
        </section>
      {{/if}}

      <!-- TASK INSTRUCTIONS -->
      {{#if task_instructions.length}}
        <section class="white-container single_mission-section">
          <h2 class="single_mission-section-title">task instructions</h2>
          {{#each task_instructions}}
            <div class="single_mission-task-block">
              {{#if heading}}
                <h3 class="single_mission-task-heading">{{heading}}</h3>
              {{/if}}

              {{#if instructions.length}}
                <ul class="single_mission-task-list">
                  {{#each instructions}}
                    <li>{{this}}</li>
                  {{/each}}
                </ul>
              {{/if}}
            </div>
          {{/each}}
        </section>
      {{/if}}

      <!-- DELIVERABLES -->
      {{#if deliverables_checklist.length}}
        <section class="white-container single_mission-section">
          <h2 class="single_mission-section-title">deliverables checklist</h2>
          <ul class="single_mission-deliverables-list">
            {{#each deliverables_checklist}}
              <li>{{this}}</li>
            {{/each}}
          </ul>
        </section>
      {{/if}}

      <!-- CONTACTS -->
      {{#if contacts.length}}
        <section class="white-container single_mission-section">
          <h2 class="single_mission-section-title">contacts</h2>
          <p class="form-hint">These people can answer questions or help unblock progress on this mission.</p>
          <ul class="single_mission-contacts-list">
            {{#each contacts}}
              <li class="contact-row">
                <strong>{{role}}</strong>
                {{#if name}} – {{name}}{{/if}}
                {{#if email}} · <a href="mailto:{{email}}">{{email}}</a>{{/if}}
                {{#if phone}} · {{phone}}{{/if}}
              </li>
            {{/each}}
          </ul>
        </section>
      {{/if}}

      <!-- LEADER: assign mission via tags -->
      {{#if isLeader}}
        <div class="assign-tag-form white-container">
          <h4 class="assign-tag-title">Assign this mission to yourself or your group</h4>

          <form id="assignMissionTagForm" action="/tags/create" method="POST">
            <input type="hidden" name="_csrf" value="{{csrfToken}}">
            <input type="hidden" name="itemId" value="{{_id}}">
            <input type="hidden" name="itemType" value="mission">

            <div class="form-field">
              <label for="missionTagName">Give the assignment a name</label>
              <input type="text" id="missionTagName" name="tagName" required>
            </div>

            <fieldset class="assign-tag-members">
              <legend class="assign-tag-legend">Select recipients and enter instructions:</legend>

              <!-- Leader self-assignment -->
              <div class="assign-tag-member-block">
                <label class="assign-tag-member-label">
                  <input
                    type="checkbox"
                    name="assignedTo[{{leaderId}}][member]"
                    value="{{leaderId}}"
                    onchange="toggleInstructionField(this)">
                  {{leaderName}} (you)
                </label>
                <textarea
                  class="assign-tag-instructions"
                  name="assignedTo[{{leaderId}}][instructions]"
                  placeholder="Instructions for yourself"
                  style="display:none;"></textarea>
              </div>

              <hr class="assign-tag-divider">

              <!-- Group members -->
              {{#each groupMembers}}
                <div class="assign-tag-member-block">
                  <label class="assign-tag-member-label">
                    <input
                      type="checkbox"
                      name="assignedTo[{{_id}}][member]"
                      value="{{_id}}"
                      onchange="toggleInstructionField(this)">
                    {{name}}
                  </label>
                  <textarea
                    class="assign-tag-instructions"
                    name="assignedTo[{{_id}}][instructions]"
                    placeholder="Instructions for {{name}}"
                    style="display:none;"></textarea>
                </div>
              {{/each}}
            </fieldset>

            <button type="submit" class="form-button submit-button">assign mission</button>
          </form>
        </div>
      {{/if}}

      {{!-- Admin: suggest this unit to org leaders --}}
{{#if isOrgAdmin}}
  <div class="assign-tag-form white-container" style="margin-top:1.25rem;">
    <h4 class="assign-tag-title">Suggest this mission to organization leaders</h4>
    <p class="groupsection-org-card-info" style="margin-top:0.25rem;">
      Send a suggestion (with an optional note) to one or more leaders in your organization.
    </p>

    <form id="suggestMissionForm-{{_id}}" action="/unitsuggestions/org-suggestions/create" method="POST">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <input type="hidden" name="unitId" value="{{_id}}">
      <input type="hidden" name="unitType" value="mission">

      <fieldset class="assign-tag-members">
        <legend class="assign-tag-legend">Select leaders and optionally add a note:</legend>

        {{#each orgLeaders}}
          <div class="assign-tag-member-block">
            <label class="assign-tag-member-label">
              <input
                type="checkbox"
                name="suggestTo[{{_id}}][leader]"
                value="{{_id}}"
                onchange="toggleSuggestNoteField(this)">
              {{groupLeaderName}}{{#if groupName}} — {{groupName}}{{/if}}
            </label>

            <textarea
              class="assign-tag-instructions"
              name="suggestTo[{{_id}}][note]"
              placeholder="Optional note for {{groupLeaderName}}"
              style="display:none;"></textarea>
          </div>
        {{/each}}
      </fieldset>

      <button type="submit" class="form-button submit-button">send suggestions</button>
    </form>
  </div>
{{/if}}


      <!-- MEMBER / GROUP MEMBER: quick 'tag this mission' -->
      {{#if isGroupMemberOrMember}}
        <div class="single_unit-tag-container" style="margin-bottom:200px;">
          <form action="/tags/create" method="POST" class="inline" id="missionTagForm">
            <input type="hidden" name="_csrf" value="{{csrfToken}}">
            <input type="hidden" name="itemId" value="{{_id}}">
            <input type="hidden" name="itemType" value="mission">
            <input type="hidden" name="tagName" value="Work on this mission">
            <button type="button"
                    class="tag-this-unit-link"
                    onclick="promptAndSubmitTag('missionTagForm')"
                    style="background:none;border:none;padding:0;cursor:pointer;">
              tag this mission
              <svg class="tag-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 39.48 36.66">
                <path class="cls-1" d="M38.77,21.12L16.05.56C15.65.19,15.13,0,14.59,0L2.12.16c-1.18.01-2.12.97-2.12,2.15v11.2c0,.63.28,1.24.77,1.64l24.95,21c.9.76,2.24.65,3.01-.24l10.23-11.8c.77-.88.69-2.22-.18-3ZM6.28,8.87c-1.57,0-2.84-1.27-2.84-2.84s1.27-2.84,2.84-2.84,2.84,1.27,2.84,2.84-1.27,2.84-2.84,2.84Z"/>
              </svg>
            </button>
          </form>
        </div>
      {{/if}}



      <!-- NOTES -->
      {{#if isGroupMemberOrLeader}}
        <div class="single_mission-notes-container">
          <h3 class="single_mission-notes-title">record notes</h3>
          <p class="single_mission-notes-instructions">
            Capture your observations as you work on this mission: what you learned, what surprised you, and ideas for next steps.
            These notes will be part of your Twennie learning record.
          </p>

          <form action="/notes/submit" method="POST" class="single_mission-notes-form">
            <input type="hidden" name="_csrf" value="{{csrfToken}}">
            <input type="hidden" name="unitId" value="{{_id}}">
            <input type="hidden" name="unitType" value="mission">
            <input type="hidden" name="main_topic" value="{{main_topic}}">
            <input type="hidden" name="secondary_topic" value="{{sub_topic}}">

            <textarea
              name="note_content"
              class="single_mission-notes-textarea"
              rows="5"
              maxlength="1000"
              placeholder="Write your notes here..."
            ></textarea>

            <button type="submit" class="single_mission-notes-submit">submit notes</button>
          </form>
        </div>
      {{/if}}
    </div> <!-- /.single_mission-main-body -->
  </div>

<!-- Sidebar -->
<aside class="single_mission-sidebar">
  <!-- Icon -->
  <div class="single_mission-icon-container">
    <img src="/icons/mission.svg" alt="Mission icon" class="single_mission-icon">
  </div>

  <div class="single_mission-sidebar-card">

    <!-- Title ALWAYS visible -->
    <p class="single_mission-title-sidebar">{{mission_title}}</p>

    <!-- Toggle Arrow Under Title -->
    <div class="single_mission-sidebar-toggle" onclick="toggleSidebarContent(this)">
      <svg class="single_mission-sidebar-arrow-icon"
           xmlns="http://www.w3.org/2000/svg"
           viewBox="0 0 331.65 100.99">
        <defs><style>.cls-1 { fill: #4e50a2; }</style></defs>
        <g><polygon class="cls-1" points="0 0 161.57 100.99 331.65 0 0 0"/></g>
      </svg>
    </div>

    <!-- Hidden Content -->
    <div class="single_mission-sidebar-content hidden">

      <!-- CREATOR -->
      {{#if creator}}
        <div class="sidebar-block">
          <p class="sidebar-label">Creator</p>
          <div class="single_mission-creator-block">
            <img src="{{creator.image}}" alt="{{creator.name}}" class="single_mission-creator-image">
            <p class="single_mission-creator-name">{{creator.name}}</p>
          </div>
        </div>
      {{/if}}

      <!-- CATEGORY -->
      {{#if category}}
        <div class="sidebar-block">
          <p class="sidebar-label">Category</p>
          <div class="sidebar-chip-row">
            <span class="mission-chip mission-category mission-category-{{category}}">
              {{#ifEquals category "learning"}}learning{{/ifEquals}}
              {{#ifEquals category "research"}}research{{/ifEquals}}
              {{#ifEquals category "business_development"}}business development{{/ifEquals}}
              {{#ifEquals category "internal_improvement"}}internal improvement{{/ifEquals}}
              {{#ifEquals category "culture_play"}}culture &amp; play{{/ifEquals}}
              {{#ifEquals category "client_experience"}}client experience{{/ifEquals}}
              {{#ifEquals category "community"}}community{{/ifEquals}}
              {{#ifEquals category "administrative"}}administrative{{/ifEquals}}
              {{#ifEquals category "other"}}rogue / other{{/ifEquals}}
            </span>
          </div>
        </div>
      {{/if}}

      <!-- TIMEFRAME -->
      {{#if timeframe}}
        <div class="sidebar-block">
          <p class="sidebar-label">Timeframe</p>
          <div class="sidebar-chip-row">
            <span class="mission-chip mission-timeframe">{{timeframe}}</span>
          </div>
        </div>
      {{/if}}

      <!-- HOURS -->
      {{#if estimated_effort_hours}}
        <div class="sidebar-block">
          <p class="sidebar-label">Effort</p>
          <div class="sidebar-chip-row">
            <span class="mission-chip mission-effort">
              approx. {{estimated_effort_hours}} hours
            </span>
          </div>
        </div>
      {{/if}}

      <!-- OPEN TO -->
      {{#if open_to}}
        <div class="sidebar-block">
          <p class="sidebar-label">Open&nbsp;To</p>
          <div class="sidebar-chip-row">
            <span class="mission-chip mission-open-to">
              {{open_to}}
            </span>
          </div>
        </div>
      {{/if}}

      {{#if isOwner}}
        <a href="/unitform/edit_mission/{{_id}}" class="single_mission-edit-btn">
          edit this mission
        </a>
      {{/if}}

    </div><!-- /.sidebar-content -->

  </div>
</aside>


</div>

<script>
  function toggleSidebarContent(element) {
    var sidebarContent = element.nextElementSibling;
    if (sidebarContent) {
      sidebarContent.classList.toggle('hidden');
      element.classList.toggle('open');
    }
  }

  function toggleSuggestNoteField(checkbox) {
  var leaderId = checkbox.value;
  var selector = 'textarea[name="suggestTo[' + leaderId + '][note]"]';
  var textarea = document.querySelector(selector);
  if (textarea) {
    textarea.style.display = checkbox.checked ? 'block' : 'none';
  }
}


  function toggleInstructionField(checkbox) {
    var memberId = checkbox.value;
    var selector = 'textarea[name="assignedTo[' + memberId + '][instructions]"]';
    var textarea = document.querySelector(selector);
    if (textarea) {
      textarea.style.display = checkbox.checked ? 'block' : 'none';
    }
  }

  function promptAndSubmitTag(formId) {
    var form = document.getElementById(formId);
    var btn  = form.querySelector('.tag-this-unit-link');
    var input = form.querySelector('input[name="tagName"]');
    var suggested = (input.value || 'Work on this mission').trim();
    var entered = window.prompt('Name this tag', suggested);
    if (!entered) return;
    input.value = entered.trim();
    if (!input.value) return;
    if (btn) btn.disabled = true;
    form.submit();
  }

  function toggleMissionDetails(button) {
    var body = document.getElementById('singleMissionBody');
    if (!body) return;

    var isHidden = body.classList.contains('hidden');
    if (isHidden) {
      body.classList.remove('hidden');
      button.setAttribute('aria-expanded', 'true');
      button.classList.add('open');
    } else {
      body.classList.add('hidden');
      button.setAttribute('aria-expanded', 'false');
      button.classList.remove('open');
    }
  }

  async function markTagComplete(tagId) {
    try {
      await fetch('/tags/' + tagId + '/complete', {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': '{{csrfToken}}'
        },
        body: JSON.stringify({ _csrf: '{{csrfToken}}' })
      });
      var btn = document.querySelector(
        '.tag-action[data-action="complete"][data-tag="' + tagId + '"]'
      );
      if (btn) {
        btn.outerHTML = '<span class="tag-status" style="font-size:12px; color:#0ea75a;">completed</span>';
      }
    } catch (e) {
      alert('Could not mark complete. Please try again.');
    }
  }

  async function removeTagFromUnit(tagId, itemId, itemType) {
    try {
      await fetch('/tags/remove/' + tagId + '/' + itemId + '/' + itemType, {
        method: 'DELETE',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': '{{csrfToken}}'
        },
        body: JSON.stringify({ _csrf: '{{csrfToken}}' })
      });
      var btn = document.querySelector(
        '.tag-action[data-action="remove"][data-tag="' + tagId +
        '"][data-item="' + itemId +
        '"][data-type="' + itemType + '"]'
      );
      if (btn) {
        var pill = btn.closest('.tag-pill');
        if (pill) pill.remove();
      }
    } catch (e) {
      alert('Could not remove tag from this unit. Please try again.');
    }
  }

  // Delegate clicks for tag actions
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('.tag-action');
    if (!btn) return;
    var action = btn.dataset.action;
    if (action === 'complete') {
      return markTagComplete(btn.dataset.tag);
    }
    if (action === 'remove') {
      return removeTagFromUnit(
        btn.dataset.tag,
        btn.dataset.item,
        btn.dataset.type
      );
    }
  });
</script>
