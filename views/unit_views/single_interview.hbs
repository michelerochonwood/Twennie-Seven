{{!-- File: views/unit_views/single_interview.hbs --}}
{{#*inline "title"}}View Interview | Twennie{{/inline}}

<div class="single_interview-container">
  <!-- Main Section -->
  <div class="single_interview-main">
    <h1 class="single_interview-main-title">{{interview_title}}</h1>
    <p class="single_interview-short-summary" style="color:#4e50a2;"><strong>{{short_summary}}</strong></p>
    <p class="single_interview-long-summary" style="margin-bottom: 20px;">{{full_summary}}</p>

    {{!-- Optional Estimated Time --}}
    {{#if time_required}}
      <div class="single_interview-time-display">
        <p class="single_interview-short-summary">
          <strong>Estimated Time:</strong> {{time_required}}
        </p>
      </div>
    {{/if}}

    <!-- Toggle + Video (matches video view behavior) -->
    <div class="single_interview-toggle"
         onclick="toggleInterviewContent(this)"
         data-authorized="{{isAuthorizedToViewFullContent}}">
      <svg class="single_interview-arrow-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 331.65 100.99">
        <defs><style>.cls-1 { fill: #4e50a2; }</style></defs>
        <g><polygon class="cls-1" points="0 0 161.57 100.99 331.65 0 0 0"/></g>
      </svg>
    </div>

    <!-- Interview Content Section (hidden by default like videos) -->
    <div class="single_interview-content hidden">
      {{#if isAuthorizedToViewFullContent}}
        <div class="single_interview-window">
          {{#if embedLink}}
            <div class="single_interview-video-wrapper" style="text-align: center;">
              <iframe
                width="100%"
                height="450"
                src="{{embedLink}}"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                class="single_interview-frame">
              </iframe>
              <p style="text-align: center; margin-top: 0.5rem;">
                Having trouble viewing? <a href="{{embedLink}}" target="_blank" rel="noopener noreferrer">Watch on YouTube</a>
              </p>
            </div>
          {{else}}
            <p style="text-align: center;">This is where the video will appear once the link is provided in the interview form.</p>
          {{/if}}
        </div>
        

        <!-- Downloads (optional) -->
        {{#if document_uploads}}
          <div class="single_interview-download white-container">
            <h4 style="margin:0 0 10px 0;">Downloads</h4>
            <div class="single_interview-documents" style="display:flex; flex-wrap:wrap; gap:10px;">
              {{#each document_uploads}}
                {{#with (split this "/") as |parts|}}
                  <a href="{{../this}}" target="_blank" rel="noopener" class="single_interview-download-btn" download
                     style="display:inline-block; padding:8px 12px; border-radius:999px; background:#262262; color:#fff; text-decoration:none;">
                    Download {{decode (last parts)}}
                  </a>
                {{/with}}
              {{/each}}
            </div>
          </div>

        {{/if}}
        

        <!-- Quick Tag (Member/Group Member) -->
{{#if isGroupMemberOrMember}}
  {{#unless isAssignedToCurrentUser}}
    <div class="single_unit-tag-container" style="margin-top:12px;">
      <form action="/tags/create" method="POST" class="inline" id="interviewTagForm-{{_id}}">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <input type="hidden" name="itemId" value="{{_id}}">
        <input type="hidden" name="itemType" value="interview">
        <input type="hidden" name="tagName" value="Read Later">
        <input type="hidden" name="assignedTo[{{currentUserId}}][member]" value="{{currentUserId}}">

        <button type="button"
                class="tag-this-unit-link"
                onclick="promptAndSubmitTag('interviewTagForm-{{_id}}')"
                style="background:none;border:none;padding:0;cursor:pointer;">
          assign this unit to myself
          <svg class="tag-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 39.48 36.66">
            <path class="cls-1" d="M38.77,21.12L16.05.56C15.65.19,15.13,0,14.59,0L2.12.16c-1.18.01-2.12.97-2.12,2.15v11.2c0,.63.28,1.24.77,1.64l24.95,21c.9.76,2.24.65,3.01-.24l10.23-11.8c.77-.88.69-2.22-.18-3ZM6.28,8.87c-1.57,0-2.84-1.27-2.84-2.84s1.27-2.84,2.84-2.84,2.84,1.27,2.84,2.84-1.27,2.84-2.84,2.84Z"/>
          </svg>
        </button>
      </form>
    </div>
  {{/unless}}
{{/if}}

        <!-- Leader Assignment Form -->
{{#if isLeader}}
  {{#unless isAssignedToCurrentUser}}
    <div class="assign-tag-form white-container">
      <h4 class="assign-tag-title">Assign this interview to yourself or your group</h4>

      <form action="/tags/create" method="POST">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <input type="hidden" name="itemId" value="{{_id}}">
        <input type="hidden" name="itemType" value="interview">

        <div class="form-field">
          <label for="tagName">Give the assignment a name</label>
          <input type="text" id="tagName" name="tagName" required>
        </div>

        <fieldset class="assign-tag-members">
          <legend class="assign-tag-legend">Select recipients and enter instructions:</legend>

          <!-- Leader self-assignment -->
          <div class="assign-tag-member-block">
            <label class="assign-tag-member-label">
              <input
                type="checkbox"
                name="assignedTo[{{leaderId}}][member]"
                value="{{leaderId}}"
                onchange="toggleInstructionField(this)">
              {{leaderName}} (you)
            </label>
            <textarea
              class="assign-tag-instructions"
              name="assignedTo[{{leaderId}}][instructions]"
              placeholder="Instructions for yourself"
              style="display:none;"></textarea>
          </div>

          <hr class="assign-tag-divider">

          <!-- Group members -->
          {{#each groupMembers}}
            <div class="assign-tag-member-block">
              <label class="assign-tag-member-label">
                <input
                  type="checkbox"
                  name="assignedTo[{{_id}}][member]"
                  value="{{_id}}"
                  onchange="toggleInstructionField(this)">
                {{name}}
              </label>
              <textarea
                class="assign-tag-instructions"
                name="assignedTo[{{_id}}][instructions]"
                placeholder="Instructions for {{name}}"
                style="display:none;"></textarea>
            </div>
          {{/each}}
        </fieldset>

        <button type="submit" class="form-button submit-button">assign interview</button>
      </form>
    </div>
  {{/unless}}
{{/if}}

{{!-- Admin: suggest this unit to org leaders --}}
{{#if isOrgAdmin}}
  <div class="assign-tag-form white-container" style="margin-top:1.25rem;">

    {{!-- ✅ SUCCESS MESSAGE --}}
    {{#if (and suggestionSuccess (eq suggestedUnitId _id))}}
      <div class="success-message" style="
        margin-bottom:0.75rem;
        padding:0.6rem 0.75rem;
        background:#e9f7ef;
        color:#0f5132;
        border-radius:6px;
        font-weight:600;
      ">
        ✅ Suggestions sent successfully.
      </div>
    {{/if}}

    <h4 class="assign-tag-title">Suggest this unit to organization leaders</h4>
    <p class="groupsection-org-card-info" style="margin-top:0.25rem;">
      Send a suggestion (with an optional note) to one or more leaders in your organization.
    </p>

    <form
      id="suggestInterviewForm-{{_id}}"
      action="/unitsuggestions/org-suggestions/create"
      method="POST"
    >
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <input type="hidden" name="unitId" value="{{_id}}">
      <input type="hidden" name="unitType" value="interview">

      <fieldset class="assign-tag-members">
        <legend class="assign-tag-legend">
          Select leaders and optionally add a note:
        </legend>

        {{#each orgLeaders}}
          <div class="assign-tag-member-block">
            <label class="assign-tag-member-label">
              <input
                type="checkbox"
                name="suggestTo[{{_id}}][leader]"
                value="{{_id}}"
                onchange="toggleSuggestNoteField(this)"
              >
              {{groupLeaderName}}{{#if groupName}} — {{groupName}}{{/if}}
            </label>

            <textarea
              class="assign-tag-instructions"
              name="suggestTo[{{_id}}][note]"
              placeholder="Optional note for {{groupLeaderName}}"
              style="display:none;"
            ></textarea>
          </div>
        {{/each}}
      </fieldset>

      <button type="submit" class="form-button submit-button">
        send suggestions
      </button>
    </form>

  </div>
{{/if}}

{{!-- Notes --}}
{{#if isGroupMemberOrLeaderOrMember}}

  {{#if isAssignedToCurrentUser}}

    <div class="single_interview-notes-container">
      <h3 class="single_interview-notes-title">complete this unit by recording notes</h3>
      <p class="single_interview-notes-instructions">
        To complete this unit, record notes on this interview. Consider how it relates to your work and how it might change your approach. These notes will be part of your Twennie learning record.
      </p>

      <form action="/notes/submit" method="POST" class="single_interview-notes-form">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <input type="hidden" name="unitId" value="{{_id}}">
        <input type="hidden" name="unitType" value="interview">
        <input type="hidden" name="main_topic" value="{{main_topic}}">
        <input type="hidden" name="secondary_topic" value="{{sub_topic}}">

        <textarea
          name="note_content"
          class="single_interview-notes-textarea"
          rows="5"
          maxlength="1000"
          placeholder="Write your notes here..."
        ></textarea>

        <button type="submit" class="single_interview-notes-submit">submit notes</button>
      </form>
    </div>

  {{else}}

    <div class="single_interview-notes-container">
      <h3 class="single_interview-notes-title">complete this unit by recording notes</h3>
      <p class="single_interview-notes-instructions">
        Before recording notes, assign this unit to yourself so it appears in your dashboard with your other assigned units.
      </p>
    </div>

  {{/if}}

{{/if}}
{{/if}}

    {{!-- ✅ CLOSE .single_interview-content --}}
    </div>

  {{!-- ✅ CLOSE .single_interview-main --}}
  </div>

  <!-- Sidebar -->
  <aside class="single_interview-sidebar">
    <div class="single_interview-duration-image-container" style="text-align:center; margin-bottom:10px; width:100px; height:auto; display:inline-block">
      <img src="https://www.twennie.com/images/30mins.svg" alt="Estimated Time: 30 Minutes" class="single_interview-duration-image">
    </div>

    <p class="single_interview-title-sidebar">{{interview_title}}</p>

    <div class="single_interview-author">
      <img src="{{author.image}}" alt="Author Image" class="single_interview-author-image">
      <p class="single_interview-author-name">Interviewer: {{author.name}}</p>
    </div>

    <div class="single_interview-details">
      <p class="single_interview-unit-type">Interview</p>
      <p class="single_interview-main-topic">Main Topic: {{main_topic}}</p>
      <p class="single_interview-subtitle">Sub Topic(s): {{sub_topic}}</p>
      <p class="single_interview-secondary-topics">
        {{#each secondary_topics}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}
      </p>

      {{#if isOwner}}
        <a href="/unitform/edit_interview/{{_id}}" class="single_interview-edit-btn">edit this unit</a>
      {{/if}}
    </div>
  </aside>
</div>

<script>
function toggleInterviewContent(element) {
  const isAuthorized = element.dataset.authorized === "true";
  const content = element.nextElementSibling;
  if (isAuthorized) {
    content.classList.toggle('hidden');
    element.classList.toggle('open');
  } else {
    alert("You don't have access to view this interview.");
  }
}

function toggleInstructionField(checkbox) {
  const memberId = checkbox.value;
  const textarea = document.querySelector(`textarea[name="assignedTo[${memberId}][instructions]"]`);
  if (textarea) {
    textarea.style.display = checkbox.checked ? 'block' : 'none';
  }
}

function toggleSuggestNoteField(checkbox) {
  const leaderId = checkbox.value;
  const selector = `textarea[name="suggestTo[${leaderId}][note]"]`;
  const textarea = document.querySelector(selector);
  if (textarea) textarea.style.display = checkbox.checked ? 'block' : 'none';
}


// Prompt for tag name and submit the form as a normal POST
function promptAndSubmitTag(formId) {
  const form = document.getElementById(formId);
  if (!form) return;
  const input = form.querySelector('input[name="tagName"]');
  const suggested = (input?.value || 'Read Later').trim();
  const entered = window.prompt('Name this tag', suggested);
  if (!entered) return;
  input.value = entered.trim();
  if (!input.value) return;
  const btn = form.querySelector('.tag-this-unit-link');
  if (btn) btn.disabled = true;
  form.submit();
}

// Delegate clicks for tag actions (complete/remove) if you reuse the same API as videos
document.addEventListener('click', (e) => {
  const btn = e.target.closest('.tag-action');
  if (!btn) return;
  const action = btn.dataset.action;
  if (action === 'complete') {
    fetch(`/tags/${btn.dataset.tag}/complete`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '{{csrfToken}}' },
      body: JSON.stringify({ _csrf: '{{csrfToken}}' })
    }).then(() => {
      btn.outerHTML = '<span class="tag-status" style="font-size:12px; color:#0ea75a;">completed</span>';
    }).catch(() => alert('Could not mark complete. Please try again.'));
  }
  if (action === 'remove') {
    fetch(`/tags/remove/${btn.dataset.tag}/${btn.dataset.item}/${btn.dataset.type}`, {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '{{csrfToken}}' },
      body: JSON.stringify({ _csrf: '{{csrfToken}}' })
    }).then(() => btn.closest('.tag-pill').remove())
      .catch(() => alert('Could not remove tag from this unit. Please try again.'));
  }
});
</script>









