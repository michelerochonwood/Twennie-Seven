{{!-- File: views/unit_views/mine.hbs --}}
{{#*inline "title"}}The Mine | Twennie{{/inline}}

<div class="mine-wrapper">
  <h1 class="mine-title">Welcome to the Twennie Mine</h1>

  <div class="mine-hero">
    <img src="/images/minerbluey.png" alt="Miner Bluey" class="mine-hero-img" style="width: 250px" />
  </div>

  <p class="mine-subtitle">
    Start digging for early intel. Choose a path to see nuggets organized by <strong>client</strong>, <strong>region</strong>, or <strong>discipline</strong>.
  </p>

  <div style="text-align: center; margin: 30px auto 60px; max-width: 700px;">
  <p class="mine-subtitle" style="font-size: 15px; margin-bottom: 20px;">
    If you want to create nuggets of your own, go to your learning dashboard under the tab
    <strong>create learning</strong>.
  </p>

  <p>Please note that the Twennie Mine is not meant to replace CRM systems or formal opportunity tracking. Twennie is a learning platform. We use real opportunities because we want you to learn earlier awareness habits using real work, but Twennie should not replace other tracking tools or processes.</p>


</div>

<div class="mine-grid">
  <!-- CLIENT -->
  <a href="/unitviews/mine/clients"
     class="mine-card"
     aria-label="Browse Nuggets by Client"
     title="Browse Nuggets by Client">
    <div class="mine-card-inner">
      <div class="mine-card-icon">
        <img src="/images/clienticon.png" alt="client icon" id="client-icon" style="width: 100px;">
      </div>
    </div>
  </a>

  <!-- REGION -->
  <a href="/unitviews/mine/regions"
     class="mine-card"
     aria-label="Browse Nuggets by Region"
     title="Browse Nuggets by Region">
    <div class="mine-card-inner">
      <div class="mine-card-icon">
        <img src="/images/regionicon.png" alt="region icon" id="region-icon" style="width: 125px;">
      </div>
    </div>
  </a>

  <!-- DISCIPLINE -->
  <a href="/unitviews/mine/disciplines"
     class="mine-card"
     aria-label="Browse Nuggets by Discipline"
     title="Browse Nuggets by Discipline">
    <div class="mine-card-inner">
      <div class="mine-card-icon">
        <img src="/images/disciplineicon.png" alt="discipline icon" id="discipline-icon" style="width: 125px;">
      </div>
    </div>
  </a>
</div>

</div>


<!-- ⭐️ Centered Video Frame Below -->
<div style="display: flex; justify-content: center; margin: 40px 0;">
  <div
    class="youtube-poster-wrapper"
    style="
      position: relative;
      width: 100%;
      max-width: 800px;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      border-radius: 12px;
      cursor: pointer;
    "
    onclick="
      var poster = this.querySelector('.youtube-poster');
      var iframe = this.querySelector('iframe');
      if (poster) poster.style.display = 'none';
      if (iframe) {
        iframe.style.display = 'block';
        if (!iframe.dataset.loaded) {
          iframe.src = iframe.dataset.src;
          iframe.dataset.loaded = 'true';
        }
      }
    "
  >
    <!-- Poster -->
    <img
      src="/images/nuggetposter.png"
      alt="video poster"
      class="youtube-poster"
      style="
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      "
    />

    <!-- Play Button -->
    <div
      style="
        position: absolute;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        width: 90px;
        height: 90px;
        background: rgba(0,0,0,0.55);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
      "
    >
      <div
        style="
          width: 0;
          height: 0;
          border-left: 32px solid white;
          border-top: 20px solid transparent;
          border-bottom: 20px solid transparent;
          margin-left: 6px;
        "
      ></div>
    </div>

    <!-- YouTube iframe (src is set only after click) -->
    <iframe
      data-src="https://www.youtube.com/embed/8kAkjSbz-us"
      src="about:blank"
      title="The Mine intro video"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
      style="
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: none;  
      "
    ></iframe>
  </div>
</div>