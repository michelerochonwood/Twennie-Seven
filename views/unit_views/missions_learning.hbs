{{!-- views/unit_views/missions_learning.hbs --}}
{{#*inline "title"}}{{title}} | Twennie{{/inline}}

<div class="bytopic-container">
  <h1 class="bytopic-title">{{title}}</h1>

  {{#if shortSummary}}
    <p class="bytopic-short-summary">{{shortSummary}}</p>
  {{/if}}

  {{#if longSummary}}
    <p class="bytopic-long-summary">{{longSummary}}</p>
  {{/if}}

  {{!-- One or more sections, same idea as bytopic view --}}
  {{#each sectionedMissions}}
    <h2 class="bytopic-section-title">{{this.sectionTitle}}</h2>
    <hr class="bytopic-section-divider">

    {{#if this.missions.length}}
      <div class="bytopic-library-units-grid">
        {{#each this.missions}}
          <article class="bytopic-library-unit-card" data-mission-id="{{_id}}">
            <div class="bytopic-card-inner">
              {{!-- Optional: SVG wave header, like bytopic cards --}}
              <div class="bytopic-card-svg-header">
                {{!-- you can inline the same SVG used on the bytopic cards here --}}
                {{!-- or leave this div empty; the layout still works --}}
              </div>

              <div class="bytopic-card-content">
                <div class="bytopic-visible-content">
                  <div class="bytopic-unit-type-icon-container">
                    <img
                      src="/icons/missionicon.png"
                      alt="mission icon"
                      class="bytopic-unit-type-icon"
                    >
                  </div>

                  {{!-- Title field: rename to match your Mission schema --}}
                  <h3 class="bytopic-unit-title">
                    {{mission_title}}
                  </h3>

                  {{!-- Short blurb / purpose – pick a real field you have --}}
                  {{#if short_summary}}
                    <p class="bytopic-detail-value-purpose">
                      {{short_summary}}
                    </p>
                  {{/if}}

                  <button
                    class="bytopic-expand-toggle"
                    type="button"
                    aria-expanded="false"
                  >
                    {{!-- same arrow SVG as bytopic cards, with .expand-arrow --}}
                    <svg class="expand-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                      <path class="cls-1" d="M12 15.5L5 8.5l1.4-1.4L12 12.7l5.6-5.6L19 8.5z"/>
                    </svg>
                  </button>
                </div>

                <div class="bytopic-hidden-content">
                  {{!-- Longer description --}}
                  {{#if long_summary}}
                    <div class="bytopic-unit-summary-container">
                      <p class="bytopic-unit-long-summary">
                        {{long_summary}}
                      </p>
                    </div>
                  {{/if}}

                  {{!-- You can add more mission metadata here: status, dates, etc. --}}
                  {{#if status}}
                    <p class="bytopic-detail-value-purpose">
                      Status: {{status}}
                    </p>
                  {{/if}}

                  <div class="bytopic-unit-review-container">
                    <a
                      href="/unitviews/missions/view/{{_id}}"
                      class="bytopic-unit-review-btn"
                    >
                      view mission
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </article>
        {{/each}}
      </div>
    {{else}}
      <p class="bytopic-empty-section-message">
        {{this.emptyMessage}}
      </p>
    {{/if}}
  {{/each}}
</div>

