{{#*inline "title"}}Learning Missions | Twennie{{/inline}}

<div class="mission-container">
  <!-- Main content column -->
  <div class="mission-content has-right-rail">
    <h1 class="mission-title">{{title}}</h1>
    <p class="mission-short-summary">{{shortSummary}}</p>
    <p class="mission-long-summary">{{longSummary}}</p>

    {{!-- sectionedMissions is an array of { sectionTitle, missions, emptyMessage } --}}
    {{#each sectionedMissions}}
      <h2 class="mission-section-title">{{this.sectionTitle}}</h2>
      <hr class="mission-section-divider">

      {{#if this.missions.length}}
        <div class="mission-card-grid">
          {{#each this.missions}}
          <article class="mission-card" data-mission-id="{{_id}}">

            <!-- Inner wrapper preserves rounded-corner clipping -->
            <div class="mission-card-inner">
              <!-- Mission SVG Header -->
<div class="mission-card-svg-header">
  <img src="/images/missionsvg.svg"
       alt=""
       aria-hidden="true"
       class="mission-card-svg-image">
</div>

              <!-- Card Content -->
              <div class="mission-card-content">
                <!-- Always-visible content -->
                <div class="mission-visible-content">
                  <div class="mission-type-icon-container">
                    <img src="/images/mission_learning.png" alt="Learning mission icon" class="mission-type-icon">
                  </div>
                  <div class="mission-title-container">
                    <h2 class="mission-card-title">{{mission_title}}</h2>
                  </div>
                </div>

                <!-- Expand Toggle -->
                <button
                  class="mission-expand-toggle"
                  type="button"
                  onclick="toggleMissionCard(this)"
                  aria-expanded="false"
                  aria-label="Toggle mission details">
                  <svg class="mission-expand-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 331.65 100.99" aria-hidden="true" focusable="false">
                    <defs><style>.cls-1 { fill: #4e50a2; }</style></defs>
                    <polygon class="cls-1" points="0 0 161.57 100.99 331.65 0 0 0"/>
                  </svg>
                </button>

                <!-- Expandable content -->
                <div class="mission-hidden-content" style="display:none;">
                  <div class="mission-creator-label">
                    CREATED BY
                  </div>

                  <div class="mission-creator-image-container">
                    <img src="{{creatorImage}}" alt="Creator Image" class="mission-creator-image">
                  </div>

                  <div class="mission-creator-name-container">
                    <span class="mission-creator-name">
                      {{creatorName}}
                    </span>
                  </div>

                  {{!-- Mission summary / purpose / why it matters --}}
                  <div class="mission-summary-container">
                    <p class="mission-summary">
                      {{short_purpose}}
                    </p>
                  </div>

                  <div class="mission-detail-block">
                    <strong>Purpose:</strong><br>
                    {{purpose}}
                  </div>

                  {{#if why_it_matters}}
                    <div class="mission-detail-block">
                      <strong>Why this mission matters:</strong><br>
                      {{why_it_matters}}
                    </div>
                  {{/if}}

                  {{#if timeframe}}
                    <div class="mission-detail-inline">
                      <strong>Timeframe:</strong> {{timeframe}}
                    </div>
                  {{/if}}

                  {{#if estimated_effort_hours}}
                    <div class="mission-detail-inline">
                      <strong>Estimated effort:</strong> {{estimated_effort_hours}} hours
                    </div>
                  {{/if}}

                  {{#if department_requesting}}
                    <div class="mission-detail-inline">
                      <strong>Requested by:</strong> {{department_requesting}}
                    </div>
                  {{/if}}

                  <!-- CTA -->
                  <div class="mission-cta-container">
                    {{#if loggedIn}}
                      <a href="/unitviews/missions/view/{{_id}}" class="mission-cta-btn">
                        view mission
                      </a>
                    {{else}}
                      <div class="mission-cta-btn mission-cta-disabled">
                        login required
                      </div>
                    {{/if}}
                  </div>
                </div>
              </div>
            </div> <!-- /.mission-card-inner -->
          </article>
          {{/each}}
        </div>
      {{else}}
        <div class="mission-empty-section-message">
          {{#if this.emptyMessage}}<p>{{this.emptyMessage}}</p>{{/if}}
        </div>
      {{/if}}
    {{/each}}
  </div>
</div>

<script>
  function toggleMissionCard(el) {
    const card = el.closest('.mission-card');
    const content = card.querySelector('.mission-hidden-content');
    const isOpen = card.classList.contains('active');
    card.classList.toggle('active', !isOpen);
    el.setAttribute('aria-expanded', String(!isOpen));
    content.style.display = isOpen ? 'none' : 'flex';
  }
</script>
