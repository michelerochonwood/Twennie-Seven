{{!-- File: views/unit_views/region_view.hbs --}}
{{#*inline "title"}}Nuggets by Region | Twennie{{/inline}}

<div class="mineclients-container bytopic-container">
  <!-- Hero -->
  <div class="mineclients-hero">
    <h1 class="mineclients-title bytopic-title">
      {{#if pageTitle}}{{pageTitle}}{{else}}Nuggets by Region{{/if}}
    </h1>

    <img
      src="/images/mapbluey.png"
      alt="Region Bluey"
      class="mineclients-region-img"
    >

    {{#if pageIntro}}
      <p class="mineclients-intro bytopic-short-summary">{{pageIntro}}</p>
    {{/if}}

    {{#if shortSummary}}
      <p class="mineclients-short-summary bytopic-short-summary">{{shortSummary}}</p>
    {{/if}}

    {{#if longSummary}}
      <p class="mineclients-long-summary bytopic-long-summary">{{longSummary}}</p>
    {{/if}}
  </div>

  <!-- Main content + right rail -->
  <div class="mineclients-content has-right-rail bytopic-content">
    {{#each sectionedNuggets}}
      <h2 class="mineclients-section-title bytopic-section-title">{{this.sectionTitle}}</h2>
      <hr class="mineclients-section-divider bytopic-section-divider">

      {{#if this.nuggets.length}}
        <div class="mineclients-nuggets-grid bytopic-library-units-grid">
          {{#each this.nuggets}}
            <article class="mineclients-nugget-card bytopic-library-unit-card" data-nugget-id="{{_id}}">

              <div class="bytopic-card-top-badges">
                <div class="bytopic-card-top-badge bytopic-card-author-badge">
                  <img
                    src="{{#if creatorImage}}{{creatorImage}}{{else}}/images/default-avatar.png{{/if}}"
                    alt="{{creatorName}}"
                    class="bytopic-card-author-mini"
                  >
                </div>

                {{#if organizationId}}
                  <div class="bytopic-card-top-badge bytopic-card-org-badge">
                    <a href="/profile/organization/{{organizationId}}" class="bytopic-card-org-link">
                      <img
                        src="{{#if organizationLogo}}{{organizationLogo}}{{else}}/images/default-organization-logo.png{{/if}}"
                        alt="{{#if organizationName}}{{organizationName}}{{else}}Organization{{/if}} logo"
                        class="bytopic-card-org-logo"
                      >
                    </a>
                  </div>
                {{/if}}
              </div>

              <div class="mineclients-card-inner bytopic-card-inner">
                <div class="mineclients-card-svg-header bytopic-card-svg-header">
                  <img
                    src="/icons/goldsvg.svg"
                    alt=""
                    aria-hidden="true"
                    class="bytopic-card-svg-image"
                  >
                </div>

                <div class="mineclients-card-content bytopic-card-content">
                  <div class="mineclients-visible-content bytopic-visible-content">
                    <div class="mineclients-nugget-icon-container bytopic-unit-type-icon-container">
                      <img
                        src="/images/nuggeticon.png"
                        alt="Nugget icon"
                        class="mineclients-nugget-icon bytopic-unit-type-icon"
                      >
                    </div>

                    <div class="mineclients-nugget-title-container bytopic-unit-title-container">
                      <h2 class="mineclients-nugget-title bytopic-unit-title">{{region}}</h2>
                    </div>

                    <div class="mineregion-nugget-subtitle-container bytopic-unit-subtitle-container" style="display:flex; justify-content:center;">
                      <h3
                        class="mineregion-nugget-subtitle bytopic-unit-subtitle"
                        title="{{title}}"
                        style="color:#4e50a2; text-align:center;"
                      >
                        {{title}}
                      </h3>
                    </div>
                  </div>

                  <button
                    class="mineclients-expand-toggle bytopic-expand-toggle"
                    type="button"
                    onclick="toggleMineRegionCard(this)"
                    aria-expanded="false"
                    aria-label="Toggle details"
                  >
                    <svg
                      class="expand-arrow"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 331.65 100.99"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <defs><style>.cls-1 { fill: #4e50a2; }</style></defs>
                      <polygon class="cls-1" points="0 0 161.57 100.99 331.65 0 0 0"/>
                    </svg>
                  </button>

                  <div class="mineclients-hidden-content bytopic-hidden-content" style="display:none;">
                    <div class="bytopic-author-label">AUTHOR</div>

                    <div class="bytopic-author-image-container">
                      <img
                        src="{{#if creatorImage}}{{creatorImage}}{{else}}/images/default-avatar.png{{/if}}"
                        alt="{{creatorName}}"
                        class="bytopic-author-image"
                      >
                    </div>

                    <div class="bytopic-author-name-container">
                      <span class="bytopic-author-name">{{creatorName}}</span>
                    </div>

                    <div class="bytopic-unit-summary-container">
                      <p class="bytopic-unit-long-summary">
                        {{#if overview}}
                          {{overview}}
                        {{else if notes}}
                          {{notes}}
                        {{else}}
                          Nugget details available in full view.
                        {{/if}}
                      </p>
                    </div>

                    <div class="mineclients-meta-badges">
                      {{#if discipline}}
                        <div class="mineclients-meta-item">
                          <div class="mineclients-meta-label">discipline</div>
                          <div class="mineclients-meta-value">{{discipline}}</div>
                        </div>
                      {{/if}}

                      {{#if region}}
                        <div class="mineclients-meta-item">
                          <div class="mineclients-meta-label">region</div>
                          <div class="mineclients-meta-value">{{region}}</div>
                        </div>
                      {{/if}}
                    </div>

                    <div class="mineclients-actions bytopic-unit-review-container">
                      <a href="/unitviews/nuggets/view/{{_id}}" class="mineclients-view-btn bytopic-unit-review-btn">
                        view nugget
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </article>
          {{/each}}
        </div>
      {{else}}
        <div class="mineclients-empty-section-message bytopic-empty-section-message">
          {{#if this.emptyMessage}}<p>{{this.emptyMessage}}</p>{{/if}}
        </div>
      {{/if}}
    {{/each}}
  </div>
</div>

<script>
  function toggleMineRegionCard(el) {
    const card = el.closest('.mineclients-nugget-card');
    if (!card) return;

    const content = card.querySelector('.mineclients-hidden-content');
    if (!content) return;

    const isOpen = card.classList.contains('active');
    card.classList.toggle('active', !isOpen);
    el.setAttribute('aria-expanded', String(!isOpen));
    content.style.display = isOpen ? 'none' : 'flex';
  }
</script>
