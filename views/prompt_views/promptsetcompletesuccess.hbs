{{#*inline "title"}}Success! | Twennie{{/inline}}

<div class="promptset-complete-success-container">
<video
  class="promptset-complete-video"
  autoplay
  muted
  playsinline
  preload="auto"
>
  <source src="/prompt-celebrations/bluey-explodes-20.mp4" type="video/mp4">
  Your browser does not support the video tag.
</video>
  <h1 class="promptset-complete-success-title">Congratulations! You've completed this prompt set!</h1>
  <h2 class="promptset-complete-success-subtitle">{{title}}</h2>
  
  <p class="promptset-complete-success-message">
    <strong>Purpose:</strong> {{purpose}}
  </p>
  
  <div class="promptset-complete-success-badge-container">
    <img src="{{badge}}" alt="{{badgeName}}" class="promptset-complete-badge-img">
    <p class="promptset-complete-badge-label">You've earned the <strong>{{badgeName}}</strong> badge!</p>
  </div><br>
  
  <a href="{{dashboard}}" class="promptset-complete-success-btn" style="margin-bottom: 200px">return to my dashboard</a>
</div>

<script>
  function startConfetti() {
    const confettiCanvas = document.createElement('canvas');
    confettiCanvas.id = 'confetti-canvas';
    document.body.appendChild(confettiCanvas);

    const ctx = confettiCanvas.getContext('2d');
    const colors = ['#4e50a2', '#dc176a', '#8dc63f', '#fbb040', '#00a4e4'];
    const confetti = [];

    function resizeCanvas() {
      confettiCanvas.width = window.innerWidth;
      confettiCanvas.height = window.innerHeight;
    }

    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    for (let i = 0; i < 150; i++) {
      confetti.push({
        x: Math.random() * confettiCanvas.width,
        y: Math.random() * confettiCanvas.height - confettiCanvas.height,
        r: Math.random() * 6 + 4,
        d: Math.random() * 150 + 50,
        color: colors[Math.floor(Math.random() * colors.length)]
      });
    }

    function update() {
      confetti.forEach(piece => {
        piece.y += Math.cos(piece.d / 15) + 2;
        piece.x += Math.sin(piece.d / 15);

        if (piece.y > confettiCanvas.height) {
          piece.y = -10;
          piece.x = Math.random() * confettiCanvas.width;
        }
      });
    }

    function draw() {
      ctx.clearRect(
        0,
        0,
        confettiCanvas.width,
        confettiCanvas.height
      );

      confetti.forEach(piece => {
        ctx.beginPath();
        ctx.arc(piece.x, piece.y, piece.r, 0, Math.PI * 2);
        ctx.fillStyle = piece.color;
        ctx.fill();
      });

      update();
      requestAnimationFrame(draw);
    }

    draw();
  }

  window.setTimeout(startConfetti, 10000);
</script>


