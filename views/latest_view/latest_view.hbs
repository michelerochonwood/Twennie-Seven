<!-- Expand Toggle Script -->
<script>
  function toggleLatestCard(element) {
    const card = element.closest('.latest-library-unit-card');
    const content = card.querySelector('.latest-hidden-content');

    const isActive = card.classList.contains('active');

    if (isActive) {
      card.classList.remove('active');
      content.style.display = 'none';
    } else {
      card.classList.add('active');
      content.style.display = 'flex';
    }
  }


  document.addEventListener("DOMContentLoaded", function () {
    const aboutAnimated = document.querySelectorAll(".latest-about-reveal");

    const aboutObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add("in-view");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.18 }
    );

    aboutAnimated.forEach(element => aboutObserver.observe(element));
  });


  document.addEventListener("DOMContentLoaded", function () {
    const aboutAnimated = document.querySelectorAll(
      ".latest-about-reveal, .latest-about-quote"
    );

    const aboutObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add("in-view");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.18 }
    );

    aboutAnimated.forEach(element => aboutObserver.observe(element));
  });


  function toggleLatestCard(element) {
    const card = element.closest('.latest-library-unit-card');
    const content = card.querySelector('.latest-hidden-content');

    const isActive = card.classList.contains('active');

    if (isActive) {
      card.classList.remove('active');
      content.style.display = 'none';
    } else {
      card.classList.add('active');
      content.style.display = 'flex';
    }
  }

  document.addEventListener("DOMContentLoaded", function () {
    const aboutAnimated = document.querySelectorAll(".latest-about-reveal");

    const aboutObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add("in-view");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.18 }
    );

    aboutAnimated.forEach(element => aboutObserver.observe(element));
  });

  document.addEventListener("DOMContentLoaded", function () {
    const aboutAnimated = document.querySelectorAll(
      ".latest-about-reveal, .latest-about-quote"
    );

    const aboutObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add("in-view");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.18 }
    );

    aboutAnimated.forEach(element => aboutObserver.observe(element));
  });

  document.addEventListener('DOMContentLoaded', function () {
    const shell = document.querySelector('.home-featured-carousel-shell');
    const track = document.getElementById('homeFeaturedCarouselTrack');
    const slides = Array.from(document.querySelectorAll('.home-featured-slide'));
    const dots = Array.from(document.querySelectorAll('.home-featured-dot'));
    const prevBtn = document.getElementById('homeFeaturedPrev');
    const nextBtn = document.getElementById('homeFeaturedNext');

    if (!shell || !track || !slides.length) return;

    let currentIndex = 0;
    let intervalId = null;
    let direction = 1;

    function getStepSize() {
      if (slides.length < 2) return slides[0].offsetWidth;

      const firstRect = slides[0].getBoundingClientRect();
      const secondRect = slides[1].getBoundingClientRect();

      return secondRect.left - firstRect.left;
    }

    function getCenteredOffset(index) {
      const step = getStepSize();
      const shellWidth = shell.clientWidth;
      const slideWidth = slides[index].offsetWidth;

      const rawOffset = (index * step) - ((shellWidth - slideWidth) / 2);
      return Math.max(0, rawOffset);
    }

    function showSlide(index) {
      if (index < 0) index = 0;
      if (index >= slides.length) index = slides.length - 1;

      const offset = getCenteredOffset(index);
      track.style.transform = `translateX(-${offset}px)`;

      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === index);
      });

      currentIndex = index;
    }

    function nextSlide() {
      if (slides.length < 2) return;

      if (currentIndex === slides.length - 1) {
        direction = -1;
      } else if (currentIndex === 0) {
        direction = 1;
      }

      showSlide(currentIndex + direction);
    }

    function prevSlide() {
      direction = -1;

      if (currentIndex === 0) {
        direction = 1;
        showSlide(1);
        return;
      }

      showSlide(currentIndex - 1);
    }

    function startAutoRotate() {
      if (slides.length < 2) return;
      stopAutoRotate();
      intervalId = setInterval(nextSlide, 7000);
    }

    function stopAutoRotate() {
      if (intervalId) {
        clearInterval(intervalId);
        intervalId = null;
      }
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function () {
        prevSlide();
        startAutoRotate();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function () {
        direction = 1;

        if (currentIndex === slides.length - 1) {
          direction = -1;
        }

        nextSlide();
        startAutoRotate();
      });
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', function () {
        const index = Number(this.dataset.slide);
        direction = index > currentIndex ? 1 : -1;
        showSlide(index);
        startAutoRotate();
      });
    });

    window.addEventListener('resize', function () {
      showSlide(currentIndex);
    });

    showSlide(0);
    startAutoRotate();
  });


</script>





