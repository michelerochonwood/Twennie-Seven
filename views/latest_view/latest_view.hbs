{{#*inline "title"}}Latest Additions | Twennie{{/inline}}

<section class="latest-about-strip latest-about-animated">

  <div class="latest-about-grid">

    <div class="latest-about-copy latest-about-reveal">
      <p class="latest-about-eyebrow">about twennie</p>

      <h2 class="latest-about-title">
        Built for technical professionals who need useful learning in minutes, not hours.
      </h2>

      <p class="latest-about-text">
        Hi! I’m Michele Rochon-Wood, a 20-year business development specialist in AEC. I worked for four global firms before striking out on my own a few years ago. I wanted to bring valuable learning content to the world of technical consulting. At the time, I had a handful of modules, but I wanted to build a comprehensive library, a full digital warehouse of urgently needed, non-technical learning.
      </p>


      <p class="latest-about-text">
        On Twennie, technical professionals and their internal support teams have access to learning in project management, business development, and engaging clients to succeed in their fields of expertise. That learning is built to consume fewer billable hours while bringing essential clarity to the most challenging concepts in the business.
      </p>

      <p class="latest-about-text">
        <b>Twennie’s name is from the Pareto Principle - 20% of effort produces 80% of results. Twennie learning follows this guideline, teaching high-impact action, efficient use of resources, and fit-for-purpose techniques, asynchronously in less time, affordably.</b>
      </p>

      <div class="latest-about-pill-row">
        <span class="latest-about-pill">20-minute learning</span>
        <span class="latest-about-pill">high-impact action</span>
        <span class="latest-about-pill">built for real work</span>
      </div>
    </div>

    <div class="latest-about-images latest-about-reveal">
      <div class="latest-about-image-stack">
  <img
    src="/images/panels.png"
    alt="Industry panel discussions that informed Twennie"
    class="latest-about-image latest-about-image-panels"
  >

  <!-- NEW FOUNDERS IMAGE -->
  <img
    src="/images/twenniefounders3.png"
    alt="Twennie Founders"
    class="latest-about-image latest-about-image-founders"
  >

  <img
    src="/images/michele.png"
    alt="Michele Rochon-Wood"
    class="latest-about-image latest-about-image-michele"
  >

        <div class="latest-about-quote">
          <p>
            I assembled a network of veteran professionals from AEC. They remained anonymous, but believed in my vision for a new kind of learning resource and wanted to lend their support. Over several months, I interviewed them about their experiences in leadership, working with clients, and managing successful projects. From those interviews came Twennie, an online environment designed just for technical service providers. On Twennie, the veterans I interviewed are known as the Twennie Founders.
          </p>
        </div>

        <img
          src="/images/pareto3d2.png"
          alt="Pareto principle illustration"
          class="latest-about-image latest-about-image-pareto"
        >
      </div>
    </div>

  </div>
</section>

      <hr class="latest-divider" style="width: 90%; margin: 0 auto">

<section class="home-featured-carousel-section">
  <div class="home-featured-carousel-shell">

    <div class="home-featured-carousel-track" id="homeFeaturedCarouselTrack">
      {{#each featuredPromos}}
        <article class="home-featured-slide">
          <section class="latest-featured-row">
            <div class="latest-featured-main">

              <div class="latest-featured-topline">
                <span class="latest-featured-eyebrow">featured</span>
              </div>

              <h2 class="latest-featured-title">
                {{this.title}}
                {{#if this.subtitle}}
                  <span class="latest-featured-subtitle">{{this.subtitle}}</span>
                {{/if}}
              </h2>

              <div class="latest-featured-grid">

                <div class="latest-featured-content-row">
                  <div class="latest-featured-image-col">
                    <div class="latest-featured-image-frame">
                      <img
                        src="{{this.image}}"
                        alt="{{this.title}}"
                        class="latest-featured-main-image"
                      >
                    </div>
                  </div>

                  <div class="latest-featured-copy-col">
                    <p class="latest-featured-kicker">{{this.kicker}}</p>
                    <p class="latest-featured-body">{{this.body}}</p>

                  </div>
                </div>

                <aside class="latest-featured-author-col">
                  <div class="latest-featured-author-row">

                    <img
                      src="{{this.authorImage}}"
                      alt="Author image"
                      class="latest-featured-author-image"
                    >

                    <div class="latest-featured-author-name">
                      Michele Rochon-Wood
                    </div>

                    <div class="latest-featured-divider"></div>

                    <div class="latest-featured-unit-icon">
                      {{#if (eq this.unitType "promptset")}}
                        <img src="/icons/promptset.svg" alt="{{this.unitLabel}}">
                      {{else if (eq this.unitType "interview")}}
                        <img src="/icons/interview.svg" alt="{{this.unitLabel}}">
                      {{else}}
                        <img src="/icons/video.svg" alt="{{this.unitLabel}}">
                      {{/if}}
                    </div>

                    <p class="latest-featured-type-description">
                      {{#if (eq this.unitType "promptset")}}
                        Prompt sets contain 20 brief activities you complete over time that help you build new habits in business development, project management, and creativity.
                      {{else if (eq this.unitType "interview")}}
                        Twennie interviews feature conversations with industry professionals sharing practical insights you can apply directly to your work.
                      {{else}}
                        Twennie videos are shorter than 20 minutes and explore a topic relevant to your work.
                      {{/if}}
                    </p>

                    <div class="latest-featured-divider"></div>

                    <div class="latest-featured-btn-wrap">
                      {{#if this.button.disabled}}
                        <div class="latest-unit-review-btn disabled">
                          {{this.button.text}}
                        </div>
                      {{else}}
                        <a href="{{this.button.href}}" class="latest-unit-review-btn">
                          {{this.button.text}}
                        </a>
                      {{/if}}
                    </div>

                  </div>
                </aside>

              </div>
            </div>
          </section>
        </article>
      {{/each}}
    </div>

    {{#if featuredPromos.length}}
      <div class="home-featured-carousel-controls">
        <button
          type="button"
          class="home-featured-carousel-btn"
          id="homeFeaturedPrev"
          aria-label="Previous featured item"
        >
          ‹
        </button>

        <div class="home-featured-carousel-dots" id="homeFeaturedDots">
          {{#each featuredPromos}}
            <button
              type="button"
              class="home-featured-dot {{#if @first}}is-active{{/if}}"
              data-slide="{{@index}}"
              aria-label="Go to featured item {{@index}}"
            ></button>
          {{/each}}
        </div>

        <button
          type="button"
          class="home-featured-carousel-btn"
          id="homeFeaturedNext"
          aria-label="Next featured item"
        >
          ›
        </button>
      </div>
    {{/if}}

  </div>
</section>



<div class="latest-library-container">
      <hr class="latest-divider">
  <h1 class="latest-title">latest additions to the Twennie library</h1>

  <!-- Section: This Month -->
  <div class="latest-section">
    <h2 class="latest-section-title">this month</h2>
    <div class="latest-library-units-grid">
      {{#each thisMonthItems}}
        <div class="latest-library-unit-card">
          <div class="latest-card-svg-header">
            <img
              src="/images/unitsvg.svg"
              alt=""
              aria-hidden="true"
              class="latest-card-svg-image"
            >
          </div>

          <div class="latest-card-content">
            <img src="{{getUnitTypeIcon this.type}}" alt="Unit Type Icon" class="latest-unit-type-icon">
            <h2 class="latest-unit-title">{{this.title}}</h2>

            <div class="latest-expand-toggle" onclick="toggleLatestCard(this)">
              <svg class="latest-arrow-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 331.65 100.99">
                <defs><style>.cls-1 { fill: #4e50a2; }</style></defs>
                <polygon class="cls-1" points="0 0 161.57 100.99 331.65 0 0 0"/>
              </svg>
            </div>

            <div class="latest-hidden-content">
              <div class="latest-author-label">AUTHOR</div>
              <img src="{{authorImage}}" alt="Author Image" class="latest-author-image">
              <div class="latest-author-name">{{this.authorName}}</div>

              <p class="latest-unit-long-summary">{{this.full_summary}}</p>

              {{#if (eq this.type "promptset")}}
                <div class="latest-detail-value-purpose">
                  <strong>Purpose:</strong><br>
                  {{this.purpose}}
                </div>
              {{/if}}

              <div class="latest-unit-review-btn-container">
                {{#if isAuthenticated}}
                  {{#if isLeaderOrGroupMember}}
                    <a href="/unitviews/{{capitalize this.type}}s/view/{{this._id}}" class="latest-unit-review-btn">review this unit</a>
                  {{else if isPaid}}
                    <a href="/unitviews/{{capitalize this.type}}s/view/{{this._id}}" class="latest-unit-review-btn">review this unit</a>
                  {{else}}
                    {{#if isFree}}
                      {{#if isVideoOrArticle}}
                        <a href="/unitviews/{{capitalize this.type}}s/view/{{this._id}}" class="latest-unit-review-btn">review this unit</a>
                      {{else}}
                        <div class="latest-unit-review-btn disabled">membership upgrade required</div>
                      {{/if}}
                    {{else}}
                      <div class="latest-unit-review-btn disabled">membership upgrade required</div>
                    {{/if}}
                  {{/if}}
                {{else}}
                  <a href="/auth/login" class="latest-unit-review-btn">log in to view</a>
                {{/if}}
              </div>
            </div>
          </div>
        </div>
      {{else}}
        <p>No new items this week.</p>
      {{/each}}
    </div>
  </div>

  <hr class="latest-divider">

