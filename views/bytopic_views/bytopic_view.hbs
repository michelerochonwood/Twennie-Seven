{{#*inline "title"}}Search by Topic | Twennie{{/inline}}

<div class="bytopic-container">
  <!-- Main content column -->
  <div class="bytopic-content has-right-rail">
    <h1 class="bytopic-title">{{title}}</h1>
    <p class="bytopic-short-summary">{{shortSummary}}</p>
    <p class="bytopic-long-summary">{{longSummary}}</p>

<!-- Unit Card SVG Key -->
<div class="bytopic-unit-key" aria-label="Unit card key">
  <div class="bytopic-unit-key-item">
    <span class="bytopic-unit-key-label">ready to go</span>
    <img src="/images/unitsvg.svg"
         alt=""
         aria-hidden="true"
         class="bytopic-unit-key-svg">
  </div>

  <div class="bytopic-unit-key-item">
    <span class="bytopic-unit-key-label">upcoming unit</span>
    <img src="/images/newupcomingsvg.svg"
         alt=""
         aria-hidden="true"
         class="bytopic-unit-key-svg">
  </div>
</div>

<!-- Unit Type Icon Key -->
<div class="bytopic-unit-type-key" aria-label="Unit type key">
  <div class="bytopic-unit-type-key-item">
    <img src="/icons/article.svg" alt="" aria-hidden="true">
    <div class="bytopic-unit-type-title">Article</div>
    <div class="bytopic-unit-type-desc">
      A quick, written synopsis on a topic, no more than 1200 words.
    </div>
  </div>

  <div class="bytopic-unit-type-key-item">
    <img src="/icons/video.svg" alt="" aria-hidden="true">
    <div class="bytopic-unit-type-title">Video</div>
    <div class="bytopic-unit-type-desc">
      An informative video on a subject, no more than 20 minutes long; most are under 10 minutes.
    </div>
  </div>

  <div class="bytopic-unit-type-key-item">
    <img src="/icons/interview.svg" alt="" aria-hidden="true">
    <div class="bytopic-unit-type-title">Interview</div>
    <div class="bytopic-unit-type-desc">
      A filmed or audio interview with a professional in the AEC industry.
    </div>
  </div>

  <div class="bytopic-unit-type-key-item">
    <img src="/icons/promptset.svg" alt="" aria-hidden="true">
    <div class="bytopic-unit-type-title">Prompt Set</div>
    <div class="bytopic-unit-type-desc">
      20 brief activities completed daily, weekly, or monthly to build habits around a topic.
    </div>
  </div>

  <div class="bytopic-unit-type-key-item">
    <img src="/icons/exercise.svg" alt="" aria-hidden="true">
    <div class="bytopic-unit-type-title">Exercise</div>
    <div class="bytopic-unit-type-desc">
      A group activity designed to plan, strategize, explore, or develop procedures.
    </div>
  </div>

  <div class="bytopic-unit-type-key-item">
    <img src="/icons/template.svg" alt="" aria-hidden="true">
    <div class="bytopic-unit-type-title">Template</div>
    <div class="bytopic-unit-type-desc">
      A document, spreadsheet, or drawing that supports a task or exercise.
    </div>
  </div>
</div>




    {{#each sectionedUnits}}
      <h2 class="bytopic-section-title">{{this.sectionTitle}}</h2>
      <hr class="bytopic-section-divider">

      {{#if this.units.length}}
        <div class="bytopic-library-units-grid">
          {{#each this.units}}
<article class="bytopic-library-unit-card" data-unit-id="{{_id}}">
  {{#if (eq this.type "upcoming")}}
    <!-- Upcoming corner badge -->
    <img src="/icons/upcomingsvg.svg" alt="" aria-hidden="true" class="bytopic-upcoming-badge">
  {{/if}}

  <!-- Inner wrapper preserves rounded-corner clipping -->
  <div class="bytopic-card-inner">
    <!-- SVG Header -->
    <div class="bytopic-card-svg-header">
      {{#if (eq this.type "upcoming")}}
        <!-- Upcoming header SVG -->
        <img src="/images/newupcomingsvg.svg"
             alt=""
             aria-hidden="true"
             class="bytopic-card-svg-image">
      {{else}}
        <!-- Regular unit header SVG -->
        <img src="/images/unitsvg.svg"
             alt=""
             aria-hidden="true"
             class="bytopic-card-svg-image">
      {{/if}}
    </div>

    <!-- Card Content -->
    <div class="bytopic-card-content">
      <!-- Always-visible content -->
      <div class="bytopic-visible-content">
        <div class="bytopic-unit-type-icon-container">
          {{#if (eq this.type "upcoming")}}
            <img src="{{getUnitTypeIcon this.unit_type}}" alt="Unit Type Icon" class="bytopic-unit-type-icon">
          {{else}}
            <img src="{{getUnitTypeIcon this.type}}" alt="Unit Type Icon" class="bytopic-unit-type-icon">
          {{/if}}
        </div>
        <div class="bytopic-unit-title-container">
          <h2 class="bytopic-unit-title">{{this.title}}</h2>
        </div>
      </div>

      <!-- Expand Toggle -->
      <button class="bytopic-expand-toggle" type="button" onclick="toggleCard(this)" aria-expanded="false" aria-label="Toggle details">
        <svg class="expand-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 331.65 100.99" aria-hidden="true" focusable="false">
          <defs><style>.cls-1 { fill: #4e50a2; }</style></defs>
          <polygon class="cls-1" points="0 0 161.57 100.99 331.65 0 0 0"/>
        </svg>
      </button>

      <!-- Expandable content -->
      <div class="bytopic-hidden-content" style="display:none;">
        <div class="bytopic-author-label">
          {{#if (eq this.type "upcoming")}}PROJECTED{{else}}AUTHOR{{/if}}
        </div>

        <div class="bytopic-author-image-container">
          {{#if (eq this.type "upcoming")}}
            <img src="{{image.url}}" alt="{{#if image.alt}}{{image.alt}}{{else}}Upcoming image{{/if}}" class="bytopic-author-image">
          {{else}}
            <img src="{{authorImage}}" alt="Author Image" class="bytopic-author-image">
          {{/if}}
        </div>

        <div class="bytopic-author-name-container">
          <span class="bytopic-author-name">
            {{#if (eq this.type "upcoming")}}
              {{#if projected_release_at}}{{formatDate projected_release_at}}{{else}}TBD{{/if}}
            {{else}}
              {{this.authorName}}
            {{/if}}
          </span>
        </div>

        <div class="bytopic-unit-summary-container">
          <p class="bytopic-unit-long-summary">
            {{#if (eq this.type "upcoming")}}
              {{long_teaser}}
            {{else}}
              {{this.full_summary}}
            {{/if}}
          </p>
        </div>

        {{#if (eq this.type "promptset")}}
          <div class="bytopic-detail-value-purpose">
            <strong>Purpose:</strong><br>
            {{this.purpose}}
          </div>
        {{/if}}

        <!-- ACCESS CONTROL / CTA -->
        <div class="bytopic-unit-review-container">
          {{#if (eq this.type "upcoming")}}
            <a href="/unitviews/upcoming/view/{{_id}}" class="bytopic-unit-review-btn">view upcoming</a>
          {{else}}
            {{#if loggedIn}}
              {{#if isLeaderOrGroupMember}}
                <a href="/unitviews/{{capitalize type}}s/view/{{_id}}" class="bytopic-unit-review-btn">review this unit</a>
              {{else if isPaid}}
                <a href="/unitviews/{{capitalize type}}s/view/{{_id}}" class="bytopic-unit-review-btn">review this unit</a>
              {{else}}
                {{#if isFree}}
                  {{#if isVideoOrArticle}}
                    <a href="/unitviews/{{capitalize type}}s/view/{{_id}}" class="bytopic-unit-review-btn">review this unit</a>
                  {{else}}
                    <div class="bytopic-unit-review-btn" style="color: gray; cursor: default;">membership upgrade required</div>
                  {{/if}}
                {{else}}
                  <div class="bytopic-unit-review-btn" style="color: gray; cursor: default;">membership upgrade required</div>
                {{/if}}
              {{/if}}
            {{else}}
              <div class="bytopic-unit-review-btn" style="color: gray; cursor: default;">login required</div>
            {{/if}}
          {{/if}}
        </div>
      </div>
    </div>
  </div> <!-- /.bytopic-card-inner -->
</article>

          {{/each}}
        </div>
      {{else}}
        <div class="bytopic-empty-section-message">
          {{#if this.emptyMessage}}<p>{{this.emptyMessage}}</p>{{/if}}
        </div>
      {{/if}}
    {{/each}}
  </div>

  <!-- Right Topics Column (fixed; reused partial) -->
  <div class="bytopic-page">
    {{> topicpartials/topics_column_partial}}
  </div>
</div>

<!-- Expand Toggle Script -->
<script>
  function toggleCard(el) {
    const card = el.closest('.bytopic-library-unit-card');
    const content = card.querySelector('.bytopic-hidden-content');
    const isOpen = card.classList.contains('active');
    card.classList.toggle('active', !isOpen);
    el.setAttribute('aria-expanded', String(!isOpen));
    content.style.display = isOpen ? 'none' : 'flex';
  }
</script>













