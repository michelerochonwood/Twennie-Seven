<!-- Sample Static Template View for Promotional Use -->
{{#*inline "title"}}Sample Template | Twennie{{/inline}}
<div class="single_template-container">
  <!-- Main Section -->
  <div class="single_template-main">
    <h1 class="single_template-main-title">SAMPLE TEMPLATE: The First 10 Days Communication Rulebook Template</h1>
    <p class="single_template-short-summary">
      <strong>Create a project communication system before problems occur. This practical rulebook helps project managers establish tone, cadence, documentation standards, boundaries, and communication strategies throughout the entire project lifecycle.</strong>
    </p>
    <p class="single_template-long-summary">
      Strong communication does not happen by accident. The First 10 Days Communication Rulebook Template helps project managers intentionally design how communication will work before scope drift, misunderstandings, burnout, or crises emerge. Through structured worksheets, checklists, scripts, and planning tools, users establish communication tone, client update cadence, decision documentation practices, scope-reset strategies, crisis communication protocols, team workload management approaches, phase-transition procedures, project closeout methods, and post-project knowledge capture processes.
    </p>

    <div class="single_template-image">
      <img src="/images/first10days.png" alt="Sample Template Image">
    </div>

    <div class="template-download">

    </div>
  </div>

  <!-- Sidebar -->
  <aside class="single_template-sidebar">
    <div class="single_template-duration-image-container">
      <img src="/images/30mins.svg" alt="Estimated Time: 30 Minutes" class="single_template-duration-image" style="width: 100px">
    </div>

    <div class="single_template-image-container">
      <img src="/icons/template.svg" alt="Template Icon" class="single_template-sidebar-image">
    </div>

    <p class="single_template-title-sidebar">Pink Team Review Template Form</p>

    <div class="single_template-author">
      <img src="/images/author-article.jpeg" alt="Author" class="single_template-author-image">
      <p class="single_template-author-name">Author: Michele Rochon-Wood</p>
    </div>

    <div class="single_template-details">
      <p class="single_template-unit-type">Template</p>
      <p class="single_template-main-topic">Main Topic: Proposal Management</p>
    </div>
  </aside>
</div>

{{> mainpartials/home_subfooter}}
