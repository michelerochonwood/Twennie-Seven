<div class="bookdemo-page">

  <div class="bookdemo-header">
    <img
      src="/images/executivebluey.png"
      alt="Executive Bluey"
      class="bookdemo-hero-image"
    >

<h1 class="bookdemo-title">book a demo</h1>

<p class="bookdemo-intro">
  Curious whether Twennie is right for you or your organization?
</p>

<p class="bookdemo-description">
  During this conversation, we'll learn about your goals, challenges, and priorities,
  demonstrate the areas of Twennie most relevant to your needs, and answer any
  questions you may have.
</p>


  </div>

  <div class="bookdemo-info-card">
    <h3>what to expect</h3>


<ul>
  <li>30 or 60 minute virtual meeting (20+10 Q&A)  (40+20 Q&A)</li>
  <li>Overview of the Twennie platform</li>
  <li>Discussion of your goals and challenges</li>
  <li>Questions and answers</li>
</ul>




  </div>

  <form action="/demo/book-a-demo" method="POST" class="bookdemo-form">


<input type="hidden" name="_csrf" value="{{csrfToken}}">

<div class="bookdemo-field">
  <label for="name" class="bookdemo-label">
    your name <span class="required">*</span>
  </label>
  <input type="text" id="name" name="name" class="bookdemo-input" required>
</div>

<div class="bookdemo-field">
  <label for="email" class="bookdemo-label">
    email address <span class="required">*</span>
  </label>
  <input type="email" id="email" name="email" class="bookdemo-input" required>
</div>

<div class="bookdemo-field">
  <label for="organization" class="bookdemo-label">
    organization (optional)
  </label>
  <input type="text" id="organization" name="organization" class="bookdemo-input">
</div>

<div class="bookdemo-field">
  <label for="jobTitle" class="bookdemo-label">
    job title (optional)
  </label>
  <input type="text" id="jobTitle" name="jobTitle" class="bookdemo-input">
</div>

<div class="bookdemo-field">
  <label for="teamSize" class="bookdemo-label">
    group size (optional)
  </label>
  <select id="teamSize" name="teamSize" class="bookdemo-select">
    <option value="">Select one</option>
    <option>individual</option>
    <option>1-50</option>
    <option>50+</option>
  </select>
</div>



<div class="bookdemo-field">
  <label for="message" class="bookdemo-label">
    additional information (optional)
  </label>
  <textarea id="message" name="message" rows="6" maxlength="2000" class="bookdemo-textarea"></textarea>
</div>

<button type="submit" class="bookdemo-submit">
  request a demo
</button>


  </form>

</div>

{{> mainpartials/home_subfooter}}
