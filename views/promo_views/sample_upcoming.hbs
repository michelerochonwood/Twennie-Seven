<!-- Sample Static Upcoming View for Promotional Use -->
{{#*inline "title"}}Sample Upcoming | Twennie{{/inline}}

<div class="single_upcoming-container">

  <!-- Main -->
  <div class="single_upcoming-main">
    <h1 class="single_upcoming-main-title">SAMPLE UPCOMING UNIT</h1>

    <p class="single_upcoming-unit-title">VIDEO: Leading a Team Through a Crisis</p>

    <div class="single_upcoming-hero">
      <img
        src="https://res.cloudinary.com/dgeszflt3/image/upload/v1759961369/twennie_upcoming/fgiaqmrdvmoxn49felfi.png"
        alt="Leading a Team Through a Crisis"
        class="single_upcoming-hero-image"
      />
    </div>

    <p class="single_upcoming-teaser">
      <strong>
        When everything feels uncertain, leadership matters most. Learn how to stay calm, communicate clearly,
        and lead with confidence when your team faces crisis or disruption.
      </strong>
    </p>

    <p class="single_upcoming-long-teaser">
      Every leader will face moments when plans unravel and pressure mounts. Leading a Team Through a Crisis prepares you for those moments.
      This video explores proven strategies for maintaining stability, protecting morale, and guiding teams through uncertainty.
      You’ll learn how to prioritize communication, make fast but thoughtful decisions, and sustain trust when the stakes are high.
    </p>

    <div class="single_upcoming-main-body">

      <section class="single_upcoming-card">
        <h2 class="single_upcoming-section-title">Details</h2>

        <dl class="single_upcoming-details-list">
          <div class="single_upcoming-details-row">
            <dt>Status</dt>
            <dd>in production</dd>
          </div>

          <div class="single_upcoming-details-row">
            <dt>Unit type</dt>
            <dd>video</dd>
          </div>

          <div class="single_upcoming-details-row">
            <dt>Main topic</dt>
            <dd>Leadership in Technical Services</dd>
          </div>

          <div class="single_upcoming-details-row">
            <dt>Projected release</dt>
            <dd>October 8, 2025</dd>
          </div>

          <div class="single_upcoming-details-row">
            <dt>Visibility</dt>
            <dd>all members</dd>
          </div>
        </dl>
      </section>

      <section class="single_upcoming-card">
        <h2 class="single_upcoming-section-title">What this page demonstrates</h2>
        <p class="single_upcoming-text">
          Upcoming units are previews. They show what’s coming, why it matters, and when it’s expected to launch.
          Members can use these pages to get oriented and decide what to watch for next.
        </p>
      </section>

    </div>
  </div>

  <!-- Sidebar -->
  <aside class="single_upcoming-sidebar">
    <div class="single_upcoming-sidebar-card">

      <div class="single_upcoming-icon-wrap" aria-hidden="true">
        <img src="/images/upcomingicon.png" alt="" class="single_upcoming-icon">
      </div>

      <p class="single_upcoming-title-sidebar">Leading a Team Through a Crisis</p>

      <div class="single_upcoming-creator">
        <img src="/images/author-article.jpeg" alt="Creator Image" class="single_upcoming-creator-image">
        <p class="single_upcoming-creator-name">Created by: Twennie Founders</p>
      </div>

      <div class="single_upcoming-sidebar-block">
        <div class="single_upcoming-sidebar-label">status</div>
        <div class="single_upcoming-chips">
          <span class="single_upcoming-chip single_upcoming-chip-status">in production</span>
        </div>
      </div>

      <div class="single_upcoming-sidebar-block">
        <div class="single_upcoming-sidebar-label">unit type</div>
        <div class="single_upcoming-chips">
          <span class="single_upcoming-chip single_upcoming-chip-type">video</span>
        </div>
      </div>

      <div class="single_upcoming-sidebar-block">
        <div class="single_upcoming-sidebar-label">topic</div>
        <div class="single_upcoming-chips">
          <span class="single_upcoming-chip single_upcoming-chip-topic">Leadership in Technical Services</span>
        </div>
      </div>

      <div class="single_upcoming-sidebar-block">
        <div class="single_upcoming-sidebar-label">release</div>
        <div class="single_upcoming-chips">
          <span class="single_upcoming-chip single_upcoming-chip-date">Oct 8, 2025</span>
        </div>
      </div>

      <div class="single_upcoming-details-meta">
        <p class="single_upcoming-unit-type">Upcoming</p>
      </div>

    </div>
  </aside>

</div>


{{> mainpartials/home_subfooter}}