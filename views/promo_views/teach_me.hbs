<script>
  // Local toggle so Teach Me behaves like KPI expandables
  document.addEventListener('DOMContentLoaded', function () {
    const items = document.querySelectorAll('.teach-me-expandable-item');

    items.forEach(function (item) {
      const header = item.querySelector('.expandable-header');
      const content = item.querySelector('.expandable-content');

      if (!header || !content) return;

      // Hide by default
      content.style.display = 'none';

      header.addEventListener('click', function () {
        const isActive = item.classList.contains('active');
        item.classList.toggle('active', !isActive);
        header.setAttribute('aria-expanded', String(!isActive));
        content.style.display = isActive ? 'none' : 'block';
      });
    });
  });
</script>
