{{!-- views/archiveviews/member_archive.hbs --}}

<section class="leader-archive-page">
  <header class="leader-archive-header">
    <div class="leader-archive-hero-image-wrap">
      <img
        src="/images/archive bluey.png"
        alt="Archive Bluey"
        class="leader-archive-hero-image"
      >
    </div>

    <h1 class="leader-archive-title">learning archive</h1>
    <p class="leader-archive-intro">
      Review archived work by topic, see what has been completed, and jump back to the unit or report center whenever you need more detail.
    </p>
  </header>

  <div class="leader-archive-top-actions">
    <a href="/dashboard/member" class="leader-archive-back-link">return to dashboard</a>
    <a href="/reports/mylearningnotes_individual" class="leader-archive-report-link">view my learning notes</a>
  </div>

  {{#if archiveTopics.length}}
    <div class="leader-archive-topic-sections">
      {{#each archiveTopics}}
        <section class="leader-archive-topic-block">
          <div class="leader-archive-topic-header">
            <h2 class="leader-archive-topic-title">
              {{#if topicTitle}}{{topicTitle}}{{else}}no topic assigned{{/if}}
            </h2>

            {{#if topicLongSummary}}
              <p class="leader-archive-topic-summary">{{topicLongSummary}}</p>
            {{/if}}

            <p class="leader-archive-topic-count">
              {{archivedItems.length}} archived item{{#unless (eq archivedItems.length 1)}}s{{/unless}}
            </p>
          </div>

          <div class="leader-archive-grid">
            {{#each archivedItems}}
              <article class="leader-archive-card tagged-unit-card leader-dashboard-wave-card">
                <div class="leader-archive-card-inner leader-dashboard-wave-card-inner">
                  <div class="leader-dashboard-wave-header">
                    <img src="/icons/unitsvg.svg" alt="" aria-hidden="true" class="leader-dashboard-wave-image">
                  </div>

                  <div class="leader-dashboard-wave-content">
                    <div class="tagged-unit-icon leader-archive-unit-icon">
                      <img
                        src="/icons/{{#if (eq unitType 'article')}}article.svg{{else}}{{#if (eq unitType 'video')}}video.svg{{else}}{{#if (eq unitType 'interview')}}interview.svg{{else}}{{#if (eq unitType 'promptset')}}promptset.svg{{else}}{{#if (eq unitType 'exercise')}}exercise.svg{{else}}{{#if (eq unitType 'template')}}template.svg{{else}}article.svg{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}"
                        alt="{{unitType}} icon"
                      >
                    </div>

                    <div class="leader-archive-card-body">
                      <h3 class="leader-archive-card-title">{{titleSnapshot}}</h3>

                      {{#if archiveScope}}
                        <p class="leader-archive-card-meta">
                          <strong>assignment type:</strong>
                          {{#if (eq archiveScope "self_assigned")}}
                            self-assigned
                          {{else}}
                            assigned
                          {{/if}}
                        </p>
                      {{/if}}

                      {{#if assignedToNameSnapshot}}
                        <p class="leader-archive-card-meta">
                          <strong>assigned to:</strong> {{assignedToNameSnapshot}}
                        </p>
                      {{/if}}

                      {{#if unitAuthorName}}
                        <p class="leader-archive-card-meta">
                          <strong>unit author:</strong> {{unitAuthorName}}
                        </p>
                      {{/if}}

                      {{#if isCompleted}}
                        <p class="leader-archive-card-meta">
                          <strong>completed by:</strong>
                          {{#if completedByName}}{{completedByName}}{{else}}{{assignedToNameSnapshot}}{{/if}}{{#if completedWhenFormatted}}, {{completedWhenFormatted}}{{/if}}
                        </p>

                        {{#if this.badgeImagePath}}
                          <div style="display:flex; align-items:center; justify-content:center; gap:8px; margin:10px 0;">
                            <img
                              src="{{this.badgeImagePath}}"
                              alt="{{#if this.badgeName}}{{this.badgeName}}{{else}}earned badge{{/if}}"
                              style="width:85px; height:85px; object-fit:contain; flex-shrink:0;"
                            >

                            <div style="display:flex; flex-direction:column; align-items:flex-start; line-height:1.2;">
                              <span style="font-size:0.6rem; font-weight:800; color:#dc176a;">badge earned</span>
                              <span style="font-size:0.7rem; font-weight:800; color:#262262;">
                                {{#if this.badgeName}}{{this.badgeName}}{{else}}badge earned{{/if}}
                              </span>
                            </div>
                          </div>
                        {{/if}}
                      {{else}}
                        <div class="leader-archive-not-completed">
                          <span class="leader-archive-not-completed-dot"></span>
                          <strong>not completed</strong>
                        </div>
                      {{/if}}

                      {{#if summarySnapshot}}
                        <div class="leader-archive-card-summary">
                          <h4 class="leader-archive-card-subtitle">summary</h4>
                          <p>{{summarySnapshot}}</p>
                        </div>
                      {{/if}}

                      {{#if notesPreview}}
                        <div class="leader-archive-card-notes">
                          <h4 class="leader-archive-card-subtitle">notes</h4>
                          <p>{{notesPreview}}</p>
                        </div>
                      {{else}}
                        <div class="leader-archive-card-notes leader-archive-card-notes--empty">
                          <h4 class="leader-archive-card-subtitle">notes</h4>
                          <p class="muted">no notes available</p>
                        </div>
                      {{/if}}

                      {{#if archiveNoteInstruction}}
                        {{#if (eq unitType "promptset")}}
                          <div class="archive-prompt-report-cta-wrap">
                            <a href="/reports/mycompletedpromptsets-individual" class="archive-prompt-report-cta">
                              {{archiveNoteInstruction}}
                            </a>
                          </div>
                        {{else}}
                          <div class="leader-archive-note-instruction-block">
                            <strong>{{archiveNoteInstruction}}</strong>
                          </div>
                        {{/if}}
                      {{/if}}
                    </div>

                    <div class="leader-archive-card-actions">
                      {{#if viewPath}}
                        <a href="{{viewPath}}" class="tagged-unit-link">view unit</a>
                      {{/if}}
                    </div>
                  </div>
                </div>
              </article>
            {{/each}}
          </div>
        </section>
      {{/each}}
    </div>
  {{else}}
    <section class="leader-archive-empty">
      <h2 class="leader-archive-empty-title">nothing archived yet</h2>
      <p class="leader-archive-empty-text">
        Once you move units out of your active dashboard, they’ll appear here by topic.
      </p>

      <div class="leader-archive-top-actions">
        <a href="/dashboard/member" class="leader-archive-back-link">return to dashboard</a>
      </div>
    </section>
  {{/if}}
</section>