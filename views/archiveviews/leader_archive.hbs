{{!-- views/archiveviews/leader_archive.hbs --}}

<section class="leader-archive-page">
  <header class="leader-archive-header">
    <div class="leader-archive-hero-image-wrap">
      <img
        src="/images/archive bluey.png"
        alt="Archive Bluey"
        class="leader-archive-hero-image"
      >
    </div>

    <h1 class="leader-archive-title">learning archive</h1>
    <p class="leader-archive-intro">
      Review archived work by topic, see what has been completed, and jump back to the unit or report center whenever you need more detail.
    </p>
  </header>

  <div class="leader-archive-top-actions">
    <a href="/dashboard/leader" class="leader-archive-back-link">return to dashboard</a>
  </div>

  {{#if archiveTopics.length}}
    <div class="leader-archive-topic-sections">
      {{#each archiveTopics}}
        <section class="leader-archive-topic-block">
          <div class="leader-archive-topic-header">
            <h2 class="leader-archive-topic-title">
              {{#if topicTitle}}{{topicTitle}}{{else}}no topic assigned{{/if}}
            </h2>

            {{#if topicLongSummary}}
              <p class="leader-archive-topic-summary">{{topicLongSummary}}</p>
            {{/if}}

            <p class="leader-archive-topic-count">
              {{archivedItems.length}} archived item{{#unless (eq archivedItems.length 1)}}s{{/unless}}
            </p>
          </div>

          <div class="leader-archive-grid">
            {{#each archivedItems}}
              <article class="leader-archive-card tagged-unit-card leader-dashboard-wave-card">
                <div class="leader-archive-card-inner leader-dashboard-wave-card-inner">
                  <div class="leader-dashboard-wave-header">
                    <img src="/icons/unitsvg.svg" alt="" aria-hidden="true" class="leader-dashboard-wave-image">
                  </div>

                  <div class="leader-dashboard-wave-content">
                    <div class="tagged-unit-icon leader-archive-unit-icon">
                      <img
                        src="/icons/{{#if (eq unitType 'article')}}article.svg{{else}}{{#if (eq unitType 'video')}}video.svg{{else}}{{#if (eq unitType 'interview')}}interview.svg{{else}}{{#if (eq unitType 'promptset')}}promptset.svg{{else}}{{#if (eq unitType 'exercise')}}exercise.svg{{else}}{{#if (eq unitType 'template')}}template.svg{{else}}article.svg{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}"
                        alt="{{unitType}} icon"
                      >
                    </div>

                    <div class="leader-archive-card-body">
                      <h3 class="leader-archive-card-title">{{titleSnapshot}}</h3>

                      {{#if archiveScope}}
                        <p class="leader-archive-card-meta">
                          <strong>assignment type:</strong>
                          {{#if (eq archiveScope "self_assigned")}}
                            self-assigned by {{#if completedByName}}{{completedByName}}{{else}}{{assignedToNameSnapshot}}{{/if}}
                          {{else}}
                            assigned by leader
                          {{/if}}
                        </p>
                      {{/if}}

                      {{#if unitAuthorName}}
                        <p class="leader-archive-card-meta">
                          <strong>unit author:</strong> {{unitAuthorName}}
                        </p>
                      {{/if}}

                      {{#if isCompleted}}
                        <p class="leader-archive-card-meta">
                          <strong>completed by:</strong>
                          {{completedByName}}{{#if completedWhenFormatted}}, {{completedWhenFormatted}}{{/if}}
                        </p>

{{#if hasEarnedBadge}}
  <div class="leader-archive-badge-earned-block">
    <img
      src="{{badgeImagePath}}"
      alt="{{#if badgeName}}{{badgeName}}{{else}}earned badge{{/if}}"
      class="leader-archive-badge-earned-image"
    >
    <div class="leader-archive-badge-earned-copy">
      <span class="leader-archive-badge-earned-label">badge earned</span>
      {{#if badgeName}}
        <span class="leader-archive-badge-earned-name">{{badgeName}}</span>
      {{else}}
        <span class="leader-archive-badge-earned-name">mission badge</span>
      {{/if}}
    </div>
  </div>
{{/if}}
                      {{else}}
                        <div class="leader-archive-not-completed">
                          <span class="leader-archive-not-completed-dot"></span>
                          <strong>not completed</strong>
                        </div>
                      {{/if}}

                      {{#if summarySnapshot}}
                        <div class="leader-archive-card-summary">
                          <h4 class="leader-archive-card-subtitle">summary</h4>
                          <p>{{summarySnapshot}}</p>
                        </div>
                      {{/if}}

                      {{#if notesPreview}}
                        <div class="leader-archive-card-notes">
                          <h4 class="leader-archive-card-subtitle">notes</h4>
                          <p>{{notesPreview}}</p>
                        </div>
                      {{else}}
                        <div class="leader-archive-card-notes leader-archive-card-notes--empty">
                          <h4 class="leader-archive-card-subtitle">notes</h4>
                          <p class="muted">no notes available</p>
                        </div>
                      {{/if}}

                      {{#if archiveNoteInstruction}}
                        {{#if (eq unitType "promptset")}}
                          <div class="archive-prompt-report-cta-wrap">
                            <a href="/reports/promptsetscompleted" class="archive-prompt-report-cta">
                              {{archiveNoteInstruction}}
                            </a>
                          </div>
                        {{else}}
                          <div class="leader-archive-note-instruction-block">
                            <strong>{{archiveNoteInstruction}}</strong>
                          </div>
                        {{/if}}
                      {{/if}}
                    </div>

                    <div class="leader-archive-card-actions">
                      {{#if viewPath}}
                        <a href="{{viewPath}}" class="tagged-unit-link">view unit</a>
                      {{/if}}
                    </div>
                  </div>
                </div>
              </article>
            {{/each}}
          </div>
        </section>
      {{/each}}
    </div>
  {{/if}}

{{#if archivedMissions.length}}
  <section class="leader-archive-topic-block">
    <div class="leader-archive-topic-header">
      <h2 class="leader-archive-topic-title">archived missions</h2>
      <p class="leader-archive-topic-count">
        {{archivedMissions.length}} archived mission{{#unless (eq archivedMissions.length 1)}}s{{/unless}}
      </p>
    </div>

    <div class="leader-archive-grid">
      {{#each archivedMissions}}
        <article class="leader-archive-card tagged-unit-card leader-dashboard-wave-card">
          <div class="leader-archive-card-inner leader-dashboard-wave-card-inner">
            <div class="leader-dashboard-wave-header">
              <img src="/icons/onyxsvg.svg" alt="" aria-hidden="true" class="leader-dashboard-wave-image">
            </div>

            <div class="leader-dashboard-wave-content">
              <div class="tagged-unit-icon leader-archive-unit-icon">
                <img src="/icons/mission.svg" alt="mission icon">
              </div>

              <div class="leader-archive-card-body">
                <h3 class="leader-archive-card-title">{{titleSnapshot}}</h3>

                {{#if archiveScope}}
                  <p class="leader-archive-card-meta">
                    <strong>assignment type:</strong>
                    {{#if (eq archiveScope "self_assigned")}}
                      self-assigned by {{#if completedByName}}{{completedByName}}{{else}}{{assignedToNameSnapshot}}{{/if}}
                    {{else}}
                      assigned by leader
                    {{/if}}
                  </p>
                {{/if}}

                {{#if isCompleted}}
                  <p class="leader-archive-card-meta">
                    <strong>completed by:</strong>
                    {{completedByName}}{{#if completedWhenFormatted}}, {{completedWhenFormatted}}{{/if}}
                  </p>

                  <div class="leader-archive-badge-earned-block">
                    {{#if (eq category "administrative")}}
                      <img src="/badges/missions/adminbadge.png" alt="administrative mission badge" class="leader-archive-badge-earned-image">
                      <div class="leader-archive-badge-earned-copy">
                        <span class="leader-archive-badge-earned-label">badge earned</span>
                        <span class="leader-archive-badge-earned-name">administrative mission badge</span>
                        
                      </div>
                    {{else if (eq category "business_development")}}
                      <img src="/badges/missions/bdbadge.png" alt="business development mission badge" class="leader-archive-badge-earned-image">
                      <div class="leader-archive-badge-earned-copy">
                        <span class="leader-archive-badge-earned-label">badge earned</span>
                        <span class="leader-archive-badge-earned-name">business development mission badge</span>
                      </div>
                    {{else if (eq category "client_experience")}}
                      <img src="/badges/missions/clientxbadge.png" alt="client experience mission badge" class="leader-archive-badge-earned-image">
                      <div class="leader-archive-badge-earned-copy">
                        <span class="leader-archive-badge-earned-label">badge earned</span>
                        <span class="leader-archive-badge-earned-name">client experience mission badge</span>
                      </div>
                    {{else if (eq category "community")}}
                      <img src="/badges/missions/communiitybadge.png" alt="community mission badge" class="leader-archive-badge-earned-image">
                      <div class="leader-archive-badge-earned-copy">
                        <span class="leader-archive-badge-earned-label">badge earned</span>
                        <span class="leader-archive-badge-earned-name">community mission badge</span>
                      </div>
                    {{else if (eq category "culture_play")}}
                      <img src="/badges/missions/culturebadge.png" alt="culture and play mission badge" class="leader-archive-badge-earned-image">
                      <div class="leader-archive-badge-earned-copy">
                        <span class="leader-archive-badge-earned-label">badge earned</span>
                        <span class="leader-archive-badge-earned-name">culture and play mission badge</span>
                      </div>
                    {{else if (eq category "internal_improvement")}}
                      <img src="/badges/missions/improvebadge.png" alt="internal improvement mission badge" class="leader-archive-badge-earned-image">
                      <div class="leader-archive-badge-earned-copy">
                        <span class="leader-archive-badge-earned-label">badge earned</span>
                        <span class="leader-archive-badge-earned-name">internal improvement mission badge</span>
                      </div>
                    {{else if (eq category "learning")}}
                      <img src="/badges/missions/learningbadge.png" alt="learning mission badge" class="leader-archive-badge-earned-image">
                      <div class="leader-archive-badge-earned-copy">
                        <span class="leader-archive-badge-earned-label">badge earned</span>
                        <span class="leader-archive-badge-earned-name">learning mission badge</span>
                      </div>
                    {{else if (eq category "research")}}
                      <img src="/badges/missions/researchbadge.png" alt="research mission badge" class="leader-archive-badge-earned-image">
                      <div class="leader-archive-badge-earned-copy">
                        <span class="leader-archive-badge-earned-label">badge earned</span>
                        <span class="leader-archive-badge-earned-name">research mission badge</span>
                      </div>
                    {{else if (eq category "other")}}
                      <img src="/badges/missions/roguebadge.png" alt="rogue mission badge" class="leader-archive-badge-earned-image">
                      <div class="leader-archive-badge-earned-copy">
                        <span class="leader-archive-badge-earned-label">badge earned</span>
                        <span class="leader-archive-badge-earned-name">rogue mission badge</span>
                      </div>
                    {{/if}}
                  </div>
                {{else}}
                  <div class="leader-archive-not-completed">
                    <span class="leader-archive-not-completed-dot"></span>
                    <strong>not completed</strong>
                  </div>
                {{/if}}

                {{#if summarySnapshot}}
                  <div class="leader-archive-card-summary">
                    <h4 class="leader-archive-card-subtitle">summary</h4>
                    <p>{{summarySnapshot}}</p>
                  </div>
                {{/if}}

                {{#if notesPreview}}
                  <div class="leader-archive-card-notes">
                    <h4 class="leader-archive-card-subtitle">notes</h4>
                    <p>{{notesPreview}}</p>
                  </div>
                {{else}}
                  <div class="leader-archive-card-notes leader-archive-card-notes--empty">
                    <h4 class="leader-archive-card-subtitle">notes</h4>
                    <p class="muted">no notes available</p>
                  </div>
                {{/if}}
              </div>

              <div class="leader-archive-card-actions">
                {{#if viewPath}}
                  <a href="{{viewPath}}" class="tagged-unit-link">view mission</a>
                {{/if}}


              </div>
            </div>
          </div>
        </article>
      {{/each}}
    </div>
  </section>
{{/if}}

  {{#if archivedNuggets.length}}
    <section class="leader-archive-topic-block">
      <div class="leader-archive-topic-header">
        <h2 class="leader-archive-topic-title">archived nuggets</h2>
        <p class="leader-archive-topic-count">
          {{archivedNuggets.length}} archived nugget{{#unless (eq archivedNuggets.length 1)}}s{{/unless}}
        </p>
      </div>

      <div class="leader-archive-grid">
        {{#each archivedNuggets}}
          <article class="leader-archive-card tagged-unit-card leader-dashboard-wave-card">
            <div class="leader-archive-card-inner leader-dashboard-wave-card-inner">
              <div class="leader-dashboard-wave-header">
                <img src="/icons/goldsvg.svg" alt="" aria-hidden="true" class="leader-dashboard-wave-image">
              </div>

              <div class="leader-dashboard-wave-content">
                <div class="tagged-unit-icon leader-archive-unit-icon">
                  <img src="/icons/nuggeticon.svg" alt="nugget icon">
                </div>

                <div class="leader-archive-card-body">
                  <h3 class="leader-archive-card-title">{{titleSnapshot}}</h3>

                  {{#if archiveScope}}
                    <p class="leader-archive-card-meta">
                      <strong>assignment type:</strong>
                      {{#if (eq archiveScope "self_assigned")}}
                        self-assigned by {{#if completedByName}}{{completedByName}}{{else}}{{assignedToNameSnapshot}}{{/if}}
                      {{else}}
                        assigned by leader
                      {{/if}}
                    </p>
                  {{/if}}

                  {{#if completedByName}}
                    <p class="leader-archive-card-meta">
                      <strong>archived for:</strong>
                      {{completedByName}}{{#if completedWhenFormatted}}, {{completedWhenFormatted}}{{/if}}
                    </p>
                  {{/if}}

                  {{#if mainTopicSnapshot}}
                    <p class="leader-archive-card-meta">
                      <strong>classification:</strong> {{mainTopicSnapshot}}
                    </p>
                  {{/if}}

                  {{#if summarySnapshot}}
                    <div class="leader-archive-card-summary">
                      <h4 class="leader-archive-card-subtitle">summary</h4>
                      <p>{{summarySnapshot}}</p>
                    </div>
                  {{/if}}

                  {{#if notesPreview}}
                    <div class="leader-archive-card-notes">
                      <h4 class="leader-archive-card-subtitle">notes</h4>
                      <p>{{notesPreview}}</p>
                    </div>
                  {{else}}
                    <div class="leader-archive-card-notes leader-archive-card-notes--empty">
                      <h4 class="leader-archive-card-subtitle">notes</h4>
                      <p class="muted">no notes available</p>
                    </div>
                  {{/if}}

                  {{#if archiveNoteInstruction}}
                    <div class="leader-archive-note-instruction-block">
                      <strong>{{archiveNoteInstruction}}</strong>
                    </div>
                  {{/if}}
                </div>

                <div class="leader-archive-card-actions">
                  {{#if viewPath}}
                    <a href="{{viewPath}}" class="tagged-unit-link">view nugget</a>
                  {{/if}}
                </div>
              </div>
            </div>
          </article>
        {{/each}}
      </div>
    </section>
  {{/if}}

  {{#unless archiveTopics.length}}
    {{#unless archivedMissions.length}}
      {{#unless archivedNuggets.length}}
        <section class="leader-archive-empty">
          <h2 class="leader-archive-empty-title">nothing archived yet</h2>
          <p class="leader-archive-empty-text">
            Once you or your group move units out of the active dashboard, they’ll appear here by topic.
          </p>

          <div class="leader-archive-top-actions">
            <a href="/dashboard/leader" class="leader-archive-back-link">return to dashboard</a>
          </div>
        </section>
      {{/unless}}
    {{/unless}}
  {{/unless}}
</section>