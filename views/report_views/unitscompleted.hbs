{{#*inline "title"}}Units Completed Report | Twennie{{/inline}}

<section class="dashboard-section">
  <h1 class="dashboard-section-title">
    {{leaderGroupName}}; Units Completed
  </h1>

  <div class="table-container">
    <table class="dashboard-library-table">
      <thead>
        <tr>
          <th class="dashboard-library-header">unit title</th>
          <th class="dashboard-library-header">unit type</th>
          <th class="dashboard-library-header">topics</th>
          <th class="dashboard-library-header">completed by</th>
          <th class="dashboard-library-header">notes history</th>
        </tr>
      </thead>

      <tbody>
        {{#each unitsCompletedReports}}
          <tr class="dashboard-library-row">

            <td class="dashboard-library-cell">
              {{#if this.unitTitle}}
                {{this.unitTitle}}
              {{else}}
                <span class="no-data">Untitled unit</span>
              {{/if}}
            </td>

            <td class="dashboard-library-cell">
              {{#if this.unitType}}
                {{this.unitType}}
              {{else}}
                <span class="no-data">Unknown type</span>
              {{/if}}
            </td>

            <td class="dashboard-library-cell">
              {{#if this.main_topic}}
                <div class="multi-record-item">{{this.main_topic}}</div>
              {{else}}
                <span class="no-data">No main topic</span>
              {{/if}}

              {{#each this.secondary_topics}}
                <div class="multi-record-item">{{this}}</div>
              {{else}}
                <span class="no-data">No secondary topics</span>
              {{/each}}
            </td>

            <td class="dashboard-library-cell">
              {{#each this.completedBy}}
                <div class="multi-record-item">
                  {{#if this.memberName}}
                    {{this.memberName}}
                  {{else}}
                    Unknown member
                  {{/if}}

                  {{#if this.dateCompleted}}
                    <span style="opacity:0.8;">({{formatDate this.dateCompleted}})</span>
                  {{/if}}
                </div>
              {{else}}
                <span class="no-data">No completions</span>
              {{/each}}
            </td>

            <td class="dashboard-library-cell notes-top-align">
              {{#each this.memberNotes}}
                <div class="multi-record-item" style="margin-bottom: 0.75rem;">
                  {{#if this.memberName}}
                    <div style="font-weight:600; margin-bottom: 0.2rem;">
                      {{this.memberName}}
                    </div>
                  {{/if}}

                  {{#each this.notes}}
                    <div class="multi-record-item" style="margin-bottom: 0.5rem;">
                      <div>{{this.content}}</div>

                      {{#if this.dateSubmitted}}
                        <div style="font-size: 0.85rem; opacity: 0.75; margin-top: 0.25rem;">
                          {{formatDate this.dateSubmitted}}
                        </div>
                      {{/if}}
                    </div>
                  {{else}}
                    <span class="no-data">No notes</span>
                  {{/each}}
                </div>
              {{else}}
                <span class="no-data">No notes</span>
              {{/each}}
            </td>

          </tr>
        {{else}}
          <tr>
            <td colspan="5" class="no-data">
              No unit completion data available.
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

<div class="report-links-container report-links-enhanced">

  {{#unless isMemberEngagement}}
  <div class="report-card">
    <a href="/reports/memberengagement" class="report-link">
      <img src="/images/memberengagementreport.png" alt="Member Engagement Report">
    </a>
    <p class="report-description">
      Explore how your team is engaging with learning, including topics, completed units, and mission activity.
    </p>
  </div>
  {{/unless}}

  {{#unless isNuggetsMonitored}}
  <div class="report-card">
    <a href="/reports/nuggetsmonitored" class="report-link">
      <img src="/images/nuggetsreport.png" alt="Nuggets Being Monitored Report">
    </a>
    <p class="report-description">
      Monitor active nuggets, see who is responsible, and review the latest insights being captured.
    </p>
  </div>
  {{/unless}}

  {{#unless isPromptSetsCompleted}}
  <div class="report-card">
    <a href="/reports/promptsetscompleted" class="report-link">
      <img src="/images/promptsetsreport.png" alt="Prompt Sets Report">
    </a>
    <p class="report-description">
      Review prompt set completion across your team, including participation, notes, and learning patterns.
    </p>
  </div>
  {{/unless}}

  {{#unless isUnitsCompleted}}
  <div class="report-card">
    <a href="/reports/unitscompleted" class="report-link">
      <img src="/images/libraryunitsreport.png" alt="Library Units Report">
    </a>
    <p class="report-description">
      View completed learning units along with contributor activity and recorded notes over time.
    </p>
  </div>
  {{/unless}}

</div>
</section>


