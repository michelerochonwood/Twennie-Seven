{{#*inline "title"}}Units Completed Report | Twennie{{/inline}}

<section class="dashboard-section">
  <h1 class="dashboard-section-title">
    {{leaderGroupName}}; Units Completed
  </h1>

  <div class="units-completed-accordion">

    {{#each unitsCompletedReports}}

      <article class="unit-completed-card">

        <button class="unit-completed-toggle" type="button">
          <span>
            <strong>
              {{#if this.unitTitle}}
                {{this.unitTitle}}
              {{else}}
                Untitled unit
              {{/if}}
            </strong>

            <small>
              {{#if this.unitType}}
                {{this.unitType}}
              {{else}}
                unknown type
              {{/if}}

              {{#if this.completedBy.length}}
                · {{this.completedBy.length}} completion(s)
              {{else}}
                · no completions
              {{/if}}
            </small>
          </span>

          <span class="unit-completed-icon">+</span>
        </button>

        <div class="unit-completed-panel">

          <div class="unit-completed-overview">

            <div class="unit-completed-overview-block">
              <h3>unit type</h3>
              <p>
                {{#if this.unitType}}
                  {{this.unitType}}
                {{else}}
                  <span class="no-data">Unknown type</span>
                {{/if}}
              </p>
            </div>

            <div class="unit-completed-overview-block">
              <h3>topics</h3>

              {{#if this.main_topic}}
                <p class="unit-topic-pill">{{this.main_topic}}</p>
              {{else}}
                <p class="no-data">No main topic</p>
              {{/if}}
            </div>

            <div class="unit-completed-overview-block">
              <h3>completed by</h3>

              {{#each this.completedBy}}
                <div class="unit-completed-person unit-completed-person--with-image">
                  <img
                    src="{{#if this.memberImage}}{{this.memberImage}}{{else}}/images/default-avatar.png{{/if}}"
                    alt="{{#if this.memberName}}{{this.memberName}}{{else}}Member{{/if}} profile image"
                    class="unit-completed-person-image"
                  >

                  <div class="unit-completed-person-text">
                    <strong>
                      {{#if this.memberName}}
                        {{this.memberName}}
                      {{else}}
                        Unknown member
                      {{/if}}
                    </strong>

                    {{#if this.dateCompleted}}
                      <span>{{formatDate this.dateCompleted}}</span>
                    {{/if}}
                  </div>
                </div>
              {{else}}
                <p class="no-data">No completions</p>
              {{/each}}
            </div>

          </div>

          <div class="unit-notes-section">
            <h3 class="unit-notes-section-title">notes history</h3>

            <div class="unit-member-notes-grid">

              {{#each this.memberNotes}}

                <section class="unit-member-notes-column">

                  <div class="unit-member-notes-header unit-member-notes-header--with-image">
                    <img
                      src="{{#if this.memberImage}}{{this.memberImage}}{{else}}/images/default-avatar.png{{/if}}"
                      alt="{{#if this.memberName}}{{this.memberName}}{{else}}Member{{/if}} profile image"
                      class="unit-member-notes-image"
                    >

                    <div class="unit-member-notes-identity">
                      <h4>
                        {{#if this.memberName}}
                          {{this.memberName}}
                        {{else}}
                          Unknown member
                        {{/if}}
                      </h4>
                    </div>
                  </div>

                  <div class="unit-member-notes-timeline">

                    {{#each this.notes}}
                      <div class="unit-note-entry">
                        <p>{{this.content}}</p>

                        {{#if this.dateSubmitted}}
                          <span>{{formatDate this.dateSubmitted}}</span>
                        {{/if}}
                      </div>
                    {{else}}
                      <p class="no-data">No notes</p>
                    {{/each}}

                  </div>

                </section>

              {{else}}

                <p class="no-data">No notes available.</p>

              {{/each}}

            </div>
          </div>

        </div>

      </article>

    {{else}}

      <p class="no-data">No unit completion data available.</p>

    {{/each}}

  </div>

  <div class="report-links-container report-links-enhanced">

    {{#unless isMemberEngagement}}
      <div class="report-card">
        <a href="/reports/memberengagement" class="report-link">
          <img src="/images/memberengagementreport.png" alt="Member Engagement Report">
        </a>
        <p class="report-description">
          Explore how your team is engaging with learning, including topics, completed units, and mission activity.
        </p>
      </div>
    {{/unless}}

    {{#unless isNuggetsMonitored}}
      <div class="report-card">
        <a href="/reports/nuggetsmonitored" class="report-link">
          <img src="/images/nuggetsreport.png" alt="Nuggets Being Monitored Report">
        </a>
        <p class="report-description">
          Monitor active nuggets, see who is responsible, and review the latest insights being captured.
        </p>
      </div>
    {{/unless}}

    {{#unless isPromptSetsCompleted}}
      <div class="report-card">
        <a href="/reports/promptsetscompleted" class="report-link">
          <img src="/images/promptsetsreport.png" alt="Prompt Sets Report">
        </a>
        <p class="report-description">
          Review prompt set completion across your team, including participation, notes, and learning patterns.
        </p>
      </div>
    {{/unless}}

    {{#unless isUnitsCompleted}}
      <div class="report-card">
        <a href="/reports/unitscompleted" class="report-link">
          <img src="/images/libraryunitsreport.png" alt="Library Units Report">
        </a>
        <p class="report-description">
          View completed learning units along with contributor activity and recorded notes over time.
        </p>
      </div>
    {{/unless}}

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.unit-completed-toggle').forEach(button => {
      button.addEventListener('click', () => {
        const card = button.closest('.unit-completed-card');
        if (!card) return;
        card.classList.toggle('is-open');
      });
    });
  });
</script>