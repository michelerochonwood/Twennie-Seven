{{!-- views/report_views/nuggetsmonitored.hbs --}}
{{#*inline "title"}}Nuggets Being Monitored | Twennie{{/inline}}

<section class="dashboard-section">
  <h1 class="dashboard-section-title" style="margin-bottom: 30px;">
    {{leaderGroupName}}; Nuggets Being Monitored
  </h1>

  <div class="table-container">
    <table class="dashboard-library-table">
      <thead>
        <tr>
          <th class="dashboard-library-header">nugget</th>
<th class="dashboard-library-header">assignment</th>
<th class="dashboard-library-header">latest monitoring note</th>
<th class="dashboard-library-header">last update</th>
<th class="dashboard-library-header">date assigned</th>
        </tr>
      </thead>

      <tbody>
        {{#each monitoredNuggets}}
          <tr class="dashboard-library-row">

            {{!-- Nugget --}}
            <td class="dashboard-library-cell">
              <div class="multi-record-item">
                {{#if this.nuggetTitle}}
                  {{this.nuggetTitle}}
                {{else}}
                  Untitled Nugget
                {{/if}}
              </div>

              {{!-- Optional extra context (safe to leave blank until controller supplies it) --}}
              {{#if this.client}}
                <div class="multi-record-item" style="opacity:0.8;">client: {{this.client}}</div>
              {{/if}}
              {{#if this.region}}
                <div class="multi-record-item" style="opacity:0.8;">region: {{this.region}}</div>
              {{/if}}
              {{#if this.discipline}}
                <div class="multi-record-item" style="opacity:0.8;">discipline: {{this.discipline}}</div>
              {{/if}}
            </td>

            {{!-- Who’s Monitoring --}}
            <td class="dashboard-library-cell">
              {{#each this.monitoredBy}}
                <div class="multi-record-item">
                  {{this.memberName}}
                  {{#if this.role}}
                    <span style="opacity:0.8;">({{this.role}})</span>
                  {{/if}}
                </div>
              {{else}}
                <span class="no-data">No monitors listed</span>
              {{/each}}
            </td>

            {{!-- Tag / Assignment --}}
<td class="dashboard-library-cell">
  {{#if this.assignmentName}}
    <div class="multi-record-item">{{this.assignmentName}}</div>
  {{else}}
    <span class="no-data">No assignment name</span>
  {{/if}}

  {{#if this.isAssigned}}
    <div class="multi-record-item" style="opacity:0.9;">active</div>
  {{else}}
    <div class="multi-record-item" style="opacity:0.9;">unassigned</div>
  {{/if}}
</td>

            {{!-- Notes / Instructions --}}
<td class="dashboard-library-cell">
  {{#if this.assignmentDescription}}
    <div class="multi-record-item">{{this.assignmentDescription}}</div>
  {{/if}}

  {{#each this.instructions}}
    <div class="multi-record-item">• {{this}}</div>
  {{else}}
    <span class="no-data">No instructions</span>
  {{/each}}
</td>

            {{!-- Date Tagged --}}
<td class="dashboard-library-cell">
  {{#if this.assignedAt}}
    {{formatDate this.assignedAt}}
  {{else}}
    <span class="no-data">—</span>
  {{/if}}
</td>

          </tr>
        {{else}}
          <tr>
            <td colspan="5" class="no-data">No monitored nuggets available.</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  {{!-- Report Navigation Links --}}
<div class="report-links-container report-links-enhanced">

  {{#unless isMemberEngagement}}
  <div class="report-card">
    <a href="/reports/memberengagement" class="report-link">
      <img src="/images/memberengagementreport.png" alt="Member Engagement Report">
    </a>
    <p class="report-description">
      See how each team member is engaging with learning, including topics explored, units completed, and mission activity.
    </p>
  </div>
  {{/unless}}

  {{#unless isNuggetsMonitored}}
  <div class="report-card">
    <a href="/reports/nuggetsmonitored" class="report-link">
      <img src="/images/nuggetsreport.png" alt="Nuggets Being Monitored Report">
    </a>
    <p class="report-description">
      Track which nuggets are being monitored, who is responsible, and the latest insights being recorded.
    </p>
  </div>
  {{/unless}}

  {{#unless isPromptSetsCompleted}}
  <div class="report-card">
    <a href="/reports/promptsetscompleted" class="report-link">
      <img src="/images/promptsetsreport.png" alt="Prompt Sets Report">
    </a>
    <p class="report-description">
      Review completed prompt sets across your team, including progress, notes, and learning patterns.
    </p>
  </div>
  {{/unless}}

  {{#unless isUnitsCompleted}}
  <div class="report-card">
    <a href="/reports/unitscompleted" class="report-link">
      <img src="/images/libraryunitsreport.png" alt="Library Units Report">
    </a>
    <p class="report-description">
      View all completed learning units, who completed them, and the notes recorded along the way.
    </p>
  </div>
  {{/unless}}

</div>
</section>
