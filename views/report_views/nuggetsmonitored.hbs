{{!-- views/report_views/nuggetsmonitored.hbs --}}
{{#*inline "title"}}Nuggets Being Monitored | Twennie{{/inline}}

<section class="dashboard-section">
  <h1 class="dashboard-section-title" style="margin-bottom: 30px;">
    {{leaderGroupName}}; Nuggets Being Monitored
  </h1>

  <div class="nuggets-monitored-accordion">
    {{#each monitoredNuggets}}
      <article class="nugget-monitored-card">
        <button class="nugget-monitored-toggle" type="button">
          <span>
            <strong>
              {{#if this.nuggetTitle}}
                {{this.nuggetTitle}}
              {{else}}
                Untitled Nugget
              {{/if}}
            </strong>

            <small>
              {{#if this.isAssigned}}
                active assignment
              {{else}}
                unassigned
              {{/if}}

              {{#if this.monitoredBy.length}}
                · {{this.monitoredBy.length}} monitor(s)
              {{else}}
                · no monitors listed
              {{/if}}

              {{#if this.monitoringNotes.length}}
                · {{this.monitoringNotes.length}} note(s)
              {{else}}
                · no notes yet
              {{/if}}
            </small>
          </span>

          <span class="nugget-monitored-icon">+</span>
        </button>

        <div class="nugget-monitored-panel">
          <div class="nugget-monitored-overview">
            <div class="nugget-monitored-overview-block">
              <h3>assignment</h3>

              {{#if this.assignmentName}}
                <p><strong>{{this.assignmentName}}</strong></p>
              {{else}}
                <p class="no-data">No assignment name</p>
              {{/if}}

              {{#if this.assignedAt}}
                <p class="nugget-muted">assigned: {{formatDate this.assignedAt}}</p>
              {{else}}
                <p class="nugget-muted">assigned: —</p>
              {{/if}}
            </div>

            <div class="nugget-monitored-overview-block">
              <h3>context</h3>

              {{#if this.client}}
                <span class="nugget-context-pill">client: {{this.client}}</span>
              {{/if}}

              {{#if this.region}}
                <span class="nugget-context-pill">region: {{this.region}}</span>
              {{/if}}

              {{#if this.discipline}}
                <span class="nugget-context-pill">discipline: {{this.discipline}}</span>
              {{/if}}

              {{#unless this.client}}
                {{#unless this.region}}
                  {{#unless this.discipline}}
                    <p class="no-data">No extra context provided</p>
                  {{/unless}}
                {{/unless}}
              {{/unless}}
            </div>

            <div class="nugget-monitored-overview-block">
              <h3>monitored by</h3>

              {{#each this.monitoredBy}}
                <div class="nugget-monitor-person nugget-monitor-person--with-image">
                  <img
                    src="{{#if this.memberImage}}{{this.memberImage}}{{else}}/images/default-avatar.png{{/if}}"
                    alt="{{#if this.memberName}}{{this.memberName}}{{else}}Member{{/if}} profile image"
                    class="nugget-monitor-person-image"
                  >

                  <div class="nugget-monitor-person-text">
                    <strong>{{this.memberName}}</strong>

                    {{#if this.role}}
                      <span>{{this.role}}</span>
                    {{/if}}
                  </div>
                </div>
              {{else}}
                <p class="no-data">No monitors listed</p>
              {{/each}}
            </div>
          </div>

          <div class="nugget-monitoring-section">
            <div class="nugget-monitoring-block">
              <h3>assignment description</h3>

              {{#if this.assignmentDescription}}
                <p>{{this.assignmentDescription}}</p>
              {{else}}
                <p class="no-data">No assignment description</p>
              {{/if}}
            </div>

            <div class="nugget-monitoring-block">
              <h3>monitoring instructions</h3>

              {{#each this.instructions}}
                <div class="nugget-instruction-item">
                  {{this}}
                </div>
              {{else}}
                <p class="no-data">No instructions</p>
              {{/each}}
            </div>

            <div class="nugget-monitoring-block nugget-monitoring-notes-block">
              <h3>monitoring notes</h3>

              {{#if this.monitoringNotes.length}}
                <div class="nugget-report-notes-list">
                  {{#each this.monitoringNotes}}
                    <article class="nugget-report-note-entry">
                      <div class="nugget-report-note-meta nugget-report-note-meta--with-image">
                        <img
                          src="{{#if this.addedByImage}}{{this.addedByImage}}{{else}}{{#if this.memberImage}}{{this.memberImage}}{{else}}/images/default-avatar.png{{/if}}{{/if}}"
                          alt="{{#if this.addedByNameSnapshot}}{{this.addedByNameSnapshot}}{{else}}Twennie member{{/if}} profile image"
                          class="nugget-report-note-image"
                        >

                        <div class="nugget-report-note-person">
                          {{#if this.addedByNameSnapshot}}
                            <strong>{{this.addedByNameSnapshot}}</strong>
                          {{else}}
                            <strong>Twennie member</strong>
                          {{/if}}

                          {{#if this.createdAt}}
                            <span>{{formatDate this.createdAt}}</span>
                          {{/if}}
                        </div>
                      </div>

                      {{#if this.note}}
                        <p>{{this.note}}</p>
                      {{else}}
                        <p class="no-data">No note text recorded.</p>
                      {{/if}}
                    </article>
                  {{/each}}
                </div>
              {{else}}
                <p class="no-data">No monitoring notes have been added yet.</p>
              {{/if}}
            </div>
          </div>
        </div>
      </article>
    {{else}}
      <p class="no-data">No monitored nuggets available.</p>
    {{/each}}
  </div>

  <div class="report-links-container report-links-enhanced">
    {{#unless isMemberEngagement}}
      <div class="report-card">
        <a href="/reports/memberengagement" class="report-link">
          <img src="/images/memberengagementreport.png" alt="Member Engagement Report">
        </a>
        <p class="report-description">
          See how each team member is engaging with learning, including topics explored, units completed, and mission activity.
        </p>
      </div>
    {{/unless}}

    {{#unless isNuggetsMonitored}}
      <div class="report-card">
        <a href="/reports/nuggetsmonitored" class="report-link">
          <img src="/images/nuggetsreport.png" alt="Nuggets Being Monitored Report">
        </a>
        <p class="report-description">
          Track which nuggets are being monitored, who is responsible, and the latest insights being recorded.
        </p>
      </div>
    {{/unless}}

    {{#unless isPromptSetsCompleted}}
      <div class="report-card">
        <a href="/reports/promptsetscompleted" class="report-link">
          <img src="/images/promptsetsreport.png" alt="Prompt Sets Report">
        </a>
        <p class="report-description">
          Review completed prompt sets across your team, including progress, notes, and learning patterns.
        </p>
      </div>
    {{/unless}}

    {{#unless isUnitsCompleted}}
      <div class="report-card">
        <a href="/reports/unitscompleted" class="report-link">
          <img src="/images/libraryunitsreport.png" alt="Library Units Report">
        </a>
        <p class="report-description">
          View all completed learning units, who completed them, and the notes recorded along the way.
        </p>
      </div>
    {{/unless}}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.nugget-monitored-toggle').forEach(button => {
      button.addEventListener('click', () => {
        const card = button.closest('.nugget-monitored-card');
        if (!card) return;
        card.classList.toggle('is-open');
      });
    });
  });
</script>