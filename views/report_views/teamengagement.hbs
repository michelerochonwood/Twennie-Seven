{{#*inline "title"}}Team Engagement Report | Twennie{{/inline}}

<section class="dashboard-section">
  <h1 class="dashboard-section-title">{{leaderGroupName}}; Team Engagement</h1>

  {{!-- =========================================================
      ACCORDION: Team Engagement
  ========================================================= --}}
  <div class="team-engagement-accordion">

    {{#each teamEngagementReports}}

      <article class="team-engagement-card">

        <button class="team-engagement-toggle" type="button">
          <span>
            <strong>
              {{#if this.memberName}}
                {{this.memberName}}
              {{else}}
                Team engagement record
              {{/if}}
            </strong>

            <small>
              {{this.promptSetsCompleted.length}} prompt set(s)
              · {{this.badgesEarned.length}} badge(s)
              · {{this.unitsCompleted.length}} unit(s)
            </small>
          </span>

          <span class="team-engagement-icon">+</span>
        </button>

        <div class="team-engagement-panel">

          <div class="team-engagement-summary-strip">

            <div class="team-engagement-stat">
              <strong>{{this.promptSetsCompleted.length}}</strong>
              <span>prompt sets</span>
            </div>

            <div class="team-engagement-stat">
              <strong>{{this.badgesEarned.length}}</strong>
              <span>badges</span>
            </div>

            <div class="team-engagement-stat">
              <strong>{{this.unitsCompleted.length}}</strong>
              <span>units completed</span>
            </div>

            <div class="team-engagement-stat">
              <strong>{{this.unitsContributed.length}}</strong>
              <span>units contributed</span>
            </div>

            <div class="team-engagement-stat">
              <strong>{{this.topicsEngaged.length}}</strong>
              <span>topics</span>
            </div>

          </div>

          <div class="team-engagement-grid">

            <section class="team-engagement-column">
              <h3>prompt sets completed</h3>

              {{#each this.promptSetsCompleted}}
                <div class="team-engagement-item">
                  <strong>{{this.name}}</strong>

                  {{#if this.dateCompleted}}
                    <span>{{formatDate this.dateCompleted}}</span>
                  {{/if}}
                </div>
              {{else}}
                <p class="no-data">No prompt sets completed</p>
              {{/each}}
            </section>

            <section class="team-engagement-column">
              <h3>badges earned</h3>

              {{#each this.badgesEarned}}
                <div class="team-engagement-badge-item">
                  {{#if this.badgeImage}}
                    <img src="{{this.badgeImage}}" alt="Badge">
                  {{/if}}

                  <strong>{{this.badgeName}}</strong>
                </div>
              {{else}}
                <p class="no-data">No badges earned</p>
              {{/each}}
            </section>

            <section class="team-engagement-column">
              <h3>units completed</h3>

              {{#each this.unitsCompleted}}
                <div class="team-engagement-item">
                  <strong>{{this.unitTitle}}</strong>

                  {{#if this.unitType}}
                    <span>{{this.unitType}}</span>
                  {{/if}}
                </div>
              {{else}}
                <p class="no-data">No units completed</p>
              {{/each}}
            </section>

            <section class="team-engagement-column">
              <h3>units contributed</h3>

              {{#each this.unitsContributed}}
                <div class="team-engagement-item">
                  <strong>{{this.unitTitle}}</strong>

                  {{#if this.unitType}}
                    <span>{{this.unitType}}</span>
                  {{/if}}
                </div>
              {{else}}
                <p class="no-data">No units contributed</p>
              {{/each}}
            </section>

            <section class="team-engagement-column team-engagement-column--topics">
              <h3>topics engaged</h3>

              <div class="team-engagement-topic-list">
                {{#each this.topicsEngaged}}
                  <span class="team-engagement-topic-pill">{{this}}</span>
                {{else}}
                  <p class="no-data">No topics engaged</p>
                {{/each}}
              </div>
            </section>

          </div>

        </div>

      </article>

    {{else}}

      <p class="no-data">No team engagement data available.</p>

    {{/each}}

  </div>

  {{!-- Report Navigation Links --}}
  <div class="report-links-container report-links-enhanced">

    {{#unless isMemberEngagement}}
      <div class="report-card">
        <a href="/reports/memberengagement" class="report-link">
          <img src="/images/memberengagementreport.png" alt="Member Engagement Report">
        </a>
        <p class="report-description">
          See how each team member is engaging with learning, including topics explored, units completed, and mission activity.
        </p>
      </div>
    {{/unless}}

    {{#unless isNuggetsMonitored}}
      <div class="report-card">
        <a href="/reports/nuggetsmonitored" class="report-link">
          <img src="/images/nuggetsreport.png" alt="Nuggets Being Monitored Report">
        </a>
        <p class="report-description">
          Track which nuggets are being monitored, who is responsible, and the latest insights being recorded.
        </p>
      </div>
    {{/unless}}

    {{#unless isPromptSetsCompleted}}
      <div class="report-card">
        <a href="/reports/promptsetscompleted" class="report-link">
          <img src="/images/promptsetsreport.png" alt="Prompt Sets Report">
        </a>
        <p class="report-description">
          Review completed prompt sets across your team, including progress, notes, and learning patterns.
        </p>
      </div>
    {{/unless}}

    {{#unless isUnitsCompleted}}
      <div class="report-card">
        <a href="/reports/unitscompleted" class="report-link">
          <img src="/images/libraryunitsreport.png" alt="Library Units Report">
        </a>
        <p class="report-description">
          View all completed learning units, who completed them, and the notes recorded along the way.
        </p>
      </div>
    {{/unless}}

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.team-engagement-toggle').forEach(button => {
      button.addEventListener('click', () => {
        const card = button.closest('.team-engagement-card');
        if (!card) return;
        card.classList.toggle('is-open');
      });
    });
  });
</script>