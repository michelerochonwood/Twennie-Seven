{{#*inline "title"}}Member Engagement Report | Twennie{{/inline}}

<section class="dashboard-section">
  <h1 class="dashboard-section-title">
    {{leaderGroupName}}; Member Engagement
  </h1>

  <p class="member-engagement-intro">
    These reports show the units your team members have completed. Your group members may have other units assigned but not yet completed, or prompt sets and missions still in progress. For prompt sets in progress, see the prompt sets completed and in progress report.
  </p>

  {{#if groupedUnits.length}}
    <div class="member-grouped-units-block">
      <h2>units completed by more than one member</h2>

      <div class="member-grouped-units-grid">
        {{#each groupedUnits}}
          <article class="member-grouped-unit-card">
            <h3>
              {{#if this.unitTitle}}
                {{this.unitTitle}}
              {{else}}
                Untitled unit
              {{/if}}
            </h3>

            <p class="member-grouped-unit-type">
              {{#if this.unitType}}
                {{this.unitType}}
              {{else}}
                unknown type
              {{/if}}
            </p>

            <div class="member-grouped-unit-members">
              {{#each this.members}}
                <span>{{this}}</span>
              {{else}}
                <span class="no-data">No members listed</span>
              {{/each}}
            </div>
          </article>
        {{/each}}
      </div>
    </div>
  {{/if}}

  <div class="member-engagement-accordion">

    {{#each memberEngagementReports}}

      <article class="member-engagement-card">

        <button class="member-engagement-toggle" type="button">
          <span>
            <strong>
              {{#if this.memberName}}
                {{this.memberName}}
              {{else}}
                Unnamed member
              {{/if}}
            </strong>

            <small>
              {{this.unitsCompleted.length}} unit(s)
              · {{this.promptSetsCompleted.length}} prompt set(s)
              · {{this.missionsCompleted.length}} mission(s)
            </small>
          </span>

          <span class="member-engagement-icon">+</span>
        </button>

        <div class="member-engagement-panel">

          <div class="member-engagement-summary-strip">

            <div class="member-engagement-stat">
              <strong>{{this.topicsEngaged.length}}</strong>
              <span>topics</span>
            </div>

            <div class="member-engagement-stat">
              <strong>{{this.unitsCompleted.length}}</strong>
              <span>units completed</span>
            </div>

            <div class="member-engagement-stat">
              <strong>{{this.promptSetsCompleted.length}}</strong>
              <span>prompt sets</span>
            </div>

            <div class="member-engagement-stat">
              <strong>{{this.missionsCompleted.length}}</strong>
              <span>missions</span>
            </div>

            {{#if ../leaderName}}
              <div class="member-engagement-stat member-engagement-stat--leader">
                <strong>{{../leaderName}}</strong>
                <span>leader</span>
              </div>
            {{/if}}

          </div>

          <div class="member-engagement-grid">

            <section class="member-engagement-column member-engagement-column--topics">
              <h3>topics engaged</h3>

              <div class="member-engagement-topic-list">
                {{#each this.topicsEngaged}}
                  <span class="member-engagement-topic-pill">{{this}}</span>
                {{else}}
                  <p class="no-data">No topics engaged</p>
                {{/each}}
              </div>
            </section>

            <section class="member-engagement-column">
              <h3>units completed</h3>

              {{#each this.unitsCompleted}}
                <div class="member-engagement-item">
                  <strong>{{this.unitTitle}}</strong>

                  {{#if this.unitType}}
                    <span>{{this.unitType}}</span>
                  {{/if}}
                </div>
              {{else}}
                <p class="no-data">No units completed</p>
              {{/each}}
            </section>

            <section class="member-engagement-column">
              <h3>prompt sets completed</h3>

              {{#each this.promptSetsCompleted}}
                <div class="member-engagement-item">
                  <strong>{{this.name}}</strong>

                  {{#if this.dateCompleted}}
                    <span>{{formatDate this.dateCompleted}}</span>
                  {{/if}}
                </div>
              {{else}}
                <p class="no-data">No prompt sets completed</p>
              {{/each}}
            </section>

            <section class="member-engagement-column">
              <h3>missions completed</h3>

              {{#each this.missionsCompleted}}
                <div class="member-engagement-item">
                  <strong>
                    {{#if this.missionTitle}}
                      {{this.missionTitle}}
                    {{else}}
                      Untitled mission
                    {{/if}}
                  </strong>

                  {{#if this.dateCompleted}}
                    <span>{{formatDate this.dateCompleted}}</span>
                  {{/if}}
                </div>
              {{else}}
                <p class="no-data">No missions completed</p>
              {{/each}}
            </section>

          </div>

        </div>

      </article>

    {{else}}

      <p class="no-data">No engagement data available.</p>

    {{/each}}

  </div>

  <div class="report-links-container report-links-enhanced">

    {{#unless isMemberEngagement}}
      <div class="report-card">
        <a href="/reports/memberengagement" class="report-link">
          <img src="/images/memberengagementreport.png" alt="Member Engagement Report">
        </a>
        <p class="report-description">
          Understand how each team member is engaging with learning, including topics explored, units completed, and mission activity.
        </p>
      </div>
    {{/unless}}

    {{#unless isNuggetsMonitored}}
      <div class="report-card">
        <a href="/reports/nuggetsmonitored" class="report-link">
          <img src="/images/nuggetsreport.png" alt="Nuggets Being Monitored Report">
        </a>
        <p class="report-description">
          See which nuggets are being monitored, who is responsible, and the most recent insights being captured.
        </p>
      </div>
    {{/unless}}

    {{#unless isPromptSetsCompleted}}
      <div class="report-card">
        <a href="/reports/promptsetscompleted" class="report-link">
          <img src="/images/promptsetsreport.png" alt="Prompt Sets Report">
        </a>
        <p class="report-description">
          Review prompt set completion across your team, including notes, participation, and learning trends.
        </p>
      </div>
    {{/unless}}

    {{#unless isUnitsCompleted}}
      <div class="report-card">
        <a href="/reports/unitscompleted" class="report-link">
          <img src="/images/libraryunitsreport.png" alt="Library Units Report">
        </a>
        <p class="report-description">
          View completed learning units along with contributor activity and recorded notes for deeper insight.
        </p>
      </div>
    {{/unless}}

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.member-engagement-toggle').forEach(button => {
      button.addEventListener('click', () => {
        const card = button.closest('.member-engagement-card');
        if (!card) return;
        card.classList.toggle('is-open');
      });
    });
  });
</script>

