{{#*inline "title"}}Member Engagement Report | Twennie{{/inline}}

<section class="dashboard-section">
  <h1 class="dashboard-section-title">
    {{leaderGroupName}}; Member Engagement
  </h1>

  <p style="width: 50%; margin: 0 auto; padding-top: 20px; padding-bottom: 20px;">
    These reports show the units your team members have completed. Your group members may have other units assigned but not yet completed, or prompt sets and missions still in progress. For prompt sets in progress, see the prompt sets completed and in progress report.
  </p>

  {{#if groupedUnits.length}}
    <div class="table-container">
      <h2 class="dashboard-section-title" style="margin-bottom: 14px; margin-top: -30px;">
        units completed (grouped)
      </h2>

      <table class="dashboard-library-table">
        <thead>
          <tr>
            <th class="dashboard-library-header">unit</th>
            <th class="dashboard-library-header">type</th>
            <th class="dashboard-library-header">members</th>
          </tr>
        </thead>

        <tbody>
          {{#each groupedUnits}}
            <tr class="dashboard-library-row">
              <td class="dashboard-library-cell">
                {{#if this.unitTitle}}
                  {{this.unitTitle}}
                {{else}}
                  <span class="no-data">Untitled unit</span>
                {{/if}}
              </td>

              <td class="dashboard-library-cell">
                {{#if this.unitType}}
                  {{this.unitType}}
                {{else}}
                  <span class="no-data">Unknown type</span>
                {{/if}}
              </td>

              <td class="dashboard-library-cell">
                {{#each this.members}}
                  <div class="multi-record-item">{{this}}</div>
                {{else}}
                  <span class="no-data">No members listed</span>
                {{/each}}
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  {{/if}}

  <div class="table-container">
    <table class="dashboard-library-table">

      <thead>
        <tr>
          <th class="dashboard-library-header">member</th>
          <th class="dashboard-library-header">topics engaged</th>
          <th class="dashboard-library-header">units completed</th>
          <th class="dashboard-library-header">prompt sets completed</th>
          <th class="dashboard-library-header">missions completed</th>
        </tr>
      </thead>

      <tbody>
        {{#each memberEngagementReports}}
          <tr class="dashboard-library-row">

            <td class="dashboard-library-cell member-name">
              {{#if this.memberName}}
                {{this.memberName}}
              {{else}}
                <span class="no-data">Unnamed member</span>
              {{/if}}

              {{#if ../leaderName}}
                <div class="multi-record-item" style="opacity:0.75; font-size:0.85em;">
                  leader: {{../leaderName}}
                </div>
              {{/if}}
            </td>

            <td class="dashboard-library-cell">
              {{#each this.topicsEngaged}}
                <div class="multi-record-item">{{this}}</div>
              {{else}}
                <span class="no-data">No topics engaged</span>
              {{/each}}
            </td>

            <td class="dashboard-library-cell">
              {{#each this.unitsCompleted}}
                <div class="multi-record-item">
                  {{this.unitTitle}} {{#if this.unitType}}({{this.unitType}}){{/if}}
                </div>
              {{else}}
                <span class="no-data">No units completed</span>
              {{/each}}
            </td>

            <td class="dashboard-library-cell">
              {{#each this.promptSetsCompleted}}
                <div class="multi-record-item">
                  {{this.name}}
                  {{#if this.dateCompleted}}
                    <span style="opacity:0.8;">({{formatDate this.dateCompleted}})</span>
                  {{/if}}
                </div>
              {{else}}
                <span class="no-data">No prompt sets completed</span>
              {{/each}}
            </td>

            <td class="dashboard-library-cell">
              {{#each this.missionsCompleted}}
                <div class="multi-record-item">
                  {{#if this.missionTitle}}
                    {{this.missionTitle}}
                  {{else}}
                    Untitled mission
                  {{/if}}

                  {{#if this.dateCompleted}}
                    <span style="opacity:0.8;">({{formatDate this.dateCompleted}})</span>
                  {{/if}}
                </div>
              {{else}}
                <span class="no-data">No missions completed</span>
              {{/each}}
            </td>

          </tr>
        {{else}}
          <tr>
            <td colspan="5" class="no-data">No engagement data available.</td>
          </tr>
        {{/each}}
      </tbody>

    </table>
  </div>

<div class="report-links-container report-links-enhanced">

  {{#unless isMemberEngagement}}
  <div class="report-card">
    <a href="/reports/memberengagement" class="report-link">
      <img src="/images/memberengagementreport.png" alt="Member Engagement Report">
    </a>
    <p class="report-description">
      Understand how each team member is engaging with learning, including topics explored, units completed, and mission activity.
    </p>
  </div>
  {{/unless}}

  {{#unless isNuggetsMonitored}}
  <div class="report-card">
    <a href="/reports/nuggetsmonitored" class="report-link">
      <img src="/images/nuggetsreport.png" alt="Nuggets Being Monitored Report">
    </a>
    <p class="report-description">
      See which nuggets are being monitored, who is responsible, and the most recent insights being captured.
    </p>
  </div>
  {{/unless}}

  {{#unless isPromptSetsCompleted}}
  <div class="report-card">
    <a href="/reports/promptsetscompleted" class="report-link">
      <img src="/images/promptsetsreport.png" alt="Prompt Sets Report">
    </a>
    <p class="report-description">
      Review prompt set completion across your team, including notes, participation, and learning trends.
    </p>
  </div>
  {{/unless}}

  {{#unless isUnitsCompleted}}
  <div class="report-card">
    <a href="/reports/unitscompleted" class="report-link">
      <img src="/images/libraryunitsreport.png" alt="Library Units Report">
    </a>
    <p class="report-description">
      View completed learning units along with contributor activity and recorded notes for deeper insight.
    </p>
  </div>
  {{/unless}}

</div>
</section>

