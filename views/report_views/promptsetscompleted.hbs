{{!-- =========================================================
    ACCORDION: Prompt Notes History
========================================================= --}}
<h2 class="dashboard-section-title">Prompt Notes (History)</h2>

<div class="prompt-notes-accordion">

  {{#each promptNotesReports}}

    <article class="promptset-accordion-card">

      <button class="promptset-accordion-toggle" type="button">
        <span>
          <strong>{{this.promptSetTitle}}</strong>
          <small>
            {{#if this.completedBy.length}}
              {{this.completedBy.length}} team member response(s)
            {{else}}
              no responses yet
            {{/if}}
          </small>
        </span>

        <span class="promptset-accordion-icon">+</span>
      </button>

      <div class="promptset-accordion-panel">

        {{#if this.prompts.[0].promptText}}
          <div class="promptset-orientation-card">
            <h3>orientation</h3>
            <p>{{this.prompts.[0].promptText}}</p>
          </div>
        {{/if}}

        <div class="prompt-response-list">

          {{#each this.prompts}}
            {{#unless @first}}

              <details class="prompt-response-details">

                <summary>
                  <span class="prompt-number">prompt {{@index}}</span>
                  <span class="prompt-title">
                    {{#if this.promptHeadline}}
                      {{this.promptHeadline}}
                    {{else}}
                      Untitled prompt
                    {{/if}}
                  </span>
                </summary>

                <div class="prompt-response-body prompt-response-body--grouped">

                  <div class="prompt-question prompt-question--left">
                    <strong>question:</strong>
                    <p>{{this.promptText}}</p>
                  </div>

                  <div class="prompt-member-notes-grid">

                    {{#each ../completedBy}}

                      <section class="prompt-member-note-column">

                        <div class="prompt-member-note-header prompt-member-note-header--with-image">
                          <img
                            src="{{#if this.memberImage}}{{this.memberImage}}{{else}}/images/default-avatar.png{{/if}}"
                            alt="{{this.memberName}} profile image"
                            class="prompt-member-note-image"
                          >

                          <div class="prompt-member-note-identity">
                            <h3>{{this.memberName}}</h3>
                            <span>
                              {{#if this.dateCompleted}}
                                completed: {{formatDate this.dateCompleted}}
                              {{else}}
                                in progress
                              {{/if}}
                            </span>
                          </div>
                        </div>

                        <div class="prompt-answer">
                          <strong>notes:</strong>

                          {{#with (lookup this.promptNotes @../index)}}
                            {{#each this.notes}}
                              <div class="prompt-note-entry">
                                <p>{{this.content}}</p>

                                {{#if this.dateSubmitted}}
                                  <div class="prompt-note-date">
                                    {{formatDate this.dateSubmitted}}
                                  </div>
                                {{/if}}
                              </div>
                            {{else}}
                              <span class="no-data">No notes</span>
                            {{/each}}
                          {{else}}
                            <span class="no-data">No notes</span>
                          {{/with}}
                        </div>

                      </section>

                    {{else}}

                      <p class="no-data">No notes available.</p>

                    {{/each}}

                  </div>

                </div>

              </details>

            {{/unless}}
          {{/each}}

        </div>

      </div>
    </article>

  {{else}}

    <p class="no-data">No prompt notes available.</p>

  {{/each}}

</div>

<div class="report-links-container report-links-enhanced">

  {{#unless isMemberEngagement}}
  <div class="report-card">
    <a href="/reports/memberengagement" class="report-link">
      <img src="/images/memberengagementreport.png" alt="Member Engagement Report">
    </a>
    <p class="report-description">
      Explore how your team is engaging with learning, including topics, completed units, and mission activity.
    </p>
  </div>
  {{/unless}}

  {{#unless isNuggetsMonitored}}
  <div class="report-card">
    <a href="/reports/nuggetsmonitored" class="report-link">
      <img src="/images/nuggetsreport.png" alt="Nuggets Being Monitored Report">
    </a>
    <p class="report-description">
      Monitor active nuggets, see who is responsible, and review the latest insights being captured.
    </p>
  </div>
  {{/unless}}

  {{#unless isPromptSetsCompleted}}
  <div class="report-card">
    <a href="/reports/promptsetscompleted" class="report-link">
      <img src="/images/promptsetsreport.png" alt="Prompt Sets Report">
    </a>
    <p class="report-description">
      Review prompt set completion across your team, including participation, notes, and learning patterns.
    </p>
  </div>
  {{/unless}}

  {{#unless isUnitsCompleted}}
  <div class="report-card">
    <a href="/reports/unitscompleted" class="report-link">
      <img src="/images/libraryunitsreport.png" alt="Library Units Report">
    </a>
    <p class="report-description">
      View completed learning units along with contributor activity and recorded notes over time.
    </p>
  </div>
  {{/unless}}

</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.promptset-accordion-toggle').forEach(button => {
      button.addEventListener('click', () => {
        const card = button.closest('.promptset-accordion-card');
        if (!card) return;
        card.classList.toggle('is-open');
      });
    });
  });
</script>