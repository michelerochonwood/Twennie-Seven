{{!-- views/report_views/promptsetscompleted.hbs --}}
{{#*inline "title"}}Prompt Sets Completed | Twennie{{/inline}}

<section class="dashboard-section">
  <h1 class="dashboard-section-title">{{leaderGroupName}}; Prompt Sets Completed</h1>

  {{!-- =========================================================
      TABLE 1: Prompt Set Overview (grouped by prompt set)
      - one row per prompt set
      - completedBy lists members + dates
  ========================================================= --}}
  <div class="table-container" style="margin-bottom: -100px;">
    <table class="dashboard-library-table">
      <thead>
        <tr>
          <th class="dashboard-library-header">prompt set title</th>
          <th class="dashboard-library-header">topics</th>
          <th class="dashboard-library-header">purpose</th>
          <th class="dashboard-library-header">completed by (member)</th>
          <th class="dashboard-library-header">completion date</th>
        </tr>
      </thead>

      <tbody>
        {{#each promptSetsCompletedReports}}
          <tr class="dashboard-library-row">
            <td class="dashboard-library-cell">{{this.promptSetTitle}}</td>

            {{!-- Topics --}}
            <td class="dashboard-library-cell">
              {{#if this.main_topic}}
                <div class="multi-record-item">{{this.main_topic}}</div>
              {{else}}
                <span class="no-data">No main topic</span>
              {{/if}}

              {{#each this.secondary_topics}}
                <div class="multi-record-item">{{this}}</div>
              {{else}}
                <span class="no-data">No secondary topics</span>
              {{/each}}
            </td>

            {{!-- Purpose --}}
            <td class="dashboard-library-cell">
              {{#if this.purpose}}
                {{this.purpose}}
              {{else}}
                <span class="no-data">No purpose provided</span>
              {{/if}}
            </td>

            {{!-- Completed By (Member Name) --}}
            <td class="dashboard-library-cell">
              {{#each this.completedBy}}
                <div class="multi-record-item">{{this.memberName}}</div>
              {{else}}
                <span class="no-data">No completions</span>
              {{/each}}
            </td>

            {{!-- Completion Date --}}
            <td class="dashboard-library-cell">
              {{#each this.completedBy}}
                <div class="multi-record-item">{{formatDate this.dateCompleted}}</div>
              {{else}}
                <span class="no-data">No completions</span>
              {{/each}}
            </td>
          </tr>
        {{else}}
          <tr>
            <td colspan="5" class="no-data">No prompt set completion data available.</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  {{!-- =========================================================
      TABLE 2: Prompt Notes (Option A)
      - one big table
      - prompt texts shown ONCE per prompt set (header row)
      - then one row per completing member with notes
  ========================================================= --}}
  <h2 class="dashboard-section-title">Prompt Notes</h2>

  <div class="table-container wide-table-container">
    <table class="dashboard-library-table wide-table">
      <thead>
        <tr>
          <th class="dashboard-library-header">prompt set / member</th>
          {{#each (range 1 21)}}
            <th class="dashboard-library-header">prompt {{this}}</th>
          {{/each}}
        </tr>
      </thead>

      <tbody>
        {{#each promptSetsCompletedReports}}

          {{!-- Header row for this prompt set (prompts shown once) --}}
          <tr class="dashboard-library-row" style="border-top: 3px solid #e6e6e6;">
            <td class="dashboard-library-cell">
              <strong>{{this.promptSetTitle}}</strong><br>
              <span class="multi-record-item">prompts (header)</span>
            </td>

            {{#each this.prompts}}
              <td class="dashboard-library-cell" style="vertical-align: top;">
                <div class="multi-record-item">
                  <strong>{{this.promptHeadline}}:</strong> {{this.promptText}}
                </div>
              </td>
            {{else}}
              {{!-- If for some reason prompts are missing, keep the table intact --}}
              <td class="dashboard-library-cell" colspan="21">
                <span class="no-data">No prompt text available</span>
              </td>
            {{/each}}
          </tr>

          {{!-- Member rows (notes only) --}}
          {{#each this.completedBy}}
            <tr class="dashboard-library-row">
              <td class="dashboard-library-cell">
                <strong>{{this.memberName}}</strong><br>
                <span class="multi-record-item">{{formatDate this.dateCompleted}}</span>
              </td>

              {{#each this.promptNotes}}
                <td class="dashboard-library-cell" style="vertical-align: top;">
                  {{#each this.notes}}
                    <div class="multi-record-item">{{this.content}}</div>
                  {{else}}
                    <span class="no-data">No notes</span>
                  {{/each}}
                </td>
              {{else}}
                <td class="dashboard-library-cell" colspan="21">
                  <span class="no-data">No notes</span>
                </td>
              {{/each}}
            </tr>
          {{else}}
            <tr class="dashboard-library-row">
              <td class="dashboard-library-cell">
                <strong>{{../promptSetTitle}}</strong>
              </td>
              <td colspan="21" class="no-data">No completions</td>
            </tr>
          {{/each}}

        {{else}}
          <tr>
            <td colspan="22" class="no-data">No prompt notes available.</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  {{!-- =========================================================
      Report Navigation Links
  ========================================================= --}}
  <div class="report-links-container">
    {{#unless isMemberEngagement}}
      <a href="/reports/memberengagement" class="report-link">
        <img src="/images/memberengagementreport.png" alt="Member Engagement Report">
      </a>
    {{/unless}}

    {{#unless isNuggetsMonitored}}
      <a href="/reports/nuggetsmonitored" class="report-link">
        <img src="/images/nuggetsreport.png" alt="Nuggets Being Monitored Report">
      </a>
    {{/unless}}

    {{#unless isPromptSetsCompleted}}
      <a href="/reports/promptsetscompleted" class="report-link">
        <img src="/images/promptsetsreport.png" alt="Prompt Sets Report">
      </a>
    {{/unless}}

    {{#unless isUnitsCompleted}}
      <a href="/reports/unitscompleted" class="report-link">
        <img src="/images/libraryunitsreport.png" alt="Library Units Report">
      </a>
    {{/unless}}
  </div>
</section>


