{{#*inline "title"}}My Completed Prompt Sets | Twennie{{/inline}}

<section class="dashboard-section">
  <h1 class="dashboard-section-title">Your Completed Prompt Sets</h1>

  <div class="prompt-notes-accordion">

    {{#each promptNotesReports}}

      <article class="promptset-accordion-card">

        <button class="promptset-accordion-toggle" type="button">
          <span>
            <strong>{{this.promptSetTitle}}</strong>
            <small>
              {{#if this.dateCompleted}}
                completed: {{formatDate this.dateCompleted}}
              {{else}}
                in progress
              {{/if}}
            </small>
          </span>

          <span class="promptset-accordion-icon">+</span>
        </button>

        <div class="promptset-accordion-panel">

          {{#if this.prompts.[0].promptText}}
            <div class="promptset-orientation-card">
              <h3>orientation</h3>
              <p>{{this.prompts.[0].promptText}}</p>
            </div>
          {{/if}}

          <div class="prompt-response-list">

            {{#each this.prompts}}
              {{#unless @first}}

                <details class="prompt-response-details">

                  <summary>
                    <span class="prompt-number">prompt {{@index}}</span>
                    <span class="prompt-title">
                      {{#if this.promptHeadline}}
                        {{this.promptHeadline}}
                      {{else}}
                        Untitled prompt
                      {{/if}}
                    </span>
                  </summary>

                  <div class="prompt-response-body prompt-response-body--grouped">

                    <div class="prompt-question prompt-question--left">
                      <strong>question:</strong>
                      <p>{{this.promptText}}</p>
                    </div>

                    <div class="prompt-member-notes-grid">

                      <section class="prompt-member-note-column">

                        <div class="prompt-member-note-header">
                          <h3>your notes</h3>
                          <span>
                            {{#if ../dateCompleted}}
                              completed: {{formatDate ../dateCompleted}}
                            {{else}}
                              in progress
                            {{/if}}
                          </span>
                        </div>

                        <div class="prompt-answer">
                          <strong>notes:</strong>

                          {{#with (lookup ../promptNotes @index)}}
                            {{#each this.notes}}
                              <div class="prompt-note-entry">
                                <p>{{this.content}}</p>

                                {{#if this.dateSubmitted}}
                                  <div class="prompt-note-date">
                                    {{formatDate this.dateSubmitted}}
                                  </div>
                                {{/if}}
                              </div>
                            {{else}}
                              <span class="no-data">No notes</span>
                            {{/each}}
                          {{else}}
                            <span class="no-data">No notes</span>
                          {{/with}}

                        </div>

                      </section>

                    </div>

                  </div>

                </details>

              {{/unless}}
            {{/each}}

          </div>

        </div>
      </article>

    {{else}}

      <p class="no-data">You haven’t started any prompt sets yet.</p>

    {{/each}}

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.promptset-accordion-toggle').forEach(button => {
      button.addEventListener('click', () => {
        const card = button.closest('.promptset-accordion-card');
        if (!card) return;
        card.classList.toggle('is-open');
      });
    });
  });
</script>