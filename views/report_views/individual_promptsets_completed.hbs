{{#*inline "title"}}My Completed Prompt Sets | Twennie{{/inline}}

<section class="dashboard-section">
  <h1 class="dashboard-section-title">Your Completed Prompt Sets</h1>

  <!-- Table 1: Prompt Set Overview -->
  <div class="table-container" style="margin-bottom: -100px;">
    <table class="dashboard-library-table">
      <thead>
        <tr>
          <th class="dashboard-library-header">prompt set title</th>
          <th class="dashboard-library-header">topics</th>
          <th class="dashboard-library-header">purpose</th>
          <th class="dashboard-library-header">characteristics</th>
          <th class="dashboard-library-header">target audience</th>
          <th class="dashboard-library-header">completion date</th>
        </tr>
      </thead>
      <tbody>
        {{#each promptSetsCompletedReports}}
          <tr class="dashboard-library-row">
            <td class="dashboard-library-cell">
              {{#if this.promptSetTitle}}
                {{this.promptSetTitle}}
              {{else}}
                <span class="no-data">Untitled prompt set</span>
              {{/if}}
            </td>

            <td class="dashboard-library-cell">
              {{#if this.main_topic}}
                <div class="multi-record-item">{{this.main_topic}}</div>
              {{else}}
                <span class="no-data">No main topic</span>
              {{/if}}

              {{#each this.secondary_topics}}
                <div class="multi-record-item">{{this}}</div>
              {{else}}
                <span class="no-data">No secondary topics</span>
              {{/each}}
            </td>

            <td class="dashboard-library-cell">
              {{#if this.purpose}}
                {{this.purpose}}
              {{else}}
                <span class="no-data">No purpose provided</span>
              {{/if}}
            </td>

            <td class="dashboard-library-cell">
              {{#each this.characteristics}}
                <div class="multi-record-item">{{this}}</div>
              {{else}}
                <span class="no-data">No characteristics provided</span>
              {{/each}}
            </td>

            <td class="dashboard-library-cell">
              {{#if this.targetAudience}}
                {{this.targetAudience}}
              {{else}}
                <span class="no-data">No target audience provided</span>
              {{/if}}
            </td>

            <td class="dashboard-library-cell">
              {{#if this.dateCompleted}}
                {{formatDate this.dateCompleted}}
              {{else}}
                <span class="no-data">No completion date</span>
              {{/if}}
            </td>
          </tr>
        {{else}}
          <tr>
            <td colspan="6" class="no-data">You have not completed any prompt sets yet.</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  <!-- Table 2: Prompt Notes History -->
  <h2 class="dashboard-section-title">Your Prompt Notes</h2>
  <div class="table-container wide-table-container">
    <table class="dashboard-library-table wide-table">
      <thead>
        <tr>
          <th class="dashboard-library-header">prompt set title</th>
          {{#each (range 1 21)}}
            <th class="dashboard-library-header">prompt {{this}}</th>
          {{/each}}
        </tr>
      </thead>
      <tbody>
        {{#each promptSetsCompletedReports}}
          <!-- Row 1: Prompt Texts -->
          <tr class="dashboard-library-row">
            <td class="dashboard-library-cell">
              <strong>{{this.promptSetTitle}}</strong>
            </td>

            {{#each this.prompts}}
              <td class="dashboard-library-cell" style="vertical-align: top;">
                <div class="multi-record-item">
                  <strong>{{this.promptHeadline}}:</strong>
                  {{this.promptText}}
                </div>
              </td>
            {{/each}}
          </tr>

          <!-- Row 2: Notes History -->
          <tr class="dashboard-library-row">
            <td class="dashboard-library-cell">
              <strong>your notes (history)</strong>
            </td>

            {{#each this.promptNotes}}
              <td class="dashboard-library-cell" style="vertical-align: top;">
                {{#each this.notes}}
                  <div class="multi-record-item" style="margin-bottom: 0.75rem;">
                    <div>{{this.content}}</div>

                    {{#if this.dateSubmitted}}
                      <div style="font-size: 0.85rem; opacity: 0.75; margin-top: 0.25rem;">
                        {{formatDate this.dateSubmitted}}
                      </div>
                    {{/if}}
                  </div>
                {{else}}
                  <span class="no-data">No notes</span>
                {{/each}}
              </td>
            {{/each}}
          </tr>
        {{else}}
          <tr>
            <td colspan="21" class="no-data">You haven’t completed any prompts yet.</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>