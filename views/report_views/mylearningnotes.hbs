{{#*inline "title"}}My Learning Notes | Twennie{{/inline}}

<section class="dashboard-section">
  <h1 class="dashboard-section-title">My Learning Notes</h1>

  {{!-- TABLE 1: Standard Learning Unit Notes --}}
  <div class="table-container">
    <table class="dashboard-library-table">
      <thead>
        <tr>
          <th class="dashboard-library-header">unit title</th>
          <th class="dashboard-library-header">unit type</th>
          <th class="dashboard-library-header">topics</th>
          <th class="dashboard-library-header">notes</th>
          <th class="dashboard-library-header">latest update</th>
        </tr>
      </thead>

      <tbody>
        {{#each myLearningNotesReports}}
          <tr class="dashboard-library-row">
            <td class="dashboard-library-cell">
              {{#if this.unitTitle}}
                {{this.unitTitle}}
              {{else}}
                <span class="no-data">Untitled unit</span>
              {{/if}}
            </td>

            <td class="dashboard-library-cell">
              {{#if this.unitType}}
                {{this.unitType}}
              {{else}}
                <span class="no-data">Unknown type</span>
              {{/if}}
            </td>

            <td class="dashboard-library-cell">
              {{#if this.main_topic}}
                <div class="multi-record-item">{{this.main_topic}}</div>
              {{else}}
                <span class="no-data">No main topic</span>
              {{/if}}

              {{#each this.secondary_topics}}
                <div class="multi-record-item">{{this}}</div>
              {{else}}
                <span class="no-data">No secondary topics</span>
              {{/each}}
            </td>

            <td class="dashboard-library-cell">
              {{#each this.notes}}
                <div class="multi-record-item" style="margin-bottom: 0.75rem;">
                  <div>{{this.content}}</div>
                  {{#if this.dateSubmitted}}
                    <div style="font-size: 0.85rem; opacity: 0.75; margin-top: 0.25rem;">
                      {{formatDate this.dateSubmitted}}
                    </div>
                  {{/if}}
                </div>
              {{else}}
                <span class="no-data">No notes</span>
              {{/each}}
            </td>

            <td class="dashboard-library-cell">
              {{#if this.latestNoteDate}}
                {{formatDate this.latestNoteDate}}
              {{else}}
                <span class="no-data">No update yet</span>
              {{/if}}
            </td>
          </tr>
        {{else}}
          <tr>
            <td colspan="5" class="no-data">You haven’t created any standard learning notes yet.</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  {{!-- TABLE 2: Prompt Notes History --}}
  <h2 class="dashboard-section-title">Prompt Notes</h2>

  <div class="table-container wide-table-container">
    <table class="dashboard-library-table wide-table">
      <thead>
        <tr>
          <th class="dashboard-library-header">prompt set</th>

          {{#if promptNotesReports.[0].prompts}}
            {{#each promptNotesReports.[0].prompts}}
              {{#unless @first}}
                <th class="dashboard-library-header">
                  prompt {{@index}}
                </th>
              {{/unless}}
            {{/each}}
          {{/if}}
        </tr>
      </thead>

      <tbody>
        {{#each promptNotesReports}}

          <tr class="dashboard-library-row promptset-header-row">
            <td class="dashboard-library-cell">
              <strong>{{this.promptSetTitle}}</strong><br>

              {{#if this.dateCompleted}}
                <span class="multi-record-item">
                  completed: {{formatDate this.dateCompleted}}
                </span>
              {{else}}
                <span class="multi-record-item">
                  in progress
                </span>
              {{/if}}

              {{#if this.prompts.[0].promptText}}
                <div class="multi-record-item" style="margin-top: 0.5rem;">
                  <strong>orientation:</strong> {{this.prompts.[0].promptText}}
                </div>
              {{/if}}
            </td>

            {{#each this.prompts}}
              {{#unless @first}}
                <td class="dashboard-library-cell" style="vertical-align: top;">
                  <div class="multi-record-item">
                    <strong>{{this.promptHeadline}}:</strong> {{this.promptText}}
                  </div>
                </td>
              {{/unless}}
            {{/each}}
          </tr>

          <tr class="dashboard-library-row">
            <td class="dashboard-library-cell">
              <strong>my notes</strong>
            </td>

            {{#each this.promptNotes}}
              {{#unless @first}}
                <td class="dashboard-library-cell" style="vertical-align: top;">
                  {{#each this.notes}}
                    <div class="multi-record-item" style="margin-bottom: 0.6rem;">
                      <div>{{this.content}}</div>

                      {{#if this.dateSubmitted}}
                        <div style="font-size: 0.8rem; opacity: 0.7;">
                          {{formatDate this.dateSubmitted}}
                        </div>
                      {{/if}}
                    </div>
                  {{else}}
                    <span class="no-data">No notes</span>
                  {{/each}}
                </td>
              {{/unless}}
            {{/each}}
          </tr>

        {{else}}
          <tr>
            <td colspan="21" class="no-data">No prompt notes available.</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>