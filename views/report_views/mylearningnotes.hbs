{{#*inline "title"}}My Learning Notes | Twennie{{/inline}}

<section class="dashboard-section">
  <h1 class="dashboard-section-title">My Learning Notes</h1>

  {{!-- =========================================================
      ACCORDION: Standard Learning Unit Notes
  ========================================================= --}}
  <h2 class="dashboard-section-title">Learning Unit Notes</h2>

  <div class="units-completed-accordion">

    {{#each myLearningNotesReports}}

      <article class="unit-completed-card">

        <button class="unit-completed-toggle" type="button">
          <span>
            <strong>
              {{#if this.unitTitle}}
                {{this.unitTitle}}
              {{else}}
                Untitled unit
              {{/if}}
            </strong>

            <small>
              {{#if this.unitType}}
                {{this.unitType}}
              {{else}}
                unknown type
              {{/if}}

              {{#if this.latestNoteDate}}
                · updated {{formatDate this.latestNoteDate}}
              {{else}}
                · no update yet
              {{/if}}
            </small>
          </span>

          <span class="unit-completed-icon">+</span>
        </button>

        <div class="unit-completed-panel">

          <div class="unit-completed-overview">

            <div class="unit-completed-overview-block">
              <h3>unit type</h3>
              <p>
                {{#if this.unitType}}
                  {{this.unitType}}
                {{else}}
                  <span class="no-data">Unknown type</span>
                {{/if}}
              </p>
            </div>

            <div class="unit-completed-overview-block">
              <h3>topics</h3>

              {{#if this.main_topic}}
                <p class="unit-topic-pill">{{this.main_topic}}</p>
              {{else}}
                <p class="no-data">No main topic</p>
              {{/if}}

              {{#each this.secondary_topics}}
                <p class="unit-topic-pill unit-topic-pill--secondary">{{this}}</p>
              {{else}}
                <p class="no-data">No secondary topics</p>
              {{/each}}
            </div>

            <div class="unit-completed-overview-block">
              <h3>latest update</h3>
              <p>
                {{#if this.latestNoteDate}}
                  {{formatDate this.latestNoteDate}}
                {{else}}
                  <span class="no-data">No update yet</span>
                {{/if}}
              </p>
            </div>

          </div>

          <div class="unit-notes-section">
            <h3 class="unit-notes-section-title">notes history</h3>

            <div class="unit-member-notes-grid">

              <section class="unit-member-notes-column">

                <div class="unit-member-notes-header">
                  <h4>my notes</h4>
                </div>

                <div class="unit-member-notes-timeline">

                  {{#each this.notes}}
                    <div class="unit-note-entry">
                      <p>{{this.content}}</p>

                      {{#if this.dateSubmitted}}
                        <span>{{formatDate this.dateSubmitted}}</span>
                      {{/if}}
                    </div>
                  {{else}}
                    <p class="no-data">No notes</p>
                  {{/each}}

                </div>

              </section>

            </div>
          </div>

        </div>

      </article>

    {{else}}

      <p class="no-data">You haven’t created any standard learning notes yet.</p>

    {{/each}}

  </div>

  {{!-- =========================================================
      ACCORDION: Prompt Notes History
  ========================================================= --}}
  <h2 class="dashboard-section-title">Prompt Notes</h2>

  <div class="prompt-notes-accordion">

    {{#each promptNotesReports}}

      <article class="promptset-accordion-card">

        <button class="promptset-accordion-toggle" type="button">
          <span>
            <strong>{{this.promptSetTitle}}</strong>
            <small>
              {{#if this.dateCompleted}}
                completed: {{formatDate this.dateCompleted}}
              {{else}}
                in progress
              {{/if}}
            </small>
          </span>

          <span class="promptset-accordion-icon">+</span>
        </button>

        <div class="promptset-accordion-panel">

          {{#if this.prompts.[0].promptText}}
            <div class="promptset-orientation-card">
              <h3>orientation</h3>
              <p>{{this.prompts.[0].promptText}}</p>
            </div>
          {{/if}}

          <div class="prompt-response-list">

            {{#each this.prompts}}
              {{#unless @first}}

                <details class="prompt-response-details">

                  <summary>
                    <span class="prompt-number">prompt {{@index}}</span>
                    <span class="prompt-title">
                      {{#if this.promptHeadline}}
                        {{this.promptHeadline}}
                      {{else}}
                        Untitled prompt
                      {{/if}}
                    </span>
                  </summary>

                  <div class="prompt-response-body">

                    <div class="prompt-question">
                      <strong>question:</strong>
                      <p>{{this.promptText}}</p>
                    </div>

                    <div class="prompt-answer">
                      <strong>my notes:</strong>

                      {{#with (lookup ../promptNotes @index)}}
                        {{#each this.notes}}
                          <div class="prompt-note-entry">
                            <p>{{this.content}}</p>

                            {{#if this.dateSubmitted}}
                              <div class="prompt-note-date">
                                {{formatDate this.dateSubmitted}}
                              </div>
                            {{/if}}
                          </div>
                        {{else}}
                          <span class="no-data">No notes</span>
                        {{/each}}
                      {{else}}
                        <span class="no-data">No notes</span>
                      {{/with}}

                    </div>

                  </div>

                </details>

              {{/unless}}
            {{/each}}

          </div>

        </div>
      </article>

    {{else}}

      <p class="no-data">No prompt notes available.</p>

    {{/each}}

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.unit-completed-toggle').forEach(button => {
      button.addEventListener('click', () => {
        const card = button.closest('.unit-completed-card');
        if (!card) return;
        card.classList.toggle('is-open');
      });
    });

    document.querySelectorAll('.promptset-accordion-toggle').forEach(button => {
      button.addEventListener('click', () => {
        const card = button.closest('.promptset-accordion-card');
        if (!card) return;
        card.classList.toggle('is-open');
      });
    });
  });
</script>