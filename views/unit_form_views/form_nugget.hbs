{{#*inline "title"}}Create a Nugget | Twennie{{/inline}}
{{> mainpartials/nuggetinstructions_partial}}


<div class="form-mission-video-wrapper">
  <div class="form-mission-video-container">
    <iframe
      src="https://www.youtube.com/embed/8kAkjSbz-us"
      title="Mission Control intro video"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
      class="form-mission-video-embed"
      width="500"
    ></iframe>
  </div>



  <p class="form-hint form-mission-video-hint">
    Before creating a nugget, watch this video. It provides guidance for creating successful nuggets based on what you want to achieve.
  </p>
</div>


<input type="hidden" name="fromUpcomingId" value="{{fromUpcomingId}}">
<div class="contribute-wave-divider">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 160">
    <path fill="#939598" fill-opacity="1"
      d="M0,64L80,58.7C160,53,320,43,480,58.7C640,75,800,117,960,122.7C1120,128,1280,96,1360,80L1440,64L1440,320L1360,320C1280,320,1120,320,960,320C800,320,640,320,480,320C320,320,160,320,80,320L0,320Z">
    </path>
  </svg>
</div>

<div class="form-nugget-background">
  <div class="form-nugget-container">
    <form 
      id="nugget-form" 
      class="nugget-form" 
      action="/unitform/submit_nugget" 
      method="POST"
    >
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <input type="hidden" name="_id" value="{{data._id}}">

      <!-- Title -->
      <div class="form-field">
        <label for="nugget-title">Nugget Title</label>
        <input type="text" id="nugget-title" name="title" value="{{data.title}}" required>
      </div>

      <!-- Client -->
      <div class="form-field">
        <label for="client">Client</label>
        <input type="text" id="client" name="client" value="{{data.client}}" required>
      </div>

      <!-- Horizon -->
      <div class="form-field">
        <label for="horizon">Horizon</label>
        <select id="horizon" name="horizon" required>
          <option value="">Select horizon</option>
          <option value="1y" {{#ifEquals data.horizon "1y"}}selected{{/ifEquals}}>1 Year</option>
          <option value="3y" {{#ifEquals data.horizon "3y"}}selected{{/ifEquals}}>3 Years</option>
          <option value="5y" {{#ifEquals data.horizon "5y"}}selected{{/ifEquals}}>5 Years</option>
        </select>
      </div>

      <!-- Discipline (alphabetical) -->
      <div class="form-field">
        <label for="discipline">Discipline</label>
        <select id="discipline" name="discipline" required>
          <option value="">Select discipline</option>
          <option value="Architecture"           {{#ifEquals data.discipline "Architecture"}}selected{{/ifEquals}}>Architecture</option>
          <option value="Bridges"                {{#ifEquals data.discipline "Bridges"}}selected{{/ifEquals}}>Bridges</option>
          <option value="Buildings"              {{#ifEquals data.discipline "Buildings"}}selected{{/ifEquals}}>Buildings</option>
          <option value="Electrical"             {{#ifEquals data.discipline "Electrical"}}selected{{/ifEquals}}>Electrical</option>
          <option value="Environmental"          {{#ifEquals data.discipline "Environmental"}}selected{{/ifEquals}}>Environmental</option>
          <option value="Geotechnical"           {{#ifEquals data.discipline "Geotechnical"}}selected{{/ifEquals}}>Geotechnical</option>
          <option value="Hydrology"              {{#ifEquals data.discipline "Hydrology"}}selected{{/ifEquals}}>Hydrology</option>
          <option value="Interior Design"        {{#ifEquals data.discipline "Interior Design"}}selected{{/ifEquals}}>Interior Design</option>
          <option value="Landscape Architecture" {{#ifEquals data.discipline "Landscape Architecture"}}selected{{/ifEquals}}>Landscape Architecture</option>
          <option value="Land Development"       {{#ifEquals data.discipline "Land Development"}}selected{{/ifEquals}}>Land Development</option>
          <option value="Mechanical"             {{#ifEquals data.discipline "Mechanical"}}selected{{/ifEquals}}>Mechanical</option>
          <option value="Planning"               {{#ifEquals data.discipline "Planning"}}selected{{/ifEquals}}>Planning</option>
          <option value="Transit"                {{#ifEquals data.discipline "Transit"}}selected{{/ifEquals}}>Transit</option>
          <option value="Transportation"         {{#ifEquals data.discipline "Transportation"}}selected{{/ifEquals}}>Transportation</option>
          <option value="Water and Wastewater"   {{#ifEquals data.discipline "Water and Wastewater"}}selected{{/ifEquals}}>Water and Wastewater</option>
          <option value="Other"   {{#ifEquals data.discipline "Water and Wastewater"}}selected{{/ifEquals}}>Other</option>
        </select>
      </div>

      <!-- Region -->
      <div class="form-field">
        <label for="region">Region</label>
        <select id="region" name="region" required>
          <option value="">Select region</option>
          <option value="Southern Ontario"                  {{#ifEquals data.region "Southern Ontario"}}selected{{/ifEquals}}>Southern Ontario</option>
          <option value="Northern Ontario"                  {{#ifEquals data.region "Northern Ontario"}}selected{{/ifEquals}}>Northern Ontario</option>
          <option value="Prairies"                          {{#ifEquals data.region "Prairies"}}selected{{/ifEquals}}>Prairies</option>
          <option value="BC"                                {{#ifEquals data.region "BC"}}selected{{/ifEquals}}>BC</option>
          <option value="Quebec"                            {{#ifEquals data.region "Quebec"}}selected{{/ifEquals}}>Quebec</option>
          <option value="Maritimes"                         {{#ifEquals data.region "Maritimes"}}selected{{/ifEquals}}>Maritimes</option>
          <option value="Nunavut, NWT, and the Yukon"       {{#ifEquals data.region "Nunavut, NWT, and the Yukon"}}selected{{/ifEquals}}>Nunavut, NWT, and the Yukon</option>
          <option value="Other"                             {{#ifEquals data.discipline "Water and Wastewater"}}selected{{/ifEquals}}>Other</option>
        </select>
      </div>

      <!-- Estimated Value (range bucket) -->
<div class="form-field">
  <label for="estimated-value-bucket">Estimated Value (CAD)</label>
  <select id="estimated-value-bucket" name="estimatedValue.bucket">
    <option value="">Select range</option>
    <option value="<$100K"        {{#ifEquals data.estimatedValue.bucket "<$100K"}}selected{{/ifEquals}}>&lt;$100K</option>
    <option value="$100K - $500K" {{#ifEquals data.estimatedValue.bucket "$100K - $500K"}}selected{{/ifEquals}}>$100K - $500K</option>
    <option value="$500K - $1M"   {{#ifEquals data.estimatedValue.bucket "$500K - $1M"}}selected{{/ifEquals}}>$500K - $1M</option>
    <option value="$1M - $5M"     {{#ifEquals data.estimatedValue.bucket "$1M - $5M"}}selected{{/ifEquals}}>$1M - $5M</option>
    <option value="$5M - $10M"    {{#ifEquals data.estimatedValue.bucket "$5M - $10M"}}selected{{/ifEquals}}>$5M - $10M</option>
    <option value="$10M - $50M"   {{#ifEquals data.estimatedValue.bucket "$10M - $50M"}}selected{{/ifEquals}}>$10M - $50M</option>
    <option value=">$50M"         {{#ifEquals data.estimatedValue.bucket ">$50M"}}selected{{/ifEquals}}>&gt;$50M</option>
    <option value="unknown"       {{#ifEquals data.estimatedValue.bucket "unknown"}}selected{{/ifEquals}}>unknown</option>
  </select>

  <input
    type="hidden"
    name="estimatedValue.currency"
    value="{{#if data.estimatedValue.currency}}{{data.estimatedValue.currency}}{{else}}CAD{{/if}}"
  >
</div>

      <!-- Project Delivery Type -->
      <div class="form-field">
        <label for="delivery-type">Project Delivery Type</label>
        <select id="delivery-type" name="projectDeliveryType">
          <option value="unknown"     {{#ifEquals data.projectDeliveryType "unknown"}}selected{{/ifEquals}}>Unknown</option>
          <option value="design"      {{#ifEquals data.projectDeliveryType "design"}}selected{{/ifEquals}}>Design</option>
          <option value="design-build"{{#ifEquals data.projectDeliveryType "design-build"}}selected{{/ifEquals}}>Design-Build</option>
          <option value="CMAR"        {{#ifEquals data.projectDeliveryType "CMAR"}}selected{{/ifEquals}}>CMAR</option>
          <option value="P3"          {{#ifEquals data.projectDeliveryType "P3"}}selected{{/ifEquals}}>P3</option>
          <option value="DBFM"        {{#ifEquals data.projectDeliveryType "DBFM"}}selected{{/ifEquals}}>DBFM</option>
          <option value="DBF"         {{#ifEquals data.projectDeliveryType "DBF"}}selected{{/ifEquals}}>DBF</option>
          <option value="Other"         {{#ifEquals data.projectDeliveryType "DBF"}}selected{{/ifEquals}}>Other</option>
        </select>
      </div>

      <!-- Original Source -->
      <div class="form-field">
        <label for="source-label">Original Source</label>
        <input type="text" id="source-label" name="originalSource.label" value="{{data.originalSource.label}}" required>
        <input type="url" id="source-url" name="originalSource.url" value="{{data.originalSource.url}}" placeholder="http://...">
      </div>

      <!-- Likelihood -->
      <div class="form-field">
        <label for="likelihood">Win Probability (%)</label>
        <input type="number" id="likelihood" name="likelihood" value="{{data.likelihood}}" min="0" max="100" step="5">
      </div>

      <section class="mission-learning-units">
        <h2 class="mission-learning-units-title">Twennie learning units (optional)</h2>
        <p class="mission-learning-units-help">
          Does your nugget include learning? If so, attach up to three Twennie learning units that support this nugget.
          Start typing a keyword from the unit title and choose from the list. 
        </p>

        <div class="mission-learning-units-search" style="width: 80%; border-radius: 50px">
          <label for="twennie-unit-search">Search for a unit</label>
          <input
            id="twennie-unit-search"
            type="text"
            name="twennie_unit_search"
            autocomplete="off"
            placeholder="Type a keyword to find units..."
          >
          <div
            id="twennie-unit-search-results"
            class="mission-learning-units-results"
            aria-live="polite"
          ></div>
        </div>

        <div class="mission-learning-units-selected">
          <h3>Selected units (max 3)</h3>
          <div id="twennie-selected-units" class="mission-learning-units-chips"></div>
        </div>

        <div id="twennie-units-hidden-inputs"></div>
      </section>

      <!-- Notes -->
      <div class="form-field">
        <label for="notes">Notes</label>
        <textarea id="notes" name="notes" rows="5">{{data.notes}}</textarea>
      </div>

      <!-- Visibility -->
      <div class="form-field">
        <label>Who can access this nugget?</label>
        <div class="visibility-toggle-row">
          <label class="visibility-option">
            <input type="radio" name="visibility" value="team_only" {{#ifEquals data.visibility "team_only"}}checked{{/ifEquals}} required>
            share with my group only
          </label>
          <label class="visibility-option">
            <input type="radio" name="visibility" value="organization_only" {{#ifEquals data.visibility "organization_only"}}checked{{/ifEquals}} required>
            share with my organization only
          </label>
          <label class="visibility-option">
            <input type="radio" name="visibility" value="all_members" {{#ifEquals data.visibility "all_members"}}checked{{/ifEquals}} required>
            share with all Twennie members
          </label>
        </div>
      </div>

      <div class="form-buttons">
        {{#if data._id}}
          <button type="submit" name="submit" value="edit" class="form-button submit-button">save edited nugget</button>
        {{else}}
          <button type="submit" name="submit" value="submit" class="form-button submit-button">submit nugget</button>
        {{/if}}
      </div>
    </form>
  </div>
</div>

{{> mainpartials/footer}}
