{{#*inline "title"}}Post an Interview | Twennie{{/inline}}
{{> mainpartials/interviewinstructions_partial}}


<!-- near the top of every form_* file -->
<input type="hidden" name="fromUpcomingId" value="{{fromUpcomingId}}">
<div class="contribute-wave-divider">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 160">
    <path fill="#939598" fill-opacity="1"
      d="M0,64L80,58.7C160,53,320,43,480,58.7C640,75,800,117,960,122.7C1120,128,1280,96,1360,80L1440,64L1440,320L1360,320C1280,320,1120,320,960,320C800,320,640,320,480,320C320,320,160,320,80,320L0,320Z">
    </path>
  </svg>
</div>

<div class="form-interview-background">
  <div class="form-interview-container">
    <form id="interview-form" class="interview-form" action="/unitform/submit_interview" method="POST">

      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <input type="hidden" name="_id" value="{{data._id}}">

      <!-- Interview Title -->
      <div class="form-field">
        <label for="interview-title">Interview Title</label>
        <input type="text" id="interview-title" name="interview_title" value="{{data.interview_title}}" required>
      </div>

{{> unitformpartials/topicdropdown }}


      <!-- Video Link -->
      <div class="form-field">
        <label for="video-link">YouTube Link</label>
        <p class="form-help-text" style="font-size: 0.85rem; color: #555; margin-bottom: 6px;">
          <strong>Reminder:</strong> Please upload your video to YouTube and set it to <strong>Unlisted</strong> (not Private). This makes it so your video is not public, but Twennie members can view it based on the visibility level you've selected. 
          <a href="https://support.google.com/youtube/answer/157177" target="_blank" rel="noopener noreferrer" style="color:#4a4ab2;">Learn how</a>.
        </p>
        <input type="url" id="video-link" name="video_link" value="{{data.video_link}}" placeholder="Paste the YouTube link here" required>
      </div>

      <!-- Transcript -->
      <div class="form-field">
        <label for="transcript">Interview Transcript <span style="font-weight: normal; font-size: 0.85em;">(Optional)</span></label>
        <p class="form-help-text" style="font-size: 0.85rem; color: #555;">
          Transcripts improve accessibility and help members preview the content. Paste it here if available.
        </p>
        <textarea id="transcript" name="transcript" rows="25" maxlength="8000" placeholder="Paste the interview transcript here">{{{formatContent data.transcript}}}</textarea>
      </div>

<div class="form-toggle">
  <label>
    <input
      type="checkbox"
      name="permission"
      {{#if data.permission}}checked{{/if}}
    >
    I consent to Twennie using this library unit (with attribution) for promotional purposes.
  </label>
  <p class="form-field-help">
    This consent is optional and does not affect your membership or access.
  </p>
</div>

      <!-- Short Summary -->
      <div class="form-field">
        <label for="short-summary">Short Summary (30 words)</label>
        <textarea id="short-summary" name="short_summary" maxlength="300" required>{{data.short_summary}}</textarea>
      </div>

      <!-- Full Summary -->
      <div class="form-field">
        <label for="full-summary">
          Full Summary <span style="font-weight: normal; font-size: 0.85em;">(Optional, 90 words)</span>
        </label>
        <p class="form-help-text" style="font-size: 0.85rem; color: #555; margin-top: 4px;">
          The full summary helps members further understand the focus and insights of your interview. Including both summaries is recommended.
        </p>
        <textarea id="full-summary" name="full_summary" maxlength="600">{{data.full_summary}}</textarea>
      </div>

      <!-- Visibility -->
      <div class="form-field">
        <label>Who can access this interview?</label>
        <div class="visibility-toggle-row">
          <label class="visibility-option">
            <input type="radio" name="visibility" value="team_only" {{#ifEquals data.visibility "team_only"}}checked{{/ifEquals}} required>
            share with my group only
          </label>
          <label class="visibility-option">
            <input type="radio" name="visibility" value="organization_only" {{#ifEquals data.visibility "organization_only"}}checked{{/ifEquals}} required>
            share with my organization only
          </label>
          <label class="visibility-option">
            <input type="radio" name="visibility" value="all_members" {{#ifEquals data.visibility "all_members"}}checked{{/ifEquals}} required>
            share with all Twennie members
          </label>
        </div>
      </div>

      <!-- Submit -->
      <div class="form-buttons">
        <button type="submit" name="submit" value="submit" class="form-button submit-button">submit</button>
      </div>
    </form>
  </div>
</div>
{{> mainpartials/home_subfooter}}
{{> mainpartials/footer}}

