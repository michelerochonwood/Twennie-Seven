{{#*inline "title"}}Post a Video | Twennie{{/inline}}
{{> mainpartials/videoinstructions_partial}}


<!-- near the top of every form_* file -->
<input type="hidden" name="fromUpcomingId" value="{{fromUpcomingId}}">
<div class="contribute-wave-divider">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 160">
    <path fill="#939598" fill-opacity="1"
      d="M0,64L80,58.7C160,53,320,43,480,58.7C640,75,800,117,960,122.7C1120,128,1280,96,1360,80L1440,64L1440,320L1360,320C1280,320,1120,320,960,320C800,320,640,320,480,320C320,320,160,320,80,320L0,320Z">
    </path>
  </svg>
</div>

<div class="form-video-background">
  <div class="form-video-container">
    <!-- Form Content -->
    <form id="video-form" class="video-form" action="/unitform/submit_video" method="POST">

      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <input type="hidden" name="_id" value="{{data._id}}">

      <!-- Video Title -->
      <div class="form-field">
        <label for="video-title">Video Title</label>
        <input type="text" id="video-title" name="video_title" value="{{data.video_title}}" required>
      </div>

{{> unitformpartials/topicdropdown }}

      <!-- Video Content -->
<div class="form-field">
  <label for="video-content">Videos should be a minimum of 3 minutes, maximum 20 minutes.</label>

<p class="form-help-text" style="margin-top: 0.5rem; font-size: 0.85rem; color: #555;">
  <strong>Important:</strong> We recommend uploading your video to a personal or team YouTube channel and setting the visibility to <strong>"Unlisted"</strong>. This ensures your video is not publicly searchable on YouTube but can still be viewed by Twennie members based on the visibility level you've selected.
  <a href="https://support.google.com/youtube/answer/157177" target="_blank" rel="noopener noreferrer" style="color:#4a4ab2; text-decoration: underline;">
    Learn how to change YouTube visibility settings
  </a>.
  If you prefer not to use YouTube, Twennie also supports videos hosted on <strong>Vimeo</strong>, <strong>Cloudinary</strong>, and <strong>Wistia</strong>. Simply paste the video URL into the field below.
</p>

  <textarea id="video-content" name="video_content" rows="25" placeholder="Paste your video link here." required>{{data.video_content}}</textarea>
</div>

      <!-- Toggles -->
<div class="form-toggle">
  <label>
    <input
      type="checkbox"
      name="permission"
      {{#if data.permission}}checked{{/if}}
    >
    I consent to Twennie using this library unit (with attribution) for promotional purposes.
  </label>
  <p class="form-field-help">
    This consent is optional and does not affect your membership or access.
  </p>
</div>

      <!-- Short Summary -->
      <div class="form-field">
        <label for="short-summary">Short Summary (~30 words)</label>
        <textarea id="short-summary" name="short_summary" maxlength="300" required>{{data.short_summary}}</textarea>
      </div>

      <!-- Full Summary -->
<!-- Full Summary -->
<div class="form-field">
  <label for="full-summary">
    Full Summary <span style="font-weight: normal; font-size: 0.85em;">(Optional, ~90 words)</span>
  </label>
  <p class="form-help-text" style="font-size: 0.85rem; color: #555; margin-top: 4px;">
    The full summary provides additional context about your video and helps other members understand its focus and value. While optional, including both summaries is encouraged.
  </p>
  <textarea id="full-summary" name="full_summary" maxlength="600">{{data.full_summary}}</textarea>
</div>

{{!-- Visibility Toggles --}}
<div class="form-field">
  <label>Who can access this video?</label>

  <div class="visibility-toggle-row">
    {{#unless (eq user.membershipType "member")}}
      <label class="visibility-option">
        <input
          type="radio"
          name="visibility"
          value="team_only"
          {{#ifEquals data.visibility "team_only"}}checked{{/ifEquals}}
        >
        share with my group only
      </label>

      <label class="visibility-option">
        <input
          type="radio"
          name="visibility"
          value="organization_only"
          {{#ifEquals data.visibility "organization_only"}}checked{{/ifEquals}}
        >
        share with my organization only
      </label>
    {{/unless}}

    <label class="visibility-option">
      <input
        type="radio"
        name="visibility"
        value="all_members"
        {{#ifEquals data.visibility "all_members"}}checked{{/ifEquals}}
        {{#if (eq user.membershipType "member")}}checked{{/if}}
        required
      >
      share with all Twennie members
    </label>
  </div>
</div>

      <!-- Buttons -->
      <div class="form-buttons">
        <button type="submit" name="submit" value="submit" class="form-button submit-button">submit</button>
      </div>
    </form>
  </div>
</div>
{{> mainpartials/home_subfooter}}
{{> mainpartials/footer}}

<script>
document.addEventListener("DOMContentLoaded", function () {
  const realMainTopicSelect = document.getElementById("main-topic");
  const categorySelects = document.querySelectorAll(".category-topic-select");

  const existingMainTopic = "{{data.main_topic}}";

  function clearOtherSelects(except) {
    categorySelects.forEach(sel => {
      if (sel !== except) {
        sel.value = "";
      }
    });
  }

  categorySelects.forEach(select => {
    select.addEventListener("change", function () {
      const chosen = this.value || "";
      clearOtherSelects(this);
      realMainTopicSelect.innerHTML = "";
      if (chosen) {
        const opt = document.createElement("option");
        opt.value = chosen;
        opt.textContent = chosen;
        realMainTopicSelect.appendChild(opt);
        realMainTopicSelect.value = chosen;
      } else {
        const opt = document.createElement("option");
        opt.value = "";
        opt.textContent = "Please select a main topic";
        realMainTopicSelect.appendChild(opt);
        realMainTopicSelect.value = "";
      }
    });
  });

  if (existingMainTopic) {
    categorySelects.forEach(select => {
      Array.from(select.options).forEach(opt => {
        if (opt.value === existingMainTopic) {
          select.value = existingMainTopic;
        }
      });
    });

    const opt = document.createElement("option");
    opt.value = existingMainTopic;
    opt.textContent = existingMainTopic;
    realMainTopicSelect.appendChild(opt);
    realMainTopicSelect.value = existingMainTopic;
  }
});

</script>
