{{#*inline "title"}}Create a Template | Twennie{{/inline}}
{{> mainpartials/templateinstructions_partial}}

<input type="hidden" name="fromUpcomingId" value="{{fromUpcomingId}}">

<div class="contribute-wave-divider">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 160">
    <path fill="#939598" fill-opacity="1" d="M0,64L80,58.7C160,53,320,43,480,58.7C640,75,800,117,960,122.7C1120,128,1280,96,1360,80L1440,64L1440,320L1360,320C1280,320,1120,320,960,320C800,320,640,320,480,320C320,320,160,320,80,320L0,320Z"></path>
  </svg>
</div>

<div class="form-template-background">
  <div class="form-template-container">
    <form id="template-form" action="/unitform/submit_template" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">

      {{#if data._id}}
        <input type="hidden" name="_id" value="{{data._id}}">
      {{/if}}

      <!-- Preserve existing uploads -->
      {{#if data.documentUploads}}
        <input type="hidden" name="existing_document_uploads" value='{{json data.documentUploads}}'>
      {{/if}}

      <!-- Title -->
      <div class="form-field">
        <label>Template Title</label>
        <input type="text" name="template_title" value="{{data.template_title}}" required>
      </div>

      {{> unitformpartials/topicdropdown }}

      <!-- Sub Topic -->
      <div class="form-field">
        <label>Sub Topic (Optional)</label>
        <input type="text" name="sub_topic" value="{{data.sub_topic}}">
      </div>

      <!-- Existing Files -->
      {{#if data.documentUploads}}
        <div class="uploaded-files">
          {{#each data.documentUploads}}
            <p>
              {{#ifEquals this.role "view"}}
                📄 View File:
              {{else}}
                🛠️ Working File:
              {{/ifEquals}}

              <a href="{{this.url}}" target="_blank" rel="noopener">
                {{this.filename}}
              </a>
            </p>
          {{/each}}
        </div>
      {{/if}}

      <!-- PDF Upload -->
      <div class="form-field">
        <label>Upload Template (PDF – required for new templates)</label>
        <input
          type="file"
          name="template_pdf"
          accept=".pdf,application/pdf"
          {{#unless data._id}}required{{/unless}}
        >
        <small>This file is used for viewing in the browser.</small>
      </div>

      <!-- Working File -->
      <div class="form-field">
        <label>Upload Working File (optional)</label>
        <input
          type="file"
          name="template_working"
          accept=".doc,.docx,.xls,.xlsx,.ppt,.pptx"
        >
        <small>Optional editable version.</small>
      </div>

      <!-- File Format -->
      <div class="form-field">
        <label>File Format</label>
        <label>
          <input type="radio" name="file_format" value="pdf" checked required>
          PDF
        </label>
      </div>

      <!-- Permission -->
      <div class="form-toggle">
        <label>
          <input type="checkbox" name="permission" {{#if data.permission}}checked{{/if}}>
          I consent to Twennie using this unit for promotional purposes.
        </label>
      </div>

      <!-- Summaries -->
      <div class="form-field">
        <label>Short Summary</label>
        <textarea name="short_summary" required>{{data.short_summary}}</textarea>
      </div>

      <div class="form-field">
        <label>Full Summary (optional)</label>
        <textarea name="full_summary">{{data.full_summary}}</textarea>
      </div>

      <!-- Visibility -->
      <div class="form-field">
        <label>Visibility</label>
        <label><input type="radio" name="visibility" value="team_only"> Team</label>
        <label><input type="radio" name="visibility" value="organization_only"> Org</label>
        <label><input type="radio" name="visibility" value="all_members"> All</label>
      </div>

      <!-- Submit -->
      <div class="form-buttons">
        <button type="submit" class="form-button submit-button">
          {{#if data._id}}save template{{else}}submit{{/if}}
        </button>
      </div>

    </form>
  </div>
</div>

{{> mainpartials/home_subfooter}}
{{> mainpartials/footer}}


