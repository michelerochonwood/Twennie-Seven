{{#*inline "title"}}Create a Template | Twennie{{/inline}}
{{> mainpartials/templateinstructions_partial}}

<input type="hidden" name="fromUpcomingId" value="{{fromUpcomingId}}">

<div class="contribute-wave-divider">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 160">
    <path fill="#939598" fill-opacity="1" d="M0,64L80,58.7C160,53,320,43,480,58.7C640,75,800,117,960,122.7C1120,128,1280,96,1360,80L1440,64L1440,320L1360,320C1280,320,1120,320,960,320C800,320,640,320,480,320C320,320,160,320,80,320L0,320Z"></path>
  </svg>
</div>

<div class="form-template-background">
  <div class="form-template-container">
    <form id="template-form" action="/unitform/submit_template" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">

      {{#if data._id}}
        <input type="hidden" name="_id" value="{{data._id}}">
      {{/if}}

      <!-- Preserve existing uploads -->
      {{#if data.documentUploads}}
        <input type="hidden" name="existing_document_uploads" value='{{json data.documentUploads}}'>
      {{/if}}

      <!-- Title -->
      <div class="form-field">
        <label for="template-title">Template Title</label>
        <input type="text" id="template-title" name="template_title" value="{{data.template_title}}" required>
      </div>

      {{> unitformpartials/topicdropdown }}

      <!-- Sub Topic -->
      <div class="form-field">
        <label for="sub-topic">Sub Topic (Optional)</label>
        <input type="text" id="sub-topic" name="sub_topic" value="{{data.sub_topic}}">
      </div>

      <!-- Existing files display -->
      {{#if data.documentUploads}}
        <div class="uploaded-files">
          {{#each data.documentUploads}}
            <p>
              <a href="{{this.url}}" target="_blank" rel="noopener">
                View {{this.filename}}
              </a>
            </p>
          {{/each}}
        </div>
      {{/if}}

      <!-- Upload -->
<!-- PDF Upload (REQUIRED) -->
<div class="form-field">
  <label for="template_pdf">Upload Template (PDF – required)</label>
  <input
    type="file"
    id="template_pdf"
    name="template_pdf"
    accept=".pdf,application/pdf"
    required
  >
  <small>This PDF will be used for viewing in the browser.</small>
</div>

<!-- Working File Upload (OPTIONAL) -->
<div class="form-field">
  <label for="template_working">Upload Working File (optional)</label>
  <input
    type="file"
    id="template_working"
    name="template_working"
    accept=".doc,.docx,.xls,.xlsx"
  >
  <small>Optional: upload a Word or Excel file for practical use.</small>
</div>

      <!-- File Format -->
      <div class="form-field">
        <label>File Format</label>
        <div class="white-container">
          <div class="toggle-group">
            <label>
              <input type="radio" name="file_format" value="pdf" checked required>
              PDF
            </label>
          </div>
        </div>
      </div>

      <!-- Permission -->
      <div class="form-toggle">
        <label>
          <input type="checkbox" name="permission" {{#if data.permission}}checked{{/if}}>
          I consent to Twennie using this library unit for promotional purposes.
        </label>
      </div>

      <!-- Short Summary -->
      <div class="form-field">
        <label for="short-summary">Short Summary (~30 words)</label>
        <textarea id="short-summary" name="short_summary" maxlength="300" required>{{data.short_summary}}</textarea>
      </div>

      <!-- Full Summary -->
      <div class="form-field">
        <label for="full-summary">Full Summary (optional)</label>
        <textarea id="full-summary" name="full_summary" maxlength="600">{{data.full_summary}}</textarea>
      </div>

      <!-- Visibility -->
      <div class="form-field">
        <label>Who can access this template?</label>
        <div class="visibility-toggle-row">
          <label>
            <input type="radio" name="visibility" value="team_only" {{#ifEquals data.visibility "team_only"}}checked{{/ifEquals}} required>
            My group
          </label>
          <label>
            <input type="radio" name="visibility" value="organization_only" {{#ifEquals data.visibility "organization_only"}}checked{{/ifEquals}}>
            My organization
          </label>
          <label>
            <input type="radio" name="visibility" value="all_members" {{#ifEquals data.visibility "all_members"}}checked{{/ifEquals}}>
            All members
          </label>
        </div>
      </div>

      <!-- Submit -->
      <div class="form-buttons">
        <button type="submit" class="form-button submit-button">
          {{#if data._id}}save template{{else}}submit{{/if}}
        </button>
      </div>

    </form>
  </div>
</div>

{{> mainpartials/home_subfooter}}
{{> mainpartials/footer}}



