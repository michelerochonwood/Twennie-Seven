{{#*inline "title"}}Create an Exercise | Twennie{{/inline}}
{{> mainpartials/exerciseinstructions_partial}}

<div class="contribute-wave-divider">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 160">
    <path fill="#939598" fill-opacity="1" d="M0,64L80,58.7C160,53,320,43,480,58.7C640,75,800,117,960,122.7C1120,128,1280,96,1360,80L1440,64L1440,320L1360,320C1280,320,1120,320,960,320C800,320,640,320,480,320C320,320,160,320,80,320L0,320Z"></path>
  </svg>
</div>

<div class="form-exercise-background">
  <div class="form-exercise-container">
    <form id="exercise-form" action="/unitform/submit_exercise" method="POST" enctype="multipart/form-data">

      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <input type="hidden" name="fromUpcomingId" value="{{fromUpcomingId}}">

      {{#if data._id}}
        <input type="hidden" name="_id" value="{{data._id}}">
      {{/if}}

      {{#if data.document_uploads}}
        <input type="hidden" name="existing_document_uploads" value='{{json data.document_uploads}}'>
      {{/if}}

      <div class="form-field">
        <label for="exercise-title">Exercise Title</label>
        <input type="text" id="exercise-title" name="exercise_title" value="{{data.exercise_title}}" required>
      </div>

      {{> unitformpartials/topicdropdown }}

      <div class="form-field">
        <label>File Format</label>
        <label>
          <input type="radio" name="file_format" value="PDF" checked required>
          PDF
        </label>
      </div>

      <div class="form-field">
        <label for="document_uploads">Upload Exercise PDF</label>
        <input
          type="file"
          id="document_uploads"
          name="document_uploads"
          multiple
          accept="application/pdf,.pdf"
          onchange="
            const files = Array.from(this.files);
            const tooMany = files.length > 3;
            const hasNonPdf = files.some(file => file.type !== 'application/pdf' && !file.name.toLowerCase().endsWith('.pdf'));

            if (tooMany) {
              alert('You can upload a maximum of 3 PDFs.');
              this.value = '';
            }

            if (hasNonPdf) {
              alert('Only PDF files are allowed.');
              this.value = '';
            }
          "
        >
        <p class="form-field-help">PDF only. Maximum 3 files.</p>
      </div>

      <div class="form-field">
        <label for="time_required">Estimated Time</label>
        <select id="time_required" name="time_required" required>
          <option value="">Select</option>
          <option value="15 mins" {{#ifEquals data.time_required "15 mins"}}selected{{/ifEquals}}>15 mins</option>
          <option value="30 mins" {{#ifEquals data.time_required "30 mins"}}selected{{/ifEquals}}>30 mins</option>
          <option value="1 hour" {{#ifEquals data.time_required "1 hour"}}selected{{/ifEquals}}>1 hour</option>
          <option value="1.5 hours" {{#ifEquals data.time_required "1.5 hours"}}selected{{/ifEquals}}>1.5 hours</option>
        </select>
      </div>

      <div class="form-toggle">
        <label>
          <input
            type="checkbox"
            name="permission"
            {{#if data.permission}}checked{{/if}}
          >
          I consent to Twennie using this library unit (with attribution) for promotional purposes.
        </label>
        <p class="form-field-help">
          This consent is optional and does not affect your membership or access.
        </p>
      </div>

      <div class="form-field">
        <label for="short_summary">Short Summary</label>
        <textarea id="short_summary" name="short_summary" required>{{data.short_summary}}</textarea>
      </div>

      <div class="form-field">
        <label for="full_summary">Full Summary (optional)</label>
        <textarea id="full_summary" name="full_summary">{{data.full_summary}}</textarea>
      </div>

      <div class="form-field">
        <label>Who can access this exercise?</label>

        <div class="visibility-toggle-row">
          {{#unless (eq user.membershipType "member")}}
            <label class="visibility-option">
              <input
                type="radio"
                name="visibility"
                value="team_only"
                {{#ifEquals data.visibility "team_only"}}checked{{/ifEquals}}
              >
              share with my group only
            </label>

            <label class="visibility-option">
              <input
                type="radio"
                name="visibility"
                value="organization_only"
                {{#ifEquals data.visibility "organization_only"}}checked{{/ifEquals}}
              >
              share with my organization only
            </label>
          {{/unless}}

          <label class="visibility-option">
            <input
              type="radio"
              name="visibility"
              value="all_members"
              {{#ifEquals data.visibility "all_members"}}checked{{/ifEquals}}
              {{#if (eq user.membershipType "member")}}checked{{/if}}
              required
            >
            share with all Twennie members
          </label>
        </div>
      </div>

      <div class="form-buttons">
        <button type="submit" class="form-button submit-button">submit</button>
      </div>

    </form>
  </div>
</div>

{{> mainpartials/home_subfooter}}
{{> mainpartials/footer}}