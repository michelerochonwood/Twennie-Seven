{{#*inline "title"}}Create an Exercise | Twennie{{/inline}}
{{> mainpartials/exerciseinstructions_partial}}

<input type="hidden" name="fromUpcomingId" value="{{fromUpcomingId}}">

<div class="contribute-wave-divider">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 160">
    <path fill="#939598" fill-opacity="1" d="M0,64L80,58.7C160,53,320,43,480,58.7C640,75,800,117,960,122.7C1120,128,1280,96,1360,80L1440,64L1440,320L1360,320C1280,320,1120,320,960,320C800,320,640,320,480,320C320,320,160,320,80,320L0,320Z"></path>
  </svg>
</div>

<div class="form-exercise-background">
  <div class="form-exercise-container">
    <form id="exercise-form" action="/unitform/submit_exercise" method="POST" enctype="multipart/form-data">

      <input type="hidden" name="_csrf" value="{{csrfToken}}">

      {{#if data._id}}
        <input type="hidden" name="_id" value="{{data._id}}">
      {{/if}}

      <!-- Preserve existing -->
      {{#if data.document_uploads}}
        <input type="hidden" name="existing_document_uploads" value='{{json data.document_uploads}}'>
      {{/if}}

      <!-- Title -->
      <div class="form-field">
        <label for="exercise-title">Exercise Title</label>
        <input type="text" id="exercise-title" name="exercise_title" value="{{data.exercise_title}}" required>
      </div>

      {{> unitformpartials/topicdropdown }}

      <!-- File Format -->
      <div class="form-field">
        <label>File Format</label>
        <label>
          <input type="radio" name="file_format" value="PDF" checked required>
          PDF
        </label>
      </div>

      <!-- Upload -->
      <div class="form-field">
        <label for="document_uploads">Upload Exercise (PDF only, max 3)</label>
        <input
          type="file"
          id="document_uploads"
          name="document_uploads"
          multiple
          accept=".pdf,application/pdf"
          onchange="if(this.files.length > 3) { alert('Max 3 PDFs'); this.value=''; }"
        >
      </div>

      <!-- Time -->
      <div class="form-field">
        <label for="time_required">Estimated Time</label>
        <select name="time_required" required>
          <option value="">Select</option>
          <option value="15 mins">15 mins</option>
          <option value="30 mins">30 mins</option>
          <option value="1 hour">1 hour</option>
          <option value="1.5 hours">1.5 hours</option>
        </select>
      </div>

      <!-- Permission -->
<div class="form-toggle">
  <label>
    <input
      type="checkbox"
      name="permission"
      {{#if data.permission}}checked{{/if}}
    >
    I consent to Twennie using this library unit (with attribution) for promotional purposes.
  </label>
  <p class="form-field-help">
    This consent is optional and does not affect your membership or access.
  </p>
</div>

      <!-- Summaries -->
      <div class="form-field">
        <label>Short Summary</label>
        <textarea name="short_summary" required>{{data.short_summary}}</textarea>
      </div>

      <div class="form-field">
        <label>Full Summary (optional)</label>
        <textarea name="full_summary">{{data.full_summary}}</textarea>
      </div>

      <!-- NEW: Visibility Toggles -->
      <div class="form-field">
        <label>Who can access this article?</label>
        <div class="visibility-toggle-row">
          <label class="visibility-option">
            <input type="radio" name="visibility" value="team_only" {{#ifEquals data.visibility "team_only"}}checked{{/ifEquals}} required>
            share with my group only
          </label>
          <label class="visibility-option">
            <input type="radio" name="visibility" value="organization_only" {{#ifEquals data.visibility "organization_only"}}checked{{/ifEquals}} required>
            share with my organization only
          </label>
          <label class="visibility-option">
            <input type="radio" name="visibility" value="all_members" {{#ifEquals data.visibility "all_members"}}checked{{/ifEquals}} required>
            share with all Twennie members
          </label>
        </div>
      </div>

      <!-- Submit -->
      <div class="form-buttons">
        <button type="submit" class="form-button submit-button">submit</button>
      </div>

    </form>
  </div>
</div>

{{> mainpartials/home_subfooter}}
{{> mainpartials/footer}}