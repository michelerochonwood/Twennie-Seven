{{!-- views/unitform_views/form_mission.hbs --}}
{{#*inline "title"}}Create a Mission | Twennie{{/inline}}

<input type="hidden" name="fromUpcomingId" value="{{fromUpcomingId}}">

    <!-- YouTube iframe (src is set only after click) -->
    <iframe
      data-src="https://www.youtube.com/embed/tUnOLnUaV5o?autoplay=1"
      src="about:blank"
      title="Mission Control intro video"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
      style="
        position: absolute;
        inset: 0;
        width: 80%;
        height: 80%;
        display: none;
      "
    ></iframe>
            <p class="form-hint">
          Before creating a mission, watch this video. It provides guidance and tips for creating successful missions based on what you want to achieve.
        </p>

<div class="contribute-wave-divider">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 160">
    <path fill="#939598" fill-opacity="1"
      d="M0,64L80,58.7C160,53,320,43,480,58.7C640,75,800,117,960,122.7C1120,128,1280,96,1360,80L1440,64L1440,320L1360,320C1280,320,1120,320,960,320C800,320,640,320,480,320C320,320,160,320,80,320L0,320Z">
    </path>
  </svg>
</div>

<div class="form-mission-background">
  <div class="form-mission-container">
    <form
      id="mission-form"
      class="mission-form"
      action="/unitform/submit_mission"
      method="POST"
      enctype="application/x-www-form-urlencoded"
    >
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <input type="hidden" name="_id" value="{{data._id}}">

      <div class="form-field">
        <label for="mission-title">Mission Title</label>
        <input
          type="text"
          id="mission-title"
          name="mission_title"
          value="{{data.mission_title}}"
          required
        >
      </div>

      <div class="form-field">
        <label for="badge-name">Give your mission badge a name</label>
        <input
          type="text"
          id="badge-name"
          name="badge_name"
          value="{{data.badge_name}}"
          required
          maxlength="60"
          placeholder="e.g., Client Whisperer, Scope Guardian, Research Runner"
        >
        <p class="form-hint">
          This name appears on the badge when someone completes the mission. It can be the same as the mission title, if you like. If you want it to be different, make it short but specific to the assignment. It should show what the assignee accomplished, such as Manual Writing or Conducting Stay Interviews.
        </p>
      </div>

      <div class="form-field">
        <label for="category">Mission Category</label>
        <select id="category" name="category" required>
          <option value="">-- Select a category --</option>
          <option value="learning" {{#ifEquals data.category "learning"}}selected{{/ifEquals}}>Learning</option>
          <option value="research" {{#ifEquals data.category "research"}}selected{{/ifEquals}}>Research</option>
          <option value="business_development" {{#ifEquals data.category "business_development"}}selected{{/ifEquals}}>Business Development</option>
          <option value="internal_improvement" {{#ifEquals data.category "internal_improvement"}}selected{{/ifEquals}}>Internal Improvement</option>
          <option value="culture_play" {{#ifEquals data.category "culture_play"}}selected{{/ifEquals}}>Culture &amp; Play</option>
          <option value="client_experience" {{#ifEquals data.category "client_experience"}}selected{{/ifEquals}}>Client Experience</option>
          <option value="community" {{#ifEquals data.category "community"}}selected{{/ifEquals}}>Community</option>
          <option value="administrative" {{#ifEquals data.category "administrative"}}selected{{/ifEquals}}>Administrative</option>
          <option value="other" {{#ifEquals data.category "other"}}selected{{/ifEquals}}>Rogue / Other</option>
        </select>
      </div>

      <div class="form-field" style="margin-top: 10px">
        <label for="status">Mission Status</label>
        <select id="status" name="status" required>
          <option value="one time mission" {{#ifEquals data.status "one time mission"}}selected{{/ifEquals}}>One Time Mission</option>
          <option value="on-going" {{#ifEquals data.status "on-going"}}selected{{/ifEquals}}>On-Going</option>
          <option value="intermittent" {{#ifEquals data.status "intermittent"}}selected{{/ifEquals}}>Intermittent</option>
        </select>
      </div>

      <div class="form-field">
        <label for="purpose">Mission Purpose and Summary</label>
        <textarea
          id="purpose"
          name="purpose"
          rows="4"
          required
        >{{data.purpose}}</textarea>
        <p class="form-hint">
          Describe what this mission is meant to achieve. What tasks are involved and who might support the process? How does the mission contribute to the goals of the organization? Aim for about 250 words.
        </p>
      </div>


      <div class="form-field">
        <label for="additional_instructions">
          Additional Instructions
          <span style="font-weight: normal; font-size: 0.85em;">(optional)</span>
        </label>
        <textarea
          id="additional_instructions"
          name="additional_instructions"
          rows="5"
        >{{data.additional_instructions}}</textarea>
        <p class="form-hint">
          Use this as a catch-all for extra context, background, requests, guidance, budgets, job numbers or anything else people should know.
        </p>
      </div>



      <div class="form-field">
        <label>Who can access this mission?</label>
        <div class="visibility-toggle-row">
          <label class="visibility-option">
            <input
              type="radio"
              name="visibility"
              value="team_only"
              {{#ifEquals data.visibility "team_only"}}checked{{/ifEquals}}
              required
            >
            share with my team only
          </label>
          <label class="visibility-option">
            <input
              type="radio"
              name="visibility"
              value="organization_only"
              {{#ifEquals data.visibility "organization_only"}}checked{{/ifEquals}}
              required
            >
            share with my organization only
          </label>
          <label class="visibility-option">
            <input
              type="radio"
              name="visibility"
              value="all_members"
              {{#ifEquals data.visibility "all_members"}}checked{{/ifEquals}}
              required
            >
            share with all Twennie members
          </label>
        </div>
      </div>

      <section class="mission-learning-units">
        <h2 class="mission-learning-units-title">Twennie learning units (optional)</h2>
        <p class="mission-learning-units-help">
          Does your mission include learning? If so, attach up to six Twennie learning units that support this mission.
          Start typing a keyword from the unit title and choose from the list. 
        </p>

        <div class="mission-learning-units-search" style="width: 80%; border-radius: 50px">
          <label for="twennie-unit-search">Search for a unit</label>
          <input
            id="twennie-unit-search"
            type="text"
            name="twennie_unit_search"
            autocomplete="off"
            placeholder="Type a keyword to find units..."
          >
          <div
            id="twennie-unit-search-results"
            class="mission-learning-units-results"
            aria-live="polite"
          ></div>
        </div>

        <div class="mission-learning-units-selected">
          <h3>Selected units (max 6)</h3>
          <div id="twennie-selected-units" class="mission-learning-units-chips"></div>
        </div>

        <div id="twennie-units-hidden-inputs"></div>
      </section>

      <div class="form-field" style="margin-top: 30px">
        <label>Task Instructions <span style="font-weight: normal; font-size: 0.85em;">(optional)</span></label>
        <p class="form-hint">
          Break the mission into task lists or phases. If it only includes one phase, use only this section. Otherwise, add more. Use a heading for each section and put each instruction on a new line.
        </p>

        <div id="tasks-container">
          {{#if data.task_instructions.length}}
            {{#each data.task_instructions}}
              <div class="dynamic-block task-block">
                <input
                  type="text"
                  name="task_instructions[{{@index}}][heading]"
                  placeholder="Heading (e.g., Scheduling)"
                  value="{{heading}}"
                >
                <textarea
                  name="task_instructions[{{@index}}][instructions]"
                  rows="4"
                  placeholder="Put each instruction on a new line."
                >{{#each instructions}}{{this}}
{{/each}}</textarea>
                <button type="button" class="form-button small-button remove-task">remove section</button>
              </div>
            {{/each}}
          {{else}}
            <div class="dynamic-block task-block">
              <input
                type="text"
                name="task_instructions[0][heading]"
                placeholder="Heading (e.g., Scheduling)"
              >
              <textarea
                name="task_instructions[0][instructions]"
                rows="4"
                placeholder="Put each instruction on a new line."
              ></textarea>
              <button type="button" class="form-button small-button remove-task">remove section</button>
            </div>
          {{/if}}
        </div>

        <button type="button" id="add-task" class="form-button secondary-button">add another section</button>
      </div>

      <div class="form-field">
        <label for="deliverables_checklist">
          Deliverables Checklist
          <span style="font-weight: normal; font-size: 0.85em;">(optional)</span>
        </label>
        <p class="form-hint">
          Put each deliverable on a new line.
        </p>
        <textarea
          id="deliverables_checklist"
          name="deliverables_checklist"
          rows="5"
        >{{#each data.deliverables_checklist}}{{this}}
{{/each}}</textarea>
      </div>

      <div class="form-buttons">
        {{#if data._id}}
          <button
            type="submit"
            name="submit"
            value="edit"
            class="form-button submit-button"
          >
            save edited mission
          </button>
        {{else}}
          <button
            type="submit"
            name="submit"
            value="submit"
            class="form-button submit-button"
          >
            submit mission
          </button>
        {{/if}}
      </div>
    </form>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var tasksContainer = document.getElementById('tasks-container');
    var addTaskBtn = document.getElementById('add-task');

    function getTaskIndex() {
      return tasksContainer.querySelectorAll('.task-block').length;
    }

    if (addTaskBtn) {
      addTaskBtn.addEventListener('click', function () {
        var idx = getTaskIndex();
        var block = document.createElement('div');
        block.className = 'dynamic-block task-block';
        block.innerHTML =
          '<input type="text" name="task_instructions[' + idx + '][heading]" placeholder="Heading (e.g., Scheduling)">' +
          '<textarea name="task_instructions[' + idx + '][instructions]" rows="4" placeholder="Put each instruction on a new line."></textarea>' +
          '<button type="button" class="form-button small-button remove-task">remove section</button>';
        tasksContainer.appendChild(block);
      });
    }

    if (tasksContainer) {
      tasksContainer.addEventListener('click', function (e) {
        if (e.target.classList.contains('remove-task')) {
          var block = e.target.closest('.task-block');
          if (block) block.remove();
        }
      });
    }
  });

  (function () {
    const searchInput = document.getElementById('twennie-unit-search');
    const resultsContainer = document.getElementById('twennie-unit-search-results');
    const selectedContainer = document.getElementById('twennie-selected-units');
    const hiddenInputsContainer = document.getElementById('twennie-units-hidden-inputs');

    if (!searchInput || !resultsContainer || !selectedContainer || !hiddenInputsContainer) {
      return;
    }

    const MAX_UNITS = 6;
    let selectedUnits = [];
    let searchTimeout = null;

    function renderSelectedUnits() {
      selectedContainer.innerHTML = '';
      hiddenInputsContainer.innerHTML = '';

      selectedUnits.forEach((u) => {
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'mission-unit-chip';
        chip.textContent = u.label + ' ✕';
        chip.dataset.value = u.value;

        chip.addEventListener('click', () => {
          selectedUnits = selectedUnits.filter(su => su.value !== u.value);
          renderSelectedUnits();
        });

        selectedContainer.appendChild(chip);

        const hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.name = 'twennie_units[]';
        hidden.value = u.value;
        hiddenInputsContainer.appendChild(hidden);
      });
    }

    function renderResults(results) {
      resultsContainer.innerHTML = '';

      if (!results || !results.length) {
        resultsContainer.style.display = 'none';
        return;
      }

      results.forEach(result => {
        const item = document.createElement('div');
        item.className = 'mission-learning-units-result-item';
        item.textContent = result.label;
        item.dataset.value = result.value;

        item.addEventListener('click', () => {
          const alreadySelected = selectedUnits.some(u => u.value === result.value);

          if (alreadySelected || selectedUnits.length >= MAX_UNITS) {
            resultsContainer.innerHTML = '';
            resultsContainer.style.display = 'none';
            searchInput.value = '';
            return;
          }

          selectedUnits.push({
            value: result.value,
            label: result.label,
            unit_type: result.unit_type,
            unit_id: result.unit_id
          });

          renderSelectedUnits();
          resultsContainer.innerHTML = '';
          resultsContainer.style.display = 'none';
          searchInput.value = '';
        });

        resultsContainer.appendChild(item);
      });

      resultsContainer.style.display = 'block';
    }

    async function performSearch(query) {
      if (query.length < 2) {
        renderResults([]);
        return;
      }

      try {
        const res = await fetch('/search/library-units?q=' + encodeURIComponent(query));
        if (!res.ok) {
          console.error('Search error:', res.statusText);
          return;
        }
        const data = await res.json();
        renderResults(data);
      } catch (err) {
        console.error('Error performing search:', err);
      }
    }

    searchInput.addEventListener('input', function () {
      const query = this.value.trim();

      if (searchTimeout) {
        clearTimeout(searchTimeout);
      }

      searchTimeout = setTimeout(() => {
        performSearch(query);
      }, 250);
    });

    document.addEventListener('click', (evt) => {
      if (!resultsContainer.contains(evt.target) && evt.target !== searchInput) {
        resultsContainer.style.display = 'none';
      }
    });
  })();
</script>

{{> mainpartials/footer}}