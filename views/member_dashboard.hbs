{{#*inline "title"}}Member Dashboard | Twennie{{/inline}}

<div class="dashboard-grid">
  <!-- Sidebar (Left) -->
  <div class="dashboard-sidebar">
    {{> dashboardpartials/member_sidebar }}
  </div>

  <!-- Main Content (Right) -->
  <div class="dashboard-main">

    <!-- Member Tab Navigation -->
    <div class="leader-dashboard-tab-groups">

      <div class="leader-dashboard-tab-groups-row member-dashboard-tab-groups-row" data-tabs-scope="member">

        <!-- LEARNING -->
        <div class="leader-dashboard-tab-group leader-dashboard-tab-group--learning member-dashboard-tab-group member-dashboard-tab-group--learning">
          <h3 class="leader-dashboard-tab-group-title">learning</h3>

          <div class="dashboard-tabs-container member-dashboard-tabs-container member-dashboard-tabs-container--learning">
            <button class="dashboard-tab active" data-tab="prompts" data-count="{{memberCounts.prompts}}">
              <span class="tab-title" style="font-size:1rem; color:#9da0c9">complete a prompt</span>
              {{#if memberBadges.prompts}}<span class="tab-dot"></span>{{/if}}
              <div class="tab-arrow"></div>
            </button>

            <button class="dashboard-tab" data-tab="progress" data-count="{{memberCounts.progress}}">
              <span class="tab-title">prompt set progress and completions</span>
              {{#if memberBadges.progress}}<span class="tab-dot"></span>{{/if}}
              <div class="tab-arrow"></div>
            </button>

            <button class="dashboard-tab" data-tab="tagged" data-count="{{memberCounts.tagged}}">
              <span class="tab-title">my learning and assignments</span>
              {{#if memberBadges.tagged}}<span class="tab-dot"></span>{{/if}}
              <div class="tab-arrow"></div>
            </button>

            <button class="dashboard-tab" data-tab="missions">
              <span class="tab-title">my missions and nuggets</span>
              <div class="tab-arrow"></div>
            </button>

            <button class="dashboard-tab" data-tab="topics">
              <span class="tab-title">my favorite topics</span>
              <div class="tab-arrow"></div>
            </button>
          </div>
        </div>

        <!-- CUSTOM LIBRARY -->
        <div class="leader-dashboard-tab-group leader-dashboard-tab-group--library member-dashboard-tab-group member-dashboard-tab-group--library">
          <h3 class="leader-dashboard-tab-group-title">my custom library content</h3>

          <div class="dashboard-tabs-container member-dashboard-tabs-container member-dashboard-tabs-container--library">
            <button class="dashboard-tab" data-tab="contribute">
              <span class="tab-title">contribute to my library</span>
              <div class="tab-arrow"></div>
            </button>

            <button class="dashboard-tab" data-tab="library" data-count="{{memberCounts.library}}">
              <span class="tab-title">my library contributions</span>
              {{#if memberBadges.library}}<span class="tab-dot"></span>{{/if}}
              <div class="tab-arrow"></div>
            </button>
          </div>
        </div>

        <!-- MEMBERSHIP -->
        <div class="leader-dashboard-tab-group leader-dashboard-tab-group--membership member-dashboard-tab-group member-dashboard-tab-group--membership">
          <h3 class="leader-dashboard-tab-group-title">manage membership</h3>

          <div class="dashboard-tabs-container member-dashboard-tabs-container member-dashboard-tabs-container--membership">
            <button class="dashboard-tab" data-tab="membership">
              <span class="tab-title">membership overview</span>
              <div class="tab-arrow"></div>
            </button>

            <button class="dashboard-tab" data-tab="group">
              <span class="tab-title">my group</span>
              <div class="tab-arrow"></div>
            </button>
          </div>
        </div>

      </div>
    </div>

    <!-- Right Topics Column -->
    <div class="dashboard-page">
      {{> topicpartials/topics_column_partial}}
    </div>

    <!-- Tab Content -->
    <div class="dashboard-tab-content" id="membership">
      {{> dashboardpartials/member_membership }}
    </div>

    <div class="dashboard-tab-content" id="topics">
      {{> dashboardpartials/member_topics }}
    </div>

    <div class="dashboard-tab-content active" id="prompts">
      {{#if registeredPromptSets.length}}

        {{#each registeredPromptSets}}
          <section class="member-prompt-section">
            {{> dashboardpartials/member_prompt
                promptSet=this
                promptSchedule=(lookup ../promptSchedules @index)
                csrfToken=../csrfToken
            }}
          </section>
        {{/each}}

      {{else}}

        <section class="member-prompt-section">
          {{> dashboardpartials/member_prompt
              promptSet=null
              promptSchedule=null
              csrfToken=csrfToken
          }}
        </section>

      {{/if}}
    </div>

    <div class="dashboard-tab-content" id="progress">
      {{> dashboardpartials/member_progress
          currentPromptSets=currentPromptSets
          completedPromptSets=completedPromptSets
          csrfToken=csrfToken }}
    </div>

    <div class="dashboard-tab-content" id="tagged">
      {{> dashboardpartials/member_tagged_units }}
    </div>

    <div class="dashboard-tab-content" id="missions">
      {{> dashboardpartials/member_missions }}
    </div>

    <div class="dashboard-tab-content" id="contribute">
      {{> dashboardpartials/member_contribution }}
    </div>

    <div class="dashboard-tab-content" id="library">
      {{> dashboardpartials/member_mylibraryunits }}
    </div>

    <div class="dashboard-tab-content" id="group">
      {{> dashboardpartials/member_group }}
    </div>

  </div>
</div>

<script>
  (function () {
    const scopeRoot = document.querySelector('[data-tabs-scope="member"]');
    if (!scopeRoot) return;

    const tabs = Array.from(scopeRoot.querySelectorAll('.dashboard-tab[data-tab]'));
    const panels = Array.from(document.querySelectorAll('.dashboard-tab-content'));

    function setActive(tabId) {
      tabs.forEach(tab => tab.classList.toggle('active', tab.dataset.tab === tabId));
      panels.forEach(panel => panel.classList.toggle('active', panel.id === tabId));
    }

    async function markSeenMember(tab, count) {
      try {
        await fetch('/dashboard/member/mark-seen', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': '{{csrfToken}}'
          },
          body: JSON.stringify({ tab, count: Number(count || 0), _csrf: '{{csrfToken}}' })
        });
      } catch (e) { /* no-op */ }
    }

    tabs.forEach(btn => {
      btn.addEventListener('click', () => {
        const tab = btn.dataset.tab;
        const count = btn.dataset.count || 0;

        setActive(tab);

        if (['prompts','progress','library','tagged'].includes(tab)) {
          markSeenMember(tab, count);
          const dot = btn.querySelector('.tab-dot');
          if (dot) dot.style.display = 'none';
        }
      });
    });

    const preActive = tabs.find(t => t.classList.contains('active')) || tabs[0];
    if (preActive) setActive(preActive.dataset.tab);
  })();
</script>




