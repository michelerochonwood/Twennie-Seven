<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Page title -->
  <title>{{title}}</title>

  {{!-- Google Consent Mode defaults --}}
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }

    gtag('consent', 'default', {
      security_storage: 'granted',
      functionality_storage: {{#if consent.functional}}"granted"{{else}}"denied"{{/if}},
      analytics_storage: {{#if consent.analytics}}"granted"{{else}}"denied"{{/if}},
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied"
    });
  </script>

  {{!-- Google Analytics 4 --}}
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-4F1QSZP0ZK"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }

    gtag('js', new Date());
    gtag('config', 'G-4F1QSZP0ZK');
  </script>

  <!-- Global Navigation Styles -->
  <link rel="stylesheet" href="https://www.twennie.com/css/navigation.css?v={{timestamp}}">

  <!-- Unit Form Styles -->
  <link rel="stylesheet" href="https://www.twennie.com/css/unitformstyles.css?v={{timestamp}}">
    <link rel="stylesheet" href="https://www.twennie.com/css/profilestyles.css?v={{timestamp}}">

  <!-- Mobile Navigation Script -->
  <script src="https://www.twennie.com/javascript/mobile-nav.js?v={{timestamp}}" defer></script>

  <!-- Ionicons -->
  <script type="module" src="https://cdn.jsdelivr.net/npm/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
  <script nomodule src="https://cdn.jsdelivr.net/npm/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>

  <!-- Quill Editor -->
  <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
  <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
</head>

<body class="main-body" style="margin-bottom: 200px">

  {{> mainpartials/header}}

  <!-- Main content -->
  {{{body}}}

  <footer>
    {{> mainpartials/footer}}
  </footer>

  {{> mainpartials/cookie_banner}}

</body>
</html>
