<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{{#if title}}{{title}} - Twennie Dashboard{{else}}Twennie Dashboard{{/if}}</title>

  {{!-- (Optional) FOUC blocker: uncomment if needed --}}
  {{!-- <style>html.fouc body{visibility:hidden;}</style>
  <script>document.documentElement.classList.add('fouc');</script> --}}

  {{!-- Google Consent Mode defaults --}}
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }

    gtag('consent', 'default', {
      security_storage: 'granted',
      functionality_storage: {{#if consent.functional}}"granted"{{else}}"denied"{{/if}},
      analytics_storage: {{#if consent.analytics}}"granted"{{else}}"denied"{{/if}},
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied"
    });
  </script>

  {{!-- Google Analytics 4 --}}
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-4F1QSZP0ZK"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }

    gtag('js', new Date());
    gtag('config', 'G-4F1QSZP0ZK');
  </script>

  {{!-- CSS --}}
  <link rel="preload" href="/css/navigation.css?v={{timestamp}}" as="style">
  <link rel="stylesheet" href="/css/navigation.css?v={{timestamp}}">

  <link rel="preload" href="/css/dashboardstyles.css?v={{timestamp}}" as="style">
  <link rel="stylesheet" href="/css/dashboardstyles.css?v={{timestamp}}">

  <link rel="preload" href="/css/mainstyles.css?v={{timestamp}}" as="style">
  <link rel="stylesheet" href="/css/mainstyles.css?v={{timestamp}}">

  {{!-- Mobile Navigation Script --}}
  <script src="/javascript/mobile-nav.js?v={{timestamp}}" defer></script>

  {{!-- Ionicons --}}
  <script type="module" src="https://cdn.jsdelivr.net/npm/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
  <script nomodule src="https://cdn.jsdelivr.net/npm/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>

  {{!-- (Optional) FOUC blocker end: uncomment if needed --}}
  {{!-- <script>
    window.addEventListener('load', () => {
      document.documentElement.classList.remove('fouc');
    });
  </script> --}}
</head>

<body class="dashboard-body" style="margin-bottom: 200px">
  {{> mainpartials/header}}

  <main class="main-content">
    {{#if error}}
      <div class="dashboard-alert error">{{error}}</div>
    {{/if}}

    {{#if message}}
      <div class="dashboard-alert success">{{message}}</div>
    {{/if}}

    {{{body}}}
  </main>

  <!-- Dashboard Scripts with Cache-Busting -->
  <script src="/javascript/animation/progresspies.js?v={{timestamp}}"></script>
  <script src="/javascript/dashboard_cont.js?v={{timestamp}}"></script>
  <script src="/javascript/prompts/unregister.js?v={{timestamp}}"></script>
  <script src="/javascript/dashboard/dashboard_tabs.js?v={{timestamp}}"></script>
  <script src="/javascript/dashboard/topicdashboard.js?v={{timestamp}}"></script>

  <!-- External library -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <script>
    (function () {
      const rail = document.querySelector('.topic-sidebar');
      if (!rail) return;

      const path = location.pathname.replace(/\/+$/, '').toLowerCase();
      rail.querySelectorAll('a[href]').forEach(a => {
        let href = a.getAttribute('href');
        if (!href) return;
        href = href.replace(/\/+$/, '').toLowerCase();
        if (href === path) {
          a.setAttribute('aria-current', 'page');
          a.querySelector('.sidebar-item')?.classList.add('is-active');
        }
      });
    })();
  </script>

  <footer>
    {{> mainpartials/footer}}
  </footer>

  {{> mainpartials/cookie_banner}}
</body>
</html>
