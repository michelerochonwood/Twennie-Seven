<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="robots"
    content="noindex, nofollow"
  >

  <title>{{#if title}}{{title}} | Twennie Admin{{else}}Twennie Admin{{/if}}</title>

  {{!-- Global Twennie styles used for fonts, resets, and shared elements --}}
  <link
    rel="stylesheet"
    href="https://www.twennie.com/css/grandpoobaastyles.css?v={{timestamp}}"
  >

  {{!-- Grand Poobaa administrative styles --}}
  <link
    rel="stylesheet"
    href="https://www.twennie.com/css/grand-poobaa.css?v={{timestamp}}"
  >

  {{!-- Ionicons --}}
  <script
    type="module"
    src="https://cdn.jsdelivr.net/npm/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"
  ></script>

  <script
    nomodule
    src="https://cdn.jsdelivr.net/npm/ionicons@7.1.0/dist/ionicons/ionicons.js"
  ></script>

  {{!-- Page-specific stylesheet, when needed --}}
  {{#if pageStylesheet}}
    <link
      rel="stylesheet"
      href="https://www.twennie.com/css/{{pageStylesheet}}?v={{timestamp}}"
    >
  {{/if}}
</head>

<body class="grand-poobaa-body">

  <div class="grand-poobaa-shell">

    {{> grandpoobaapartials/admin_sidebar}}

    <div class="grand-poobaa-main">

      {{> grandpoobaapartials/admin_header}}

      <main class="grand-poobaa-content" id="main-content">
        {{{body}}}
      </main>

    </div>

  </div>

  <script
    src="https://cdn.jsdelivr.net/npm/sweetalert2@11"
  ></script>

  <script
    src="https://www.twennie.com/javascript/grand-poobaa.js?v={{timestamp}}"
    defer
  ></script>

  {{!-- Optional JavaScript for an individual admin page --}}
  {{#if pageScript}}
    <script
      src="https://www.twennie.com/javascript/{{pageScript}}?v={{timestamp}}"
      defer
    ></script>
  {{/if}}

</body>
</html>