{{#*inline "title"}}Leader Dashboard | Twennie{{/inline}}

<div class="dashboard-grid">
  <!-- Sidebar (Left) -->
  <div class="dashboard-sidebar">
    {{> dashboardpartials/leader_sidebar }}
  </div>

  <!-- Main Content (Right) -->
  <div class="dashboard-main has-right-rail">

    {{!-- =========================================================
         ADMIN MODE TOGGLE (admins only)
         - Show ONLY in admin mode here
    ========================================================= --}}
    {{#if leader.isAdmin}}
      {{#if adminMode}}
        <div class="dashboard-admin-toggle leader-dashboard-admin-switch">
          <a class="dashboard-tab" href="/dashboard/leader" style="text-decoration:none;">
            <span class="tab-title">← back to leader dashboard</span>
            <div class="tab-arrow"></div>
          </a>
        </div>
      {{/if}}
    {{/if}}

    {{!-- =========================================================
         ADMIN MODE VIEW
         - JS tabs (no reload)
         - IMPORTANT: render ALL panels; show/hide with .active
    ========================================================= --}}
    {{#if adminMode}}
      {{#if leader.isAdmin}}

        <!-- Admin Tab Navigation -->
        <div class="dashboard-tabs-container dashboard-tabs-container--admin" data-tabs-scope="admin">

          <button
            class="dashboard-tab {{#if (eq adminTab "groups-leaders")}}active{{/if}}"
            type="button"
            data-tab="admin-groups-leaders"
            data-href="/dashboard/leader/org-admin/groups-leaders"
          >
            <span class="tab-title">my groups and leaders</span>
            <div class="tab-arrow"></div>
          </button>

          <button
            class="dashboard-tab {{#if (eq adminTab "my-organization")}}active{{/if}}"
            type="button"
            data-tab="admin-my-organization"
            data-href="/dashboard/leader/org-admin/my-organization"
          >
            <span class="tab-title">my organization stats</span>
            <div class="tab-arrow"></div>
          </button>

          <button
            class="dashboard-tab {{#if (eq adminTab "requests")}}active{{/if}}"
            type="button"
            data-tab="admin-requests"
            data-href="/dashboard/leader/org-admin/requests"
          >
            <span class="tab-title">requests from leaders to join</span>
            <div class="tab-arrow"></div>
          </button>

          <button
            class="dashboard-tab {{#if (eq adminTab "suggestions")}}active{{/if}}"
            type="button"
            data-tab="admin-suggestions"
            data-href="/dashboard/leader/org-admin/suggestions"
          >
            <span class="tab-title">learning suggestions</span>
            <div class="tab-arrow"></div>
          </button>

          <button
            class="dashboard-tab {{#if (eq adminTab "company-library")}}active{{/if}}"
            type="button"
            data-tab="admin-company-library"
            data-href="/dashboard/leader/org-admin/company-library"
          >
            <span class="tab-title">organization's library units</span>
            <div class="tab-arrow"></div>
          </button>

          <button
            class="dashboard-tab {{#if (eq adminTab "reports")}}active{{/if}}"
            type="button"
            data-tab="admin-reports"
            data-href="/dashboard/leader/org-admin/reports"
          >
            <span class="tab-title">organization's reports</span>
            <div class="tab-arrow"></div>
          </button>
        </div>

        <!-- Admin Content Panels -->
        <div class="leader-admin-panel" data-panels-scope="admin">

          <div
            class="dashboard-tab-content admin-tab-content {{#if (eq adminTab "my-organization")}}active{{/if}}"
            id="admin-my-organization"
          >
            {{> dashboardpartials/admin_myorganization }}
          </div>

          <div
            class="dashboard-tab-content admin-tab-content {{#if (eq adminTab "groups-leaders")}}active{{/if}}"
            id="admin-groups-leaders"
          >
            {{> dashboardpartials/admin_groupsleaders }}
          </div>

          <div
            class="dashboard-tab-content admin-tab-content {{#if (eq adminTab "requests")}}active{{/if}}"
            id="admin-requests"
          >
            {{> dashboardpartials/admin_requests }}
          </div>

          <div
            class="dashboard-tab-content admin-tab-content {{#if (eq adminTab "suggestions")}}active{{/if}}"
            id="admin-suggestions"
          >
            {{> dashboardpartials/admin_suggestions }}
          </div>

          <div
            class="dashboard-tab-content admin-tab-content {{#if (eq adminTab "company-library")}}active{{/if}}"
            id="admin-company-library"
          >
            {{> dashboardpartials/admin_companylibrary }}
          </div>

          <div
            class="dashboard-tab-content admin-tab-content {{#if (eq adminTab "reports")}}active{{/if}}"
            id="admin-reports"
          >
            {{> dashboardpartials/admin_reports }}
          </div>

        </div>

      {{/if}}

    {{!-- =========================================================
         LEADER MODE VIEW (default)
    ========================================================= --}}
    {{else}}

      <!-- Leader Tab Navigation -->
      <div class="leader-dashboard-tab-groups">

        {{#if leader.isAdmin}}
          <div class="leader-dashboard-admin-switch">
            <a class="dashboard-tab" href="/dashboard/leader/org-admin/my-organization" style="text-decoration:none;">
              <span class="tab-title">switch to admin dashboard</span>
              <div class="tab-arrow"></div>
            </a>
          </div>
        {{/if}}

        <div class="leader-dashboard-tab-groups-row" data-tabs-scope="leader">

          <!-- LEARNING -->
          <div class="leader-dashboard-tab-group leader-dashboard-tab-group--learning">
            <h3 class="leader-dashboard-tab-group-title">learning</h3>

            <div class="dashboard-tabs-container">

               <button class="dashboard-tab" type="button" data-tab="prompts" data-count="{{leaderCounts.prompts}}">
                <span class="tab-title" style="font-size:1rem; color:#9da0c9">complete a prompt</span>
                {{#if leaderBadges.prompts}}<span class="tab-dot"></span>{{/if}}
                <div class="tab-arrow"></div>
              </button>



              <button class="dashboard-tab" type="button" data-tab="progress" data-count="{{leaderCounts.progress}}">
                <span class="tab-title">group prompt set progress and completions</span>
                {{#if leaderBadges.progress}}<span class="tab-dot"></span>{{/if}}
                <div class="tab-arrow"></div>
              </button>

              <button class="dashboard-tab" type="button" data-tab="tagged" data-count="{{leaderCounts.tagged}}">
                <span class="tab-title">my group's learning and assignments</span>
                {{#if leaderBadges.tagged}}<span class="tab-dot"></span>{{/if}}
                <div class="tab-arrow"></div>
              </button>

              <button class="dashboard-tab" type="button" data-tab="missions" data-count="{{leaderCounts.missions}}">
                <span class="tab-title">my group's missions</span>
                {{#if leaderBadges.missions}}<span class="tab-dot"></span>{{/if}}
                <div class="tab-arrow"></div>
              </button>

              <button class="dashboard-tab" type="button" data-tab="topics" data-count="{{leaderCounts.topics}}">
                <span class="tab-title">my favorite topics</span>
                {{#if leaderBadges.topics}}<span class="tab-dot"></span>{{/if}}
                <div class="tab-arrow"></div>
              </button>
            </div>
          </div>

          <!-- CUSTOM LIBRARY -->
          <div class="leader-dashboard-tab-group leader-dashboard-tab-group--library">
            <h3 class="leader-dashboard-tab-group-title">my custom library content</h3>

            <div class="dashboard-tabs-container">
              <button class="dashboard-tab" type="button" data-tab="contribute">
                <span class="tab-title">contribute to my library</span>
                <div class="tab-arrow"></div>
              </button>

              <button class="dashboard-tab" type="button" data-tab="library" data-count="{{leaderCounts.library}}">
                <span class="tab-title">my library contributions</span>
                {{#if leaderBadges.library}}<span class="tab-dot"></span>{{/if}}
                <div class="tab-arrow"></div>
              </button>
            </div>
          </div>

          <!-- MEMBERSHIP -->
          <div class="leader-dashboard-tab-group leader-dashboard-tab-group--membership">
            <h3 class="leader-dashboard-tab-group-title">manage memberships</h3>

            <div class="dashboard-tabs-container">
              <button class="dashboard-tab active" type="button" data-tab="membership">
                <span class="tab-title">membership overview</span>
                <div class="tab-arrow"></div>
              </button>

              <button class="dashboard-tab" type="button" data-tab="group" data-count="{{leaderCounts.group}}">
                <span class="tab-title">my group members</span>
                {{#if leaderBadges.group}}<span class="tab-dot"></span>{{/if}}
                <div class="tab-arrow"></div>
              </button>
            </div>
          </div>

        </div>
      </div>

      <!-- Right Topics Column -->
      <div class="dashboard-page">
        {{> topicpartials/topics_column_partial}}
      </div>

      <!-- Leader Panels -->
      <div class="dashboard-tab-content active" id="membership">
        {{> dashboardpartials/leader_membership }}
      </div>

      <div class="dashboard-tab-content" id="topics">
        {{> dashboardpartials/leader_topics }}
      </div>

      <div class="dashboard-tab-content" id="group">
        {{> dashboardpartials/leader_group }}
      </div>

      <div class="dashboard-tab-content" id="prompts">
        {{#each registeredPromptSets}}
          <section class="leader-prompt-section">
            {{> dashboardpartials/leader_prompt
                promptSet=this
                csrfToken=../csrfToken
                assignedPromptCards=../assignedPromptCards
            }}
          </section>
        {{/each}}
      </div>

      <div class="dashboard-tab-content" id="progress">
        {{> dashboardpartials/leader_progress }}
      </div>

      <div class="dashboard-tab-content" id="tagged">
        {{> dashboardpartials/leader_tagged_units }}
      </div>

      <div class="dashboard-tab-content" id="missions">
        {{> dashboardpartials/leader_missions }}
      </div>

      <div class="dashboard-tab-content" id="contribute">
        {{> dashboardpartials/leader_contribution }}
      </div>

      <div class="dashboard-tab-content" id="library">
        {{> dashboardpartials/leader_mylibraryunits }}
      </div>

    {{/if}}

    {{!-- =========================================================
         ONE TAB SCRIPT (handles leader + admin, safely scoped)
    ========================================================= --}}
    <script>
      (function () {
        function initTabs(scopeName) {
          const scopeRoot = document.querySelector(`[data-tabs-scope="${scopeName}"]`);
          const panelsScope = document.querySelector(`[data-panels-scope="${scopeName}"]`);
          const panelRoot = panelsScope || document;

          if (!scopeRoot) return;

          const tabs = Array.from(scopeRoot.querySelectorAll('.dashboard-tab[data-tab]'));
          if (!tabs.length) return;

          function setActive(tabId) {
            tabs.forEach(t => t.classList.toggle('active', t.dataset.tab === tabId));

            const panels = Array.from(panelRoot.querySelectorAll('.dashboard-tab-content'));
            panels.forEach(p => p.classList.toggle('active', p.id === tabId));
          }

          tabs.forEach(btn => {
            btn.addEventListener('click', () => {
              const tabId = btn.dataset.tab;
              const href = btn.dataset.href;

              if (scopeName === 'admin' && href) {
                window.location.href = href;
                return;
              }

              setActive(tabId);
            });
          });

          const preActive = tabs.find(t => t.classList.contains('active')) || tabs[0];
          if (preActive) setActive(preActive.dataset.tab);
        }

        document.addEventListener('DOMContentLoaded', () => {
          initTabs('admin');
          initTabs('leader');
        });
      })();
    </script>

    <!-- 
    ✅ OPTIONAL: tiny client script (so the "thanks!" button works)
    Put this in the leader dashboard page script area.
    It assumes your thanks button has: data-suggestion-id="{{_id}}"
    -->
    <script>
      async function leaderThanksSuggestion(btn) {
        const id = btn?.dataset?.suggestionId;
        if (!id) return;

        btn.disabled = true;

        try {
          const csrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
          const res = await fetch(`/dashboard/leader/suggestions/${id}/thanks`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', ...(csrf ? { 'X-CSRF-Token': csrf } : {}) }
          });
          const data = await res.json().catch(() => ({}));

          if (!res.ok || !data.ok) {
            btn.disabled = false;
            alert(data.message || 'Could not save. Please try again.');
            return;
          }

          location.reload();
        } catch (e) {
          console.error(e);
          btn.disabled = false;
          alert('Could not save. Please try again.');
        }
      }

      document.addEventListener('click', (e) => {
        const btn = e.target.closest('button[data-suggestion-id]');
        if (!btn) return;
        if (btn.textContent.trim().toLowerCase() !== 'thanks!') return;
        leaderThanksSuggestion(btn);
      });
    </script>

    {{!-- =========================================================
         LEADER "MARK SEEN" SCRIPT (leader mode only)
         - safe: only binds if leader tab buttons exist
    ========================================================= --}}
    {{#unless adminMode}}
      <script>
        async function markSeenLeader(tab, count) {
          try {
            await fetch('/dashboard/leader/mark-seen', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'x-csrf-token': '{{csrfToken}}'
              },
              body: JSON.stringify({ tab, count: Number(count || 0) })
            });
          } catch (e) { /* no-op */ }
        }

        document.addEventListener('DOMContentLoaded', () => {
          document.querySelectorAll('[data-tabs-scope="leader"] .dashboard-tab[data-tab]').forEach(btn => {
            btn.addEventListener('click', () => {
              const tab = btn.dataset.tab;
              const count = btn.dataset.count || 0;

              if (['group','topics','prompts','progress','library','tagged','missions'].includes(tab)) {
                markSeenLeader(tab, count);
                const dot = btn.querySelector('.tab-dot');
                if (dot) dot.style.display = 'none';
              }
            });
          });
        });
      </script>
    {{/unless}}

  </div>
</div>