{{!-- =========================================================
     ONE TAB SCRIPT
     - Handles leader + admin tabs
     - Admin green-dot / mark-seen logic removed
========================================================= --}}
<script>
  (function () {
    function initTabs(scopeName) {
      const scopeRoot = document.querySelector(`[data-tabs-scope="${scopeName}"]`);
      const panelsScope = document.querySelector(`[data-panels-scope="${scopeName}"]`);
      const panelRoot = panelsScope || document;

      if (!scopeRoot) return;

      const tabs = Array.from(scopeRoot.querySelectorAll('.dashboard-tab[data-tab]'));
      if (!tabs.length) return;

      function getPanelId(tab) {
        return tab.dataset.panel || tab.dataset.tab;
      }

      function setActive(tabId) {
        const activeTab = tabs.find(t => t.dataset.tab === tabId);
        const activePanelId = activeTab ? getPanelId(activeTab) : tabId;

        tabs.forEach(t => {
          t.classList.toggle('active', t.dataset.tab === tabId);
        });

        const panels = Array.from(panelRoot.querySelectorAll('.dashboard-tab-content'));
        panels.forEach(p => {
          p.classList.toggle('active', p.id === activePanelId);
        });
      }

      tabs.forEach(btn => {
        btn.addEventListener('click', () => {
          const tabId = btn.dataset.tab;
          const href = btn.dataset.href;

          if (scopeName === 'admin' && href) {
            window.location.href = href;
            return;
          }

          setActive(tabId);
        });
      });

      const preActive = tabs.find(t => t.classList.contains('active')) || tabs[0];
      if (preActive) setActive(preActive.dataset.tab);
    }

    document.addEventListener('DOMContentLoaded', () => {
      initTabs('admin');
      initTabs('leader');
    });
  })();
</script>

    <!-- 
    ✅ OPTIONAL: tiny client script (so the "thanks!" button works)
    Put this in the leader dashboard page script area.
    It assumes your thanks button has: data-suggestion-id="{{_id}}"
    -->
    <script>
      async function leaderThanksSuggestion(btn) {
        const id = btn?.dataset?.suggestionId;
        if (!id) return;

        btn.disabled = true;

        try {
          const csrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
          const res = await fetch(`/dashboard/leader/suggestions/${id}/thanks`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', ...(csrf ? { 'X-CSRF-Token': csrf } : {}) }
          });
          const data = await res.json().catch(() => ({}));

          if (!res.ok || !data.ok) {
            btn.disabled = false;
            alert(data.message || 'Could not save. Please try again.');
            return;
          }

          location.reload();
        } catch (e) {
          console.error(e);
          btn.disabled = false;
          alert('Could not save. Please try again.');
        }
      }

      document.addEventListener('click', (e) => {
        const btn = e.target.closest('button[data-suggestion-id]');
        if (!btn) return;
        if (btn.textContent.trim().toLowerCase() !== 'thanks!') return;
        leaderThanksSuggestion(btn);
      });
    </script>

    {{!-- =========================================================
         LEADER "MARK SEEN" SCRIPT (leader mode only)
         - safe: only binds if leader tab buttons exist
    ========================================================= --}}
{{#unless adminMode}}
  <script>
    (function () {
      const seenTabs = [
        'group',
        'topics',
        'prompts',
        'progress',
        'library',
        'tagged',
        'missions'
      ];

      async function markSeenLeader(tabKey, currentCount) {
        if (!seenTabs.includes(tabKey)) return false;

        try {
          const response = await fetch('/dashboard/leader/mark-seen', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': '{{csrfToken}}'
            },
            body: JSON.stringify({
              tab: tabKey,
              count: Number(currentCount || 0)
            })
          });

          return response.ok;
        } catch (e) {
          console.error('[leader dashboard] mark seen failed:', e);
          return false;
        }
      }

      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('[data-tabs-scope="leader"] .dashboard-tab[data-tab]').forEach(btn => {
          btn.addEventListener('click', async () => {
            const tabKey = btn.dataset.tab;
            const currentCount = btn.dataset.count || 0;

            const saved = await markSeenLeader(tabKey, currentCount);

            if (saved) {
              const dot = btn.querySelector('.tab-dot');
              if (dot) dot.remove();
            }
          });
        });
      });
    })();
  </script>
{{/unless}}

