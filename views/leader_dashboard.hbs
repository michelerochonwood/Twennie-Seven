{{#*inline "title"}}Leader Dashboard | Twennie{{/inline}}

<div class="dashboard-grid">
  <!-- Sidebar (Left) -->
  <div class="dashboard-sidebar">
    {{> dashboardpartials/leader_sidebar }}
  </div>

  <!-- Main Content (Right) -->
  <div class="dashboard-main has-right-rail">

    {{!-- =========================================================
         ADMIN MODE TOGGLE (admins only)
         - Visible only if leader.isAdmin is true
         - Switches between leader mode and admin mode
    ========================================================= --}}
    {{#if leader.isAdmin}}
      <div class="dashboard-admin-toggle" style="display:flex; justify-content:flex-end; margin-bottom: 0.75rem;">
        {{#if adminMode}}
          <a class="dashboard-tab" href="/dashboard/leader" style="text-decoration:none;">
            <span class="tab-title">← back to leader dashboard</span>
            <div class="tab-arrow"></div>
          </a>
        {{else}}
          <a class="dashboard-tab" href="/dashboard/leader/org-admin/my-organization" style="text-decoration:none;">
            <span class="tab-title">organization admin</span>
            <div class="tab-arrow"></div>
          </a>
        {{/if}}
      </div>
    {{/if}}

    {{!-- =========================================================
         ADMIN MODE VIEW
         - Shows admin tabs + admin content ONLY
         - Hides leader tabs/content entirely
    ========================================================= --}}
    {{#if adminMode}}
      {{#if leader.isAdmin}}

<!-- Admin Tab Navigation (JS tabs, no page reload) -->
<div class="dashboard-tabs-container dashboard-tabs-container--admin">

  <button class="dashboard-tab {{#if (eq adminTab "my-organization")}}active{{/if}}"
          type="button"
          data-admin-tab="my-organization"
          data-admin-href="/dashboard/leader/org-admin/my-organization">
    <span class="tab-title">my organization</span>
    <div class="tab-arrow"></div>
  </button>

  <button class="dashboard-tab {{#if (eq adminTab "groups-leaders")}}active{{/if}}"
          type="button"
          data-admin-tab="groups-leaders"
          data-admin-href="/dashboard/leader/org-admin/groups-leaders">
    <span class="tab-title">my groups and leaders</span>
    <div class="tab-arrow"></div>
  </button>

  <button class="dashboard-tab {{#if (eq adminTab "requests")}}active{{/if}}"
          type="button"
          data-admin-tab="requests"
          data-admin-href="/dashboard/leader/org-admin/requests">
    <span class="tab-title">requests to join</span>
    <div class="tab-arrow"></div>
  </button>

  <button class="dashboard-tab {{#if (eq adminTab "suggestions")}}active{{/if}}"
          type="button"
          data-admin-tab="suggestions"
          data-admin-href="/dashboard/leader/org-admin/suggestions">
    <span class="tab-title">learning suggestions</span>
    <div class="tab-arrow"></div>
  </button>

  <button class="dashboard-tab {{#if (eq adminTab "company-library")}}active{{/if}}"
          type="button"
          data-admin-tab="company-library"
          data-admin-href="/dashboard/leader/org-admin/company-library">
    <span class="tab-title">company library units</span>
    <div class="tab-arrow"></div>
  </button>

  <button class="dashboard-tab {{#if (eq adminTab "reports")}}active{{/if}}"
          type="button"
          data-admin-tab="reports"
          data-admin-href="/dashboard/leader/org-admin/reports">
    <span class="tab-title">organization reports</span>
    <div class="tab-arrow"></div>
  </button>

</div>


<!-- Admin Content Panels (JS toggles .active like leader tabs) -->
<div class="leader-admin-panel">

  <div class="dashboard-tab-content admin-tab-content {{#if (eq adminTab "my-organization")}}active{{/if}}"
       id="admin-my-organization">
    {{> dashboardpartials/admin_myorganization }}
  </div>

  <div class="dashboard-tab-content admin-tab-content {{#if (eq adminTab "groups-leaders")}}active{{/if}}"
       id="admin-groups-leaders">
    {{> dashboardpartials/admin_groupsleaders }}
  </div>

  <div class="dashboard-tab-content admin-tab-content {{#if (eq adminTab "requests")}}active{{/if}}"
       id="admin-requests">
    {{> dashboardpartials/admin_requests }}
  </div>

  <div class="dashboard-tab-content admin-tab-content {{#if (eq adminTab "suggestions")}}active{{/if}}"
       id="admin-suggestions">
    {{> dashboardpartials/admin_suggestions }}
  </div>

  <div class="dashboard-tab-content admin-tab-content {{#if (eq adminTab "company-library")}}active{{/if}}"
       id="admin-company-library">
    {{> dashboardpartials/admin_companylibrary }}
  </div>

  <div class="dashboard-tab-content admin-tab-content {{#if (eq adminTab "reports")}}active{{/if}}"
       id="admin-reports">
    {{> dashboardpartials/admin_reports }}
  </div>

</div>
<script>
  // Admin tabs (no page reload)
  document.querySelectorAll('.dashboard-tab[data-admin-tab]').forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = btn.dataset.adminTab;

      // Toggle active state on admin tab buttons
      document.querySelectorAll('.dashboard-tab[data-admin-tab]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      // Toggle active state on admin content panels
      document.querySelectorAll('.admin-tab-content').forEach(p => p.classList.remove('active'));
      const panel = document.getElementById(`admin-${tab}`);
      if (panel) panel.classList.add('active');

      // Update URL without navigation (nice UX)
      const href = btn.dataset.adminHref;
      if (href && window.history && window.history.replaceState) {
        window.history.replaceState({}, '', href);
      }
    });
  });
</script>


      {{/if}}
    {{!-- =========================================================
         LEADER MODE VIEW (default)
         - Your existing smooth JS tabs
    ========================================================= --}}
    {{else}}

      <!-- Tab Navigation -->
      <div class="dashboard-tabs-container">
        <!-- 1) Membership overview -->
        <button class="dashboard-tab active" data-tab="membership">
          <span class="tab-title">membership overview</span>
          <div class="tab-arrow"></div>
        </button>

        <!-- 2) My favorite topics -->
        <button class="dashboard-tab" data-tab="topics" data-count="{{leaderCounts.topics}}">
          <span class="tab-title">my favorite topics</span>
          {{#if leaderBadges.topics}}<span class="tab-dot"></span>{{/if}}
          <div class="tab-arrow"></div>
        </button>

        <!-- 3) My group members -->
        <button class="dashboard-tab" data-tab="group" data-count="{{leaderCounts.group}}">
          <span class="tab-title">my group members</span>
          {{#if leaderBadges.group}}<span class="tab-dot"></span>{{/if}}
          <div class="tab-arrow"></div>
        </button>

        <!-- 4) Registered prompt sets -->
        <button class="dashboard-tab" data-tab="prompts" data-count="{{leaderCounts.prompts}}">
          <span class="tab-title">registered prompt sets</span>
          {{#if leaderBadges.prompts}}<span class="tab-dot"></span>{{/if}}
          <div class="tab-arrow"></div>
        </button>

        <!-- 5) Prompt set progress & completions -->
        <button class="dashboard-tab" data-tab="progress" data-count="{{leaderCounts.progress}}">
          <span class="tab-title">prompt set progress and completions</span>
          {{#if leaderBadges.progress}}<span class="tab-dot"></span>{{/if}}
          <div class="tab-arrow"></div>
        </button>

        <!-- 6) My tags and assignments -->
        <button class="dashboard-tab" data-tab="tagged" data-count="{{leaderCounts.tagged}}">
          <span class="tab-title">my team's learning and assignments</span>
          {{#if leaderBadges.tagged}}<span class="tab-dot"></span>{{/if}}
          <div class="tab-arrow"></div>
        </button>

        <!-- ✅ Missions -->
        <button class="dashboard-tab" data-tab="missions" data-count="{{leaderCounts.missions}}">
          <span class="tab-title">my team's missions</span>
          {{#if leaderBadges.missions}}<span class="tab-dot"></span>{{/if}}
          <div class="tab-arrow"></div>
        </button>

        <!-- 7) Contribute to the library -->
        <button class="dashboard-tab" data-tab="contribute">
          <span class="tab-title">contribute to my library</span>
          <div class="tab-arrow"></div>
        </button>

        <!-- 8) My library units -->
        <button class="dashboard-tab" data-tab="library" data-count="{{leaderCounts.library}}">
          <span class="tab-title">my library units</span>
          {{#if leaderBadges.library}}<span class="tab-dot"></span>{{/if}}
          <div class="tab-arrow"></div>
        </button>
      </div>

      <!-- Right Topics Column (fixed; reused partial) -->
      <div class="dashboard-page">
        {{> topicpartials/topics_column_partial}}
      </div>

      <!-- Tab Content -->
      <div class="dashboard-tab-content active" id="membership">
        {{> dashboardpartials/leader_membership }}
      </div>

      <div class="dashboard-tab-content" id="topics">
        {{> dashboardpartials/leader_topics }}
      </div>

      <div class="dashboard-tab-content" id="group">
        {{> dashboardpartials/leader_group }}
      </div>

      <div class="dashboard-tab-content" id="prompts">
        {{#each registeredPromptSets}}
          <section class="leader-prompt-section">
            {{> dashboardpartials/leader_prompt
                promptSet=this
                csrfToken=../csrfToken
                assignedPromptCards=../assignedPromptCards
            }}
          </section>
        {{/each}}
      </div>

      <div class="dashboard-tab-content" id="progress">
        {{> dashboardpartials/leader_progress }}
      </div>

      <div class="dashboard-tab-content" id="tagged">
        {{> dashboardpartials/leader_tagged_units }}
      </div>

      <div class="dashboard-tab-content" id="missions">
        {{> dashboardpartials/leader_missions }}
      </div>

      <div class="dashboard-tab-content" id="contribute">
        {{> dashboardpartials/leader_contribution }}
      </div>

      <div class="dashboard-tab-content" id="library">
        {{> dashboardpartials/leader_mylibraryunits }}
      </div>

      {{!-- Leader tab JS (only run in leader mode) --}}
      <script>
        async function markSeenLeader(tab, count) {
          try {
            await fetch('/dashboard/leader/mark-seen', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'x-csrf-token': '{{csrfToken}}'
              },
              body: JSON.stringify({ tab, count: Number(count || 0) })
            });
          } catch (e) { /* no-op */ }
        }

        document.querySelectorAll('.dashboard-tab[data-tab]').forEach(btn => {
          btn.addEventListener('click', () => {
            const tab = btn.dataset.tab;
            const count = btn.dataset.count || 0;

            if (['group','topics','prompts','progress','library','tagged','missions'].includes(tab)) {
              markSeenLeader(tab, count);
              const dot = btn.querySelector('.tab-dot');
              if (dot) dot.style.display = 'none';
            }
          });
        });
      </script>

    {{/if}}

  </div>
</div>




